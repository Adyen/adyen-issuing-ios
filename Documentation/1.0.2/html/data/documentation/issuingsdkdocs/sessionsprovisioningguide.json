{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide"},"kind":"article","sections":[],"abstract":[{"text":"Add payment cards to Apple Wallet using the session-based API.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Card Provisioning Sessions","modules":[{"name":"IssuingSDKDocs"}]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"code":"CardProvisioningSessions","type":"codeVoice"},{"type":"text","text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally."}],"type":"paragraph"},{"name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}],"type":"paragraph"}],"style":"important"},{"type":"heading","level":2,"text":"Import","anchor":"Import"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"level":2,"type":"heading","anchor":"Session-Token-Role","text":"Session Token Role"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [\"Network Token: Create\"]"]},{"level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"type":"text","text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"type":"heading","text":"Initialize a Provisioning Session","anchor":"Initialize-a-Provisioning-Session","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"type":"codeVoice","code":"configure()"},{"text":".","type":"text"}]},{"code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"syntax":"swift","type":"codeListing"},{"text":"Check the Provisioning State","level":2,"anchor":"Check-the-Provisioning-State","type":"heading"},{"inlineContent":[{"type":"text","text":"Before showing the "},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"type":"text","text":" button, check the current provisioning state for the payment instrument."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Log reason for diagnostics, and map it to your own","    \/\/ copy for anything the cardholder sees.","}"]},{"type":"heading","text":"Provision the Card","anchor":"Provision-the-Card","level":2},{"inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"inlineContent":[{"type":"text","text":"Add to Apple Wallet"}],"type":"strong"},{"text":", present the native Wallet sheet:","type":"text"}],"type":"paragraph"},{"code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ The cardholder or the system dismissed the Apple Pay sheet.","    \/\/ This is not a failure, so leave your UI unchanged.","} catch {","    \/\/ Handle provisioning error","}"],"syntax":"swift","type":"codeListing"},{"text":"Handle the Result","level":2,"anchor":"Handle-the-Result","type":"heading"},{"inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"code":"CardActivationState","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"syntax":"swift","type":"codeListing"},{"text":"Error Handling","level":2,"anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"text":"All session operations throw ","type":"text"},{"code":"CardProvisioningSessionError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Match a single case","anchor":"Match-a-single-case","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The error type supports pattern matching, so you can catch one case directly without casting.","type":"text"},{"text":" ","type":"text"},{"text":"Matching compares the ","type":"text"},{"type":"codeVoice","code":"code"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"type":"text","text":" "},{"text":"underlying cause:","type":"text"}]},{"code":["do {","    try await provisioningSession.configure()","} catch CardProvisioningSessionError.couldNotEstablishSession {","    \/\/ Check connectivity and the session token, then retry.","} catch {","    \/\/ Handle everything else.","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Handle cancellation gracefully","anchor":"Handle-cancellation-gracefully","type":"heading"},{"inlineContent":[{"code":"provisioningCancelled","type":"codeVoice"},{"type":"text","text":" reports that the Apple Pay sheet was dismissed by the cardholder or by"},{"text":" ","type":"text"},{"type":"text","text":"the system. Nothing was provisioned and nothing failed, so treat it as a normal outcome. Do not"},{"text":" ","type":"text"},{"text":"present it as an error:","type":"text"}],"type":"paragraph"},{"code":["do {","    _ = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ Expected when the cardholder taps Cancel. Leave the UI as it was.","} catch {","    \/\/ Log the error for diagnostics, and show your own copy to the cardholder.","    print(error)","    showAlert(yourMessage(for: error))","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Branch across several cases","anchor":"Branch-across-several-cases"},{"inlineContent":[{"text":"To handle several failures at once, switch over ","type":"text"},{"code":"code","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Code","type":"codeVoice"},{"text":" is non-exhaustive, so always","type":"text"},{"text":" ","type":"text"},{"text":"include a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" case to stay forward compatible with future SDK versions:","type":"text"}],"type":"paragraph"},{"code":["do {","    try await provisioningSession.configure()","} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .noPaymentInstrumentsProvided:","        \/\/ `paymentInstrumentIds` in the configuration was empty.","        break","    case .noKeychainGroupIdProvided:","        \/\/ `keychainAccessGroup` was empty.","        break","    case .couldNotEstablishSession:","        \/\/ Network or authentication failure.","        break","    case .activationDataUnavailable:","        \/\/ Activation data could not be fetched or cached.","        break","    case .provisioningAlreadyInProgress:","        \/\/ A provisioning flow is already running for this payment instrument.","        break","    case .provisioningCancelled:","        \/\/ Dismissed by the cardholder or the system. Not a failure.","        break","    case .provisioningFailed:","        \/\/ PassKit or the provisioning infrastructure reported a failure.","        break","    default:","        break","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Logging","level":3,"anchor":"Logging","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"CardProvisioningSessionError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":", so log the error itself:"}],"type":"paragraph"},{"code":["print(error)","\/\/ CardProvisioningSessionError.couldNotEstablishSession: deviceRegistration, serverHTTPError. Trace: 00-abc..."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Where the failure came from a network call, ","type":"text"},{"type":"codeVoice","code":"description"},{"text":" includes the trace identifier Adyen","type":"text"},{"type":"text","text":" "},{"type":"text","text":"support needs to correlate the request. Where it came from PassKit, it includes that error’s"},{"type":"text","text":" "},{"type":"text","text":"domain and code. It never contains card data or session tokens, so it is safe to log."}],"type":"paragraph"},{"inlineContent":[{"text":"Avoid logging ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":". It carries no diagnostic detail, so the trace identifier is"},{"type":"text","text":" "},{"type":"text","text":"lost."}],"type":"paragraph"},{"inlineContent":[{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" is deliberately short because errors are commonly passed straight to the"},{"text":" ","type":"text"},{"type":"text","text":"UI, but it is not meant for display either: the text is English and is not localized. Map "},{"code":"code","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to your own copy for anything the cardholder sees.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Wallet Extension","anchor":"Wallet-Extension"},{"content":[{"inlineContent":[{"text":"The Wallet extension is mandatory. Without it, cardholders cannot add cards from the Apple Wallet app, and your app will not appear in Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section. Implement the Non-UI Extension, and the UI Extension when "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"text":", before shipping.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s "},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section.","type":"text"}]},{"inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":", that handles the full extension flow. You subclass it and override a small set of methods."}],"type":"paragraph"},{"type":"heading","text":"Prerequisites","anchor":"Prerequisites","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}]}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" you passed to ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"anchor":"Step-1-Create-the-Non-UI-Extension-Target","text":"Step 1: Create the Non-UI Extension Target","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":", find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}],"type":"paragraph"}]]],"header":"row"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"text":" entitlement (","type":"text"},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"text":") and include the same access group identifier you pass to ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"text":" (e.g., ","type":"text"},{"code":"[TeamId].com.yourcompany.shared","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":"CardProvisioningSessions","type":"codeVoice"},{"text":" as a dependency of this target.","type":"text"}]}]}],"type":"orderedList"},{"level":3,"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","text":"Step 2: Implement the Non-UI Extension Handler","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        UIImage(named: \"card\")!.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"],"type":"codeListing","syntax":"swift"},{"level":4,"anchor":"Required-Overrides","text":"Required Overrides","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared keychain group for activation data cached by the main app"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}],"type":"paragraph"}]]],"type":"table"},{"level":4,"anchor":"Optional-Overrides","text":"Optional Overrides","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".live"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Override to use "},{"type":"codeVoice","code":".test"},{"type":"text","text":" environment"}],"type":"paragraph"}]]],"type":"table"},{"level":3,"anchor":"Step-3-Ensure-Activation-Data-Is-Cached","text":"Step 3: Ensure Activation Data Is Cached","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK caches activation data in the shared keychain automatically when you call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" in the main app with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s "},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":" section."}]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user must open the provisioning flow in your main app at least once before the extension can show cards."}]}]},{"level":3,"anchor":"Step-4-Create-the-UI-Extension-Target-Optional","text":"Step 4: Create the UI Extension Target (Optional)","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":", set:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement.","type":"text"}],"type":"paragraph"}]}]},{"level":3,"anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading","text":"Step 5: Implement the UI Extension Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"code":"WalletExtensionUIHandler","type":"codeVoice"},{"text":". Build your authentication UI inside the initializer and call ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when the user finishes.","type":"text"}]},{"code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"SwiftUI is also supported via ","type":"text"},{"code":"UIHostingController","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"anchor":"Entitlements-Summary","type":"heading","text":"Entitlements Summary"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entitlement"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Main App"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UI Extension"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}]]]},{"level":3,"anchor":"How-the-Extension-Flow-Works","type":"heading","text":"How the Extension Flow Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"User opens Apple Wallet","type":"text"}],"type":"strong"},{"type":"text","text":" — the SDK reads cached activation data to determine available cards. Your app appears in "},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"User selects a card","type":"text"}]},{"text":" — card art from ","type":"text"},{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"},{"text":" is shown.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"type":"text","text":" — if "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", your UI Extension is presented."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Provisioning","type":"text"}]},{"text":" — the SDK fetches a fresh session token via ","type":"text"},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"text":" and completes provisioning.","type":"text"}],"type":"paragraph"}]}]},{"level":3,"anchor":"Troubleshooting","type":"heading","text":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"App does not appear in Wallet’s “From Apps on Your iPhone”:"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" enti