{"abstract":[{"type":"text","text":"Reveal card details, reveal PINs, and change PINs using direct service calls."}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The "},{"code":"Card","type":"codeVoice"},{"type":"text","text":" module provides low-level cryptographic services for sensitive card operations. Unlike "},{"type":"codeVoice","code":"CardSessions"},{"type":"text","text":" (which handles networking, session management, and token handling automatically), the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module when you need:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full control over the network layer (custom networking stack, interceptors, retry logic)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Integration into an architecture that doesn’t use ","type":"text"},{"code":"async\/await","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Direct access to the encrypted keys and data for custom backend flows"}]}]}]},{"type":"aside","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"If you prefer a higher-level API that handles networking and token management, use "},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","isActive":true},{"type":"text","text":" instead."}],"type":"paragraph"}],"style":"tip"},{"type":"heading","anchor":"Import","level":2,"text"