{"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"A Starting Guide (Sessions)"},"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card Provisioning Sessions"}]},{"text":" — Add payment cards to Apple Wallet","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Card Sessions"}],"type":"strong"},{"text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This guide covers the common setup steps required for all SDK features.","type":"text"}]},{"text":"Requirements","anchor":"Requirements","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS 16.0+"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Swift 5.9+","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Xcode 16+","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"https:\/\/www.adyen.com\/issuing","type":"reference"},{"text":" integration on your backend","type":"text"}]}]}]},{"text":"Prerequisites","anchor":"Prerequisites","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Before you begin:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Obtain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"text":"App Attest","type":"text"}]},{"type":"text","text":" entitlement ("},{"code":"com.apple.developer.devicecheck.appattest-environment","type":"codeVoice"},{"type":"text","text":") to your app:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Set to ","type":"text"},{"code":"\"development\"","type":"codeVoice"},{"text":" for testing. Use ","type":"text"},{"code":"SessionEnvironment.test","type":"codeVoice"},{"text":". Card operations work fully, but the provisioning flow is limited.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set to "},{"code":"\"production\"","type":"codeVoice"},{"type":"text","text":" for production. Use "},{"code":"SessionEnvironment.live","type":"codeVoice"},{"type":"text","text":". The full provisioning flow requires an App Store or TestFlight build."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"TestFlight builds automatically set the App Attest environment to "},{"type":"codeVoice","code":"\"production\""},{"text":".","type":"text"}]}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"text":"Embed the Certificate","type":"heading","level":2,"anchor":"Embed-the-Certificate"},{"type":"paragraph","inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}]},{"level":2,"type":"heading","text":"Fetch a Session Token","anchor":"Fetch-a-Session-Token"},{"type":"paragraph","inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"URL"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Test","type":"text"}]}],[{"inlineContent":[{"code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Live"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"https:\/\/authe-live.adyen.com\/authe\/api\/v1\/sessions"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"inlineContent":[{"text":"Headers:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"Content-Type: application\/json","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Body:","type":"text"}]}],"type":"paragraph"},{"code":["{","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"],"type":"codeListing","syntax":"json"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"The required ","type":"text"},{"code":"roles","type":"codeVoice"},{"text":" depend on the SDK feature you are using. See the feature-specific documentation for details.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Your backend should receive the session token and pass it to your iOS application.","type":"text"}]},{"text":"Import the SDK","anchor":"Import-the-SDK","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the appropriate import statements at the top of your Swift files:","type":"text"}]},{"code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This gives you access to all public types, including ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Do not import ","type":"text"},{"code":"IssuingCore","type":"codeVoice"},{"text":" directly. It is an internal dependency that is required at link time but has no public API for integrators.","type":"text"}]}]},{"text":"Implement a Token Provider","anchor":"Implement-a-Token-Provider","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}]},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Device-Testing-Requirements","text":"Device Testing Requirements","type":"heading"},{"inlineContent":[{"text":"The SDK requires a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Release build on a physical device"}]},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Next-Steps","text":"Next Steps","type":"heading"},{"inlineContent":[{"text":"This guide covered the common, sessions-based setup. Continue with the feature-specific guide for what you want to build:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide"},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},{"text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"type":"topic","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","title":"Issuing SDK","kind":"article","role":"collection","url":"\/documentation\/issuingsdkdocs"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SessionsProvisioningGuide":{"kind":"article","role":"article","abstract":[{"text":"Add payment cards to Apple Wallet