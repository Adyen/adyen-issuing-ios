{"sections":[],"abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide"},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally."}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"type":"text","text":" before proceeding."}]}]},{"anchor":"Import","level":2,"type":"heading","text":"Import"},{"code":["import CardProvisioningSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"text":"Session Token Role","level":2,"type":"heading","anchor":"Session-Token-Role"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}]},{"code":["\"roles\": [\"Network Token: Create\"]"],"syntax":"json","type":"codeListing"},{"text":"Create a Configuration Object","level":2,"anchor":"Create-a-Configuration-Object","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}],"type":"paragraph"},{"code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}],"type":"paragraph"}]},{"type":"heading","text":"Initialize a Provisioning Session","level":2,"anchor":"Initialize-a-Provisioning-Session"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"ProvisioningSession"},{"text":" and call ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":" to fetch activation data. The initializer is synchronous — async work begins only in ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"]},{"anchor":"Check-the-Provisioning-State","level":2,"type":"heading","text":"Check the Provisioning State"},{"type":"paragraph","inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Log reason for diagnostics, and map it to your own","    \/\/ copy for anything the cardholder sees.","}"]},{"text":"Provision the Card","level":2,"type":"heading","anchor":"Provision-the-Card"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the cardholder taps "},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"type":"text","text":", present the native Wallet sheet:"}]},{"syntax":"swift","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ The cardholder or the system dismissed the Apple Pay sheet.","    \/\/ This is not a failure, so leave your UI unchanged.","} catch {","    \/\/ Handle provisioning error","}"],"type":"codeListing"},{"text":"Handle the Result","level":2,"anchor":"Handle-the-Result","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provision(paymentInstrumentId:viewController:)"},{"text":" returns a ","type":"text"},{"type":"codeVoice","code":"CardActivationState"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"]},{"text":"Error Handling","level":2,"type":"heading","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All session operations throw "},{"type":"codeVoice","code":"CardProvisioningSessionError"},{"type":"text","text":"."}]},{"text":"Match a single case","level":3,"type":"heading","anchor":"Match-a-single-case"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The error type supports pattern matching, so you can catch one case directly without casting."},{"type":"text","text":" "},{"type":"text","text":"Matching compares the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"type":"text","text":" "},{"type":"text","text":"underlying cause:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await provisioningSession.configure()","} catch CardProvisioningSessionError.couldNotEstablishSession {","    \/\/ Check connectivity and the session token, then retry.","} catch {","    \/\/ Handle everything else.","}"]},{"text":"Handle cancellation gracefully","level":3,"type":"heading","anchor":"Handle-cancellation-gracefully"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provisioningCancelled"},{"type":"text","text":" reports that the Apple Pay sheet was dismissed by the cardholder or by"},{"type":"text","text":" "},{"type":"text","text":"the system. Nothing was provisioned and nothing failed, so treat it as a normal outcome. Do not"},{"type":"text","text":" "},{"type":"text","text":"present it as an error:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    _ = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ Expected when the cardholder taps Cancel. Leave the UI as it was.","} catch {","    \/\/ Log the error for diagnostics, and show your own copy to the cardholder.","    print(error)","    showAlert(yourMessage(for: error))","}"]},{"text":"Branch across several cases","level":3,"type":"heading","anchor":"Branch-across-several-cases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To handle several failures at once, switch over "},{"type":"codeVoice","code":"code"},{"type":"text","text":". "},{"type":"codeVoice","code":"Code"},{"type":"text","text":" is non-exhaustive, so always"},{"type":"text","text":" "},{"type":"text","text":"include a "},{"type":"codeVoice","code":"default"},{"type":"text","text":" case to stay forward compatible with future SDK versions:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await provisioningSession.configure()","} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .noPaymentInstrumentsProvided:","        \/\/ `paymentInstrumentIds` in the configuration was empty.","        break","    case .noKeychainGroupIdProvided:","        \/\/ `keychainAccessGroup` was empty.","        break","    case .couldNotEstablishSession:","        \/\/ Network or authentication failure.","        break","    case .activationDataUnavailable:","        \/\/ Activation data could not be fetched or cached.","        break","    case .provisioningAlreadyInProgress:","        \/\/ A provisioning flow is already running for this payment instrument.","        break","    case .provisioningCancelled:","        \/\/ Dismissed by the cardholder or the system. Not a failure.","        break","    case .provisioningFailed:","        \/\/ PassKit or the provisioning infrastructure reported a failure.","        break","    default:","        break","    }","}"]},{"text":"Logging","level":3,"type":"heading","anchor":"Logging"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CardProvisioningSessionError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":", so log the error itself:"}]},{"syntax":"swift","type":"codeListing","code":["print(error)","\/\/ CardProvisioningSessionError.couldNotEstablishSession: deviceRegistration, serverHTTPError. Trace: 00-abc..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the failure came from a network call, "},{"type":"codeVoice","code":"description"},{"type":"text","text":" includes the trace identifier Adyen"},{"type":"text","text":" "},{"type":"text","text":"support needs to correlate the request. Where it came from PassKit, it includes that error’s"},{"type":"text","text":" "},{"type":"text","text":"domain and code. It never contains card data or session tokens, so it is safe to log."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid logging "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":". It carries no diagnostic detail, so the trace identifier is"},{"type":"text","text":" "},{"type":"text","text":"lost."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is deliberately short because errors are commonly passed straight to the"},{"type":"text","text":" "},{"type":"text","text":"UI, but it is not meant for display either: the text is English and is not localized. Map "},{"type":"codeVoice","code":"code"},{"type":"text","text":" "},{"type":"text","text":"to your own copy for anything the cardholder sees."}]},{"text":"Wallet Extension","level":2,"type":"heading","anchor":"Wallet-Extension"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Wallet extension is mandatory. Without it, cardholders cannot add cards from the Apple Wallet app, and your app will not appear in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section. Implement the Non-UI Extension, and the UI Extension when "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", before shipping."}]}],"type":"aside","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sessions approach provides a high-level base class, "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":", that handles the full extension flow. You subclass it and override a small set of methods."}]},{"text":"Prerequisites","level":3,"type":"heading","anchor":"Prerequisites"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A shared keychain access group must be configured (the same "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" you passed to "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}]}]}],"type":"orderedList"},{"text":"Step 1: Create the Non-UI Extension Target","level":3,"type":"heading","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler","type":"codeVoice"}]}]]]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":" (e.g., "},{"type":"codeVoice","code":"[TeamId].com.yourcompany.shared"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}]}]}],"type":"orderedList"},{"text":"Step 2: Implement the Non-UI Extension Handler","level":3,"type":"heading","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        UIImage(named: \"card\")!.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"]},{"text":"Required Overrides","level":4,"type":"heading","anchor":"Required-Overrides"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared keychain group for activation data cached by the main app"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}]}]]]},{"text":"Optional Overrides","level":4,"type":"heading","anchor":"Optional-Overrides"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment()"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".live"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override to use "},{"type":"codeVoice","code":".test"},{"type":"text","text":" environment"}]}]]]},{"text":"Step 3: Ensure Activation Data Is Cached","level":3,"type":"heading","anchor":"Step-3-Ensure-Activation-Data-Is-Cached"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK caches activation data in the shared keychain automatically when you call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" in the main app with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section."}]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user must open the provisioning flow in your main app at least once before the extension can show cards."}]}],"type":"aside","name":"Important"},{"text":"Step 4: Create the UI Extension Target (Optional)","level":3,"type":"heading","anchor":"Step-4-Create-the-UI-Extension-Target-Optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", set:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}]}]]]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}]}]}],"type":"orderedList"},{"text":"Step 5: Implement the UI Extension Handler","level":3,"type":"heading","anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionUIHandler"},{"type":"text","text":". Build your authentication UI inside the initializer and call "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when the user finishes."}]},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI is also supported via "},{"type":"codeVoice","code":"UIHostingController"},{"type":"text","text":"."}]},{"text":"Entitlements Summary","level":3,"type":"heading","anchor":"Entitlements-Summary"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entitlement"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Main App"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UI Extension"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}]]]},{"text":"How the Extension Flow Works","level":3,"type":"heading","anchor":"How-the-Extension-Flow-Works"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"User opens Apple Wallet","type":"text"}]},{"type":"text","text":" — the SDK reads cached activation data to determine available cards. Your app appears in "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"User selects a card","type":"text"}]},{"type":"text","text":" — card art from "},{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"},{"type":"text","text":" is shown."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication","type":"text"}]},{"type":"text","text":" — if "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", your UI Extension is presented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Provisioning","type":"text"}]},{"type":"text","text":" — the SDK fetches a fresh session token via "},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"type":"text","text":" and completes provisioning."}]}]}],"type":"orderedList"},{"text":"Troubleshooting","level":3,"type":"heading","anchor":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"App does not appear in Wallet’s “From Apps on Your iPhone”:"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement is present on all targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" has been called in the main app at least once so activation data is cached."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" matches your class name exactly."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication UI does not appear:"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extension cannot read cached data:"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" return value matches the "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" used in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier."}]}]}],"type":"unorderedList"},{"text":"Testing","level":2,"type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card provisioning requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"type":"text","text":" and a supported distribution build (TestFlight or App Store) using the "},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"type":"text","text":" environment. The Simulator is not supported for provisioning."}]}]}],"variants":[{"paths":["\/documentation\/issuingsdkdocs\/sessionsprovisioningguide"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"IssuingSDKDocs"}],"title":"Card Provisioning Sessions"},"kind":"article","references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"title":"A Starting Guide (Sessions)","url":"\/documentation\/issuingsdkdocs\/gettingstarted","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs","type":"topic","url":"\/documentation\/issuingsdkdocs","role":"collection","kind":"symbol"}}}