{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Download-the-SDK","text":"Download the SDK"},{"inlineContent":[{"type":"text","text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:"}],"type":"paragraph"},{"type":"codeListing","syntax":"text","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need the "},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":" SDK, available from ","type":"text"},{"identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios","type":"reference","isActive":true},{"text":". Download the ","type":"text"},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" (and ","type":"text"},{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"type":"text","text":" if you use a Wallet Extension)."}]},{"anchor":"Required-Frameworks","level":2,"type":"heading","text":"Required Frameworks"},{"anchor":"Network-Token-Provisioning","text":"Network Token Provisioning","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"All of the following frameworks are "},{"inlineContent":[{"text":"required","type":"text"}],"type":"strong"},{"type":"text","text":" for Apple Wallet provisioning:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Framework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import in Code?"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provisioning logic and public API"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared types ("},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", etc.)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Internal secure communication"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple Pay provisioning interface"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]}]}]]]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" must be embedded in your app for the SDK to function, but you should "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" import them in your code. They are used internally by "},{"type":"codeVoice","code":"NetworkTokenProvisioning"},{"type":"text","text":" and should not be accessed directly."}]}]},{"level":2,"type":"heading","anchor":"Embed-the-Frameworks","text":"Embed the Frameworks"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Drag all four "},{"type":"codeVoice","code":".xcframework"},{"type":"text","text":" bundles into your Xcode project navigator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your app target, go to "},{"inlineContent":[{"text":"General > Frameworks, Libraries, and Embedded Content","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"inlineContent":[{"text":"Embed & Sign","type":"text"}],"type":"strong"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]}]}]}],"type":"orderedList"},{"level":2,"type":"heading","anchor":"Import-Statements","text":"Import Statements"},{"inlineContent":[{"type":"text","text":"When embedding manually, import the individual modules — not the SPM wrapper name:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With SPM, you use "},{"type":"codeVoice","code":"import AdyenNetworkTokenProvisioning"},{"type":"text","text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately."}]}]},{"level":2,"type":"heading","anchor":"Keychain-Access-Group","text":"Keychain Access Group"},{"inlineContent":[{"type":"text","text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable "},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"type":"text","text":" in your app target’s "},{"inlineContent":[{"text":"Signing & Capabilities","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same access group to both the app and the extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the access group identifier when configuring the SDK:"}]}]}],"type":"orderedList"},{"type":"codeListing","syntax":"swift","code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"]},{"level":2,"type":"heading","anchor":"Wallet-Extension-Support","text":"Wallet Extension Support"},{"inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"type":"text","text":" (instead of "},{"type":"codeVoice","code":"AdyenApplePayProvisioning"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"In the extension, use the same imports:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"],"type":"codeListing"},{"text":"Verify the Integration","anchor":"Verify-the-Integration","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"After embedding:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Build the project. All three frameworks should compile and link without errors."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run on the iOS Simulator to verify basic initialization."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Test provisioning on a physical device (simulators do not support Apple Wallet)."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"type":"heading","text":"Troubleshooting","anchor":"Troubleshooting"},{"text":"“No such module ‘NetworkTokenProvisioning’”","anchor":"No-such-module-NetworkTokenProvisioning","type":"heading","level":3},{"inlineContent":[{"text":"Ensure the XCFramework is added to your target’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"text":" section and is set to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"“No such module ‘IssuingCommon’”","anchor":"No-such-module-IssuingCommon","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Same as above — "},{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" must also be embedded. This framework contains shared types like "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Runtime crash: “Library not loaded: IssuingCore”","anchor":"Runtime-crash-Library-not-loaded-IssuingCore","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" is not embedded. Add it to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":" even though you don’t import it in code. The other frameworks depend on it at runtime."}],"type":"paragraph"},{"text":"Runtime crash: “Library not loaded: AdyenApplePayProvisioning”","anchor":"Runtime-crash-Library-not-loaded-AdyenApplePayProvisioning","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" is not embedded. It is a required dependency for Network Token Provisioning. Add it to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Duplicate-symbols","text":"Duplicate symbols","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"article","roleHeading":"Article","title":"Manual Integration"},"identifier":{"url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"abstract":[{"type":"text","text":"Integrate 