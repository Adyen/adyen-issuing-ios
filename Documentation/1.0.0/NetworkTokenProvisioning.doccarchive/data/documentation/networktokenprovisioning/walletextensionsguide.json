{"metadata":{"roleHeading":"Article","role":"article","title":"Wallet Extensions"},"sections":[],"abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}],"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section, giving users another path to provision their cards."}]},{"type":"paragraph","inlineContent":[{"text":"This requires two app extensions:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Extension"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Non-UI Extension"}],"type":"strong"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Provides card data, status, and handles the provisioning flow","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"strong"}]}],[{"inlineContent":[{"text":"Presents your custom authentication UI before provisioning","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic."}]},{"anchor":"Prerequisites","type":"heading","text":"Prerequisites","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before implementing wallet extensions:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Complete the "},{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","type":"reference","isActive":true},{"text":" guide and have in-app provisioning working.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure you have the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement. This entitlement must be added to ","type":"text"},{"inlineContent":[{"type":"text","text":"all three targets"}],"type":"strong"},{"text":": the main app, the Non-UI Extension, and the UI Extension.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Set up a shared keychain access group so the main app and extensions can share cached data."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","anchor":"Step-1-Create-the-Non-UI-Extension-Target","level":2,"text":"Step 1: Create the Non-UI Extension Target"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":" template and create a new target (e.g., "},{"type":"codeVoice","code":"WalletExtension"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"type":"text","text":" "},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Update the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler","type":"codeVoice"}]}]]]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement to this target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a shared app group entitlement (e.g., ","type":"text"},{"code":"group.com.yourcompany.wallet","type":"codeVoice"},{"text":") matching the one in your main app.","type":"text"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","anchor":"Add-the-SDK-to-the-Extension-Target","text":"Add the SDK to the Extension Target"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager:"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"AdyenNetworkTokenProvisioning"},{"type":"text","text":" as a dependency of your extension target, just as you did for the main app."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Manual Integration:","type":"text"}],"type":"strong"}]},{"inlineContent":[{"type":"text","text":"Embed the same XCFrameworks in the extension target with "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":". See "},{"type":"reference","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","isActive":true},{"type":"text","text":" for which frameworks are required."}],"type":"paragraph"},{"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","text":"Step 2: Implement the Non-UI Extension Handler","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler","type":"reference","isActive":true},{"text":". This class is your extension’s entry point — its name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"]},{"type":"heading","level":3,"text":"Required Overrides","anchor":"Required-Overrides"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shared keychain group for cached data between app and extension","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}],"type":"paragraph"}]]]},{"level":3,"type":"heading","anchor":"Optional-Overrides","text":"Optional Overrides"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment()"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the session environment ("},{"code":".test","type":"codeVoice"},{"text":", ","type":"text"},{"code":".live","type":"codeVoice"},{"text":")","type":"text"}]}]]]},{"text":"Step 3: Cache Activation Data in Your Main App","anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App","type":"heading","level":2},{"inlineContent":[{"text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."],"type":"codeListing","syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"type":"text","text":" section. Make sure the user has opened the provisioning flow in your main app at least once."}],"type":"paragraph"}]},{"text":"Step 4: Create the UI Extension Target","anchor":"Step-4-Create-the-UI-Extension-Target","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":" template again (e.g., "},{"type":"codeVoice","code":"WalletUIExtension"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Update the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}],"type":"paragraph"}]]]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement to this target as well.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","anchor":"Step-5-Implement-the-UI-Extension-Handler","text":"Step 5: Implement the UI Extension Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"reference","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","isActive":true},{"type":"text","text":". This view controller is presented by Apple Wallet when authentication is required."}]},{"type":"codeListing","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use UIKit or SwiftUI (via "},{"type":"codeVoice","code":"UIHostingController"},{"type":"text","text":") for the authentication UI. The key requirement is calling "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when the user finishes authenticating."}]},{"level":3,"type":"heading","anchor":"Using-SwiftUI","text":"Using SwiftUI"},{"type":"codeListing","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Entitlements-Summary","text":"Entitlements Summary"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access."}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Entitlement"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Main App"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UI Extension"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.security.application-groups"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optional","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Example "},{"code":".entitlements","type":"codeVoice"},{"type":"text","text":" file for the Non-UI Extension:"}],"type":"paragraph"},{"code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"],"syntax":"xml","type":"codeListing"},{"level":2,"type":"heading","anchor":"How-It-Works","text":"How It Works"},{"inlineContent":[{"text":"Once configured, the flow works as follows:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"User opens Apple Wallet"}],"type":"strong"},{"text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"User selects your app","type":"text"}]},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"text":" — If ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", Apple Wallet presents your UI Extension. Your UI Extension calls ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when done.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Provisioning","type":"text"}]},{"type":"text","text":" — The SDK handles the provisioning request using the session token from your "},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"type":"text","text":" method."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}]},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference."}]}]},{"anchor":"Troubleshooting","text":"Troubleshooting","level":2,"type":"heading"},{"text":"App does not appear in Wallet’s “From Apps on Your iPhone”","anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement is present on all three targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure activation data has been cached by the main app before opening Wallet."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is set to ","type":"text"},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"},{"type":"text","text":" (not the authorization variant) in the Non-UI Extension."}]}]},{"content":[{"inlineContent":[{"text":"Make sure the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" matches your handler class name exactly."}],"type":"paragraph"}]}]},{"text":"Authentication UI does not appear","anchor":"Authentication-UI-does-not-appear","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is set to "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Extension-cannot-access-cached-data","text":"Extension cannot access cached data","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm both the main app and the extension share the same keychain access group."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","te