{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"role":"article","modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article","title":"Card Provisioning Sessions"},"abstract":[{"text":"Add payment cards to Apple Wallet using the session-based API.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}],"type":"paragraph"}]},{"text":"Import","level":2,"anchor":"Import","type":"heading"},{"code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"text":"Session Token Role","type":"heading","level":2,"anchor":"Session-Token-Role"},{"inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}],"type":"paragraph"},{"syntax":"json","code":["\"roles\": [\"Network Token: Create\"]"],"type":"codeListing"},{"level":2,"text":"Create a Configuration Object","type":"heading","anchor":"Create-a-Configuration-Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"text":" with your certificate, the payment instrument IDs you want to provision,