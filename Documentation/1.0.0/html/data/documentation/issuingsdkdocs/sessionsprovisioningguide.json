"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" matches your class name exactly.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication UI does not appear:"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extension cannot read cached data:"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" return value matches the "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" used in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier."}],"type":"paragraph"}]}]},{"text":"Testing","level":2,"type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card provisioning requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" and a supported distribution build (TestFlight or App Store) using the "},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"type":"text","text":" environment. The Simulator is not supported for provisioning."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/issuingsdkdocs\/sessionsprovisioningguide"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide"},"metadata":{"roleHeading":"Article","title":"Card Provisioning Sessions","modules":[{"name":"IssuingSDKDocs"}],"role":"article"},"sections":[],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"kind":"article","type":"topic","title":"A Starting Guide (Sessions)","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","url":"\/documentation\/issuingsdkdocs\/gettingstarted","role":"article","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}]},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"kind":"symbol","title":"IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection"}}}