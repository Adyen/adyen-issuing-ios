nlineContent":[{"type":"text","text":"Ensure "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" has been called in the main app at least once so activation data is cached."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" matches your class name exactly."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication UI does not appear:"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Extension cannot read cached data:"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" return value matches the "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" used in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement is present on both the main app and Non-UI Extension targets with the same group identifier."}]}]}]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"