oice"},{"text":" entitlement is present on all targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" has been called in the main app at least once so activation data is cached."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" matches your class name exactly.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Authentication UI does not appear:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Extension cannot read cached data:","type":"text"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the "},{"code":"keychainAccessGroup()","type":"codeVoice"},{"text":" return value matches the ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" used in ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the ","type":"text"},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"code":"com.apple.security.keyc