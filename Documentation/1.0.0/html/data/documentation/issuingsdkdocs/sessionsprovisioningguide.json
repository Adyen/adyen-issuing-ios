{"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"IssuingSDKDocs"}],"title":"Card Provisioning Sessions","roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Add payment cards to Apple Wallet using the session-based API.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"The Sessions approach uses the ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally."}],"type":"paragraph"},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}],"type":"paragraph"}]},{"anchor":"Import","text":"Import","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import IssuingCommon"]},{"text":"Session Token Role","anchor":"Session-Token-Role","type":"heading","level":2},{"inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["\"roles\": [\"Network Token: Create\"]"]},{"level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"text":" with your certificate, your Apple Team ID, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}],"type":"paragraph"},{"code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    appTeamId: \"[YourAppleTeamID]\",","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":2,"anchor":"Initialize-a-Provisioning-Session","text":"Initialize a Provisioning Session","type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":" and call ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" to fetch activation data. The initializer is synchronous — async work begins only in ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Check the Provisioning State","anchor":"Check-the-Provisioning-State","type":"heading"},{"inlineContent":[{"type":"text","text":"Before showing the "},{"inlineContent":[{"type":"text","text":"Add to Apple Wallet"}],"type":"strong"},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}],"type":"paragraph"},{"code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Provision-the-Card","text":"Provision the Card","type":"heading","level":2},{"inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"type":"text","text":", present the native Wallet sheet:"}],"type":"paragraph"},{"code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Handle the Result","anchor":"Handle-the-Result","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"code":"CardActivationState","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"]},{"text":"Wallet Extension","type":"heading","anchor":"Wallet-Extension","level":2},{"inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"text":" section.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}]},{"anchor":"Prerequisites","text":"Prerequisites","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In-app provisioning must be working first.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" you passed to "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}]}]}],"type":"orderedList"},{"level":3,"type":"heading","text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"text":" and select ","type":"text"},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":", find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler"}]}]]],"header":"row"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a shared app group entitlement matching the one in your main app (e.g., "},{"code":"group.com.yourcompany.wallet","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}]}]}],"type":"orderedList"},{"type":"heading","level":3,"text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","","class WalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's ConfigurationParameters.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"]},{"type":"heading","level":4,"text":"Required Overrides","anchor":"Required-Overrides"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}]}]]],"type":"table","header":"row"},{"text":"Optional Overrides","type":"heading","level":4,"anchor":"Optional-Overrides"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default"}]}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".live"}],"type":"paragraph"}],[{"type":"para