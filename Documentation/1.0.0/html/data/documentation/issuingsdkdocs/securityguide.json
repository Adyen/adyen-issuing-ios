{"metadata":{"roleHeading":"Article","modules":[{"name":"IssuingSDKDocs"}],"role":"article","title":"Security Guide"},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"variants":[{"paths":["\/documentation\/issuingsdkdocs\/securityguide"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}]},{"level":2,"type":"heading","text":"Device Unlock Requirement","anchor":"Device-Unlock-Requirement"},{"inlineContent":[{"text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Use "},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important"},{"level":2,"anchor":"Prevent-Screen-Capture","type":"heading","text":"Prevent Screen Capture"},{"inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}],"type":"paragraph"},{"code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Protect-Sensitive-Views-in-App-Switcher","type":"heading","text":"Protect Sensitive Views in App Switcher"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}]},{"code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Secure-Data-Storage","type":"heading","text":"Secure Data Storage"},{"type":"paragraph","inlineContent":[{"text":"Never store tokens, keys, or credentials in ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}]},{"code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup.","type":"text"}]},{"level":2,"anchor":"Handle-Sensitive-Data-in-Memory","text":"Handle Sensitive Data in Memory","type":"heading"},{"inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}],"type":"paragraph"},{"code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"code":"String","type":"codeVoice"},{"type":"text","text":" — prefer "},{"code":"Data","type":"codeVoice"},{"text":" so you control the lifecycle. Never log sensitive values.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Secure-Networking","text":"Secure Networking","type":"heading"},{"inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" does not weaken App Transport Security:"}],"type":"paragraph"},{"code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}],"type":"paragraph"},{"level":2,"text":"Jailbreak Detection","anchor":"Jailbreak-Detection","type":"heading"},{"inlineContent":[{"text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}]}],"style":"note","name":"Note","type":"aside"}]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"title":"IssuingSDKDocs","kind":"symbol","url":"\/documentation\/issuingsdkdocs","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","abstract":[],"role":"collection"}}}