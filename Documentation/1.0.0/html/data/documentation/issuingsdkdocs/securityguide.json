{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices.","type":"text"}]},{"type":"heading","anchor":"Device-Unlock-Requirement","level":2,"text":"Device Unlock Requirement"},{"inlineContent":[{"text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card.","type":"text"}],"type":"paragraph"},{"code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".deviceOwnerAuthentication"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"type":"text","text":") so users with a passcode but no biometrics are not locked out."}]}],"type":"aside"},{"level":2,"anchor":"Prevent-Screen-Capture","type":"heading","text":"Prevent Screen Capture"},{"inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}],"type":"paragraph"},{"syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing"},{"text":"Protect Sensitive Views in App Switcher","anchor":"Protect-Sensitive-Views-in-App-Switcher","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}],"type":"paragraph"},{"syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing"},{"text":"Secure Data Storage","anchor":"Secure-Data-Storage","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"type":"codeVoice","code":"UserDefaults"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup.","type":"text"}]},{"level":2,"type":"heading","text":"Handle Sensitive Data in Memory","anchor":"Handle-Sensitive-Data-in-Memory"},{"type":"paragraph","inlineContent":[{"text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed.","type":"text"}]},{"syntax":"swift","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"type":"codeListing"},{"inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" — prefer ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" so you control the lifecycle. Never log sensitive values.","type":"text"}],"type":"paragraph"},{"anchor":"Secure-Networking","level":2,"type":"heading","text":"Secure Networking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" does not weaken App Transport Security:"}]},{"code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}]},{"type":"heading","level":2,"text":"Jailbreak Detection","anchor":"Jailbreak-Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}]}],"style":"note","name":"Note"}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/securityguide"]}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article","title":"Security Guide","role":"article"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","type":"topic","role":"collection","abstract":[],"kind":"symbol","title":"IssuingSDKDocs"}}}