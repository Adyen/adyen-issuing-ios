{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}]},{"anchor":"Device-Unlock-Requirement","type":"heading","level":2,"text":"Device Unlock Requirement"},{"inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}],"type":"paragraph"},{"code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".deviceOwnerAuthentication"},{"type":"text","text":" (not "},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"type":"text","text":") so users with a passcode but no biometrics are not locked out."}]}]},{"anchor":"Prevent-Screen-Capture","level":2,"text":"Prevent Screen Capture","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data.","type":"text"}]},{"code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Protect-Sensitive-Views-in-App-Switcher","level":2,"text":"Protect Sensitive Views in App Switcher"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}]},{"type":"codeListing","syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"]},{"anchor":"Secure-Data-Storage","type":"heading","level":2,"text":"Secure Data Storage"},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}]},{"anchor":"Handle-Sensitive-Data-in-Memory","type":"heading","level":2,"text":"Handle Sensitive Data in Memory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}]},{"type":"codeListing","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Avoid storing sensitive values in "},{"code":"String","type":"codeVoice"},{"type":"text","text":" — prefer "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}],"type":"paragraph"},{"anchor":"Secure-Networking","level":2,"text":"Secure Networking","type":"heading"},{"inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" does not weaken App Transport Security:"}],"type":"paragraph"},{"syntax":"xml","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"code":"URLSession","type":"codeVoice"},{"text":" to prevent man-in-the-middle attacks on your own backend endpoints.","type":"text"}],"type":"paragraph"},{"anchor":"Jailbreak-Detection","level":2,"text":"Jailbreak Detection","type":"heading"},{"inlineContent":[{"text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide"},"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"sections":[],"variants":[{"paths":["\/documentation\/issuingsdkdocs\/securityguide"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"role":"article","title":"Security Guide","roleHeading":"Article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"kind":"symbol","title":"IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection"}}}