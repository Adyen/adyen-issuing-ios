{"metadata":{"title":"Security Guide","role":"article","modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article"},"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices.","type":"text"}]},{"level":2,"anchor":"Device-Unlock-Requirement","type":"heading","text":"Device Unlock Requirement"},{"inlineContent":[{"text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".deviceOwnerAuthentication"},{"type":"text","text":" (not "},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}]}],"name":"Important","style":"important"},{"level":2,"anchor":"Prevent-Screen-Capture","type":"heading","text":"Prevent Screen Capture"},{"type":"paragraph","inlineContent":[{"text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"]},{"type":"heading","level":2,"anchor":"Protect-Sensitive-Views-in-App-Switcher","text":"Protect Sensitive Views in App Switcher"},{"type":"paragraph","inlineContent":[{"text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"]},{"type":"heading","level":2,"anchor":"Secure-Data-Storage","text":"Secure Data Storage"},{"type":"paragraph","inlineContent":[{"text":"Never store tokens, keys, or credentials in ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}]},{"type":"heading","level":2,"anchor":"Handle-Sensitive-Data-in-Memory","text":"Handle Sensitive Data in Memory"},{"inlineContent":[{"text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"]},{"inlineContent":[{"type":"text","text":"Avoid storing sensitive values in "},{"type":"codeVoice","code":"String"},{"type":"text","text":" — prefer "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}],"type":"paragraph"},{"type":"heading","anchor":"Secure-Networking","text":"Secure Networking","level":2},{"inlineContent":[{"text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" does not weaken App Transport Security:","type":"text"}],"type":"paragraph"},{"syntax":"xml","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}],"type":"paragraph"},{"text":"Jailbreak Detection","type":"heading","level":2,"anchor":"Jailbreak-Detection"},{"inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}],"type":"paragraph"},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}]}],"name":"Note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/securityguide"]}],"kind":"article","references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"role":"collection","abstract":[],"kind":"symbol","title":"IssuingSDKDocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","type":"topic","url":"\/documentation\/issuingsdkdocs"}}}