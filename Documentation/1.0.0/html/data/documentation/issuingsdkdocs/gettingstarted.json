{"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Sessions","type":"text"}]},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Prerequisites","anchor":"Prerequisites"},{"inlineContent":[{"type":"text","text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Embed the Certificate","anchor":"Embed-the-Certificate"},{"inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Fetch a Session Token","anchor":"Fetch-a-Session-Token"},{"inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph",