{"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card Provisioning Sessions"}]},{"text":" — Add payment cards to Apple Wallet","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Card Sessions","type":"text"}],"type":"strong"},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Prerequisites","anchor":"Prerequisites"},{"inlineContent":[{"text":"Before you begin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Obtain a certificate from Adyen. This certificate is required to initialize the SDK."}]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"inlineContent":[{"text":"App Attest","type":"text"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"code":"com.apple.developer.devicecheck.appattest-environment","type":"codeVoice"},{"type":"text","text":") to your app:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Set to ","type":"text"},{"code":"\"development\"","type":"codeVoice"},{"text":" for testing. Use ","type":"text"},{"code":"SessionEnvironment.test","type":"codeVoice"},{"text":". Card operations work fully, but the provisioning flow is limited.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Set to ","type":"text"},{"code":"\"production\"","type":"codeVoice"},{"text":" for production. Use ","type":"text"},{"code":"SessionEnvironment.live","type":"codeVoice"},{"text":". The full provisioning flow requires an App Store or TestFlight build.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"TestFlight builds automatically set the App Attest environment to ","type":"text"},{"code":"\"production\"","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]}]}],"type":"orderedList"},{"level":2,"type":"heading","text":"Embed the Certificate","anchor":"Embed-the-Certificate"},{"type":"paragraph","inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}]},{"level":2,"type":"heading","text":"Fetch a Session Token","anchor":"Fetch-a-Session-Token"},{"type":"paragraph","inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Perform a ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" request to the following endpoint:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"URL"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test"}]}],[{"type":"paragraph","inlineContent":[{"code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Live"}]}],[{"type":"paragraph","inlineContent":[{"code":"https:\/\/authe-live.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Headers:"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type: application\/json"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body:"}]}]},{"syntax":"json","type":"codeListing","code":["{","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The required "},{"code":"roles","type":"codeVoice"},{"type":"text","text":" depend on the SDK feature you are using. See the feature-specific documentation for details."}]}],"name":"Note","type":"aside","style":"note"},{"type":"paragraph","inlineContent":[{"text":"Your backend should receive the session token and pass it to your iOS application.","type":"text"}]},{"level":2,"type":"heading","text":"Import the SDK","anchor":"Import-the-SDK"},{"type":"paragraph","inlineContent":[{"text":"Add the appropriate import statements at the top of your Swift files:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import IssuingCommon"]},{"type":"paragraph","inlineContent":[{"text":"This gives you access to all public types, including ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":".","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"name":"Note","type":"aside","style":"note"},{"level":2,"type":"heading","text":"Implement a Token Provider","anchor":"Implement-a-Token-Provider"},{"type":"paragraph","inlineContent":[{"text":"Your app needs an object that conforms to the ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"level":2,"type":"heading","text":"Device Testing Requirements","anchor":"Device-Testing-Requirements"},{"type":"paragraph","inlineContent":[{"text":"The SDK requires a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Release build on a physical device"}]},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}]},{"level":2,"type":"heading","text":"Next Steps","anchor":"Next-Steps"},{"type":"paragraph","inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide"},{"text":" — Understand the two provisioni