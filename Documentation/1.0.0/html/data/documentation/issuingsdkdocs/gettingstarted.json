isting","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Do not import ","type":"text"},{"type":"codeVoice","code":"IssuingCore"},{"text":" directly. It is an internal dependency that is required at link time but has no public API for integrators.","type":"text"}]}],"type":"aside","name":"Note","style":"note"},{"level":2,"anchor":"Implement-a-Token-Provider","type":"heading","text":"Implement a Token Provider"},{"inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"type":"heading","level":2,"text":"Device Testing Requirements","anchor":"Device-Testing-Requirements"},{"inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide","isActive":true},{"text":" — Understand the two provisioning approaches and choose the right one for your architecture","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","isActive":true},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide","isActive":true},{"type":"text","text":" — Add cards to Apple Wallet with direct control over each provisioning step"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","isActive":true},{"text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)","type":"text"}]}]}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},"sections":[],"metadata":{"title":"A Starting Guide (Sessions)","modules":[{"name":"IssuingSDKDocs"}],"role":"article","r