K"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the appropriate import statements at the top of your Swift files:"}]},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}]},{"anchor":"Implement-a-Token-Provider","type":"heading","level":2,"text":"Implement a Token Provider"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}]},{"type":"codeListing","syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"anchor":"Device-Testing-Requirements","type":"heading","level":2,"text":"Device Testing Requirements"},{"inlineContent":[{"type":"text","text":"The SDK requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"Release build on