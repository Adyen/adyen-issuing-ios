{"sections":[],"metadata":{"title":"A Starting Guide (Sessions)","modules":[{"name":"IssuingSDKDocs"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/gettingstarted"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Sessions","type":"text"}]},{"text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"text":"Prerequisites","level":2,"type":"heading","anchor":"Prerequisites"},{"type":"paragraph","inlineContent":[{"text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}]},{"text":"Embed the Certificate","level":2,"type":"heading","anchor":"Embed-the-Certificate"},{"inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}],"type":"paragraph"},{"text":"Fetch a Session Token","level":2,"type":"heading","anchor":"Fetch-a-Session-Token"},{"inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}],"type":"paragraph"},{"inlineContent":[{"text":"Perform a ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" request to the following endpoint:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Environment","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"URL","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Test","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"text","text":"Live"}],"type":"paragraph"}],[{"inlineContent":[{"code":"https:\/\/authe-live.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Headers:","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Content-Type: application\/json","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Body:"}],"type":"strong"}],"type":"paragraph"},{"code":["{","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"],"syntax":"json","type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The required ","type":"text"},{"type":"codeVoice","code":"roles"},{"text":" depend on the SDK feature you are using. See the feature-specific documentation for details.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"text":"Your backend should receive the session token and pass it to your iOS application.","type":"text"}],"type":"paragraph"},{"anchor":"Import-the-SDK","text":"Import the SDK","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the appropriate import statements at the top of your Swift files:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"type":"paragraph","inlineContent":[{"text":"This gives you access to all public types, including ","type":"text"},{"type":"codeVoice","code":"TokenProviding"},{"text":", ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":".","type":"text"}]},{"content":[{"inlineContent":[{"text":"Do not import ","type":"text"},{"code":"IssuingCore","type":"codeVoice"},{"text":" directly. It is an internal dependency that is required at link time but has no public API for integrators.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"text":"Implement a Token Provider","level":2,"type":"heading","anchor":"Implement-a-Token-Provider"},{"inlineContent":[{"text":"Your app needs an object that conforms to the ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}],"type":"paragraph"},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Device-Testing-Requirements","text":"Device Testing Requirements","type":"heading"},{"inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"text":"Release build on a physical device","type":"text"}],"type":"strong"},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}],"type":"paragraph"},{"text":"Next Steps","level":2,"type":"heading","anchor":"Next-Steps"},{"inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide","isActive":true},{"text":" — Understand the two provisioning approaches and choose the right one for your architecture","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","type":"reference","isActive":true},{"type":"text","text":" — Add cards to Apple Wallet using the session-based API (recommended)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide","isActive":true,"type":"reference"},{"text":" — Add cards to Apple Wallet with direct control over each provisioning step","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","type":"reference","isActive":true},{"type":"text","text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"title":"IssuingSDKDocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","abstract":[],"url":"\/documentation\/issuingsdkdocs","kind":"symbol","type":"topic","role":"collection"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardProvisioningGuide":{"title":"Card Provisioning","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet from your iOS application."}],"url":"\/documentation\/issuingsdkdocs\/cardprovisioningguide","kind":"article","type":"topic","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SessionsProvisioningGuide":{"title":"Card Provisioning Sessions","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"url":"\/documentation\/issuingsdkdocs\/sessionsprovisioningguide","kind":"article","type":"topic","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/OfflineProvisioningGuide":{"title":"Card Provisioning (Offline)","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide","abstract":[{"text":"Add payment cards to Apple Wallet with direct control over each step of the provisioning flow.","type":"text"}],"url":"\/documentation\/issuingsdkdocs\/offlineprovisioningguide","kind":"article","type":"topic","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"title":"Card Sessions","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","abstract":[{"