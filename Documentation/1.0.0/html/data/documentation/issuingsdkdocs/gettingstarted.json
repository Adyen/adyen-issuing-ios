{"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}]},{"text":" — Add payment cards to Apple Wallet","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Sessions","type":"text"}]},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"level":2,"anchor":"Prerequisites","text":"Prerequisites","type":"heading"},{"inlineContent":[{"text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Embed the Certificate","anchor":"Embed-the-Certificate","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}]},{"level":2,"anchor":"Fetch-a-Session-Token","text":"Fetch a Session Token","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Perform a ","type":"text"},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"URL:","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions"}]},{"inlineContent":[{"inlineContent":[{"text":"Headers:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type: application\/json"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Body:","type":"text"}]}]},{"syntax":"json","type":"codeListing","code":["{","    \"allowOrigin\": \"https:\/\/www.adyen.com\",","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The required ","type":"text"},{"type":"codeVoice","code":"roles"},{"text":" depend on the SDK feature you are using. See the feature-specific documentation for details.","type":"text"}]}],"style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"Your backend should receive the session token and pass it to your iOS application.","type":"text"}]},{"text":"Import the SDK","anchor":"Import-the-SDK","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the appropriate import statements at the top of your Swift files:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"inlineContent":[{"text":"This gives you access to all public types, including ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"ProvisioningSession"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"text":" directly. It is an internal dependency that is required at link time but has no public API for integrators.","type":"text"}],"type":"paragraph"}],"style":"note"},{"level":2,"type":"heading","text":"Implement a Token Provider","anchor":"Implement-a-Token-Provider"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}]},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"Device Testing Requirements","anchor":"Device-Testing-Requirements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK requires a "},{"inlineContent":[{"text":"Release build on a physical device","type":"text"}],"type":"strong"},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}]},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text"