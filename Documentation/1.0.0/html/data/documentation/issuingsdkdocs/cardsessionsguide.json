{"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article","title":"Card Sessions","role":"article"},"sections":[],"variants":[{"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. The SDK handles device registration, key exchange, and end-to-end encryption internally. Your server never sees cleartext card data: all sensitive information is encrypted between the SDK and the Adyen backend."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal card details","type":"text"}]},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal PIN","type":"text"}]},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"type":"text","text":" — set a new PIN for the card"}]}]}],"type":"unorderedList"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true,"type":"reference"},{"text":" before proceeding.","type":"text"}]}],"type":"aside"},{"level":2,"text":"Import","anchor":"Import","type":"heading"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import CardSessions","import IssuingCommon"]},{"level":2,"type":"heading","text":"Session Token Roles","anchor":"Session-Token-Roles"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"]},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    appTeamId: \"[YourAppleTeamID]\",","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSession","type":"codeVoice"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"type":"aside","name":"Tip","style":"tip"},{"level":2,"text":"Reveal Card Details","anchor":"Reveal-Card-Details","type":"heading"},{"inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI","    print(\"PAN: \\(details.pan)\")","    print(\"CVC: \\(details.cvc)\")","    print(\"Expires: \\(details.expiryMonth)\/\\(details.expiryYear)\")","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"type":"codeVoice","code":"CardDetails"},{"text":" struct contains:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"inlineContent":[{"code":"pan","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Full Primary Account Number","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cvc","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Card Verification Code","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryMonth"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryYear"}]}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"level":2,"anchor":"Reveal-PIN","text":"Reveal PIN","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI","    print(\"PIN: \\(pin)\")","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"]},{"level":2,"text":"Change PIN","anchor":"Change-PIN","type":"heading"},{"inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}],"type":"paragraph"},{"code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: \"1234\"","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Error-Handling","text":"Error Handling","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure. Use the "},{"type":"codeVoice","code":"code"},{"text":" property for programmatic branching:","type":"text"}]},{"syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"],"type":"codeListing"},{"anchor":"Security-Considerations","type":"heading","level":2,"text":"Security Considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The SDK uses ephemeral key pairs for each operation, ensuring forward secrecy."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" for full end-to-end functionality due to the device attestation requirement. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}]}],"kind":"content"}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","interfaceLanguage":"swift"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","abstract":[],"title":"IssuingSDKDocs","type":"topic","role":"collection","kind":"symbol"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","url":"\/documentation\/issuingsdkdocs\/gettingstarted","type":"topic","title":"A Starting Guide (Sessions)","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"role":"article","kind":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"url":"\/documentation\/issuingsdkdocs\/securityguide","abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"title":"Security Guide","kind":"article","role":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","type":"topic"}}}