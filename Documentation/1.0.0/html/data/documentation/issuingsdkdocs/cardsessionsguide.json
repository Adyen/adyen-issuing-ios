{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Supported operations:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal PIN"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"text":" — set a new PIN for the card","type":"text"}]}]}],"type":"unorderedList"},{"style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"type":"text","text":" before proceeding."}],"type":"paragraph"}],"type":"aside"},{"anchor":"Import","level":2,"text":"Import","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the imports to your file:"}],"type":"paragraph"},{"syntax":"swift","code":["import CardSessions","import IssuingCommon"],"type":"codeListing"},{"anchor":"Session-Token-Roles","level":2,"text":"Session Token Roles","type":"heading"},{"inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}],"type":"paragraph"},{"code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSessions.Configuration","type":"codeVoice"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"type":"codeListing"},{"anchor":"Initialize-the-Card-Session","level":2,"text":"Initialize the Card Session","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSession","type":"codeVoice"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"type":"codeListing"},{"type":"aside","name":"Tip","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}],"type":"paragraph"}],"style":"tip"},{"type":"heading","level":2,"text":"Reveal Card Details","anchor":"Reveal-Card-Details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"code":"CardDetails","type":"codeVoice"},{"type":"text","text":" struct contains:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"pan","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cvc","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Verification Code"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryMonth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryYear","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}]}]]]},{"anchor":"Reveal-PIN","type":"heading","level":2,"text":"Reveal PIN"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}]},{"code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Change PIN","anchor":"Change-PIN"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}]},{"code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Error Handling","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All operations throw "},{"code":"CardSessionError","type":"codeVoice"},{"type":"text","text":" on failure. Use the "},{"code":"code","type":"codeVoice"},{"type":"text","text":" property for programmatic branching:"}]},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Security Considerations","anchor":"Security-Considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"inlineContent":[{"text":"physical device","type":"text"}],"type":"strong"},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"inlineContent":[{"text":"live","type":"text"}],"type":"strong"},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}],"kind":"content"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},"metadata":{"roleHeading":"Article","role":"article","title":"Card Sessions","modules":[{"name":"IssuingSDKDocs"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"sections":[],"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","kind":"article","role":"article","title":"Security Guide","url":"\/documentation\/issuingsdkdocs\/securityguide","type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","kind":"symbol","role":"collection","title":"IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs","type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","kind":"article","role":"article","title":"A Starting Guide (Sessions)","url":"\/documentation\/issuingsdkdocs\/gettingstarted","type":"topic"}}}