{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","interfaceLanguage":"swift"},"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reveal card details","type":"text"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal PIN","type":"text"}]},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"type":"text","text":" — set a new PIN for the card"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","type":"reference"},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}]},{"anchor":"Import","type":"heading","level":2,"text":"Import"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import CardSessions","import IssuingCommon"]},{"anchor":"Session-Token-Roles","type":"heading","level":2,"text":"Session Token Roles"},{"inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"]},{"inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"type":"codeListing"},{"level":2,"text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"type":"codeListing"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"CardSession","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"level":2,"text":"Reveal Card Details","anchor":"Reveal-Card-Details","type":"heading"},{"inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error. Log the error itself, not its localizedDescription,","    \/\/ so the trace identifier is preserved.","    print(\"Reveal failed: \\(error)\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cvc"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Card Verification Code","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryMonth"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryYear"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":2,"text":"Reveal PIN","anchor":"Reveal-PIN","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}]},{"code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Change-PIN","type":"heading","level":2,"text":"Change PIN"},{"inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error)\")","}"],"type":"codeListing"},{"level":2,"text":"Error Handling","anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"All operations throw "},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure."}],"type":"paragraph"},{"level":3,"text":"Match a single case","anchor":"Match-a-single-case","type":"heading"},{"inlineContent":[{"type":"text","text":"The error type supports pattern matching, so you can catch one case directly without casting."},{"text":" ","type":"text"},{"text":"Matching compares the ","type":"text"},{"type":"codeVoice","code":"code"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"type":"text","text":" "},{"text":"underlying cause:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: newPin","    )","} catch CardSessionError.invalidPin {","    \/\/ Ask the cardholder for a correctly formatted PIN.","} catch {","    \/\/ Handle everything else.","}"],"type":"codeListing"},{"text":"Branch across several cases","type":"heading","anchor":"Branch-across-several-cases","level":3},{"type":"paragraph","inlineContent":[{"text":"To handle several failures at once, use the ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" property. ","type":"text"},{"code":"Code","type":"codeVoice"},{"type":"text","text":" is non-exhaustive, so always"},{"type":"text","text":" "},{"type":"text","text":"include a "},{"code":"default","type":"codeVoice"},{"type":"text","text":" case to stay forward compatible with future SDK versions:"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .sessionTokenRetrievalFailed:","        \/\/ The token provider failed to retrieve a session token.","        \/\/ Check your backend or re-authenticate the user.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .cardRevealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    default:","        break","    }","}"],"syntax":"swift"},{"text":"Logging","type":"heading","anchor":"Logging","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"CustomStringConvertible"},{"text":", so log the error itself:","type":"text"}]},{"syntax":"swift","code":["print(error)","\/\/ CardSessionError.cardRevealFailed: cardReveal, serverHTTPError. Trace: 00-abc..."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Where the failure came from a network call, "},{"code":"description","type":"codeVoice"},{"type":"text","text":" includes the trace identifier Adyen"},{"type":"text","text":" "},{"type":"text","text":"support needs to correlate the request. It never contains card data, PINs or session tokens, so"},{"type":"text","text":" "},{"type":"text","text":"it is safe to log."}],"type":"paragraph"},{"inlineContent":[{"text":"Avoid logging ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"text":". It carries no diagnostic detail, so the trace identifier is","type":"text"},{"text":" ","type":"text"},{"text":"lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"localizedDescription"},{"text":" is deliberately short because errors are commonly passed straight to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"UI, but it is not meant for display either: the text is English and is not localized. Map "},{"code":"code","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to your own copy for anything the cardholder sees.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Security Considerations","anchor":"Security-Considerations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Each operation is secured with end-to-end encryption managed entirely within the SDK."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"text":"Testing","type":"heading","anchor":"Testing","level":2},{"type":"paragraph","inlineContent":[{"text":"Card Sessions requires a ","type":"text"},{"inlineContent":[{"type":"text","text":"physical device"}],"type":"strong"},{"text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}]}],"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article","role":"article","title":"Card Sessions"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"title":"IssuingSDKDocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","kind":"symbol","url":"\/documentation\/issuingsdkdocs","type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","type":"topic","url":"\/documentation\/issuingsdkdocs\/securityguide","abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"role":"article","title":"Security Guide","kind":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","type":"topic","url":"\/documentation\/issuingsdkdocs\/gettingstarted","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"role":"article","title":"A Starting Guide (Sessions)","kind":"article"}}}