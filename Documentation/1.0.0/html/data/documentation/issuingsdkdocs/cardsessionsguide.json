{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"variants":[{"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal card details","type":"text"}]},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal PIN"}]},{"type":"text","text":" — the card’s current PIN"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"type":"text","text":" — set a new PIN for the card"}]}]}]},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"Complete the steps in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"type":"text","text":" before proceeding."}],"type":"paragraph"}]},{"anchor":"Import","level":2,"text":"Import","type":"heading"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import CardSessions","import IssuingCommon"]},{"type":"heading","text":"Session Token Roles","anchor":"Session-Token-Roles","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"]},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"]},{"anchor":"Initialize-the-Card-Session","level":2,"text":"Initialize the Card Session","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"type":"aside","name":"Tip"},{"anchor":"Reveal-Card-Details","level":2,"text":"Reveal Card Details","type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}],"type":"paragraph"},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error. Log the error itself, not its localizedDescription,","    \/\/ so the trace identifier is preserved.","    print(\"Reveal failed: \\(error)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"pan"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Full Primary Account Number","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cvc"}]}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Card Verification Code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryMonth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryYear"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}],"type":"paragraph"}]]]},{"level":2,"type":"heading","text":"Reveal PIN","anchor":"Reveal-PIN"},{"inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error)\")","}"]},{"type":"heading","level":2,"anchor":"Change-PIN","text":"Change PIN"},{"type":"paragraph","inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error)\")","}"]},{"type":"heading","level":2,"anchor":"Error-Handling","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"code":"CardSessionError","type":"codeVoice"},{"text":" on failure.","type":"text"}]},{"type":"heading","level":3,"text":"Match a single case","anchor":"Match-a-single-case"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The error type supports pattern matching, so you can catch one case directly without casting."},{"type":"text","text":" "},{"type":"text","text":"Matching compares the "},{"code":"code","type":"codeVoice"},{"text":" only, so it succeeds regardless of the error’s message or","type":"text"},{"text":" ","type":"text"},{"text":"underlying cause:","type":"text"}]},{"type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: newPin","    )","} catch CardSessionError.invalidPin {","    \/\/ Ask the cardholder for a correctly formatted PIN.","} catch {","    \/\/ Handle everything else.","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Branch across several cases","anchor":"Branch-across-several-cases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To handle several failures at once, use the "},{"code":"code","type":"codeVoice"},{"type":"text","text":" property. "},{"code":"Code","type":"codeVoice"},{"type":"text","text":" is non-exhaustive, so always"},{"text":" ","type":"text"},{"type":"text","text":"include a "},{"code":"default","type":"codeVoice"},{"type":"text","text":" case to stay forward compatible with future SDK versions:"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .sessionTokenRetrievalFailed:","        \/\/ The token provider failed to retrieve a session token.","        \/\/ Check your backend or re-authenticate the user.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .cardRevealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    default:","        break","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Logging","anchor":"Logging"},{"inlineContent":[{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":", so log the error itself:"}],"type":"paragraph"},{"type":"codeListing","code":["print(error)","\/\/ CardSessionError.cardRevealFailed: cardReveal, serverHTTPError. Trace: 00-abc..."],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the failure came from a network call, "},{"type":"codeVoice","code":"description"},{"type":"text","text":" includes the trace identifier Adyen"},{"type":"text","text":" "},{"text":"support needs to correlate the request. It never contains card data, PINs or session tokens, so","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it is safe to log."}]},{"type":"paragraph","inlineContent":[{"text":"Avoid logging ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":". It carries no diagnostic detail, so the trace identifier is"},{"type":"text","text":" "},{"type":"text","text":"lost."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localizedDescription"},{"text":" is deliberately short because errors are commonly passed straight to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"UI, but it is not meant for display either: the text is English and is not localized. Map "},{"type":"codeVoice","code":"code"},{"text":" ","type":"text"},{"type":"text","text":"to your own copy for anything the cardholder sees."}]},{"anchor":"Security-Considerations","level":2,"text":"Security Considerations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each operation is secured with end-to-end encryption managed entirely within the SDK."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide"},{"type":"text","text":"."}]}]}]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"inlineContent":[{"type":"text","text":"physical device"}],"type":"strong"},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}]},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"metadata":{"title":"Card Sessions","modules":[{"name":"IssuingSDKDocs"}],"role":"article","roleHeading":"Article"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"title":"Security Guide","kind":"article","url":"\/documentation\/issuingsdkdocs\/securityguide","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"url":"\/documentation\/issuingsdkdocs\/gettingstarted","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","kind":"article","role":"article","title":"A Starting Guide (Sessions)","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}]},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"title":"IssuingSDKDocs","kind":"symbol","url":"\/documentation\/issuingsdkdocs","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","abstract":[],"role":"collection"}}}