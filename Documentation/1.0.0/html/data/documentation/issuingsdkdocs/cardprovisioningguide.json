{"abstract":[{"text":"Add payment cards to Apple Wallet from your iOS application.","type":"text"}],"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Card Provisioning enables your cardholders to add their payment cards to Apple Wallet directly from your app or from the Apple Wallet app itself. During provisioning, the SDK communicates securely with the card network to generate the cryptographic material required by Apple Wallet. The cardholder does not need to manually enter any card details.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Provisioning can happen in two ways:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"In-app provisioning","type":"text"}],"type":"strong"},{"text":" — the cardholder taps ","type":"text"},{"inlineContent":[{"type":"text","text":"Add to Apple Wallet"}],"type":"strong"},{"text":" inside your app, and the native Apple Wallet sheet is presented within your app.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Wallet extension provisioning"}],"type":"strong"},{"type":"text","text":" — your app’s name and icon appear in the Apple Wallet app under "},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"type":"text","text":", and the cardholder can provision without opening your app."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both ways are supported by both approaches described below."}],"type":"paragraph"},{"anchor":"Choosing-an-Approach","level":2,"text":"Choosing an Approach","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK offers two approaches. Choose the one that fits your backend architecture."}],"type":"paragraph"},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sessions"}]}],[{"type":"paragraph","inlineContent":[{"text":"Offline","type":"text"}]}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Package"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"CardProvisioningSessions"}],"type":"paragraph"}],[{"inlineContent":[{"code":"CardProvisioning","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"CardProvisioningExtension","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"How it works","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Your app provides a session token; the SDK manages device registration, activation data, retries, and state tracking internally","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Your backend fetches "},{"code":"sdkInput","type":"codeVoice"},{"type":"text","text":" activation data and your app passes it directly to the SDK at each step"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Who does the networking"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The SDK — your app only supplies a token"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Your app and backend — the SDK makes no network requests; it only processes the data you give it and returns cryptographic output for you to send back"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Backend dependency at provisioning time"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Token endpoint only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"networkTokenActivationData"},{"type":"text","text":" endpoint at each step"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Best for","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Apps that prefer a high-level, managed API","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Apps that already own their networking layer and want direct control over each provisioning step"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wallet extension"}]}],"type":"paragraph"}],[{"inlineContent":[{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":" subclass — SDK manages the extension flow","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ExtensionProvisioningService"},{"type":"text","text":" + manual implementation of "},{"type":"codeVoice","code":"PKIssuerProvisioningExtensionHandler"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Most new integrations should use the Sessions approach. It reduces the amount of integration code and handles edge cases such as retries and activation data caching internally."}],"type":"paragraph"}]},{"level":2,"anchor":"Prerequisites","type":"heading","text":"Prerequisites"},{"type":"paragraph","inlineContent":[{"text":"Both approaches require:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"iOS 16.0 or later","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement on every target involved in provisioning (main app, Non-UI Extension, UI Extension)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A certificate provided by Adyen, embedded in your app’s bundle"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Common setup completed — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"}]}]}]},{"level":2,"anchor":"Sessions-Approach","text":"Sessions Approach","type":"heading"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" package. You supply a session token and the SDK takes care of the rest."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide"},{"type":"text","text":" for the complete integration guide, including in-app provisioning and Wallet extension setup."}],"type":"paragraph"},{"level":2,"anchor":"Offline-Approach","text":"Offline Approach","type":"heading"},{"inlineContent":[{"type":"text","text":"The Offline approach uses the "},{"code":"CardProvisioning","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CardProvisioningExtension","type":"codeVoice"},{"type":"text","text":" packages. Your backend fetches "},{"code":"sdkInput","type":"codeVoice"},{"type":"text","text":" activation data and your app passes it to the SDK at each step."}],"type":"paragraph"},{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide","isActive":true,"type":"reference"},{"text":" for the complete integration guide, including in-app provisioning and Wallet extension setup.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/issuingsdkdocs\/cardprovisioningguide"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"title":"Card Provisioning","roleHeading":"Article","modules":[{"name":"IssuingSDKDocs"}],"role":"article"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"kind":"symbol","url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","title":"IssuingSDKDocs","type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"title":"A Starting Guide (Sessions)","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"role":"article","type":"topic","url":"\/documentation\/issuingsdkdocs\/gettingstarted","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SessionsProvisioningGuide":{"title":"Card Provisioning Sessions","kind":"article","abstract":[{"text":"Add payment cards to Apple Wallet using the session-based API.","type":"text"}],"role":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","type":"topic","url":"\/documentation\/issuingsdkdocs\/sessionsprovisioningguide"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/OfflineProvisioningGuide":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet with direct control over each step of the provisioning flow."}],"role":"article","type":"topic","url":"\/documentation\/issuingsdkdocs\/offlineprovisioningguide","kind":"article","title":"Card Provisioning (Offline)"}}}