the SDK to generate the encrypted payload","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Your backend sends the payload to Adyen (","type":"text"},{"code":"POST \/pins\/change","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Implementation","anchor":"Implementation","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let pinChangeService = PinChangeService()","","\/\/ 2. Generate the encrypted PIN block","let encryptedPin = try pinChangeService.encryptedPinBlock(","    jwk: publicKeyData,","    pin: newPin",")","","\/\/ 3. Send to your backend.","\/\/    Your backend calls POST \/pins\/change with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedPin.encryptedKey,","\/\/        \"encryptedPinBlock\": encryptedPin.encryptedPinBlock,","\/\/        \"token\": encryptedPin.token","\/\/    }"]},{"inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key:"}],"type":"paragraph"},{"code":["let encryptedPin = try pinChangeService.encryptedPinBlock(","    pem: derEncodedPublicKey,","    pin: newPin",")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Error Handling","anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"code":"encryptedPinBlock","type":"codeVoice"},{"text":" throws ","type":"text"},{"type":"codeVoice","code":"PinChangeService.PinChangeError"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Error","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Cause"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".invalidPin","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The PIN is malformed (non-decimal characters, too long)","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".unallowedPin","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The PIN is not permitted (sequential like "},{"type":"codeVoice","code":"1234"},{"text":", repeated like ","type":"text"},{"type":"codeVoice","code":"1111"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"inlineContent":[{"type":"text","text":"The public key could not be parsed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"text":"PIN encryption failed","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"level":2,"text":"Security Considerations","type":"heading","anchor":"Security-Considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"text":" module performs all cryptographic operations in memory. No sensitive data is written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The symmetric key (inside "},{"code":"RevealContext","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"PinRevealContext"},{"text":") is ephemeral and must not be persisted or transmitted.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Never log or persist decrypted card details or PINs."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"RevealContext"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"PinRevealContext"},{"text":" is single-use. Generate a new encrypted key for each reveal operation.","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Migration-from-adyen-card-reveal-ios","text":"Migration from adyen-card-reveal-ios"},{"inlineContent":[{"text":"If you previously used the standalone ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"},{"text":" package, the ","type":"text"},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a direct replacement with minor API changes:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Old API","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"New API"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import AdyenCardReveal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Card"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey(jwk:)"},{"type":"text","text":" → "},{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"code":"generateEncryptedKey(jwk:)","type":"codeVoice"},{"type":"text","text":" → "},{"code":"(encryptedKey: String, revealContext: RevealContext)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cardDetails(from: encryptedData)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"cardDetails(encryptedData:, revealContext:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"pin(encryptedPinBlock:, token:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"pin(encryptedPinBlock:, token:, revealContext:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"},{"type":"text","text":" (unchanged)"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"The key change is that ","type":"text"},{"code":"generateEncryptedKey","type":"codeVoice"},{"text":" now returns a ","type":"text"},{"code":"RevealContext","type":"codeVoice"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"PinRevealContext"},{"type":"text","text":") that must be passed to the decryption method. This makes the API safer by preventing accidental reuse of keys across requests."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardModuleGuide"},"metadata":{"title":"Card Module (Low-Level)","roleHeading":"Article","role":"article","modules":[{"name":"IssuingSDKDocs"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardmoduleguide"]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"role":"article","kind":"article","url":"\/documentation\/issuingsdkdocs\/cardsessionsguide","type":"topic","title":"Card Sessions","abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},"https://github.com/Adyen/adyen-card-reveal-ios":{"title":"adyen-card-reveal-ios","url":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","titleInlineContent":[{"type":"text","text":"adyen-card-reveal-ios"}],"type":"link"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs","role":"collection","url":"\/documentation\/issuingsdkdocs","kind":"symbol","type":"topic"}}}