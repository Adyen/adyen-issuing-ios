{"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"sections":[],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Reveal card details, reveal PINs, and change PINs using direct service calls."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"text":" module provides low-level cryptographic services for sensitive card operations. Unlike ","type":"text"},{"code":"CardSessions","type":"codeVoice"},{"text":" (which handles networking, session management, and token handling automatically), the ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption.","type":"text"}]},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"Card","type":"codeVoice"},{"type":"text","text":" module when you need:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Full control over the network layer (custom networking stack, interceptors, retry logic)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Integration into an architecture that doesn’t use "},{"code":"async\/await","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Direct access to the encrypted keys and data for custom backend flows"}],"type":"paragraph"}]}]},{"name":"Tip","style":"tip","content":[{"inlineContent":[{"text":"If you prefer a higher-level API that handles networking and token management, use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},{"text":" instead.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"anchor":"Import","text":"Import","type":"heading","level":2},{"code":["import Card"],"type":"codeListing","syntax":"swift"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a standalone cryptographic library that can be used without the rest of the SDK."}]}],"type":"aside"},{"type":"heading","anchor":"Session-Token-Roles","text":"Session Token Roles","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend needs the following API credential roles to call the Adyen endpoints used in these flows:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Operation","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Role"}]}]],[[{"inlineContent":[{"type":"text","text":"Card reveal"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bank Issuing PaymentInstrument Reveal Webservice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"PIN reveal","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Reveal Webservice"}]}]],[[{"inlineContent":[{"text":"PIN change","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Change Webservice"}],"type":"paragraph"}]]]},{"text":"Card Reveal","type":"heading","anchor":"Card-Reveal","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reveal the card’s PAN, CVC, and expiry date."}]},{"level":3,"text":"Flow","anchor":"Flow","type":"heading"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Your backend fetches a public key from Adyen (","type":"text"},{"type":"codeVoice","code":"GET \/publicKey?purpose=panReveal&format=jwk"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass the public key to the SDK to generate an encrypted session key","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"type":"codeVoice","code":"POST \/paymentInstruments\/reveal"},{"text":") and receives encrypted card data","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the encrypted data to the SDK to decrypt and obtain the card details"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Implementation","anchor":"Implementation"},{"syntax":"swift","code":["import Card","","\/\/ 1. Initialize the service","let cardRevealService = CardRevealService()","","\/\/ 2. Generate an encrypted key using the public key from your backend.","\/\/    The public key is the raw JWK data from the Adyen \/publicKey endpoint.","let (encryptedKey, revealContext) = try cardRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/paymentInstruments\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns the `encryptedData` string from the response.","","\/\/ 4. Decrypt the card details","let details = try cardRevealService.cardDetails(","    encryptedData: encryptedData,","    revealContext: revealContext",")","","\/\/ Access the decrypted values","details.pan            \/\/ Full PAN, e.g. \"5412345678901234\"","details.cvc            \/\/ CVC, e.g. \"123\"","details.expiration.month  \/\/ e.g. \"03\"","details.expiration.year   \/\/ e.g. \"2028\""],"type":"codeListing"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"revealContext","type":"codeVoice"},{"text":" returned by ","type":"text"},{"code":"generateEncryptedKey","type":"codeVoice"},{"text":" must be passed to ","type":"text"},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":". It contains the symmetric key needed for decryption and cannot be reused across separate reveal flows."}]}],"style":"important","type":"aside"},{"type":"paragraph","inlineContent":[{"text":"If you have a PEM\/DER-encoded public key instead of JWK, use ","type":"text"},{"code":"generateEncryptedKey(pem:)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let (encryptedKey, revealContext) = try cardRevealService.generateEncryptedKey(","    pem: derEncodedPublicKey",")"]},{"type":"heading","level":3,"anchor":"Error-Handling","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"code":"generateEncryptedKey","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cardDetails","type":"codeVoice"},{"text":" throw ","type":"text"},{"code":"CardRevealService.CardRevealError","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Error","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cause"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key encryption failed"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The encrypted data string is not valid hex"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".decryptionFailed","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"AES decryption of the card data failed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unexpectedData"}]}],[{"type":"paragraph","inlineContent":[{"text":"Decryption succeeded but the payload could not be decoded","type":"text"}]}]]]},{"anchor":"PIN-Reveal","type":"heading","level":2,"text":"PIN Reveal"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN."}]},{"type":"heading","level":3,"text":"Flow","anchor":"Flow"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinReveal&format=jwk"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the public key to the SDK to generate an encrypted session key"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your backend sends the encrypted key to Adyen (","type":"text"},{"code":"POST \/pins\/reveal","type":"codeVoice"},{"type":"text","text":") and receives an encrypted PIN block and token"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass both to the SDK to decrypt and obtain the PIN"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"type":"heading","anchor":"Implementation","text":"Implementation"},{"code":["import Card","","\/\/ 1. Initialize the service","let pinRevealService = PinRevealService()","","\/\/ 2. Generate an encrypted key","let (encryptedKey, revealContext) = try pinRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/pins\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns `encryptedPinBlock` and `token` from the response.","","\/\/ 4. Decrypt the PIN","let pin = try pinRevealService.pin(","    encryptedPinBlock: encryptedPinBlock,","    token: token,","    revealContext: revealContext",")"],"type":"codeListing","syntax":"swift"},{"text":"Error Handling","type":"heading","