ype":"paragraph","inlineContent":[{"type":"text","text":"Run on the iOS Simulator to verify basic initialization."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Test provisioning on a physical device (simulators do not support Apple Wallet)."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","text":"Troubleshooting","anchor":"Troubleshooting","level":2},{"anchor":"No-such-module-CardProvisioningSessions-or-No-such-module-CardSessions","level":3,"text":"“No such module ‘CardProvisioningSessions’” or “No such module ‘CardSessions’”","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the XCFramework is added to your target’s "},{"type":"strong","inlineContent":[{"text":"Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":" section and is set to "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":"."}]},{"text":"Duplicate symbols","anchor":"Duplicate-symbols","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/manualintegration"]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs","role":"collection","url":"\/documentation\/issuingsdkdocs","kind":"symbol","type":"topic"}}}