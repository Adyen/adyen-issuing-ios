rk contains shared types like ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Runtime-crash-Library-not-loaded-IssuingCore","type":"heading","text":"Runtime crash: “Library not loaded: IssuingCore”"},{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" is not embedded. Add it to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":" even though you don’t import it in code. The other frameworks depend on it at runtime.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Duplicate-symbols","type":"heading","text":"Duplicate symbols"},{"inlineContent":[{"text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/ManualIntegration","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article","role":"article","title":"Manual Integration"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/manualintegration"]}],"kind":"article","references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/issuingsdkdocs","abstract":[]}}}