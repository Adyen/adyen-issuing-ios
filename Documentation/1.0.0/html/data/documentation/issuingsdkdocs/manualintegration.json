{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code.","type":"text"}]},{"text":"Download the SDK","level":2,"anchor":"Download-the-SDK","type":"heading"},{"inlineContent":[{"text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:","type":"text"}],"type":"paragraph"},{"syntax":"text","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── CardProvisioningSessions.xcframework","│   ├── CardProvisioning.xcframework","│   ├── CardProvisioningExtension.xcframework","│   ├── CardSessions.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"],"type":"codeListing"},{"text":"Required Frameworks","anchor":"Required-Frameworks","type":"heading","level":2},{"text":"Network Token Provisioning (Sessions Approach)","type":"heading","level":3,"anchor":"Network-Token-Provisioning-Sessions-Approach"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following framework is "},{"type":"strong","inlineContent":[{"text":"required","type":"text"}]},{"text":" for the sessions-based provisioning:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Framework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"CardProvisioningSessions.xcframework","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Session-based provisioning logic and public API"}],"type":"paragraph"}]]],"header":"row"},{"text":"Network Token Provisioning (Manual Approach)","type":"heading","level":3,"anchor