":[{"type":"text","text":"You do not need all imports. Use only the modules relevant to your chosen approach."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"anchor":"Keychain-Access-Group","text":"Keychain Access Group","type":"heading","level":2},{"inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable "},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"type":"text","text":" in your app target’s "},{"type":"strong","inlineContent":[{"text":"Signing & Capabilities","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same access group to both the app and the extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the access group identifier when configuring the SDK:"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    appTeamId: \"[YourAppleTeamID]\",","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"]},{"level":2,"anchor":"Wallet-Extension-Support","type":"heading","text":"Wallet Extension Support"},{"inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CardProvisioningSessions.xcframework"}]}]},{"content"