o your target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Frameworks, Libraries, and Embedded Content"}]},{"type":"text","text":" section and is set to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Duplicate-symbols","level":3,"text":"Duplicate symbols","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both.","type":"text"}]}],"kind":"content"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","kind":"symbol","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","title":"IssuingSDKDocs","abstract":[],"type":"topic"}}}