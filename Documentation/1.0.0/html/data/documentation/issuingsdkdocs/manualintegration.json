l device (simulators do not support Apple Wallet)."}]}]}]},{"anchor":"Troubleshooting","text":"Troubleshooting","type":"heading","level":2},{"anchor":"No-such-module-CardProvisioningSessions-or-No-such-module-CardSessions","text":"“No such module ‘CardProvisioningSessions’” or “No such module ‘CardSessions’”","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Ensure the XCFramework is added to your target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Frameworks, Libraries, and Embedded Content"}]},{"type":"text","text":" section and is set to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Duplicate symbols","anchor":"Duplicate-symbols"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/issuingsdkdocs\/manualintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"role":"article","title":"Manual Integration","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"kind":"symbol","url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","title":"IssuingSDKDocs","type":"topic"}}}