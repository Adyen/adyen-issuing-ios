{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally."}],"type":"paragraph"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","type":"reference"},{"type":"text","text":" before proceeding."}]}]},{"level":2,"type":"heading","text":"Import","anchor":"Import"},{"code":["import CardProvisioningSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"Session Token Role","anchor":"Session-Token-Role"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}]},{"syntax":"json","type":"codeListing","code":["\"roles\": [\"Network Token: Create\"]"]},{"level":2,"type":"heading","text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"]},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below.","type":"text"}]}],"type":"aside"},{"level":2,"anchor":"Initialize-a-Provisioning-Session","text":"Initialize a Provisioning Session","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":"."}]},{"code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Check the Provisioning State","anchor":"Check-the-Provisioning-State"},{"type":"paragraph","inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}]},{"code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Log reason for diagnostics, and map it to your own","    \/\/ copy for anything the cardholder sees.","}"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"Provision the Card","anchor":"Provision-the-Card"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the cardholder taps "},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"type":"text","text":", present the native Wallet sheet:"}]},{"code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ The cardholder or the system dismissed the Apple Pay sheet.","    \/\/ This is not a failure, so leave your UI unchanged.","} catch {","    \/\/ Handle provisioning error","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Handle the Result","anchor":"Handle-the-Result","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provision(paymentInstrumentId:viewController:)"},{"type":"text","text":" returns a "},{"type":"codeVoice","code":"CardActivationState"},{"type":"text","text":":"}]},{"code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Error Handling","anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"type":"text","text":"All session operations throw "},{"code":"CardProvisioningSessionError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Match-a-single-case","text":"Match a single case","type":"heading"},{"inlineContent":[{"text":"The error type supports pattern matching, so you can catch one case directly without casting.","type":"text"},{"text":" ","type":"text"},{"text":"Matching compares the ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" only, so it succeeds regardless of the error’s message or","type":"text"},{"text":" ","type":"text"},{"text":"underlying cause:","type":"text"}],"type":"paragraph"},{"code":["do {","    try await provisioningSession.configure()","} catch CardProvisioningSessionError.couldNotEstablishSession {","    \/\/ Check connectivity and the session token, then retry.","} catch {","    \/\/ Handle everything else.","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Handle-cancellation-gracefully","text":"Handle cancellation gracefully","type":"heading"},{"inlineContent":[{"code":"provisioningCancelled","type":"codeVoice"},{"text":" reports that the Apple Pay sheet was dismissed by the cardholder or by","type":"text"},{"text":" ","type":"text"},{"text":"the system. Nothing was provisioned and nothing failed, so treat it as a normal outcome. Do not","type":"text"},{"text":" ","type":"text"},{"text":"present it as an error:","type":"text"}],"type":"paragraph"},{"code":["do {","    _ = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ Expected when the cardholder taps Cancel. Leave the UI as it was.","} catch {","    \/\/ Log the error for diagnostics, and show your own copy to the cardholder.","    print(error)","    showAlert(yourMessage(for: error))","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Branch-across-several-cases","text":"Branch across several cases","type":"heading"},{"inlineContent":[{"text":"To handle several failures at once, switch over ","type":"text"},{"code":"code","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Code","type":"codeVoice"},{"text":" is non-exhaustive, so always","type":"text"},{"text":" ","type":"text"},{"text":"include a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" case to stay forward compatible with future SDK versions:","type":"text"}],"type":"paragraph"},{"code":["do {","    try await provisioningSession.configure()","} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .noPaymentInstrumentsProvided:","        \/\/ `paymentInstrumentIds` in the configuration was empty.","        break","    case .noKeychainGroupIdProvided:","        \/\/ `keychainAccessGroup` was empty.","        break","    case .couldNotEstablishSession:","        \/\/ Network or authentication failure.","        break","    case .activationDataUnavailable:","        \/\/ Activation data could not be fetched or cached.","        break","    case .provisioningAlreadyInProgress:","        \/\/ A provisioning flow is already running for this payment instrument.","        break","    case .provisioningCancelled:","        \/\/ Dismissed by the cardholder or the system. Not a failure.","        break","    case .provisioningFailed:","        \/\/ PassKit or the provisioning infrastructure reported a failure.","        break","    default:","        break","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Logging","text":"Logging","type":"heading"},{"inlineContent":[{"code":"CardProvisioningSessionError","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":", so log the error itself:","type":"text"}],"type":"paragraph"},{"code":["print(error)","\/\/ CardProvisioningSessionError.couldNotEstablishSession: deviceRegistration, serverHTTPError. Trace: 00-abc..."],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Where the failure came from a network call, ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" includes the trace identifier Adyen","type":"text"},{"text":" ","type":"text"},{"text":"support needs to correlate the request. Where it came from PassKit, it includes that error’s","type":"text"},{"text":" ","type":"text"},{"text":"domain and code. It never contains card data or session tokens, so it is safe to log.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Avoid logging ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":". It carries no diagnostic detail, so the trace identifier is","type":"text"},{"text":" ","type":"text"},{"text":"lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"localizedDescription","type":"codeVoice"},{"text":" is deliberately short because errors are commonly passed straight to the","type":"text"},{"text":" ","type":"text"},{"text":"UI, but it is not meant for display either: the text is English and is not localized. Map ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to your own copy for anything the cardholder sees.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Wallet-Extension","text":"Wallet Extension","type":"heading"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Wallet extension is mandatory. Without it, cardholders cannot add cards from the Apple Wallet app, and your app will not appear in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section. Implement the Non-UI Extension, and the UI Extension when "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":", before shipping."}]}],"type":"aside"},{"inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"text":" section.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Prerequisites","text":"Prerequisites","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A shared keychain access group must be configured (the same "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" you passed to "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}]}]}],"type":"orderedList"},{"level":3,"anchor":"Step-1-Create-the-Non-UI-Extension-Target","text":"Step 1: Create the Non-UI Extension Target","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}]}]]]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":" (e.g., "},{"type":"codeVoice","code":"[TeamId].com.yourcompany.shared"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}]}]}],"type":"orderedList"},{"level":3,"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","text":"Step 2: Implement the Non-UI Extension Handler","type":"heading"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":". The class name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        UIImage(named: \"card\")!.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"],"syntax":"swift","type":"codeListing"},{"level":4,"anchor":"Required-Overrides","text":"Required Overrides","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared keychain group for activation data cached by the main app"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide card art as a "},{"code":"CGImage","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}]}]]],"type":"table"},{"level":4,"anchor":"Optional-Overrides","text":"Optional Overrides","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override to use "},{"code":".test","type":"codeVoice"},{"type":"text","text":" environment"}]}]]],"type":"table"},{"level":3,"anchor":"Step-3-Ensure-Activation-Data-Is-Cached","text":"Step 3: Ensure Activation Data Is Cached","type":"heading"},{"inlineContent":[{"text":"The SDK caches activation data in the shared keychain automatically when you call ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" in the main app with a ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"text":" section.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user must open the provisioning flow in your main app at least once before the extension can show cards."}]}],"type":"aside"},{"level":3,"anchor":"Step-4-Create-the-UI-Extension-Target-Optional","text":"Step 4: Create the UI Extension Target (Optional)","type":"heading"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", set:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}]}]]]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}]}]}],"type":"orderedList"},{"level":3,"anchor":"Step-5-Implement-the-UI-Extension-Handler","text":"Step 5: Implement the UI Extension Handler","type":"heading"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"code":"WalletExtensionUIHandler","type":"codeVoice"},{"text":". Build your authentication UI inside the initializer and call ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when the user finishes.","type":"text"}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"SwiftUI is also supported via ","type":"text"},{"code":"UIHostingController","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Entitlements-Summary","text":"Entitlements Summary","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entitlement"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Main App"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UI Extension"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}]]],"type":"table"},{"level":3,"anchor":"How-the-Extension-Flow-Works","text":"How the Extension Flow Works","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User opens Apple Wallet"}]},{"type":"text","text":" — the SDK reads cached activation data to determine available cards. Your app appears in 