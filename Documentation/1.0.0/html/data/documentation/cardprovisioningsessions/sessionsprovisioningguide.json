ntent":[{"type":"text","text":"Add the "},{"inlineContent":[{"type":"text","text":"Keychain Sharing"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"type":"text","text":") and include the same access group identifier you pass to "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" in "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":" (e.g., "},{"code":"[TeamId].com.yourcompany.shared","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"code":"CardProvisioningSessions","type":"codeVoice"},{"type":"text","text":" as a dependency of this target."}],"type":"paragraph"}]}]},{"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","type":"heading","text":"Step 2: Implement the Non-UI Extension Handler","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"code":"WalletExtensionHandler","type":"codeVoice"},{"type":"text","text":". The class name must match the "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" in "},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Required-Overrides","type":"heading","text":"Required Overrides","level":4},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}]}],[{"inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}],"type":