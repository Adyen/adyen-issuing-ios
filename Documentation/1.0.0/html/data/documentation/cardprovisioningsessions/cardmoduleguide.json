{"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardModuleGuide","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Card (Low-Level)","role":"article"},"sections":[],"seeAlsoSections":[{"title":"Card Sessions","generated":true,"anchor":"Card-Sessions","identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"Card"},{"text":" module provides low-level cryptographic services for sensitive card operations. Unlike ","type":"text"},{"type":"codeVoice","code":"CardSessions"},{"text":" (which handles networking, session management, and token handling automatically), the ","type":"text"},{"type":"codeVoice","code":"Card"},{"text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module when you need:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Full control over the network layer (custom networking stack, interceptors, retry logic)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Integration into an architecture that doesn’t use ","type":"text"},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Direct access to the encrypted keys and data for custom backend flows","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"name":"Tip","style":"tip","content":[{"inlineContent":[{"text":"If you prefer a higher-level API that handles networking and token management, use ","type":"text"},{"identifier":"doc: