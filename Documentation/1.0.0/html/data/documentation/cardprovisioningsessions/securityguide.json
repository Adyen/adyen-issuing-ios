{"seeAlsoSections":[{"identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources"],"anchor":"Resources","title":"Resources","generated":true}],"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Security Guide","role":"article"},"sections":[],"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}]},{"type":"heading","level":2,"text":"Device Unlock Requirement","anchor":"Device-Unlock-Requirement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}]},{"type":"codeListing","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"syntax":"swift"},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"text":" (not ","type":"text"},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}]}],"style":"important"},{"level":2,"text":"Prevent Screen Capture","anchor":"Prevent-Screen-Capture","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}]},{"type":"codeListing","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"Protect Sensitive Views in App Switcher","anchor":"Protect-Sensitive-Views-in-App-Switcher"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}]},{"type":"codeListing","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"Secure Data Storage","anchor":"Secure-Data-Storage"},{"type":"paragraph","inlineContent":[{"text":"Never store tokens, keys, or credentials in ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}]},{"type":"codeListing","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}]},{"type":"heading","anchor":"Handle-Sensitive-Data-in-Memory","text":"Handle Sensitive Data in Memory","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}]},{"code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" — prefer ","type":"text"},{"code":"Data","type":"codeVoice"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}]},{"level":2,"type":"heading","text":"Secure Networking","anchor":"Secure-Networking"},{"inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" does not weaken App Transport Security:"}],"type":"paragraph"},{"code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"text":"For additional protection, implement certificate pinning on your ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}]},{"level":2,"text":"Jailbreak Detection","type":"heading","anchor":"Jailbreak-Detection"},{"inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/ManualIntegration":{"url":"\/documentation\/cardprovisioningsessions\/manualintegration","title":"Manual Integration","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","kind":"article","type":"topic","role":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/AdditionalResources":{"title":"Resources","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources","type":"topic","role":"article","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"url":"\/documentation\/cardprovisioningsessions\/additionalresources","kind":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","title":"Issuing SDK","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","type":"topic","role":"collection"}}}