{"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"metadata":{"title":"Card Sessions","role":"article","roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reveal card details","type":"text"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal PIN"}]},{"type":"text","text":" — the card’s current PIN"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Change PIN"}]},{"type":"text","text":" — set a new PIN for the card"}]}]}]},{"name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}],"type":"paragraph"}],"style":"important"},{"type":"heading","level":2,"text":"Import","anchor":"Import"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the imports to your file:"}]},{"type":"codeListing","syntax":"swift","code":["import CardSessions","import IssuingCommon"]},{"type":"heading","level":2,"text":"Session Token Roles","anchor":"Session-Token-Roles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"]},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","anchor":"Create-a-Configuration-Object","level":2,"text":"Create a Configuration Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSessions.Configuration"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"]},{"type":"heading","anchor":"Initialize-the-Card-Session","level":2,"text":"Initialize the Card Session"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSession"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"name":"Tip","type":"aside","style":"tip","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations.","type":"text"}],"type":"paragraph"}]},{"type":"heading","anchor":"Reveal-Card-Details","level":2,"text":"Reveal Card Details"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"type":"codeVoice","code":"CardDetails"},{"text":" struct contains:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"pan","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Full Primary Account Number","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cvc","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Card Verification Code"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryMonth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryYear","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}]}]]],"header":"row"},{"level":2,"anchor":"Reveal-PIN","text":"Reveal PIN","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"heading","level":2,"text":"Change PIN","anchor":"Change-PIN"},{"type":"paragraph","inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}]},{"code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Error-Handling","text":"Error Handling","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"type":"codeVoice","code":"CardSessionError"},{"text":" on failure. Use the ","type":"text"},{"type":"codeVoice","code":"code"},{"type":"text","text":" property for programmatic branching and the "},{"type":"codeVoice","code":"underlyingError"},{"text":" property to get backend trace identifiers for support inquiries:","type":"text"}]},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","","    \/\/ Extract trace identifiers for Adyen support","    if let context = error.underlyingError {","        print(\"Request ID: \\(context.requestId ?? \"N\/A\")\")","        print(\"Trace: \\(context.traceParent ?? \"N\/A\")\")","        print(\"HTTP status: \\(context.httpErrorCode.map(String.init) ?? \"N\/A\")\")","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Security-Considerations","text":"Security Considerations","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Each operation is secured with end-to-end encryption managed entirely within the SDK."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Testing","text":"Testing"},{"inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"role":"collection","title":"Issuing SDK","type":"topic","kind":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}]},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"kind":"article","role":"article","type":"topic","url":"\/documentation\/cardprovisioningsessions\/securityguide","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"title":"Security Guide"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"type":"topic","title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","role":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","kind":"article"}}}