{"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","interfaceLanguage":"swift"},"kind":"article","metadata":{"roleHeading":"Article","title":"Card Sessions","role":"article"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal card details","type":"text"}]},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal PIN"}]},{"type":"text","text":" — the card’s current PIN"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Change PIN","type":"text"}]},{"text":" — set a new PIN for the card","type":"text"}]}]}]},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}]}],"type":"aside"},{"level":2,"text":"Import","anchor":"Import","type":"heading"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"code":["import CardSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"anchor":"Session-Token-Roles","level":2,"text":"Session Token Roles","type":"heading"},{"inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}],"type":"paragraph"},{"code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Include only the roles for the operations your user will perform."}],"type":"paragraph"},{"anchor":"Create-a-Configuration-Object","level":2,"text":"Create a Configuration Object","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSessions.Configuration"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"]},{"anchor":"Initialize-the-Card-Session","level":2,"text":"Initialize the Card Session","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"syntax":"swift","type":"codeListing"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"type":"heading","level":2,"text":"Reveal Card Details","anchor":"Reveal-Card-Details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"pan"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"inlineContent":[{"code":"cvc","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Card Verification Code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryMonth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryYear"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}]}]]]},{"type":"heading","level":2,"anchor":"Reveal-PIN","text":"Reveal PIN"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"heading","level":2,"anchor":"Change-PIN","text":"Change PIN"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"]},{"type":"heading","level":2,"anchor":"Error-Handling","text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All operations throw "},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure. Use the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" property for programmatic branching:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"]},{"type":"heading","level":2,"anchor":"Security-Considerations","text":"Security Considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each operation is secured with end-to-end encryption managed entirely within the SDK."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide"},{"type":"text","text":"."}]}]}]},{"type":"heading","anchor":"Testing","text":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","title":"Security Guide","kind":"article","role":"article","url":"\/documentation\/cardprovisioningsessions\/securityguide","type":"topic"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","type":"topic","role":"article","title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"kind":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"type":"topic","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","title":"Issuing SDK","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"url":"\/documentation\/issuingsdkdocs","role":"collection"}}}