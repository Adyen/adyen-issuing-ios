{"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","interfaceLanguage":"swift"},"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Supported operations:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal card details"}]},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Reveal PIN","type":"text"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Change PIN"}]},{"type":"text","text":" — set a new PIN for the card"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},{"text":" before proceeding.","type":"text"}]}],"style":"important","name":"Important","type":"aside"},{"text":"Import","anchor":"Import","level":2,"type":"heading"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import CardSessions","import IssuingCommon"],"type":"codeListing"},{"text":"Session Token Roles","anchor":"Session-Token-Roles","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}],"type":"paragraph"},{"syntax":"json","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"],"type":"codeListing"},{"inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}],"type":"paragraph"},{"anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object","level":2,"type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Initialize-the-Card-Session","text":"Initialize the Card Session","level":2,"type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSession"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}],"type":"paragraph"},{"code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"style":"tip","type":"aside","name":"Tip"},{"anchor":"Reveal-Card-Details","text":"Reveal Card Details","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}],"type":"paragraph"},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error. Log the error itself, not its localizedDescription,","    \/\/ so the trace identifier is preserved.","    print(\"Reveal failed: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"pan","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cvc"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Card Verification Code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryMonth"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryYear","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Reveal-PIN","level":2,"text":"Reveal PIN","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error)\")","}"]},{"text":"Change PIN","level":2,"anchor":"Change-PIN","type":"heading"},{"inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error)\")","}"]},{"text":"Error Handling","type":"heading","level":2,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"code":"CardSessionError","type":"codeVoice"},{"text":" on failure.","type":"text"}]},{"level":3,"text":"Match a single case","type":"heading","anchor":"Match-a-single-case"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The error type supports pattern matching, so you can catch one case directly without casting."},{"text":" ","type":"text"},{"type":"text","text":"Matching compares the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"text":" ","type":"text"},{"text":"underlying cause:","type":"text"}]},{"type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: newPin","    )","} catch CardSessionError.invalidPin {","    \/\/ Ask the cardholder for a correctly formatted PIN.","} catch {","    \/\/ Handle everything else.","}"],"syntax":"swift"},{"type":"heading","anchor":"Branch-across-several-cases","level":3,"text":"Branch across several cases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To handle several failures at once, use the "},{"type":"codeVoice","code":"code"},{"text":" property. ","type":"text"},{"code":"Code","type":"codeVoice"},{"text":" is non-exhaustive, so always","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"include a "},{"type":"codeVoice","code":"default"},{"text":" case to stay forward compatible with future SDK versions:","type":"text"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .sessionTokenRetrievalFailed:","        \/\/ The token provider failed to retrieve a session token.","        \/\/ Check your backend or re-authenticate the user.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .cardRevealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    default:","        break","    }","}"],"syntax":"swift"},{"text":"Logging","type":"heading","level":3,"anchor":"Logging"},{"inlineContent":[{"type":"codeVoice","code":"CardSessionError"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"CustomStringConvertible"},{"text":", so log the error itself:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["print(error)","\/\/ CardSessionError.cardRevealFailed: cardReveal, serverHTTPError. Trace: 00-abc..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the failure came from a network call, "},{"code":"description","type":"codeVoice"},{"type":"text","text":" includes the trace identifier Adyen"},{"type":"text","text":" "},{"type":"text","text":"support needs to correlate the request. It never contains card data, PINs or session tokens, so"},{"text":" ","type":"text"},{"text":"it is safe to log.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Avoid logging "},{"type":"codeVoice","code":"localizedDescription"},{"text":". It carries no diagnostic detail, so the trace identifier is","type":"text"},{"type":"text","text":" "},{"text":"lost.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"localizedDescription","type":"codeVoice"},{"text":" is deliberately short because errors are commonly passed straight to the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"UI, but it is not meant for display either: the text is English and is not localized. Map "},{"code":"code","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to your own copy for anything the cardholder sees."}]},{"text":"Security Considerations","level":2,"type":"heading","anchor":"Security-Considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","type":"reference","isActive":true},{"type":"text","text":"."}]}]}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"inlineContent":[{"text":"Card Sessions requires a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}],"type":"paragraph"}]}],"kind":"article","metadata":{"role":"article","title":"Card Sessions","roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardModuleGuide"],"title":"Card Sessions","generated":true,"anchor":"Card-Sessions"}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"role":"collection","url":"\/documentation\/issuingsdkdocs","title":"Issuing SDK","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"type":"topic","kind":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","role":"article","abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"type":"topic","url":"\/documentation\/cardprovisioningsessions\/securityguide","title":"Security Guide","kind":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/CardModuleGuide":{"url":"\/documentation\/cardprovisioningsessions\/cardmoduleguide","type":"topic","role":"article","title":"Card Module (Low-Level)","abstract":[{"text":"Reveal card details, reveal PINs, and change PINs using direct service calls.","type":"text"}],"kind":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardModuleGuide"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"title":"A Starting Guide (Sessions)","role":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"kind":"article","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","type":"topic"}}}