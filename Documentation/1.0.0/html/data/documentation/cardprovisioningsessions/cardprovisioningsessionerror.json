 ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningSessionError\/Code-swift.enum","isActive":true},{"text":" ","type":"text"},{"text":"is non-exhaustive, always include a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" case:","type":"text"}],"type":"paragraph"},{"code":["} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .provisioningCancelled:","        break","    case .couldNotEstablishSession:","        \/\/ Check connectivity and the session token, then retry.","        break","    default:","        break","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningSessionError\/provisioningCancelled","isActive":true,"type":"reference"},{"type":"text","text":" reports that the flow was dismissed rather than that it"},{"type":"text","text":" "},{"type":"text","text":"failed. Treat it as a normal outcome and leave your UI unchanged."}]}],"type":"aside"},{"level":2,"anchor":"Logging","text":"Logging","type":"heading"},{"inlineContent":[{"text":"Log the error itself. Its ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningSessionError\/description","isActive":true},{"text":" carries the trace identifier Adyen support needs","type":"text"},{"text":" ","type":"text"},{"text":"to correlate the failed request, and is safe to log:","type":"text"}],"type":"paragraph"},{"code":["print(error)","\/\/ CardProvisioningSessionError.couldNotEstablishSession: deviceRegistration, serverHTTPError. Trace: 00-abc..."],"syntax":"swift","type":"codeListing"},{"style":"important","name":"Important","content":[{"type":"paragr