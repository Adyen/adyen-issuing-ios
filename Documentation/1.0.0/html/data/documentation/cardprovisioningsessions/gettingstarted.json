cess to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"name":"Note","type":"aside"},{"level":2,"anchor":"Implement-a-Token-Provider","text":"Implement a Token Provider","type":"heading"},{"inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}],"type":"paragraph"},{"syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing"},{"anchor":"Device-Testing-Requirements","text":"Device Testing Requirements","level":2,"type":"heading"},{"inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}],"type":"paragraph"},{"anchor":"Next-Steps","text":"Next Steps","level":2,"type":"heading"},{"inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningGuide"},{"text":" — Understand the two provisioning approaches and choose the right one for your architecture","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide"},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/OfflineProvisioningGuide"},{"text":" — Add cards to Apple Wallet with direct control over each provisioning step","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},{"text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)","type":"text"}]}]}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},"metadata":{"role":"article","roleHeading":"Article","title":"A Starting Guide (Sessions)"},"sections":[],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","role":"collection","url":"\/docum