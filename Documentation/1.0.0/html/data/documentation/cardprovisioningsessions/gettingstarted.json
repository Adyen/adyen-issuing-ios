"type":"text","text":", "},{"type":"codeVoice","code":"ConfigurationParameters"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"Do not import ","type":"text"},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"heading","text":"Implement a Token Provider","level":2,"anchor":"Implement-a-Token-Provider"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}]},{"syntax":"swift","type":"codeListing","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"text":"Device Testing Requirements","type":"heading","level":2,"anchor":"Device-Testing-Requirements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK requires a "},{"type":"strong","inlineContent":[{"text":"Release build on a physical device","type":"text"}]},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}]},{"type":"heading","text":"Next Steps","level":2,"anchor":"Next-Steps"},{"type":"paragrap