{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Sessions","type":"text"}]},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"anchor":"Prerequisites","type":"heading","level":2,"text":"Prerequisites"},{"type":"paragraph","inlineContent":[{"text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}]},{"level":2,"type":"heading","text":"Embed the Certificate","anchor":"Embed-the-Certificate"},{"inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}],"type":"paragraph"},{"anchor":"Fetch-a-Session-Token","level":2,"text":"Fetch a Session Token","type":"heading"},{"inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Perform a ","type":"text"},{"type":"codeVoice","code":"POST"},{"type":"text","text":