{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Download the SDK","anchor":"Download-the-SDK"},{"type":"paragraph","inlineContent":[{"text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:","type":"text"}]},{"type":"codeListing","syntax":"text","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"]},{"inlineContent":[{"type":"text","text":"You also need the "},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":" SDK, available from ","type":"text"},{"identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios","type":"reference","isActive":true},{"text":". Download the ","type":"text"},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" (and ","type":"text"},{"code":"AdyenApplePayExtensionProvisioning.xcframework","type":"codeVoice"},{"text":" if you use a Wallet Extension).","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Required Frameworks","anchor":"Required-Frameworks"},{"anchor":"Network-Token-Provisioning","text":"Network Token Provisioning","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"All of the following frameworks are "},{"inlineContent":[{"type":"text","text":"required"}],"type":"strong"},{"text":" for Apple Wallet provisioning:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Framework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Import in Code?"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provisioning logic and public API"}]}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared types ("},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", etc.)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Internal secure communication"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Apple Pay provisioning interface"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]}],"type":"paragraph"}]]],"type":"table"},{"name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" must be embedded in your app for the SDK to function, but you should "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" import them in your code. They are used internally by "},{"type":"codeVoice","code":"NetworkTokenProvisioning"},{"type":"text","text":" and should not be accessed directly."}],"type":"paragraph"}],"type":"aside"},{"level":2,"text":"Embed the Frameworks","anchor":"Embed-the-Frameworks","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Drag all four "},{"type":"codeVoice","code":".xcframework"},{"type":"text","text":" bundles into your Xcode project navigator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your app target, go to "},{"inlineContent":[{"type":"text","text":"General > Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]}]}]}],"type":"orderedList"},{"level":2,"text":"Import Statements","anchor":"Import-Statements","type":"heading"},{"inlineContent":[{"text":"When embedding manually, import the individual modules — not the SPM wrapper name:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"],"type":"codeListing"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"With SPM, you use "},{"type":"codeVoice","code":