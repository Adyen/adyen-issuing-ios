workTokenProvisioning","import IssuingCommon"],"type":"codeListing"},{"content":[{"inlineContent":[{"text":"With SPM, you use ","type":"text"},{"type":"codeVoice","code":"import AdyenNetworkTokenProvisioning"},{"type":"text","text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"text":"Keychain Access Group","anchor":"Keychain-Access-Group","type":"heading","level":2},{"inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Enable "},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"type":"text","text":" in your app target’s "},{"type":"strong","inlineContent":[{"text":"Signing & Capabilities","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the same access group to both the app and the extension.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the access group identifier when configuring the SDK:","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"]},{"text":"Wallet Extension Support","anchor":"Wallet-Extension-Support","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with "},{"inlineContent":[{"text":"Embed & Sign","type":"text"}],"type":"strong"},{"type":"text","text":":"}],"ty