{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code."}]},{"text":"Download the SDK","anchor":"Download-the-SDK","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:"}]},{"type":"codeListing","syntax":"text","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning"},{"type":"text","text":" SDK, available from "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios"},{"text":". Download the ","type":"text"},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" (and ","type":"text"},{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"text":" if you use a Wallet Extension).","type":"text"}]},{"text":"Required Frameworks","anchor":"Required-Frameworks","type":"heading","level":2},{"text":"Network Token Provisioning","anchor":"Network-Token-Provisioning","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"All of the following frameworks are ","type":"text"},{"inlineContent":[{"text":"required","type":"text"}],"type":"strong"},{"text":" for Apple Wallet provisioning:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Framework","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import in Code?"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Provisioning logic and public API"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}]}],[{"inlineContent":[{"text":"Shared types (","type":"text"},{"type":"codeVoice","code":"TokenProviding"},{"text":", etc.)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Internal secure communication","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Apple Pay provisioning interface","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]}],"type":"paragraph"}]]],"header":"row","type":"table"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"IssuingCore.xcframework"},{"text":" and ","type":"text"},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" must be embedded in your app for the SDK to function, but you should ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" import them in your code. They are used internally by "},{"code":"NetworkTokenProvisioning","type":"codeVoice"},{"type":"text","text":" and should not be accessed directly."}]}],"type":"aside"},{"text":"Embed the Frameworks","type":"heading","anchor":"Embed-the-Frameworks","level":2},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Drag all four ","type":"text"},{"code":".xcframework","type":"codeVoice"},{"text":" bundles into your Xcode project navigator.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your app target, go to "},{"type":"strong","inlineContent":[{"text":"General > Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"},{"text":" — Embed & Sign","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"text":" — Embed & Sign","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"text":" — Embed & Sign","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}]}]}]}]}]},{"level":2,"text":"Import Statements","type":"heading","anchor":"Import-Statements"},{"type":"paragraph","inlineContent":[{"text":"When embedding manually, import the individual modules — not the SPM wrapper name:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"With SPM, you use ","type":"text"},{"code":"import AdyenNetworkTokenProvisioning","type":"codeVoice"},{"text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately.","type":"text"}],"type":"paragraph"}]},{"anchor":"Keychain-Access-Group","type":"heading","level":2,"text":"Keychain Access Group"},{"inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Enable ","type":"text"},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"text":" in your app target’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"Signing & Capabilities","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the same access group to both the app and the extension.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the access group identifier when configuring the SDK:","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"syntax":"swift","code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"],"type":"codeListing"},{"anchor":"Wallet-Extension-Support","level":2,"text":"Wallet Extension Support","type":"heading"},{"inlineContent":[{"text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with ","type":"text"},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"text":":","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AdyenApplePayExtensionProvisioning.xcframework","type":"codeVoice"},{"text":" (instead of ","type":"text"},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"In the extension, use the same imports:","type":"text"}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"anchor":"Verify-the-Integration","text":"Verify the Integration","type":"heading","level":2},{"inlineContent":[{"text":"After embedding:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Build the project. All three frameworks should compile and link without errors.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run on the iOS Simulator to verify basic initialization.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Test provisioning on a physical device (simulators do not support Apple Wallet).","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Troubleshooting","text":"Troubleshooting","type":"heading","level":2},{"anchor":"No-such-module-NetworkTokenProvisioning","text":"“No such module ‘NetworkTokenProvisioning’”","type":"heading","level":3},{"inlineContent":[{"text":"Ensure the XCFramework is added to your target’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"Frameworks, Libraries, and Embedded Content","type":"text"}]},{"text":" section and is set to ","type":"text"},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"No-such-module-IssuingCommon","text":"“No such module ‘IssuingCommon’”","type":"heading","level":3},{"inlineContent":[{"text":"Same as above — ","type":"text"},{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"text":" must also be embedded. This framework contains shared types like ","type":"text"},{"type":"codeVoice","code":"TokenProviding"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Runtime-crash-Library-not-loaded-IssuingCore","text":"Runtime crash: “Library not loaded: IssuingCore”","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"text":" is not embedded. Add it to ","type":"text"},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"text":" even though you don’t import it in code. The other frameworks depend on it at runtime.","type":"text"}],"type":"paragraph"},{"anchor":"Runtime-crash-Library-not-loaded-AdyenApplePayProvisioning","text":"Runtime crash: “Library not loaded: AdyenApplePayProvisioning”","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"text":" is not embedded. It is a required dependency for Network Token Provisioning. Add it to ","type":"text"},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Duplicate-symbols","text":"Duplicate symbols","type":"heading","level":3},{"inlineContent":[{"text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"identifier":{"url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","interface