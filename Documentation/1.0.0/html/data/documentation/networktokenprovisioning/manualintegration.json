ing"},{"inlineContent":[{"text":"Same as above — ","type":"text"},{"code":"IssuingCommon.xcframework","type":"codeVoice"},{"text":" must also be embedded. This framework contains shared types like ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Runtime crash: “Library not loaded: IssuingCore”","anchor":"Runtime-crash-Library-not-loaded-IssuingCore","type":"heading"},{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"},{"text":" is not embedded. Add it to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":" even though you don’t import it in code. The other frameworks depend on it at runtime.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Runtime crash: “Library not loaded: AdyenApplePayProvisioning”","anchor":"Runtime-crash-Library-not-loaded-AdyenApplePayProvisioning","type":"heading"},{"inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" is not embedded. It is a required dependency for Network Token Provisioning. Add it to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Duplicate symbols","anchor":"Duplicate-symbols","type":"heading"},{"inlineContent":[{"text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExte