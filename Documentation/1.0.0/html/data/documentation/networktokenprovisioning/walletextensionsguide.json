{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"abstract":[{"text":"Allow cardholders to provision cards directly from the Apple Wallet app.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section, giving users another path to provision their cards."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires two app extensions:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Extension"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}]}],[{"inlineContent":[{"type":"text","text":"Provides card data, status, and handles the provisioning flow"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presents your custom authentication UI before provisioning","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic.","type":"text"}]},{"level":2,"anchor":"Prerequisites","type":