as you did for the main app."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual Integration:","type":"text"}]}],"type":"paragraph"},{"inlineContent":[{"text":"Embed the same XCFrameworks in the extension target with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":". See "},{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","isActive":true,"type":"reference"},{"type":"text","text":" for which frameworks are required."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler","type":"reference"},{"text":". This class is your extension’s entry point — its name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"]},{"type":"heading","anchor":"Required-Overrides","text":"Required Overrides","level":3},{"header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared keychain group for cached data between app and extension"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":3,"type":"heading","anchor":"Optional-Overrides","text":"Optional Overrides"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment()"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".live"}]}],[{"type":"paragraph","inlineContent":[{"text":"Set the session environment (","type":"text"},{"type":"codeVoice","code":".test"},{"type":"text","text":", "},{"code":".live","type":"codeVoice"},{"type":"text","text":")"}]}]]]},{"level":2,"text":"Step 3: Cache Activation Data in Your Main App","anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App","type":"heading"},{"inlineContent":[{"text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"text":" section. Make sure the user has opened the provisioning flow in your main app at least once.","type":"text"}]}]},{"type":"heading","level":2,"text":"Step 4: Create the UI Extension Target","anchor":"Step-4-Create-the-UI-Extension-Target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":" template again (e.g., "},{"type":"codeVoice","code":"WalletUIExtension"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"type":"text","text":" "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Update the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" — find the ","type":"text"},{"code":"NSExtension","type":"codeVoice"},{"text":" dictionary and set:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}],"type":"paragraph"}]]],"type":"table","header":"row"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement to this target as well.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading","level":2,"text":"Step 5: Implement the UI Extension Handler"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler"},{"text":". This view controller is presented by Apple Wallet when authentication is required.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"]},{"inlineContent":[{"text":"You can use UIKit or SwiftUI (via ","type":"text"},{"code":"UIHostingController","type":"codeVoice"},{"text":") for the authentication UI. The key requirement is calling ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when the user finishes authenticating.","type":"text"}],"type":"paragraph"},{"anchor":"Using-SwiftUI","type":"heading","level":3,"text":"Using SwiftUI"},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"]},{"anchor":"Entitlements-Summary","type":"heading","level":2,"text":"Entitlements Summary"},{"inlineContent":[{"text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Entitlement"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Main App","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Non-UI Extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.security.application-groups"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file for the Non-UI Extension:"}]},{"type":"codeListing","syntax":"xml","code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"]},{"text":"How It Works","anchor":"How-It-Works","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Once configured, the flow works as follows:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"User opens Apple Wallet","type":"text"}]},{"text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the ","type":"text"},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User selects your app"}]},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication"}]},{"type":"text","text":" — If "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet presents your UI Extension. Your UI Extension calls "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when done."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Provisioning","type":"text"}]},{"type":"text","text":" — The SDK handles the provisioning request using the session token from your "},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"type":"text","text":" method."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Card is added to Apple Wallet","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference.","type":"text"}],"type":"paragraph"}]},{"text":"Troubleshooting","level":2,"type":"heading","anchor":"Troubleshooting"},{"text":"App does not appear in Wallet’s “From Apps on Your iPhone”","level":3,"type":"heading","anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement is present on all three targets.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure activation data has been cached by the main app before opening Wallet."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the ","type":"text"},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"text":" is set to ","type":"text"},{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"},{"text":" (not the authorization variant) in the Non-UI Extension.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make sure the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" matches your handler class name exactly.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Authentication UI does not appear","type":"heading","anchor":"Authentication-UI-does-not-appear","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is set to "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"Extension cannot access cached data","anchor":"Extension-cannot-access-cached-data","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm both the main app and the extension share the same keychain access group."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.security.application-groups","type":"codeVoice"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" override returns the correct value."}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"title":"Walle