{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" override returns the correct value."}]}]}]}]}],"identifier":{"url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Wallet Extensions","role":"article"},"references":{"doc://com.adyen.NetworkTokenProvisioning/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","title":"Issuing SDK","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"kind":"article","role":"collection","type":"topic"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/NetworkTokenProvisioningExtensionUIHandler":{"role":"symbol","kind":"symbol","type":"topic","title":"NetworkTokenProvisioningExtensionUIHandler","navigatorTitle":[{"text":"NetworkTokenProvisioningExtensionUIHandler","kind":"identifier"}],"url":"\/documentation\/networktokenprovisioning\/networktokenprovisioningextensionuihandler","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NetworkTokenProvisioningExtensionUIHandler","kind":"identifier"}],"abstract":[{"type":"text","text":"An abstract base view controller that provides the UI layer for cardholder"},{"type":"text","text":" "},{"type":"text","text":"authentication during Apple Wallet provisioning."}]}