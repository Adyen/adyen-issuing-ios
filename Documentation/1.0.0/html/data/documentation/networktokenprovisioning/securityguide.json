{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}],"type":"paragraph"},{"level":2,"text":"Device Unlock Requirement","anchor":"Device-Unlock-Requirement","type":"heading"},{"inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}],"type":"paragraph"},{"syntax":"swift","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"type":"codeListing"},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"text":" (not ","type":"text"},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}]}]},{"level":2,"text":"Prevent Screen Capture","anchor":"Prevent-Screen-Capture","type":"heading"},{"inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}],"type":"paragraph"},{"syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing"},{"level":2,"text":"Protect Sensitive Views in App Switcher","anchor":"Protect-Sensitive-Views-in-App-Switcher","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher.","type":"text"}]},{"code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Secure Data Storage","anchor":"Secure-Data-Storage","type":"heading"},{"inlineContent":[{"text":"Never store tokens, keys, or credentials in ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}]},{"type":"heading","text":"Handle Sensitive Data in Memory","level":2,"anchor":"Handle-Sensitive-Data-in-Memory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}]},{"type":"codeListing","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" — prefer ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" so you control the lifecycle. Never log sensitive values.","type":"text"}]},{"anchor":"Secure-Networking","level":2,"type":"heading","text":"Secure Networking"},{"type":"paragraph","inlineContent":[{"text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" does not weaken App Transport Security:","type":"text"}]},{"code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"inlineContent":[{"text":"For additional protection, implement certificate pinning on your ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" to prevent man-in-the-middle attacks on your own backend endpoints.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Jailbreak Detection","anchor":"Jailbreak-Detection","type":"heading"},{"inlineContent":[{"text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}]}],"style":"note","type":"aside"}]}],"identifier":{"url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/SecurityGuide","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","metadata":{"role":"article","title":"Security Guide","roleHeading":"Article"},"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources"],"anchor":"Guides","generated":true,"title":"Guides"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"references":{"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/NetworkTokenProvisioningGuide":{"type":"topic","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","kind":"article","role":"article","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet from your iOS application."}],"title":"In-App Provisioning","url":"\/documentation\/networktokenprovisioning\/networktokenprovisioningguide"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/AdditionalResources":{"title":"Additional Resources","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources","type":"topic","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"url":"\/documentation\/networktokenprovisioning\/additionalresources","role":"article","kind":"article"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/ManualIntegration":{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}],"kind":"article","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","type":"topic","role":"article","title":"Manual Integration","url":"\/documentation\/networktokenprovisioning\/manualintegration"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/WalletExtensionsGuide":{"type":"topic","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","kind":"article","role":"article","abstract":[{"text":"Allow cardholders to provision cards directly from the Apple Wallet app.","type":"text"}],"title":"Wallet Extensions","url":"\/documentation\/networktokenprovisioning\/walletextensionsguide"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/GettingStarted":{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"kind":"article","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","type":"topic","role":"article","title":"Getting Started","url":"\/documentation\/networktokenprovisioning\/gettingstarted"},"doc://com.adyen.NetworkTokenProvisioning/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs","title":"Issuing SDK","type":"topic","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"url":"\/documentation\/issuingsdkdocs","role":"collection","kind":"article"}}}