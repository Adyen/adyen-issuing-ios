{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices.","type":"text"}]},{"type":"heading","level":2,"text":"Device Unlock Requirement","anchor":"Device-Unlock-Requirement"},{"type":"paragraph","inlineContent":[{"text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":".deviceOwnerAuthentication"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}]}],"style":"important","type":"aside"},{"level":2,"text":"Prevent Screen Capture","anchor":"Prevent-Screen-Capture","type":"heading"},{"inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}],"type":"paragraph"},{"code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Protect Sensitive Views in App Switcher","anchor":"Protect-Sensitive-Views-in-App-Switcher","type":"heading"},{"inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}],"type":"paragraph"},{"code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Secure Data Storage","anchor":"Secure-Data-Storage","type":"heading"},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints."}],"type":"paragraph"},{"code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}],"type":"paragraph"},{"level":2,"text":"Handle Sensitive Data in Memory","anchor":"Handle-Sensitive-Data-in-Memory","type":"heading"},{"inlineContent":[{"text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid storing sensitive values in "},{"type":"codeVoice","code":"String"},{"type":"text","text":" — prefer "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}]},{"level":2,"type":"heading","anchor":"Secure-Networking","text":"Secure Networking"},{"inlineContent":[{"text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" does not weaken App Transport Security:"}],"type":"paragraph"},{"code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"text":"For additional protection, implement certificate pinning on your ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":" to prevent man-in-the-middle attacks on your own backend endpoints.","type":"text"}]},{"level":2,"anchor":"Jailbreak-Detection","text":"Jailbreak Detection","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Security Guide","roleHeading":"Article","role":"article"},"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"title":"Guides","anchor":"Guides","generated":true}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"kind":"article","identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide","interfaceLanguage":"swift"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"role":"collection","type":"topic","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"Issuing SDK","url":"\/documentation\/issuingsdkdocs"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/WalletExtensionsGuide":{"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","url":"\/documentation\/issuing-sdk\/walletextensionsguide","abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}],"role":"article","title":"Wallet Extensions","type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"title":"Getting Started","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","type":"topic","kind":"article","url":"\/documentation\/issuing-sdk\/gettingstarted"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/ManualIntegration":{"role":"article","type":"topic","abstract":[{"text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project.","type":"text"}],"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","title":"Manual Integration","url":"\/documentation\/issuing-sdk\/manualintegration"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/AdditionalResources":{"role":"article","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"kind":"article","title":"Additional Resources","url":"\/documentation\/issuing-sdk\/additionalresources"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/NetworkTokenProvisioningGuide":{"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","url":"\/documentation\/issuing-sdk\/networktokenprovisioningguide","abstract":[{"text":"Add payment cards to Apple Wallet from your iOS application.","type":"text"}],"role":"article","title":"In-App Provisioning","type":"topic"}}}