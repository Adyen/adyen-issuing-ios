{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}]},{"type":"heading","level":2,"text":"Device Unlock Requirement","anchor":"Device-Unlock-Requirement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}]},{"type":"codeListing","syntax":"swift","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".deviceOwnerAuthentication"},{"type":"text","text":" (not "},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}]}],"style":"important"},{"type":"heading","level":2,"text":"Prevent Screen Capture","anchor":"Prevent-Screen-Capture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}]},{"syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing"},{"text":"Protect Sensitive Views in App Switcher","type":"heading","anchor":"Protect-Sensitive-Views-in-App-Switcher","level":2},{"type":"paragraph","inlineContent":[{"text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher.","type":"text"}]},{"syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing"},{"text":"Secure Data Storage","anchor":"Secure-Data-Storage","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Never store tokens, keys, or credentials in ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}]},{"code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup.","type":"text"}]},{"text":"Handle Sensitive Data in Memory","anchor":"Handle-Sensitive-Data-in-Memory","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed.","type":"text"}]},{"code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid storing sensitive values in "},{"type":"codeVoice","code":"String"},{"type":"text","text":" — prefer "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}]},{"type":"heading","text":"Secure Networking","level":2,"anchor":"Secure-Networking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" does not weaken App Transport Security:"}]},{"code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}]},{"type":"heading","text":"Jailbreak Detection","level":2,"anchor":"Jailbreak-Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}],"type":"paragraph"}],"type":"aside","name":"Note"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide"},"metadata":{"title":"Security Guide","roleHeading":"Article","role":"article"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/AdditionalResources":{"type":"topic","title":"Additional Resources","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"role":"article","url":"\/documentation\/issuing-sdk\/additionalresources"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/GettingStarted":{"kind":"article","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"url":"\/documentation\/issuing-sdk\/gettingstarted","role":"article","title":"Getting Started","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"type":"topic","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"Issuing SDK","url":"\/documentation\/issuingsdkdocs","role":"collection"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/ManualIntegration":{"type":"topic","title":"Manual Integration","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}],"role":"article","url":"\/documentation\/issuing-sdk\/manualintegration"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/NetworkTokenProvisioningGuide":{"type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/