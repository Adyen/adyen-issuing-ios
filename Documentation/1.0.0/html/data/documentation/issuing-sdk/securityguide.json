{"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"generated":true,"anchor":"Guides"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices.","type":"text"}]},{"type":"heading","level":2,"anchor":"Device-Unlock-Requirement","text":"Device Unlock Requirement"},{"type":"paragraph","inlineContent":[{"text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"type":"aside","style":"important","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"text":" (not ","type":"text"},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}],"type":"paragraph"}],"name":"Important"},{"type":"heading","level":2,"anchor":"Prevent-Screen-Capture","text":"Prevent Screen Capture"},{"type":"paragraph","inlineContent":[{"text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"]},{"type":"heading","level":2,"anchor":"Protect-Sensitive-Views-in-App-Switcher","text":"Protect Sensitive Views in App Switcher"},{"type":"paragraph","inlineContent":[{"text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"]},{"type":"heading","level":2,"anchor":"Secure-Data-Storage","text":"Secure Data Storage"},{"type":"paragraph","inlineContent":[{"text":"Never store tokens, keys, or credentials in ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup.","type":"text"}]},{"type":"heading","level":2,"anchor":"Handle-Sensitive-Data-in-Memory","text":"Handle Sensitive Data in Memory"},{"type":"paragraph","inlineContent":[{"text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"]},{"type":"paragraph","inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" — prefer ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" so you control the lifecycle. Never log sensitive values.","type":"text"}]},{"type":"heading","level":2,"anchor":"Secure-Networking","text":"Secure Networking"},{"type":"paragraph","inlineContent":[{"text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" does not weaken App Transport Security:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"text":"For additional protection, implement certificate pinning on your ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" to prevent man-in-the-middle attacks on your own backend endpoints.","type":"text"}]},{"type":"heading","level":2,"anchor":"Jailbreak-Detection","text":"Jailbreak Detection"},{"type":"paragraph","inlineContent":[{"text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}],"type":"paragraph"}],"name":"Note"}],"kind":"content"}],"metadata":{"role":"article","roleHeading":"Article","title":"Security Guide"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide","interfaceLanguage":"swift"},"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/NetworkTokenProvisioningGuide":{"url":"\/documentation\/issuing-sdk\/networktokenprovisioningguide","role":"article","title":"In-App Provisioning","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet from your iOS application."}],"type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/AdditionalResources":{"url":"\/documentation\/issuing-sdk\/additionalresources","role":"article","title":"Additional Resources","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/ManualIntegration":{"url":"\/documentation\/issuing-sdk\/manualintegration","role":"article","title":"Manual Integration","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}],"type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/WalletExtensionsGuide":{"url":"\/documentation\/issuing-sdk\/walletextensionsguide","role":"article","title":"Wallet Extensions","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}],"type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","role":"collection","title":"Issuing SDK","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/GettingStarted":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","kind":"article","url":"\/documentation\/issuing-sdk\/gettingstarted","role":"article","type":"topic","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"title":"Getting Started"}}}