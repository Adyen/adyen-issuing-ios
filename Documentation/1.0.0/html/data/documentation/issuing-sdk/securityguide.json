{"metadata":{"roleHeading":"Article","title":"Security Guide","role":"article"},"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"anchor":"Guides","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide"},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}],"type":"paragraph"},{"level":2,"anchor":"Device-Unlock-Requirement","text":"Device Unlock Requirement","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card.","type":"text"}]},{"code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"type":"codeListing","syntax":"swift"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".deviceOwnerAuthentication"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"},{"type":"heading","level":2,"text":"Prevent Screen Capture","anchor":"Prevent-Screen-Capture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}]},{"type":"codeListing","syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"]},{"text":"Protect Sensitive Views in App Switcher","level":2,"anchor":"Protect-Sensitive-Views-in-App-Switcher","type":"heading"},{"inlineContent":[{"text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing"},{"text":"Secure Data Storage","level":2,"anchor":"Secure-Data-Storage","type":"heading"},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints."}],"type":"paragraph"},{"syntax":"swift","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup.","type":"text"}],"type":"paragraph"},{"text":"Handle Sensitive Data in Memory","level":2,"anchor":"Handle-Sensitive-Data-in-Memory","type":"heading"},{"inlineContent":[{"text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"type":"codeListing"},{"inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" — prefer ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" so you control the lifecycle. Never log sensitive values.","type":"text"}],"type":"paragraph"},{"text":"Secure Networking","level":2,"anchor":"Secure-Networking","type":"heading"},{"inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" does not weaken App Transport Security:"}],"type":"paragraph"},{"syntax":"xml","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"type":"codeVoice","code":"URLSession"},{"text":" to prevent man-in-the-middle attacks on your own backend endpoints.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Jailbreak Detection","anchor":"Jailbreak-Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}]}],"type":"aside","name":"Note","style":"note"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/WalletExtensionsGuide":{"kind":"article","url":"\/documentation\/issuing-sdk\/walletextensionsguide","type":"topic","title":"Wallet Extensions","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","role":"article","abstract":[{"text":"Allow cardholders to provision cards directly from the Apple Wallet app.","type":"text"}]},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/NetworkTokenProvisioningGuide":{"abstract":[{"type":"text","text":"Add payment cards to Apple Wallet from your iOS application."}],"role":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","title":"In-App Provisioning","type":"topic","url":"\/documentation\/issuing-sdk\/networktokenprovisioningguide","kind":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/GettingStarted":{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"url":"\/documentation\/issuing-sdk\/gettingstarted","type":"topic","title":"Getting Started","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","role":"article","kind":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"role":"collection","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"Issuing SDK","type":"topic","url":"\/documentation\/issuingsdkdocs","kind":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/AdditionalResources":{"abstract":[{"text":"Find more information about Adyen Issuing and related services.","type":"text"}],"url":"\/documentation\/issuing-sdk\/additionalresources","type":"topic","title":"Additional Resources","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources","role":"article","kind":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/ManualIntegration":{"abstract":[{"text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project.","type":"text"}],"role":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","title":"Manual Integration","type":"topic","url":"\/documentation\/issuing-sdk\/manualintegration","kind":"article"}}}