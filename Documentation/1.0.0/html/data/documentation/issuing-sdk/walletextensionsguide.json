"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","isActive":true},{"type":"text","text":". This view controller is presented by Apple Wallet when authentication is required."}]},{"code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use UIKit or SwiftUI (via "},{"code":"UIHostingController","type":"codeVoice"},{"type":"text","text":") for the authentication UI. The key requirement is calling "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" wh