:"text","text":")"}]}]]],"type":"table","header":"row"},{"text":"Step 3: Cache Activation Data in Your Main App","type":"heading","anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App","level":2},{"inlineContent":[{"type":"text","text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"content":[{"inlineContent":[{"text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section. Make sure the user has opened the provisioning flow in your main app at least once.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"type":"heading","text":"Step 4: Create the UI Extension Target","level":2,"anchor":"Step-4-Create-the-UI-Extension-Target"},{"type":"paragraph","inlineContent":[{"text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"inlineCont