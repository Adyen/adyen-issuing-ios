{"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section, giving users another path to provision their cards."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires two app extensions:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Extension"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provides card data, status, and handles the provisioning flow"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI Extension"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Presents your custom authentication UI before provisioning"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic."}]},{"anchor":"Prerequisites","text":"Prerequisites","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Before implementing wallet extensions:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted"},{"text":" guide and have in-app provisioning working.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure you have the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement. This entitlement must be added to "},{"type":"strong","inlineContent":[{"text":"all three targets","type":"text"}]},{"type":"text","text":": the main app, the Non-UI Extension, and the UI Extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set up a shared keychain access group so the main app and extensions can share cached data."}]}]}]},{"type":"heading","level":2,"text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":" template and create a new target (e.g., "},{"code":"WalletExtension","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"type":"text","text":" "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" — find the "},{"code":"NSExtension","type":"codeVoice"},{"type":"text","text":" dictionary and set:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler"}]}]]],"type":"table","header":"row"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement to this target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a shared app group entitlement (e.g., "},{"code":"group.com.yourcompany.wallet","type":"codeVoice"},{"type":"text","text":") matching the one in your main app."}]}]}]},{"type":"heading","level":3,"text":"Add the SDK to the Extension Target","anchor":"Add-the-SDK-to-the-Extension-Target"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager:"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"code":"AdyenNetworkTokenProvisioning","type":"codeVoice"},{"text":" as a dependency of your extension target, just as you did for the main app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual Integration:"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"Embed the same XCFrameworks in the extension target with ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":". See ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","isActive":true,"type":"reference"},{"text":" for which frameworks are required.","type":"text"}]},{"type":"heading","level":2,"text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler","isActive":true,"type":"reference"},{"text":". This class is your extension’s entry point — its name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"]},{"type":"heading","level":3,"text":"Required Overrides","anchor":"Required-Overrides"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared keychain group for cached data between app and extension"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","level":3,"text":"Optional Overrides","anchor":"Optional-Overrides"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".live"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Set the session environment ("},{"type":"codeVoice","code":".test"},{"type":"text","text":", "},{"type":"codeVoice","code":".live"},{"type":"text","text":")"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","level":2,"text":"Step 3: Cache Activation Data in Your Main App","anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App"},{"type":"paragraph","inlineContent":[{"text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section. Make sure the user has opened the provisioning flow in your main app at least once."}],"type":"paragraph"}]},{"level":2,"anchor":"Step-4-Create-the-UI-Extension-Target","type":"heading","text":"Step 4: Create the UI Extension Target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Select the ","type":"text"},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"type":"text","text":" template again (e.g., "},{"type":"codeVoice","code":"WalletUIExtension"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Remove all generated files ","type":"text"},{"inlineContent":[{"text":"except","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Update the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}]}]]],"header":"row","type":"table"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement to this target as well."}]}]}]},{"anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading","level":2,"text":"Step 5: Implement the UI Extension Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","isActive":true},{"text":". This view controller is presented by Apple Wallet when authentication is required.","type":"text"}]},{"syntax":"swift","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can use UIKit or SwiftUI (via "},{"type":"codeVoice","code":"UIHostingController"},{"type":"text","text":") for the authentication UI. The key requirement is calling "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when the user finishes authenticating."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Using SwiftUI","anchor":"Using-SwiftUI"},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"]},{"anchor":"Entitlements-Summary","text":"Entitlements Summary","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access.","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Entitlement"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Main App"}]}],[{"type":"paragraph","inlineContent":[{"text":"Non-UI Extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UI Extension"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.security.application-groups"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optional","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Example "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file for the Non-UI Extension:"}],"type":"paragraph"},{"syntax":"xml","code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"],"type":"codeListing"},{"anchor":"How-It-Works","text":"How It Works","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Once configured, the flow works as follows:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"User opens Apple Wallet"}],"type":"strong"},{"text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"User selects your app"}],"type":"strong"},{"text":" — The SDK displays available cards using the card art you provide.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"strong"},{"text":" — If ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", Apple Wallet presents your UI Extension. Your UI Extension calls ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when done.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Provisioning"}],"type":"strong"},{"text":" — The SDK handles the provisioning request using the session token from your ","type":"text"},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"text":" method.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}],"type":"strong"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference."}]}],"style":"note","name":"Note","type":"aside"},{"anchor":"Troubleshooting","text":"Troubleshooting","level":2,"type":"heading"},{"anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone","text":"App does not appear in Wallet’s “From Apps on Your iPhone”","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement is present on all three targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure activation data has been cached by the main app before opening Wallet."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"},{"type":"text","text":" (not the authorization variant) in the Non-UI Extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make sure the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" matches your handler class name exactly."}]}]}],"type":"unorderedList"},{"anchor":"Authentication-UI-does-not-appear","text":"Authentication UI does not appear","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"anchor":"Extension-cannot-access-cached-data","text":"Extension cannot access cached data","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm both the main app and the extension share the same keychain access group."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure the ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" override returns the correct value."}]}]}],"type":"unorderedList"}]}],"metadata":{"roleHeading":"Article","title":"Wallet Extensions","role":"article"},"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration