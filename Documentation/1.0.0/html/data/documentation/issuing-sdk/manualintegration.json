{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code."}],"type":"paragraph"},{"anchor":"Download-the-SDK","type":"heading","level":2,"text":"Download the SDK"},{"inlineContent":[{"type":"text","text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:"}],"type":"paragraph"},{"type":"codeListing","syntax":"text","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"]},{"inlineContent":[{"type":"text","text":"You also need the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning"},{"type":"text","text":" SDK, available from "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios"},{"type":"text","text":". Download the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"type":"text","text":" if you use a Wallet Extension)."}],"type":"paragraph"},{"anchor":"Required-Frameworks","type":"heading","text":"Required Frameworks","level":2},{"anchor":"Network-Token-Provisioning","type":"heading","text":"Network Token Provisioning","level":3},{"inlineContent":[{"type":"text","text":"All of the following frameworks are "},{"type":"strong","inlineContent":[{"text":"required","type":"text"}]},{"type":"text","text":" for Apple Wallet provisioning:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Framework"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Import in Code?"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"}]}],[{"inlineContent":[{"type":"text","text":"Provisioning logic and public API"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared types ("},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", etc.)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Internal secure communication","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Apple Pay provisioning interface","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]}],"type":"paragraph"}]]]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" must be embedded in your app for the SDK to function, but you should "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" import them in your code. They are used internally by "},{"code":"NetworkTokenProvisioning","type":"codeVoice"},{"text":" and should not be accessed directly.","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Embed the Frameworks","anchor":"Embed-the-Frameworks"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Drag all four ","type":"text"},{"type":"codeVoice","code":".xcframework"},{"text":" bundles into your Xcode project navigator.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select your app target, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"General > Frameworks, Libraries, and Embedded Content"}]},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Ensure all frameworks are listed and set to ","type":"text"},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}]}]}],"type":"unorderedList"}]}]},{"level":2,"anchor":"Import-Statements","text":"Import Statements","type":"heading"},{"inlineContent":[{"text":"When embedding manually, import the individual modules — not the SPM wrapper name:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"With SPM, you use ","type":"text"},{"type":"codeVoice","code":"import AdyenNetworkTokenProvisioning"},{"text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately.","type":"text"}]}],"type":"aside"},{"text":"Keychain Access Group","level":2,"anchor":"Keychain-Access-Group","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Enable "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" in your app target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the same access group to both the app and the extension.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the access group identifier when configuring the SDK:"}]}]}]},{"type":"codeListing","code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift"},{"anchor":"Wallet-Extension-Support","type":"heading","level":2,"text":"Wallet Extension Support"},{"inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"text":" (instead of ","type":"text"},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":")","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the extension, use the same imports:"}]},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"type":"heading","level":2,"anchor":"Verify-the-Integration","text":"Verify the Integration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After embedding:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Build the project. All three frameworks should compile and link without errors."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run on the iOS Simulator to verify basic initialization.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test provisioning on a physical device (simulators do not support Apple Wallet)."}]}]}],"type":"orderedList"},{"text":"Troubleshooting","type":"heading","level":2,"anchor":"Troubleshooting"},{"type":"heading","level":3,"anchor":"No-such-module-NetworkTokenProvisioning","text":"“No such module ‘NetworkTokenProvisioning’”"},{"inlineContent":[{"type":"text","text":"Ensure the XCFramework is added to your target’s "},{"type":"strong","inlineContent":[{"text":"Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":" section and is set to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"“No such module ‘IssuingCommon’”","level":3,"anchor":"No-such-module-IssuingCommon"},{"type":"paragraph","inlineContent":[{"text":"Same as above — ","type":"text"},{"code":"IssuingCommon.xcframework","type":"codeVoice"},{"text":" must also be embedded. This framework contains shared types like ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Runtime crash: “Library not loaded: IssuingCore”","level":3,"anchor":"Runtime-crash-Library-not-loaded-IssuingCore"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" is not embedded. Add it to "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"text":" even though you don’t import it in code. The other frameworks depend on it at runtime.","type":"text"}]},{"text":"Runtime crash: “Library not loaded: AdyenApplePayProvisioning”","type":"heading","anchor":"Runtime-crash-Library-not-loaded-AdyenApplePayProvisioning","level":3},{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"text":" is not embedded. It is a required dependency for Network Token Provisioning. Add it to ","type":"text"},{"inlineContent":[{"text":"Embed & Sign","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Duplicate symbols","type":"heading","anchor":"Duplicate-symbols"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both."}]}]}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProv