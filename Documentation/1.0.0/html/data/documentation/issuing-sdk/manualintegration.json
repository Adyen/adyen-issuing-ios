 Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]}],"type":"unorderedList"}]}]},{"text":"Import Statements","type":"heading","level":2,"anchor":"Import-Statements"},{"type":"paragraph","inlineContent":[{"text":"When embedding manually, import the individual modules — not the SPM wrapper name:","type":"text"}]},{"code":["import NetworkTokenProvisioning","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"With SPM, you use ","type":"text"},{"type":"codeVoice","code":"import AdyenNetworkTokenProvisioning"},{"text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately.","type":"text"}]}],"type":"aside","name":"Note","style":"note"},{"text":"Keychain Access Group","type":"heading","level":2,"anchor":"Keychain-Access-Group"},{"type":"paragraph","inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enable "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" in your app target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same access group to both the app and the extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the access group identifier when configuring the SDK:"}]}]}],"type":"orderedList"},{"syntax":"swift","type":"codeListing","