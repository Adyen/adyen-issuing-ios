","isActive":true,"identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios"},{"type":"text","text":". Download the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"type":"text","text":" if you use a Wallet Extension)."}]},{"text":"Required Frameworks","type":"heading","anchor":"Required-Frameworks","level":2},{"text":"Network Token Provisioning","type":"heading","anchor":"Network-Token-Provisioning","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"All of the following frameworks are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" for Apple Wallet provisioning:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Framework"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import in Code?"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"text":"Provisioning logic and public API","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared types ("},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", etc.)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Internal secure communication"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"No","type":"text"}],"type":"strong"}],"type":"paragraph"}]],[[{"type":"paragraph","inli