PayProvisioning.xcframework"},{"text":" — Embed & Sign","type":"text"}]}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"type":"heading","anchor":"Import-Statements","text":"Import Statements","level":2},{"inlineContent":[{"text":"When embedding manually, import the individual modules — not the SPM wrapper name:","type":"text"}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"With SPM, you use "},{"type":"codeVoice","code":"import AdyenNetworkTokenProvisioning"},{"type":"text","text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately."}],"type":"paragraph"}],"name":"Note"},{"text":"Keychain Access Group","anchor":"Keychain-Access-Group","type":"heading","level":2},{"inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Enable ","type":"text"},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"text":" in your app target’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the same access group to both the app and the extension.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the access group identifier when configuring the SDK:"}],"type":"paragraph"}]}]},{"code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Wallet Extension Support","anchor":"Wallet-Extension-Support","type":"heading"},{"inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"text":" (instead of ","type":"text"},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"In the extension, use the same imports:","type":"text"}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"text":"Verify the Integration","type":"heading","anchor":"Verify-the-Integration","level":2},{"inlineContent":[{"type":"text","text":"After embedding:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Build the project. All three frameworks should compile and link without errors.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Run on the iOS Simulator to verify basic initialization.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Test provisioning on a physical device (simulators do not support Apple Wallet)."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Troubleshooting","text":"Troubleshooting","level":2},{"anchor":"No-