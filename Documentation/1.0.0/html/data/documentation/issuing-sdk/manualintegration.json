{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code."}],"type":"paragraph"},{"anchor":"Download-the-SDK","text":"Download the SDK","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:"}],"type":"paragraph"},{"syntax":"text","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You also need the "},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"type":"text","text":" SDK, available from "},{"type":"reference","identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios","isActive":true},{"type":"text","text":". Download the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" (and "},{"code":"AdyenApplePayExtensionProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" if you use a Wallet Extension)."}],"type":"paragraph"},{"anchor":"Required-Frameworks","text":"Required Frameworks","level":2,"type":"heading"},{"anchor":"Network-Token-Provisioning","text":"Network Token Provisioning","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"All of the following frameworks are "},{"type":"strong","inlineContent":[{"text":"required","type":"text"}]},{"type":"text","text":" for Apple Wallet provisioning:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Framework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import in Code?"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Provisioning logic and public API"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared types ("},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", etc.)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Internal secure communication"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple Pay provisioning interface"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]}]}]]]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" must be embedded in your app for the SDK to function, but you should "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" import them in your code. They are used internally by "},{"type":"codeVoice","code":"NetworkTokenProvisioning"},{"type":"text","text":" and should not be accessed directly."}]}]},{"anchor":"Embed-the-Frameworks","type":"heading","level":2,"text":"Embed the Frameworks"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Drag all four "},{"type":"codeVoice","code":".xcframework"},{"type":"text","text":" bundles into your Xcode project navigator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your app target, go to "},{"type":"strong","inlineContent":[{"text":"General > Frameworks, Libraries, and Embedded Content","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure all frameworks are listed and set to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]}],"type":"unorderedList"}]}]},{"anchor":"Import-Statements","type":"heading","level":2,"text":"Import Statements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When embedding manually, import the individual modules — not the SPM wrapper name:"}]},{"syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"],"type":"codeListing"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"With SPM, you use ","type":"text"},{"code":"import AdyenNetworkTokenProvisioning","type":"codeVoice"},{"text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately.","type":"text"}]}]},{"anchor":"Keychain-Access-Group","type":"heading","level":2,"text":"Keychain Access Group"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Enable ","type":"text"},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"type":"text","text":" in your app target’s "},{"type":"strong","inlineContent":[{"text":"Signing & Capabilities","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the same access group to both the app and the extension.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass the access group identifier when configuring the SDK:","type":"text"}]}]}]},{"syntax":"swift","type":"codeListing","code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"]},{"level":2,"anchor":"Wallet-Extension-Support","type":"heading","text":"Wallet Extension Support"},{"type":"paragraph","inlineContent":[{"text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with ","type":"text"},{"inlineContent":[{"text":"Embed & Sign","type":"text"}],"type":"strong"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"AdyenApplePayExtensionProvisioning.xcframework","type":"codeVoice"},{"text":" (instead of ","type":"text"},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":")","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"In the extension, use the same imports:","type":"text"}]},{"syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"],"type":"codeListing"},{"anchor":"Verify-the-Integration","type":"heading","level":2,"text":"Verify the Integration"},{"type":"paragraph","inlineContent":[{"text":"After embedding:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Build the project. All three frameworks should compile and link without errors.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run on the iOS Simulator to verify basic initialization.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Test provisioning on a physical device (simulators do not support Apple Wallet).","type":"text"}]}]}]},{"anchor":"Troubleshooting","type":"heading","level":2,"text":"Troubleshooting"},{"anchor":"No-such-module-NetworkTokenProvisioning","type":"heading","level":3,"text":"“No such module ‘NetworkTokenProvisioning’”"},{"type":"paragraph","inlineContent":[{"text":"Ensure the XCFramework is added to your target’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"text":" section and is set to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":".","type":"text"}]},{"anchor":"No-such-module-IssuingCommon","type":"heading","level":3,"text":"“No such module ‘IssuingCommon’”"},{"type":"paragraph","inlineContent":[{"tex