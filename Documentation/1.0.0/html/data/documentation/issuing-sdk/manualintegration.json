xt","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"anchor":"Import-Statements","type":"heading","text":"Import Statements","level":2},{"type":"paragraph","inlineContent":[{"text":"When embedding manually, import the individual modules — not the SPM wrapper name:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"With SPM, you use "},{"type":"codeVoice","code":"import AdyenNetworkTokenProvisioning"},{"text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"level":2,"type":"heading","anchor":"Keychain-Access-Group","text":"Keychain Access Group"},{"type":"paragraph","inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Enable "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" in your app target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Signing & Capabilities"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the same access group to both the app and the extension.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the access group identifier when configuring the SDK:","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Wallet-Extension-Support","text":"Wallet Extension Support"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AdyenApplePayExtensionProvisioning.xcframework","type":"codeVoice"},{"text":" (instead of ","type":"text"},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the extension, use the same imports:"}]},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"level":2,"type":"heading","anchor":"Verify-the-Integration","text":"Verify the Integration"},{"inlineContent":[{"type":"text","text":"After embedding:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Build the project. All three frameworks should compile and link without errors."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run on the iOS Simulator to verify basic initialization.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Test provisioning on a physical device (simulators do not support Apple Wallet).","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":2,"anchor":"Troubleshooting","text":"Troubleshooting"},{"type":"heading","level":3,"text":"“No such module ‘NetworkTokenProvisioning’”","anchor":"No-such-module-NetworkTokenProvisioning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the XCFramework is added to your target’s "},{"type":"strong","inlineContent":[{"type":"text","text":"Frameworks, Libraries, and Embedded Content"}]},{"type":"text","text":" section and is set to "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"“No such module ‘IssuingCommon’”","anchor":"No-such-module-IssuingCommon"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Same as above — "},{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" must also be embedded. This framework contains shared types like "},{"code":"TokenProviding","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Runtime-crash-Library-not-loaded-IssuingCore","type":"heading","level":3,"text":"Runtime crash: “Library not loaded: IssuingCore”"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" is not embedded. Add it to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"type":"text","text":" even though you don’t import it in code. The other frameworks depend on it at runtime."}]},{"type":"heading","text":"Runtime crash: “Library not loaded: AdyenApplePayProvisioning”","anchor":"Runtime-crash-Library-not-loaded-AdyenApplePayProvisioning","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" is not embedded. It is a required dependency for Net