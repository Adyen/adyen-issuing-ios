{"metadata":{"role":"article","title":"Manual Integration","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code.","type":"text"}]},{"text":"Download the SDK","anchor":"Download-the-SDK","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:"}]},{"code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"],"type":"codeListing","syntax":"text"},{"type":"paragraph","inlineContent":[{"text":"You also need the ","type":"text"},{"type":"codeVoice","code":"AdyenApplePayProvisioning"},{"text":" SDK, available from ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios"},{"type":"text","text":". Download the "},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"type":"text","text":" if you use a Wallet Extension)."}]},{"level":2,"text":"Required Frameworks","anchor":"Required-Frameworks","type":"heading"},{"level":3,"text":"Network Token Provisioning","anchor":"Network-Token-Provisioning","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All of the following frameworks are ","type":"text"},{"inlineContent":[{"text":"required","type":"text"}],"type":"strong"},{"text":" for Apple Wallet provisioning:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Framework","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Import in Code?","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Provisioning logic and public API","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shared types (","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", etc.)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Internal secure communication","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Apple Pay provisioning interface","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"IssuingCore.xcframework","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" must be embedded in your app for the SDK to function, but you should ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" import them in your code. They are used internally by ","type":"text"},{"code":"NetworkTokenProvisioning","type":"codeVoice"},{"text":" and should not be accessed directly.","type":"text"}],"type":"paragraph"}]},{"text":"Embed the Frameworks","anchor":"Embed-the-Frameworks","type":"heading","level":2},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Drag all four "},{"type":"codeVoice","code":".xcframework"},{"type":"text","text":" bundles into your Xcode project navigator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your app target, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"General > Frameworks, Libraries, and Embedded Content"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"},{"type":"text","text":" — Embed & Sign"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}]}]}]}]}]},{"type":"heading","level":2,"anchor":"Import-Statements","text":"Import Statements"},{"inlineContent":[{"type":"text","text":"When embedding manually, import the individual modules — not the SPM wrapper name:"}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"text":"With SPM, you use ","type":"text"},{"type":"codeVoice","code":"import AdyenNetworkTokenProvisioning"},{"type":"text","text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"text":"Keychain Access Group","anchor":"Keychain-Access-Group","level":2,"type":"heading"},{"inlineContent":[{"text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Enable ","type":"text"},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"text":" in your app target’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"Signing & Capabilities","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add the same access group to both the app and the extension.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the access group identifier when configuring the SDK:","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"text":"Wallet Extension Support","anchor":"Wallet-Extension-Support","level":2,"type":"heading"},{"inlineContent":[{"text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AdyenApplePayExtensionProvisioning.xcframework","type":"codeVoice"},{"text":" (instead of ","type":"text"},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"In the extension, use the same imports:","type":"text"}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"text":"Verify the Integration","anchor":"Verify-the-Integration","level":2,"type":"heading"},{"inlineContent":[{"text":"After embedding:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Build the project. All three frameworks should compile and link without errors.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run on the iOS Simulator to verify basic initialization.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Test provisioning on a physical device (simulators do not support Apple Wallet).","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Troubleshooting","anchor":"Troubleshooting","level":2,"type":"heading"},{"text":"“No such module ‘NetworkTokenProvisioning’”","anchor":"No-such-module-NetworkTokenProvisioning","level":3,"type":"heading"},{"inlineContent":[{"text":"Ensure the XCFramework is added to your target’s ","type":"text"},{"inlineContent":[{"