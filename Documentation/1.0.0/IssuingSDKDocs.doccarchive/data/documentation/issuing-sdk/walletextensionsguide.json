{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Wallet Extensions"},"abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"text":" section, giving users another path to provision their cards.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This requires two app extensions:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Non-UI Extension","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Provides card data, status, and handles the provisioning flow","type":"text"}]}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Presents your custom authentication UI before provisioning"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Prerequisites","text":"Prerequisites"},{"inlineContent":[{"text":"Before implementing wallet extensions:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete the ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","isActive":true,"type":"reference"},{"text":" guide and have in-app provisioning working.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure you have the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement. This entitlement must be added to "},{"inlineContent":[{"text":"all three targets","type":"text"}],"type":"strong"},{"type":"text","text":": the main app, the Non-UI Extension, and the UI Extension."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Set up a shared keychain access group so the main app and extensions can share cached data."}],"type":"paragraph"}]}]},{"anchor":"Step-1-Create-the-Non-UI-Extension-Target","type":"heading","text":"Step 1: Create the Non-UI Extension Target","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the ","type":"text"},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"text":" template and create a new target (e.g., ","type":"text"},{"type":"codeVoice","code":"WalletExtension"},{"text":").","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files "},{"inlineContent":[{"text":"except","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement to this target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a shared app group entitlement (e.g., ","type":"text"},{"code":"group.com.yourcompany.wallet","type":"codeVoice"},{"text":") matching the one in your main app.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Add-the-SDK-to-the-Extension-Target","type":"heading","text":"Add the SDK to the Extension Target","level":3},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager:"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"AdyenNetworkTokenProvisioning"},{"type":"text","text":" as a dependency of your extension target, just as you did for the main app."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Manual Integration:","type":"text"}],"type":"strong"}]},{"inlineContent":[{"type":"text","text":"Embed the same XCFrameworks in the extension target with "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":". See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration"},{"type":"text","text":" for which frameworks are required."}],"type":"paragraph"},{"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","type":"heading","text":"Step 2: Implement the Non-UI Extension Handler","level":2},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler"},{"text":". This class is your extension’s entry point — its name must match the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"]},{"type":"heading","level":3,"text":"Required Overrides","anchor":"Required-Overrides"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared keychain group for cached data between app and extension"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}]}]]]},{"level":3,"type":"heading","text":"Optional Overrides","anchor":"Optional-Overrides"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"inlineContent":[{"text":"Default","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":".live"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Set the session environment ("},{"type":"codeVoice","code":".test"},{"type":"text","text":", "},{"type":"codeVoice","code":".live"},{"type":"text","text":")"}],"type":"paragraph"}]]],"header":"row"},{"text":"Step 3: Cache Activation Data in Your Main App","type":"heading","anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App","level":2},{"inlineContent":[{"type":"text","text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section. Make sure the user has opened the provisioning flow in your main app at least once.","type":"text"}]}]},{"type":"heading","level":2,"text":"Step 4: Create the UI Extension Target","anchor":"Step-4-Create-the-UI-Extension-Target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":" template again (e.g., "},{"type":"codeVoice","code":"WalletUIExtension"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"text":"except","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Update the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" — find the ","type":"text"},{"code":"NSExtension","type":"codeVoice"},{"text":" dictionary and set:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}]}]]],"type":"table"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement to this target as well."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading","text":"Step 5: Implement the UI Extension Handler","level":2},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","isActive":true,"type":"reference"},{"text":". This view controller is presented by Apple Wallet when authentication is required.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"You can use UIKit or SwiftUI (via ","type":"text"},{"type":"codeVoice","code":"UIHostingController"},{"text":") for the authentication UI. The key requirement is calling ","type":"text"},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when the user finishes authenticating.","type":"text"}],"type":"paragraph"},{"anchor":"Using-SwiftUI","type":"heading","text":"Using SwiftUI","level":3},{"type":"codeListing","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"syntax":"swift"},{"anchor":"Entitlements-Summary","type":"heading","text":"Entitlements Summary","level":2},{"inlineContent":[{"text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access.","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Entitlement","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Main App","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Non-UI Extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"UI Extension","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.security.application-groups","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Example ","type":"text"},{"code":".entitlements","type":"codeVoice"},{"text":" file for the Non-UI Extension:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"],"syntax":"xml"},{"anchor":"How-It-Works","type":"heading","text":"How It Works","level":2},{"inlineContent":[{"text":"Once configured, the flow works as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User opens Apple Wallet"}]},{"type":"text","text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User selects your app"}]},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication","type":"text"}]},{"type":"text","text":" — If "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":", Apple Wallet presents your UI Extension. Your UI Extension calls "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when done.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Provisioning"}],"type":"strong"},{"text":" — The SDK handles the provisioning request using the session token from your ","type":"text"},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"text":" method.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference."}],"type":"paragraph"}]},{"type":"heading","level":2,"anchor":"Troubleshooting","text":"Troubleshooting"},{"anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone","type":"heading","text":"App does not appear in Wallet’s “From Apps on Your iPhone”","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement is present on all three targets."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure activation data has been cached by the main app before opening Wallet."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is set to ","type":"text"},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"},{"text":" (not the authorization variant) in the Non-UI Extension.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make sure the "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" matches your handler class name exactly."}]}]}],"type":"unorderedList"},{"anchor":"Authentication-UI-does-not-appear","type":"heading","text":"Authentication UI does not appear","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is set to "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"anchor":"Extension-cannot-access-cached-data","type":"heading","text":"Extension cannot access cached data","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm both the main app and the extension share the same keychain access group."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.security.application-groups","type":"codeVoice"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the "},{"code":"keychainAccessGroup()","type":"codeVoice"},{"type":"text","text":" override returns the correct value."}]}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentatio