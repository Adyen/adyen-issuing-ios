:[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Apple Pay provisioning interface"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":""},{"code":"IssuingCore.xcframework","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" must be embedded in your app for the SDK to function, but you should "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" import them in your code. They are used internally by "},{"code":"NetworkTokenProvisioning","type":"codeVoice"},{"type":"text","text":" and should not be accessed directly."}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Embed the Frameworks","anchor":"Embed-the-Frameworks"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Drag all four "},{"code":".xcframework","type":"codeVoice"},{"type":"text","text":" bundles into your Xcode project navigator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your app target, go to "},{"inlineContent":[{"type":"text","text":"General > Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"IssuingCore.xcf