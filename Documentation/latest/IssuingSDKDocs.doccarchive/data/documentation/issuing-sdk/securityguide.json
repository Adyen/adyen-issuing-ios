{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide"},"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"Security Guide"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Device Unlock Requirement","anchor":"Device-Unlock-Requirement"},{"inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}],"type":"paragraph"},{"syntax":"swift","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".deviceOwnerAuthentication"},{"type":"text","text":" (not "},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"type":"text","text":") so users with a passcode but no biometrics are not locked out."}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"level":2,"type":"heading","text":"Prevent Screen Capture","anchor":"Prevent-Screen-Capture"},{"inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}],"type":"paragraph"},{"syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Protect Sensitive Views in App Switcher","anchor":"Protect-Sensitive-Views-in-App-Switcher"},{"inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}],"type":"paragraph"},{"syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Secure Data Storage","anchor":"Secure-Data-Storage"},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints."}],"type":"paragraph"},{"syntax":"swift","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Handle Sensitive Data in Memory","anchor":"Handle-Sensitive-Data-in-Memory"},{"inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}],"type":"paragraph"},{"syntax":"swift","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Avoid storing sensitive values in "},{"type":"codeVoice","code":"String"},{"type":"text","text":" — prefer "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Secure Networking","anchor":"Secure-Networking"},{"inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" does not weaken App Transport Security:"}],"type":"paragraph"},{"syntax":"xml","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Jailbreak Detection","anchor":"Jailbreak-Detection"},{"inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}],"kind":"content"}],"kind":"article","seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"generated":true,"anchor":"Guides"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/ManualIntegration":{"kind":"article","role":"article","title":"Manual Integration","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","url":"\/documentation\/issuing-sdk\/manualintegration","type":"topic","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}]},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/GettingStarted":{"type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","kind":"article","url":"\/documentation\/issuing-sdk\/gettingstarted","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"title":"Getting Started","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/NetworkTokenProvisioningGuide":{"kind":"article","role":"article","title":"In-App Provisioning","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","url":"\/documentation\/issuing-sdk\/networktokenprovisioningguide","type":"topic","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet from your iOS application."}]},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"type":"topic","kind":"article","role":"collection","url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"Issuing SDK"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/AdditionalResources":{"title":"Additional Resources","type":"topic","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"role":"article","url":"\/documentation\/issuing-sdk\/additionalresources","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources","kind":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/WalletExtensionsGuide":{"kind":"article","role":"article","title":"Wallet Extensions","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","type":"topic","url":"\/documentation\/issuing-sdk\/walletextensionsguide","abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}]}}}