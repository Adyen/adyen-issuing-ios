Your iPhone","type":"text"}]},{"type":"text","text":" section."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"User selects your app","type":"text"}],"type":"strong"},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"text":" — If ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet presents your UI Extension. Your UI Extension calls "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when done."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Provisioning","type":"text"}],"type":"strong"},{"text":" — The SDK handles the provisioning request using the session token from your ","type":"text"},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"type":"text","text":" method."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}],"type":"strong"},{"type":"text","text":"."}]}]}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference.","type":"text"}],"type":"paragraph"}],"style":"note"},{"type":"heading","level":2,"text":"Troubleshooting","anchor":"Troubleshooting"},{"type":"heading","level":3,"text":"App does not appear in Wallet’s “From Apps on Your iPhone”","anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement is present on all three targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure activation data has been cached by the main app before opening Wallet."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is set to ","type":"text"},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"},{"type":"text","text":" (not the authorization variant) in the Non-UI Extension."}]}]},{"content":[{"inlineContent":[{"text":"Make sure the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" matches your handler class name exactly.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Authentication UI does not appear","anchor":"Authentication-UI-does-not-appear"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is set to ","type":"text"},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Extension cannot access cached data","anchor":"Extension-cannot-access-cached-data"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Confirm both the main app and the extension share the same keychain access group.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the ","type":"text"},{"type":"codeVoice","code":"com.apple.security.application-