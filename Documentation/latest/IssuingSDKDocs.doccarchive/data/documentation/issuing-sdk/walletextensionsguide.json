"Add-the-SDK-to-the-Extension-Target","text":"Add the SDK to the Extension Target"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Swift Package Manager:","type":"text"}]}],"type":"paragraph"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"AdyenNetworkTokenProvisioning","type":"codeVoice"},{"type":"text","text":" as a dependency of your extension target, just as you did for the main app."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Manual Integration:"}]}],"type":"paragraph"},{"inlineContent":[{"text":"Embed the same XCFrameworks in the extension target with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":". See "},{"isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","type":"reference"},{"type":"text","text":" for which frameworks are required."}],"type":"paragraph"},{"text":"Step 2: Implement the Non-UI Extension Handler","type":"heading","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler","isActive":true,"type":"reference"},{"text":". This class is your extension’s entry point — its name must match the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" in your ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"type":"codeListing","code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"],"syntax":"swift"},{"anchor":"Required-Overrides","level":3,"type":"heading","text":"Required Overrides"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared keychain group for cached data between app and extension"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Fetch a session token from your backend","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}]}],[{"inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}],"type":"paragraph"}]]]},{"anchor":"Optional-Overrides","level":3,"type":"heading","text":"Optional Overrides"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment()"}],"type":"paragraph"}],[{"inlineContent":[{"code":".live","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the session environment ("},{"type":"codeVoice","code":".test"},{"text":", ","type":"text"},{"type":"codeVoice","code":".live"},{"type":"text","text":")"}]}]]]},{"text":"Step 3: Cache Activation Data in Your Main App","type":"heading","level":2,"anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App"},{"inlineContent":[{"text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section. Make sure the user has opened the provisioning flow in your main app at least once."}]}],"style":"important"},{"type":"heading","level":2,"text":"Step 4: Create the UI Extension Target","anchor":"Step-4-Create-the-UI-Extension-Target"},{"type":"paragraph","inlineContent":[{"text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"text":" template again (e.g., ","type":"text"},{"type":"codeVoice","code":"WalletUIExtension"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"text":"Remove all generated files ","type":"text"},{"type":"strong","inlineContent":[{"text":"except","type":"text"}]},{"text":" ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Update the ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — find the "},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}],"type":"paragraph"}]]],"type":"table","header":"row"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement to this target as well."}]}]}]},{"type":"heading","level":2,"text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","isActive":true,"type":"reference"},{"text":". This view controller is presented by Apple Wallet when authentication is required.","type":"text"}]},{"code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can use UIKit or SwiftUI (via ","type":"text"},{"type":"codeVoice","code":"UIHostingController"},{"text":") for the authentication UI. The key requirement is calling ","type":"text"},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when the user finishes authenticating.","type":"text"}]},{"type":"heading","level":3,"text":"Using SwiftUI","anchor":"Using-SwiftUI"},{"code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Entitlements Summary","anchor":"Entitlements-Summary"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access."}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Entitlement"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Main App"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-UI Extension