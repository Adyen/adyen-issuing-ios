{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Network Token Provisioning","type":"text"}],"type":"strong"},{"type":"text","text":" — Add payment cards to Apple Wallet"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"PIN & PAN Reveal","type":"text"}],"type":"strong"},{"type":"text","text":" — Securely display card details "},{"inlineContent":[{"text":"(coming soon)","type":"text"}],"type":"emphasis"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"level":2,"anchor":"Prerequisites","text":"Prerequisites","type":"heading"},{"inlineContent":[{"type":"text","text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"},{"level":2,"anchor":"Embed-the-Certificate","text":"Embed the Certificate","type":"heading"},{"inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}],"type":"paragraph"},{"level":2,"anchor":"Fetch-a-Session-Token","text":"Fetch a Session Token","type":"heading"},{"inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Perform a ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" request to the following endpoint:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"URL:"}]},{"text":" ","type":"text"},{"code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Headers:"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Content-Type: application\/json"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Body:","type":"text"}]}],"type":"paragraph"},{"code":["{","    \"allowOrigin\": \"https:\/\/www.adyen.com\",","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"],"syntax":"json","type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The required ","type":"text"},{"code":"roles","type":"codeVoice"},{"text":" depend on the SDK feature you are using. See the feature-specific documentation for details.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Your backend should receive the session token and pass it to your iOS application."}],"type":"paragraph"},{"level":2,"anchor":"Import-the-SDK","text":"Import the SDK","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the appropriate import statement at the top of your Swift files."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Swift Package Manager:","type":"text"}]}],"type":"paragraph"},{"code":["import AdyenNetworkTokenProvisioning"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This single import gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ConfigurationParameters"},{"type":"text","text":", and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual Integration (XCFrameworks):","type":"text"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you embedded the XCFrameworks directly, import the individual modules:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"text":" directly. It is an internal dependency that is required at link time but has no public API for integrators.","type":"text"}]}],"type":"aside","name":"Note"},{"anchor":"Implement-a-Token-Provider","text":"Implement a Token Provider","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}]},{"code":["import AdyenNetworkTokenProvisioning","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing","syntax":"swift"},{"text":"Device Testing Requirements","type":"heading","l