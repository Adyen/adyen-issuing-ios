{"metadata":{"role":"article","title":"Security Guide","roleHeading":"Article"},"sections":[],"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/SecurityGuide"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}]},{"anchor":"Device-Unlock-Requirement","level":2,"type":"heading","text":"Device Unlock Requirement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}]},{"code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"text":" (not ","type":"text"},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"anchor":"Prevent-Screen-Capture","level":2,"type":"heading","text":"Prevent Screen Capture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}]},{"code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Protect-Sensitive-Views-in-App-Switcher","level":2,"type":"heading","text":"Protect Sensitive Views in App Switcher"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}]},{"code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Secure-Data-Storage","level":2,"type":"heading","text":"Secure Data Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints."}]},{"code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}]},{"anchor":"Handle-Sensitive-Data-in-Memory","level":2,"type":"heading","text":"Handle Sensitive Data in Memory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}]},{"code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid storing sensitive values in "},{"type":"codeVoice","code":"String"},{"type":"text","text":" — prefer "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}]},{"anchor":"Secure-Networking","level":2,"type":"heading","text":"Secure Networking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" does not weaken App Transport Security:"}]},{"code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}]},{"anchor":"Jailbreak-Detection","level":2,"type":"heading","text":"Jailbreak Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}]},{"content":[{"inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}]}],"seeAlsoSections":[{"anchor":"Guides","generated":true,"identifiers":["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources"],"title":"Guides"}],"kind":"article","references":{"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/NetworkTokenProvisioningGuide":{"abstract":[{"text":"Add payment cards to Apple Wallet from your iOS application.","type":"text"}],"role":"article","title":"In-App Provisioning","url":"\/documentation\/networktokenprovisioning\/networktokenprovisioningguide","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","type":"topic","kind":"article"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/WalletExtensionsGuide":{"role":"article","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","type":"topic","abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}],"url":"\/documentation\/networktokenprovisioning\/walletextensionsguide","title":"Wallet Extensions","kind":"article"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/AdditionalResources":{"role":"article","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources","type":"topic","title":"Additional Resources","url":"\/documentation\/networktokenprovisioning\/additionalresources","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"kind":"article"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/GettingStarted":{"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"role":"article","title":"Getting Started","url":"\/documentation\/networktokenprovisioning\/gettingstarted","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","type":"topic","kind":"article"},"doc://com.adyen.NetworkTokenProvisioning/documentation/IssuingSDKDocs":{"role":"collection","title":"Issuing SDK","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"kind":"article","url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs","type":"topic"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/ManualIntegration":{"role":"article","title":"Manual Integration","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}],"type":"topic","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","url":"\/documentation\/networktokenprovisioning\/manualintegration","kind":"article"}}}