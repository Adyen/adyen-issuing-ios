blic types, including ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"code":"ProvisioningSession","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"type":"aside"},{"text":"Implement a Token Provider","level":2,"anchor":"Implement-a-Token-Provider","type":"heading"},{"inlineContent":[{"text":"Your app needs an object that conforms to the ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}],"type":"paragraph"},{"syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing"},{"type":"heading","text":"Device Testing Requirements","anchor":"Device-Testing-Requirements","level":2},{"type":"paragraph","inlineContent":[{"text":"The SDK requires a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Release build on a physical device"}]},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}]},{"anchor":"Ne