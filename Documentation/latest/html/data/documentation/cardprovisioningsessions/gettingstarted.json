{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"sections":[],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}],"type":"strong"},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Card Sessions","type":"text"}],"type":"strong"},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This guide covers the common setup steps required for all SDK features.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Prerequisites","text":"Prerequisites"},{"inlineContent":[{"text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Embed-the-Certificate","text":"Embed the Certificate"},{"inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Fetch-a-Session-Token","text":"Fetch a Session Token"},{"inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Perform a ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" request to the following endpoint:","type":"text"}],"type":"paragraph"},{"type":"t