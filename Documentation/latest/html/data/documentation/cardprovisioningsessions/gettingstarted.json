{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Card Provisioning Sessions"}],"type":"strong"},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Card Sessions","type":"text"}],"type":"strong"},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}]},{"text":"Requirements","anchor":"Requirements","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 16.0+"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift 5.9+"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Xcode 16+","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.adyen.com\/issuing"},{"type":"text","text":" integration on your backend"}],"type":"paragraph"}]}]},{"level":2,"text":"Prerequisites","anchor":"Prerequisites","type":"heading"},{"inlineContent":[{"text":"Before you begin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Obtain a certificate from Adyen. This certificate is required to initialize the SDK."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"type":"text","text":"App Attest"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"type":"text","text":") to your app:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Set to "},{"type":"codeVoice","code":"\"development\""},{"type":"text","text":" for testing. Use "},{"type":"codeVoice","code":"SessionEnvironment.test"},{"type":"text","text":". Card operations work fully, but the provisioning flow is limited."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set to "},{"type":"codeVoice","code":"\"production\""},{"text":" for production. Use ","type":"text"},{"code":"SessionEnvironment.live","type":"codeVoice"},{"text":". The full provisioning flow requires an App Store or TestFlight build.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"TestFlight builds automatically set the App Attest environment to "},{"code":"\"production\"","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"level":2,"anchor":"Embed-the-Certificate","type":"heading","text":"Embed the Certificate"},{"inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Fetch-a-Session-Token","type":"heading","text":"Fetch a Session Token"},{"inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Perform a ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" request to the following endpoint:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Environment","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"URL","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[