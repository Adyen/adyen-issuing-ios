{"sections":[],"kind":"article","metadata":{"title":"A Starting Guide (Sessions)","role":"article","roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Sessions","type":"text"}]},{"text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"text":"Prerequisites","level":2,"anchor":"Prerequisites","type":"heading"},{"inlineContent":[{"type":"text","text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"},{"text":"Embed the Certificate","level":2,"anchor":"Embed-the-Certificate","type":"heading"},{"inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}],"type":"paragraph"},{"text":"Fetch a Session Token","level":2,"anchor":"Fetch-a-Session-Token","type":"heading"},{"inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following 