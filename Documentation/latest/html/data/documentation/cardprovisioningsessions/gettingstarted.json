or":"Import-the-SDK"},{"inlineContent":[{"type":"text","text":"Add the appropriate import statements at the top of your Swift files:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import IssuingCommon"]},{"inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"type":"aside","style":"note"},{"type":"heading","level":2,"text":"Implement a Token Provider","anchor":"Implement-a-Token-Provider"},{"inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"type":"heading","level":2,"text":"Device Testing Requirements","anchor":"Device-Testing-Requirements"},{"inlineContent":[{"type":"text","text":"The SDK requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"Release build on a physical device"}]},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Next Steps","anchor":"Next-Steps"},{"inlineContent":[{"type":"text","text":"Once you have completed the common setup, proceed to the feature-specific guide:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningGuide"},{"type":"text","text":" — Understand the two provisioning approaches and choose the right one for your architecture"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide"},{"type":"text","text":" — Add cards to Apple Wallet using the session-based API (recommended)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/OfflineProvisioningGuide"},{"type":"text","text":" — Add cards to Apple Wallet with direct control over each provisioning step"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},{"type":"text","text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)"}]}]}]}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"metadata":{"title":"A Starting Guide (Sessio