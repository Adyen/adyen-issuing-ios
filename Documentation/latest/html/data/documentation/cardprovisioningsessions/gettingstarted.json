{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card Provisioning Sessions"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Card Sessions","type":"text"}],"type":"strong"},{"text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This guide covers the common setup steps required for all SDK features.","type":"text"}]},{"level":2,"text":"Requirements","anchor":"Requirements","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"iOS 16.0+"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Swift 5.9+"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Xcode 16+","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"https:\/\/www.adyen.com\/issuing","type":"reference","isActive":true},{"text":" integration on your backend","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Prerequisites","level":2,"anchor":"Prerequisites"},{"type":"paragraph","inlineContent":[{"text":"Before you begin:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"inlineContent":[{"type":"text","text":"App Attest"}],"type":"strong"},{"text":" entitlement (","type":"text"},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"type":"text","text":") to your app:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Set to "},{"type":"codeVoice","code":"\"development\""},{"type":"text","text":" for testing. Use "},{"type":"codeVoice","code":"SessionEnvironment.test"},{"text":". Card operations work fully, but the provisioning flow is limited.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set to "},{"type":"codeVoice","code":"\"production\""},{"type":"text","text":" for production. Use "},{"type":"codeVoice","code":"SessionEnvironment.live"},{"text":". The full provisioning flow requires an App Store or TestFlight build.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"TestFlight builds automatically set the App Attest environment to ","type":"text"},{"code":"\"production\"","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"anchor":"Embed-the-Certificate","type":"heading","level":2,"text":"Embed the Certificate"},{"type":"paragraph","inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}]},{"level":2,"type":"heading","text":"Fetch a Session Token","anchor":"Fetch-a-Session-Token"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}]},{"header":"row","rows":[[[{"inlineContent":[{"text":"Environment","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"URL"}]}]],[[{"type":"paragraph",