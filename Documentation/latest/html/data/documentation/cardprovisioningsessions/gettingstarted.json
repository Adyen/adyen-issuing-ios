cess to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"style":"note"},{"anchor":"Implement-a-Token-Provider","type":"heading","text":"Implement a Token Provider","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"type":"heading","text":"Device Testing Requirements","anchor":"Device-Testing-Requirements","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"Release build on a physical device"}]},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}]},{"type":"head