{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card Sessions"}]},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}]},{"type":"heading","anchor":"Requirements","level":2,"text":"Requirements"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 16.0+"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift 5.9+"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Xcode 16+"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"https:\/\/www.adyen.com\/issuing","type":"reference","isActive":true},{"text":" integration on your backend","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Prerequisites","text":"Prerequisites"},{"type":"paragraph","inlineContent":[{"text":"Before you begin:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"App Attest"}]},{"type":"text","text":" entitlement ("},{"code":"com.apple.developer.devicecheck.appattest-environment","type":"codeVoice"},{"type":"text","text":") to your app:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Set to ","type":"text"},{"code":"\"development\"","type":"codeVoice"},{"type":"text","text":" for testing. Use "},{"code":"SessionEnvironment.test","type":"codeVoice"},{"type":"text","text":". Card operations work fully, but the provisioning flow is limited."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Set to ","type":"text"},{"code":"\"production\"","type":"codeVoice"},{"text":" for production. Use ","type":"text"},{"code":"SessionEnvironment.live","type":"codeVoice"},{"type":"text","text":". The full provisioning flow requires an App Store or TestFlight build."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"TestFlight builds automatically set the App Attest environment to ","type":"text"},{"type":"codeVoice","code":"\"production\""},{"type":"text","text":"."}]}]}]}]}]},{"level":2,"type":"heading","anchor":"Embed-the-Certificate","text":"Embed the Certificate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}]},{"level":2,"type":"heading","anchor":"Fetch-a-Session-Token","text":"Fetch a Session Token"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}]},{"type":"paragraph","inlineContent":[{"text":"Perform a ","type":"text"},{"code":"POST","type":"codeVoice"},{"text":" request to the following endpoint:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Environment","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"URL","type":"text"}]}]],[[{"type":"paragraph",