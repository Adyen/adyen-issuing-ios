],"type":"paragraph"},{"syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"style":"note","type":"aside"},{"anchor":"Implement-a-Token-Provider","level":2,"text":"Implement a Token Provider","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}]},{"type":"codeListing","syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"type":"heading","anchor":"Device-Testing-Requirements","level":2,"text":"Device Testing Requirements"},{"inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Next-Steps","text":"Next Steps"},{"inlineContent":[{"type":"text","text":"Once you have completed the common setup, proceed to the feature-specific guide:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningGuide","isActive":true},{"text":" — Understand the two provisioning approaches and choose the right one for your architecture","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide","isActive":true},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/OfflineProvisioningGuide","isActive":true,"type":"reference"},{"type":"text","text":" — Add cards to Apple Wallet with direct control over each provisioning step"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","isActive":true,"type":"reference"},{"type":"text","text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"A Starting Guide (Sessions)","role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\