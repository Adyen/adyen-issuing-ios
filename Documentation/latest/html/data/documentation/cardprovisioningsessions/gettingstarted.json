tatements at the top of your Swift files:"}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"style":"note","type":"aside"},{"text":"Implement a Token Provider","level":2,"anchor":"Implement-a-Token-Provider","type":"heading"},{"inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}],"type":"paragraph"},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"syntax":"swift","type":"codeListing"},{"text":"Device Testing Requirements","level":2,"anchor":"Device-Testing-Requirements","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"Release build on a physical device"}]},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}],"type":"paragraph"},{"text":"Next Steps","level":2,"anchor":"Next-Steps","type":"heading"},{"inlineContent":[{"type":"text","text":"Once you have completed the common setup, proceed to the feature-specific guide:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningGuide","isActive":true},{"text":" — Understand the two provisioning approaches and choose the right one for your architecture","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide","isActive":true},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/OfflineProvisioningGuide","isActive":true},{"text":" — Add cards to Apple Wallet with direct control over each provisioning step","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","isActive":true},{"text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","interfaceLanguage":"swift"},"hierar