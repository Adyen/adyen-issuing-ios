top of your Swift files:","type":"text"}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This gives you access to all public types, including ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}],"type":"paragraph"}]},{"text":"Implement a Token Provider","type":"heading","anchor":"Implement-a-Token-Provider","level":2},{"inlineContent":[{"text":"Your app needs an object that conforms to the ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}],"type":"paragraph"},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing","syntax":"swift"},{"text":"Device Testing Requirements","type":"heading","anchor":"Device-Testing-Requirements","level":2},{"inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"text":" for full end-to-end functionality. Use Test