c types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"type":"aside"},{"text":"Implement a Token Provider","level":2,"type":"heading","anchor":"Implement-a-Token-Provider"},{"inlineContent":[{"text":"Your app needs an object that conforms to the ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing"},{"text":"Device Testing Requirements","level":2,"type":"heading","anchor":"Device-Testing-Requirements"},{"inlineContent":[{"type":"text","text":"The SDK requires a "},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}],"type":"paragraph"},{"text":"Next Steps","level":2