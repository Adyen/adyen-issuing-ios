","import IssuingCommon"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"code":"TokenProviding","type":"codeVoice"},{"type":"text","text":", "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":", and "},{"code":"ProvisioningSession","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"text":"Implement a Token Provider","level":2,"anchor":"Implement-a-Token-Provider","type":"heading"},{"inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"code":"TokenProviding","type":"codeVoice"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}],"type":"paragraph"},{"syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing"},{"text":"Device Testing Requirements","level":2,"anchor":"Device-Testing-Requirements","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK requires a "},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}],"type":"paragraph"},{"level":2,"anchor":"Next-Steps","type":"heading","text":"Next Steps"},{"type":"paragraph","inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningGuide","type":"reference"},{"text":" — Understand the two provisioning approaches and choose the right one for your architecture","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide","isActive":true,"type":"reference"},{"type":"text","text":" — Add cards to Apple Wallet using the session-based API (recommended)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/OfflineProvisioningGuide","type":"reference"},{"text":" — Add cards to Apple Wallet with direct control over each provisioning step","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},{"type":"text","text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","title":"Issuing SDK","role":"collection","url":"\/