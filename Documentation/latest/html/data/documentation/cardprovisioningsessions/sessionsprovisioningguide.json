{"sections":[],"abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide"},"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Card Provisioning Sessions"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"code":"CardProvisioningSessions","type":"codeVoice"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},{"type":"text","text":" before proceeding."}]}],"name":"Important","style":"important","type":"aside"},{"level":2,"type":"heading","text":"Import","anchor":"Import"},{"syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing"},{"level":2,"text":"Session Token Role","anchor":"Session-Token-Role","type":"heading"},{"inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}],"type":"paragraph"},{"code":["\"roles\": [\"Network Token: Create\"]"],"syntax":"json","type":"codeListing"},{"type":"heading","level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"type":"text","text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment."}]},{"syntax":"swift","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"level":2,"text":"Initialize a Provisioning Session","anchor":"Initialize-a-Provisioning-Session","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":"."}]},{"code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Check the Provisioning State","anchor":"Check-the-Provisioning-State"},{"inlineContent":[{"type":"text","text":"Before showing the "},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"type":"text","text":" button, check the current provisioning state for the payment instrument."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"]},{"level":2,"type":"heading","text":"Provision the Card","anchor":"Provision-the-Card"},{"inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"type":"text","text":", present the native Wallet sheet:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"]},{"type":"heading","level":2,"anchor":"Handle-the-Result","text":"Handle the Result"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provision(paymentInstrumentId:viewController:)"},{"type":"text","text":" returns a "},{"code":"CardActivationState","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"type":"codeListing"},{"text":"Wallet Extension","anchor":"Wallet-Extension","type":"heading","level":2},{"inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":" section."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}]},{"level":3,"type":"heading","text":"Prerequisites","anchor":"Prerequisites"},{"items":[{"content":[{"inlineContent":[{"text":"In-app provisioning must be working first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" you passed to "},{"code":"Configuration","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"orderedList"},{"level":3,"type":"heading","text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}]}]]],"header":"row"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":" (e.g., "},{"type":"codeVoice","code":"[TeamId].com.yourcompany.shared"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":". The class name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"]},{"type":"heading","text":"Required Overrides","level":4,"anchor":"Required-Overrides"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fetch a session token from your backend","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}]}]]]},{"type":"heading","text":"Optional Overrides","level":4,"anchor":"Optional-Overrides"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Override to use ","type":"text"},{"code":".test","type":"codeVoice"},{"text":" environment","type":"text"}]}]]]},{"type":"heading","text":"Step 3: Ensure Activation Data Is Cached","level":3,"anchor":"Step-3-Ensure-Activation-Data-Is-Cached"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK caches activation data in the shared keychain automatically when you call "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" in the main app with a "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section."}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The user must open the provisioning flow in your main app at least once before the extension can show cards.","type":"text"}]}]},{"type":"heading","text":"Step 4: Create the UI Extension Target (Optional)","level":3,"anchor":"Step-4-Create-the-UI-Extension-Target-Optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"type":"text","text":" and select "},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", set:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}],"type":"paragraph"}]]],"header":"row","type":"table"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]}]},{"type":"heading","text":"Step 5: Implement the UI Extension Handler","level":3,"anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"code":"WalletExtensionUIHandler","type":"codeVoice"},{"type":"text","text":". Build your authentication UI inside the initializer and call "},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"type":"text","text":" when the user finishes."}]},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI is also supported via "},{"code":"UIHostingController","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Entitlements Summary","level":3,"anchor":"Entitlements-Summary"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entitlement","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Main App","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Non-UI Extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"UI Extension","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"—","type":"text"}]}]]]},{"type":"heading","text":"How the Extension Flow Works","level":3,"anchor":"How-the-Extension-Flow-Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"User opens Apple Wallet"}],"type":"strong"},{"type":"text","text":" — the SDK reads cached activation data to determine available cards. Your app appears in "},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"User selects a card"}],"type":"strong"},{"type":"text","text":" — card art from "},{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"},{"type":"text","text":" is shown."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"strong"},{"type":"text","text":" — if "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", your UI Extension is presented."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Provisioning"}],"type":"strong"},{"type":"text","text":" — the SDK fetches a fresh session token via "},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"type":"text","text":" and completes provisioning."}],"type":"paragraph"}]}]},{"type":"heading","text":"Troubleshooting","level":3,"anchor":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"App does not appear in Wallet’s “From Apps on Your iPhone”:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement is present on all targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" has been called in the main app at least once so activation data is cached."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" matches your class name exactly."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication UI does not appear:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Extension cannot read cached data:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" return value matches the "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" used in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"inlineContent":[{"type":"text","text":"Keychain Sharing"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier."}],"type":"paragraph"}]}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card provisioning requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" and a supported distribution build (TestFlight or App Store) using the "},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"type":"text","text":" environment. The Simulator is not supported for provisioning."}]}]}],"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"seeAlsoSections":[{"title":"Card Provisioning","anchor":"Card-Provisioning","generated":true,"identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningGuide","doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/OfflineProvisioningGuide"]}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","kind":"article","role":"article","type":"topic","title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/CardProvisioningGuide":{"type":"topic","kind":"article","title":"Card Provisioning","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet from your iOS application."}],"url":"\/documentation\/cardprovisioningse