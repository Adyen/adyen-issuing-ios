{"kind":"article","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},{"type":"text","text":" before proceeding."}]}],"style":"important"},{"level":2,"type":"heading","anchor":"Import","text":"Import"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"level":2,"type":"heading","anchor":"Session-Token-Role","text":"Session Token Role"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [\"Network Token: Create\"]"]},{"level":2,"type":"heading","anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}]}],"name":"Note","style":"note"},{"type":"heading","level":2,"text":"Initialize a Provisioning Session","anchor":"Initialize-a-Provisioning-Session"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":"."}]},{"type":"codeListing","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"syntax":"swift"},{"type":"heading","text":"Check the Provisioning State","level":2,"anchor":"Check-the-Provisioning-State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before showing the "},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"type":"text","text":" button, check the current provisioning state for the payment instrument."}]},{"type":"codeListing","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"],"syntax":"swift"},{"type":"heading","text":"Provision the Card","level":2,"anchor":"Provision-the-Card"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the cardholder taps "},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":", present the native Wallet sheet:","type":"text"}]},{"code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Handle-the-Result","text":"Handle the Result","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"provision(paymentInstrumentId:viewController:)"},{"type":"text","text":" returns a "},{"type":"codeVoice","code":"CardActivationState"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"anchor":"Wallet-Extension","text":"Wallet Extension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"text":" section.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The Sessions approach provides a high-level base class, "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":", that handles the full extension flow. You subclass it and override a small set of methods."}],"type":"paragraph"},{"level":3,"anchor":"Prerequisites","text":"Prerequisites","type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A shared keychain access group must be configured (the same "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" you passed to "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}]}]}]},{"level":3,"type":"heading","text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}]}]]],"header":"row"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"text":" entitlement (","type":"text"},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":" (e.g., "},{"code":"[TeamId].com.yourcompany.shared","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}]}]}]},{"level":3,"type":"heading","text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"]},{"type":"heading","text":"Required Overrides","level":4,"anchor":"Required-Overrides"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared keychain group for activation data cached by the main app"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}]}]]]},{"type":"heading","level":4,"anchor":"Optional-Overrides","text":"Optional Overrides"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"inlineContent":[{"type":"text","text":"Default"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":".live"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Override to use ","type":"text"},{"type":"codeVoice","code":