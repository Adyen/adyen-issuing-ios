{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SessionsProvisioningGuide"},"metadata":{"roleHeading":"Article","title":"Card Provisioning Sessions","role":"article"},"sections":[],"seeAlsoSections":[{"title":"Card Provisioning","generated":true,"anchor":"Card-Provisioning","identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardProvisioningGuide","doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/OfflineProvisioningGuide"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Sessions approach uses the ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","type":"reference"},{"type":"text","text":" before proceeding."}]}],"style":"important"},{"type":"heading","text":"Import","level":2,"anchor":"Import"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"level":2,"anchor":"Session-Token-Role","text":"Session Token Role","type":"heading"},{"inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}],"type":"paragraph"},{"type":"codeListing","code":["\"roles\": [\"Network Token: Create\"]"],"syntax":"json"},{"text":"Create a Configuration Object","type":"heading","level":2,"anchor":"Create-a-Configuration-Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}]},{"type":"codeListing","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift"},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below.","type":"text"}]}],"style":"note"},{"type":"heading","text":"Initialize a Provisioning Session","level":2,"anchor":"Initialize-a-Provisioning-Session"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":"."}]},{"code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Check-the-Provisioning-State","type":"heading","text":"Check the Provisioning State","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before showing the "},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"type":"text","text":" button, check the current provisioning state for the payment instrument."}]},{"code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Log reason for diagnostics, and map it to your own","    \/\/ copy for anything the cardholder sees.","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Provision-the-Card","type":"heading","text":"Provision the Card","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the cardholder taps "},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"type":"text","text":", present the native Wallet sheet:"}]},{"code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ The cardholder or the system dismissed the Apple Pay sheet.","    \/\/ This is not a failure, so leave your UI unchanged.","} catch {","    \/\/ Handle provisioning error","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Handle-the-Result","type":"heading","text":"Handle the Result","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provision(paymentInstrumentId:viewController:)"},{"type":"text","text":" returns a "},{"type":"codeVoice","code":"CardActivationState"},{"type":"text","text":":"}]},{"code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Error-Handling","type":"heading","text":"Error Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All session operations throw "},{"type":"codeVoice","code":"CardProvisioningSessionError"},{"type":"text","text":"."}]},{"anchor":"Match-a-single-case","type":"heading","text":"Match a single case","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The error type supports pattern matching, so you can catch one case directly without casting."},{"type":"text","text":" "},{"type":"text","text":"Matching compares the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"type":"text","text":" "},{"type":"text","text":"underlying cause:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await provisioningSession.configure()","} catch CardProvisioningSessionError.couldNotEstablishSession {","    \/\/ Check connectivity and the session token, then retry.","} catch {","    \/\/ Handle everything else.","}"]},{"level":3,"anchor":"Handle-cancellation-gracefully","type":"heading","text":"Handle cancellation gracefully"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provisioningCancelled"},{"type":"text","text":" reports that the Apple Pay sheet was dismissed by the cardholder or by"},{"type":"text","text":" "},{"type":"text","text":"the system. Nothing was provisioned and nothing failed, so treat it as a normal outcome. Do not"},{"type":"text","text":" "},{"type":"text","text":"present it as an error:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    _ = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ Expected when the cardholder taps Cancel. Leave the UI as it was.","} catch {","    \/\/ Log the error for diagnostics, and show your own copy to the cardholder.","    print(error)","    showAlert(yourMessage(for: error))","}"]},{"anchor":"Branch-across-several-cases","type":"heading","text":"Branch across several cases","level":3},{"type":"paragraph","inlineContent":[{"text":"To handle several failures at once, switch over ","type":"text"},{"code":"code","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Code","type":"codeVoice"},{"text":" is non-exhaustive, so always","type":"text"},{"text":" ","type":"text"},{"text":"include a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" case to stay forward compatible with future SDK versions:","type":"text"}]},{"code":["do {","    try await provisioningSession.configure()","} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .noPaymentInstrumentsProvided:","        \/\/ `paymentInstrumentIds` in the configuration was empty.","        break","    case .noKeychainGroupIdProvided:","        \/\/ `keychainAccessGroup` was empty.","        break","    case .couldNotEstablishSession:","        \/\/ Network or authentication failure.","        break","    case .activationDataUnavailable:","        \/\/ Activation data could not be fetched or cached.","        break","    case .provisioningAlreadyInProgress:","        \/\/ A provisioning flow is already running for this payment instrument.","        break","    case .provisioningCancelled:","        \/\/ Dismissed by the cardholder or the system. Not a failure.","        break","    case .provisioningFailed:","        \/\/ PassKit or the provisioning infrastructure reported a failure.","        break","    default:","        break","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Logging","type":"heading","text":"Logging","level":3},{"type":"paragraph","inlineContent":[{"code":"CardProvisioningSessionError","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":", so log the error itself:","type":"text"}]},{"code":["print(error)","\/\/ CardProvisioningSessionError.couldNotEstablishSession: deviceRegistration, serverHTTPError. Trace: 00-abc..."],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Where the failure came from a network call, ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" includes the trace identifier Adyen","type":"text"},{"text":" ","type":"text"},{"text":"support needs to correlate the request. Where it came from PassKit, it includes that error’s","type":"text"},{"text":" ","type":"text"},{"text":"domain and code. It never contains card data or session tokens, so it is safe to log.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Avoid logging ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":". It carries no diagnostic detail, so the trace identifier is","type":"text"},{"text":" ","type":"text"},{"text":"lost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"localizedDescription","type":"codeVoice"},{"text":" is deliberately short because errors are commonly passed straight to the","type":"text"},{"text":" ","type":"text"},{"text":"UI, but it is not meant for display either: the text is English and is not localized. Map ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to your own copy for anything the cardholder sees.","type":"text"}]},{"anchor":"Wallet-Extension","type":"heading","text":"Wallet Extension","level":2},{"type":"paragraph","inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"text":" section.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}]},{"anchor":"Prerequisites","type":"heading","text":"Prerequisites","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A shared keychain access group must be configured (the same "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" you passed to "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Step-1-Create-the-Non-UI-Extension-Target","type":"heading","text":"Step 1: Create the Non-UI Extension Target","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}]}]]],"type":"table","header":"row"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":" (e.g., "},{"type":"codeVoice","code":"[TeamId].com.yourcompany.shared"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","type":"heading","text":"Step 2: Implement the Non-UI Extension Handler","level":3},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":". The class name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Required-Overrides","type":"heading","text":"Required Overrides","level":4},{"header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":4,"anchor":"Optional-Overrides","type":"heading","text":"Optional Overrides"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"inlineContent":[{"code":".live","typ