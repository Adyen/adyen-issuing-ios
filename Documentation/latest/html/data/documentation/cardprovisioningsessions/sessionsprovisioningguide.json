has been called in the main app at least once so activation data is cached.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" matches your class name exactly.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication UI does not appear:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Extension cannot read cached data:","type":"text"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" return value matches the "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" used in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier."}],"type":"paragraph"}]}]},{"anchor":"Testing","text