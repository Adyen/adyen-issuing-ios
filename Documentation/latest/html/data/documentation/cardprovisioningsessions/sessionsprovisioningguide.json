":"text"}]}]],[[{"inlineContent":[{"code":"environment()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":".live","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Override to use "},{"type":"codeVoice","code":".test"},{"type":"text","text":" environment"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","level":3,"text":"Step 3: Ensure Activation Data Is Cached","anchor":"Step-3-Ensure-Activation-Data-Is-Cached"},{"type":"paragraph","inlineContent":[{"text":"The SDK caches activation data in the shared keychain automatically when you call ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":" in the main app with a ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"text":" section.","type":"text"}]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"The user must open the provisioning flow in your main app at least once before the extension can show cards.","type":"text"}]}]},{"text":"Step 4: Create the UI Extension Target (Optional)","anchor":"Step-4-Create-the-UI-Extension-Target-Optional","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", set:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}]}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}]}]]]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Step-5-Implement-the-UI-Extension-Handler","level":3,"type":"heading","text":"Step 5: Implement the UI Extension Handler"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionUIHandler"},{"type":"text","text":". Build your authentication UI inside the initializer and call "},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"type":"text","text":" when the user finishes."}],"type":"paragraph"},{"type":"codeListing","code":["import CardProvisioningSessions","impor