graph","inlineContent":[{"code":"provisioningCancelled","type":"codeVoice"},{"type":"text","text":" reports that the Apple Pay sheet was dismissed by the cardholder or by"},{"type":"text","text":" "},{"text":"the system. Nothing was provisioned and nothing failed, so treat it as a normal outcome. Do not","type":"text"},{"text":" ","type":"text"},{"text":"present it as an error:","type":"text"}]},{"code":["do {","    _ = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ Expected when the cardholder taps Cancel. Leave the UI as it was.","} catch {","    \/\/ Log the error for diagnostics, and show your own copy to the cardholder.","    print(error)","    showAlert(yourMessage(for: error))","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Branch across several cases","anchor":"Branch-across-several-cases","level":3},{"type":"paragraph","inlineContent":[{"text":"To handle several failures at once, switch over ","type":"text"},{"type":"codeVoice","code":"code"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Code"},{"text":" is non-exhaustive, so always","type":"text"},{"text":" ","type":"text"},{"text":"include a ","type":"text"},{"type":"codeVoice","code":"default"},{"text":" case to stay forward compatible with future SDK versions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await provisioningSession.configure()","} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .noPaymentInstrumentsProvided:","        \/\/ `paymentInstrumentIds` in the configuration was empty.","        break","    case .noKeychainGroupIdProvided:","        \/\/ `keychainAccessGroup` was empty.","        break","    case .couldNotEstablishSession:","        \/\/ Network or authentication failure.","        break","    case .activatio