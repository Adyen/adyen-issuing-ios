{"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"kind":"article","seeAlsoSections":[{"title":"Resources","anchor":"Resources","identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources"],"generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Security Guide","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}]},{"level":2,"text":"Device Unlock Requirement","type":"heading","anchor":"Device-Unlock-Requirement"},{"type":"paragraph","inlineContent":[{"text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}],"type":"paragraph"}]},{"anchor":"Prevent-Screen-Capture","level":2,"text":"Prevent Screen Capture","type":"heading"},{"inlineContent":[{"text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"]},{"text":"Protect Sensitive Views in App Switcher","type":"heading","level":2,"anchor":"Protect-Sensitive-Views-in-App-Switcher"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}]},{"syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Secure Data Storage","anchor":"Secure-Data-Storage"},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"type":"codeVoice","code":"UserDefaults"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"]},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup.","type":"text"}],"type":"paragraph"},{"text":"Handle Sensitive Data in Memory","level":2,"type":"heading","anchor":"Handle-Sensitive-Data-in-Memory"},{"inlineContent":[{"text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"type":"codeVoice","code":"String"},{"type":"text","text":" — prefer "},{"code":"Data","type":"codeVoice"},{"text":" so you control the lifecycle. Never log sensitive values.","type":"text"}]},{"text":"Secure Networking","type":"heading","level":2,"anchor":"Secure-Networking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"type":"codeVoice","code":"Info.plist"},{"text":" does not weaken App Transport Security:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"text":"For additional protection, implement certificate pinning on your ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":" to prevent man-in-the-middle attacks on your own backend endpoints.","type":"text"}]},{"type":"heading","level":2,"text":"Jailbreak Detection","anchor":"Jailbreak-Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}]}],"type":"aside","style":"note","name":"Note"}]}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"type":"topic","url":"\/documentation\/issuingsdkdocs","kind":"article","role":"collection","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"title":"Issuing SDK","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/AdditionalResources":{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"title":"Resources","type":"topic","kind":"article","role":"article","url":"\/documentation\/cardprovisioningsessions\/additionalresources"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/ManualIntegration":{"type":"topic","url":"\/documentation\/cardprovisioningsessions\/manualintegration","abstract":[{"text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project.","type":"text"}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","role":"article","kind":"article","title":"Manual Integration"}}}