{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Device-Unlock-Requirement","text":"Device Unlock Requirement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}]},{"code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"],"type":"codeListing","syntax":"swift"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"type":"text","text":" (not "},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"type":"text","text":") so users with a passcode but no biometrics are not locked out."}]}],"type":"aside"},{"level":2,"anchor":"Prevent-Screen-Capture","type":"heading","text":"Prevent Screen Capture"},{"inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"]},{"level":2,"anchor":"Protect-Sensitive-Views-in-App-Switcher","type":"heading","text":"Protect Sensitive Views in App Switcher"},{"inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"]},{"level":2,"anchor":"Secure-Data-Storage","type":"heading","text":"Secure Data Storage"},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"]},{"inlineContent":[{"type":"text","text":"Use "},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}],"type":"paragraph"},{"level":2,"anchor":"Handle-Sensitive-Data-in-Memory","type":"heading","text":"Handle Sensitive Data in Memory"},{"inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"]},{"inlineContent":[{"type":"text","text":"Avoid storing sensitive values in "},{"code":"String","type":"codeVoice"},{"type":"text","text":" — prefer "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}],"type":"paragraph"},{"level":2,"anchor":"Secure-Networking","type":"heading","text":"Secure Networking"},{"inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" does not weaken App Transport Security:"}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"]},{"inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}],"type":"paragraph"},{"level":2,"anchor":"Jailbreak-Detection","type":"heading","text":"Jailbreak Detection"},{"inlineContent":[{"type":"text","text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}]}],"type":"aside"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Security Guide"},"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources"],"anchor":"Resources","generated":true,"title":"Resources"}],"sections":[],"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"type":"topic","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","role":"collection","title":"Issuing SDK"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/AdditionalResources":{"title":"Resources","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources","kind":"article","url":"\/documentation\/cardprovisioningsessions\/additionalresources","role":"article","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"type":"topic"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/ManualIntegration":{"role":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","kind":"article","title":"Manual Integration","url":"\/documentation\/cardprovisioningsessions\/manualintegration","type":"topic","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}]}}}