{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide"},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources"],"generated":true,"title":"Resources","anchor":"Resources"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices.","type":"text"}]},{"text":"Device Unlock Requirement","anchor":"Device-Unlock-Requirement","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}]},{"type":"codeListing","syntax":"swift","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Use "},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"type":"text","text":" (not "},{"code":".deviceOwnerAuthenticationWithBiometrics","type":"codeVoice"},{"type":"text","text":") so users with a passcode but no biometrics are not locked out."}],"type":"paragraph"}],"style":"important","name":"Important"},{"type":"heading","anchor":"Prevent-Screen-Capture","level":2,"text":"Prevent Screen Capture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}]},{"syntax":"swift","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"type":"codeListing"},{"type":"heading","anchor":"Protect-Sensitive-Views-in-App-Switcher","text":"Protect Sensitive Views in App Switcher","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}]},{"type":"codeListing","syntax":"swift","code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"]},{"type":"heading","anchor":"Secure-Data-Storage","text":"Secure Data Storage","level":2},{"type":"paragraph","inlineContent":[{"text":"Never store tokens, keys, or credentials in ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}]},{"syntax":"swift","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly","type":"codeVoice"},{"text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Handle Sensitive Data in Memory","anchor":"Handle-Sensitive-Data-in-Memory","type":"heading"},{"inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"]},{"type":"paragraph","inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" — prefer ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" so you control the lifecycle. Never log sensitive values.","type":"text"}]},{"type":"heading","anchor":"Secure-Networking","level":2,"text":"Secure Networking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"code":"Info.plist","type":"codeVoice"},{"text":" does not weaken App Transport Security:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"text":"For additional protection, implement certificate pinning on your ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" to prevent man-in-the-middle attacks on your own backend endpoints.","type":"text"}]},{"type":"heading","anchor":"Jailbreak-Detection","level":2,"text":"Jailbreak Detection"},{"type":"paragraph","inlineContent":[{"text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade."}]}],"style":"note","name":"Note","type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"metadata":{"roleHeading":"Article","title":"Security Guide","role":"article"},"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"kind":"article","sections":[],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/AdditionalResources":{"type":"topic","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/AdditionalResources","kind":"article","role":"article","title":"Resources","abstract":[{"text":"Find more information about Adyen Issuing and related services.","type":"text"}],"url":"\/documentation\/cardprovisioningsessions\/additionalresources"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/ManualIntegration":{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/ManualIntegration","url":"\/documentation\/cardprovisioningsessions\/manualintegration","title":"Manual Integration","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}],"kind":"article","role":"article","type":"topic"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"type":"topic","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","title":"Issuing SDK","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"url":"\/documentation\/issuingsdkdocs","role":"collection"}}}