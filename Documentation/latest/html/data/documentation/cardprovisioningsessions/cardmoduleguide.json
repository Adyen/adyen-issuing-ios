Decryption failed"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".unexpectedData","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decrypted PIN block has an unexpected format"}]}]]]},{"text":"PIN Change","type":"heading","anchor":"PIN-Change","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card."}]},{"text":"Flow","type":"heading","anchor":"Flow","level":3},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"code":"GET \/publicKey?purpose=pinChange&format=jwk","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the public key and the new PIN to the SDK to generate the encrypted payload"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Your backend sends the payload to Adyen ("},{"code":"POST \/pins\/change","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"text":"Implementation","type":"heading","anchor":"Implementation","level":3},{"type":"codeListing","syntax":"swift","code":["import Card","","\/\/ 1. Initialize the service","let pinChangeService = PinChangeService()","","\/\/ 2. Generate the encrypted PIN block","let encryptedPin = try pinChangeService.encryptedPinBlock(","    jwk: publicKeyData,","    pin: newPin",")","","\/\/ 3. Send to your backend.","\/\/    Your backend calls POST \/pins\/change with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedPin.encryptedKey,","\/\/        \"encryptedPinBlock\": encryptedPin.encryptedPinBlock,","\/\/        \"token\": encryptedPin.token","\/\/    }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key:"}]},{"type":"codeListing","syntax":"swift","code":["let encryptedPin = try pinChangeService.encryptedPinBlock(","    