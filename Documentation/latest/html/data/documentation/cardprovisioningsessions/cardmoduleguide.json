{"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardModuleGuide","interfaceLanguage":"swift"},"kind":"article","metadata":{"roleHeading":"Article","title":"Card (Low-Level)","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Card","type":"codeVoice"},{"type":"text","text":" module provides low-level cryptographic services for sensitive card operations. Unlike "},{"code":"CardSessions","type":"codeVoice"},{"type":"text","text":" (which handles networking, session management, and token handling automatically), the "},{"code":"Card","type":"codeVoice"},{"type":"text","text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":"Card","type":"codeVoice"},{"type":"text","text":" module when you need:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Full control over the network layer (custom networking stack, interceptors, retry logic)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Integration into an architecture that doesn’t use "},{"code":"async\/await","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Direct access to the encrypted keys and data for custom backend flows"}],"type":"paragraph"}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you prefer a higher-level API that handles networking and token management, use "},{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","type":"reference","isActive":true},{"type":"text","text":" instead."}]}],"name":"Tip","style":"tip