{"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Card Sessions"},"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal PIN"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"text":" — set a new PIN for the card","type":"text"}]}]}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},{"type":"text","text":" before proceeding."}]}],"style":"important"},{"type":"heading","anchor":"Import","level":2,"text":"Import"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the imports to your file:"}]},{"type":"codeListing","syntax":"swift","code":["import CardSessions","import IssuingCommon"]},{"type":"heading","anchor":"Session-Token-Roles","level":2,"text":"Session Token Roles"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Include only the roles for the operations your user will perform."}]},{"type":"heading","text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSessions.Configuration","type":"codeVoice"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}]},{"syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"type":"codeListing"},{"type":"heading","text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session","level":2},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"type":"codeListing"},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"name":"Tip","type":"aside"},{"level":2,"text":"Reveal Card Details","anchor":"Reveal-Card-Details","type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cvc"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Verification Code"}]}]],[[{"inlineContent":[{"code":"expiryMonth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryYear"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}]}]]],"type":"table"},{"level":2,"text":"Reveal PIN","anchor":"Reveal-PIN","type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"type":"codeListing"},{"type":"heading","text":"Change PIN","anchor":"Change-PIN","level":2},{"inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"type":"codeListing"},{"type":"heading","anchor":"Error-Handling","level":2,"text":"Error Handling"},{"inlineContent":[{"text":"All operations throw ","type":"text"},{"code":"CardSessionError","type":"codeVoice"},{"text":" on failure. Use the ","type":"text"},{"code":"code","type":"codeVoice"},{"type":"text","text":" property for programmatic branching:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"]},{"type":"heading","text":"Security Considerations","anchor":"Security-Considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Each operation is secured with end-to-end encryption managed entirely within the SDK."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide"},{"type":"text","text":"."}]}]}]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"inlineContent":[{"text":"physical device","type":"text"}],"type":"strong"},{"text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"inlineContent":[{"text":"live","type":"text"}],"type":"strong"},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"title":"A Starting Guide (Sessions)","kind":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","type":"topic","role":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"role":"article","type":"topic","kind":"article","title":"Security Guide","url":"\/documentation\/cardprovisioningsessions\/securityguide","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"type":"topic","role":"collection","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","title":"Issuing SDK","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"url":"\/documentation\/issuingsdkdocs"}}}