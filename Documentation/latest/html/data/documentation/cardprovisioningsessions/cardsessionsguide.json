{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"Card Sessions","roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. The SDK handles device registration, key exchange, and end-to-end encryption internally. Your server never sees cleartext card data: all sensitive information is encrypted between the SDK and the Adyen backend.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Supported operations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal card details"}]},{"type":"text","text":" — PAN, CVC, expiry month, and expiry year"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Reveal PIN","type":"text"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Change PIN","type":"text"}],"type":"strong"},{"text":" — set a new PIN for the card","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","isActive":true},{"text":" before proceeding.","type":"text"}]}],"type":"aside","name":"Important"},{"anchor":"Import","text":"Import","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the imports to your file:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CardSessions","import IssuingCommon"]},{"anchor":"Session-Token-Roles","text":"Session Token Roles","level":2,"type":"heading"},{"inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"]},{"inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}],"type":"paragraph"},{"anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSessions.Configuration"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}]},{"code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    appTeamId: \"[YourAppleTeamID]\",","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Initialize-the-Card-Session","type":"heading","text":"Initialize the Card Session","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSession","type":"codeVoice"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}]},{"code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"syntax":"swift","type":"codeListing"},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"CardSession"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations.","type":"text"}],"type":"paragraph"}],"name":"Tip","style":"tip"},{"anchor":"Reveal-Card-Details","type":"heading","text":"Reveal Card Details","level":2},{"type":"paragraph","inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}]},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI","    print(\"PAN: \\(details.pan)\")","    print(\"CVC: \\(details.cvc)\")","    print(\"Expires: \\(details.expiryMonth)\/\\(details.expiryYear)\")","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"code":"CardDetails","type":"codeVoice"},{"text":" struct contains:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"pan","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cvc","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Verification Code"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryMonth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryYear","type":"codeVoice"}]}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}]}]]],"type":"table"},{"level":2,"anchor":"Reveal-PIN","text":"Reveal PIN","type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI","    print(\"PIN: \\(pin)\")","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"heading","level":2,"text":"Change PIN","anchor":"Change-PIN"},{"type":"paragraph","inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: \"1234\"","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"]},{"anchor":"Error-Handling","type":"heading","text":"Error Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All operations throw "},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure. Use the "},{"code":"code","type":"codeVoice"},{"type":"text","text":" property for programmatic branching:"}]},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Security-Considerations","type":"heading","text":"Security Considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The SDK uses ephemeral key pairs for each operation, ensuring forward secrecy.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Consider applying screen capture protection when displaying card details. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" for full end-to-end functionality due to the device attestation requirement. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","role":"article","type":"topic","url":"\/documentation\/cardprovisioningsessions\/securityguide","title":"Security Guide","kind":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"title":"A Starting Guide (Sessions)","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"url":"\/documentation\/cardprovisioningsessions\/gettingstarted","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","type":"topic","role":"collection","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"title":"Issuing SDK","kind":"article"}}}