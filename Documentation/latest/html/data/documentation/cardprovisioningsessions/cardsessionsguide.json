{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal PIN"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"text":" — set a new PIN for the card","type":"text"}]}]}],"type":"unorderedList"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}]}],"type":"aside","style":"important"},{"anchor":"Import","type":"heading","text":"Import","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the imports to your file:"}]},{"syntax":"swift","type":"codeListing","code":["import CardSessions","import IssuingCommon"]},{"anchor":"Session-Token-Roles","type":"heading","text":"Session Token Roles","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}]},{"syntax":"json","type":"codeListing","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Include only the roles for the operations your user will perform."}]},{"anchor":"Create-a-Configuration-Object","type":"heading","text":"Create a Configuration Object","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSessions.Configuration"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"]},{"anchor":"Initialize-the-Card-Session","type":"heading","text":"Initialize the Card Session","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}]},{"syntax":"swift","type":"codeListing","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"type":"aside","style":"tip"},{"anchor":"Reveal-Card-Details","type":"heading","text":"Reveal Card Details","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error. Log the error itself, not its localizedDescription,","    \/\/ so the trace identifier is preserved.","    print(\"Reveal failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cvc"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Verification Code"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryMonth"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryYear"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}]}]]],"header":"row","type":"table"},{"anchor":"Reveal-PIN","type":"heading","text":"Reveal PIN","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error)\")","}"]},{"anchor":"Change-PIN","type":"heading","text":"Change PIN","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error)\")","}"]},{"anchor":"Error-Handling","type":"heading","text":"Error Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All operations throw "},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure."}]},{"anchor":"Match-a-single-case","type":"heading","text":"Match a single case","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The error type supports pattern matching, so you can catch one case directly without casting."},{"type":"text","text":" "},{"type":"text","text":"Matching compares the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"type":"text","text":" "},{"type":"text","text":"underlying cause:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: newPin","    )","} catch CardSessionError.invalidPin {","    \/\/ Ask the cardholder for a correctly formatted PIN.","} catch {","    \/\/ Handle everything else.","}"]},{"anchor":"Branch-across-several-cases","type":"heading","text":"Branch across several cases","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To handle several failures at once, use the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" property. "},{"type":"codeVoice","code":"Code"},{"type":"text","text":" is non-exhaustive, so always"},{"type":"text","text":" "},{"type":"text","text":"include a "},{"type":"codeVoice","code":"default"},{"type":"text","text":" case to stay forward compatible with future SDK versions:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .sessionTokenRetrievalFailed:","        \/\/ The token provider failed to retrieve a session token.","        \/\/ Check your backend or re-authenticate the user.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .cardRevealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    default:","        break","    }","}"]},{"anchor":"Logging","type":"heading","text":"Logging","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":", so log the error itself:"}]},{"syntax":"swift","type":"codeListing","code":["print(error)","\/\/ CardSessionError.cardRevealFailed: cardReveal, serverHTTPError. Trace: 00-abc..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the failure came from a network call, "},{"type":"codeVoice","code":"description"},{"type":"text","text":" includes the trace identifier Adyen"},{"type":"text","text":" "},{"type":"text","text":"support needs to correlate the request. It never contains card data, PINs or session tokens, so"},{"type":"text","text":" "},{"type":"text","text":"it is safe to log."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Avoid logging "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":". It carries no diagnostic detail, so the trace identifier is"},{"type":"text","text":" "},{"type":"text","text":"lost."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is deliberately short because errors are commonly passed straight to the"},{"type":"text","text":" "},{"type":"text","text":"UI, but it is not meant for display either: the text is English and is not localized. Map "},{"type":"codeVoice","code":"code"},{"type":"text","text":" "},{"type":"text","text":"to your own copy for anything the cardholder sees."}]},{"anchor":"Security-Considerations","type":"heading","text":"Security Considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider applying screen capture protection when displaying card details. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","isActive":true},{"text":".","type":"text"}]}]}]},{"type":"heading","anchor":"Testing","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"anchor":"Card-Sessions","identifiers":["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardModuleGuide"],"title":"Card Sessions"}],"metadata":{"role":"article","roleHeading":"Article","title":"Card Sessions"},"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"type":"topic","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","title":"Issuing SDK","kind":"article","role":"collection","url":"\/documentation\/issuingsdkdocs"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"type":"topic","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","title":"Security Guide","kind":"article","role":"article","url":"\/documentation\/cardprovisioningsessions\/securityguide"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","type":"topic"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/CardModuleGuide":{"type":"topic","abstract":[{"type":"text","text":"Reveal card details, reveal PINs, and change PINs using direct service calls."}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardModuleGuide","title":"Card (Low-Level)","kind":"article","role":"article","url":"\/documentation\/cardprovisioningsessions\/cardmoduleguide"}}}