{"metadata":{"title":"Card Sessions","role":"article","roleHeading":"Article"},"sections":[],"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. The SDK handles device registration, key exchange, and end-to-end encryption internally. Your server never sees cleartext card data: all sensitive information is encrypted between the SDK and the Adyen backend."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Supported operations:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Reveal card details","type":"text"}],"type":"strong"},{"type":"text","text":" — PAN, CVC, expiry month, and expiry year"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Reveal PIN","type":"text"}],"type":"strong"},{"type":"text","text":" — the card’s current PIN"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Change PIN","type":"text"}],"type":"strong"},{"type":"text","text":" — set a new PIN for the card"}],"type":"paragraph"}]}],"type":"unorderedList"},{"content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","isActive":true,"type":"reference"},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"anchor":"Import","level":2,"text":"Import","type":"heading"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import CardSessions","import IssuingCommon"],"type":"codeListing"},{"anchor":"Session-Token-Roles","level":2,"text":"Session Token Roles","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"]},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","level":2,"anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    appTeamId: \"[YourAppleTeamID]\",","    environment: .live",")"]},{"anchor":"Initialize-the-Card-Session","level":2,"text":"Initialize the Card Session","type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations.","type":"text"}],"type":"paragraph"}],"style":"tip","name":"Tip","type":"aside"},{"anchor":"Reveal-Card-Details","level":2,"text":"Reveal Card Details","type":"heading"},{"inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI","    print(\"PAN: \\(details.pan)\")","    print(\"CVC: \\(details.cvc)\")","    print(\"Expires: \\(details.expiryMonth)\/\\(details.expiryYear)\")","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"type":"codeListing"},{"inlineContent":[{"text":"The returned ","type":"text"},{"type":"codeVoice","code":"CardDetails"},{"text":" struct contains:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"pan","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Full Primary Account Number","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cvc","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Card Verification Code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryMonth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryYear","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Reveal-PIN","level":2,"text":"Reveal PIN","type":"heading"},{"inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI","    print(\"PIN: \\(pin)\")","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"type":"codeListing"},{"anchor":"Change-PIN","level":2,"text":"Change PIN","type":"heading"},{"inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: \"1234\"","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"]},{"type":"heading","level":2,"anchor":"Error-Handling","text":"Error Handling"},{"inlineContent":[{"text":"All operations throw ","type":"text"},{"code":"CardSessionError","type":"codeVoice"},{"text":" on failure. Use the ","type":"text"},{"type":"codeVoice","code":"code"},{"type":"text","text":" property for programmatic branching:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"]},{"text":"Security Considerations","anchor":"Security-Considerations","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The SDK uses ephemeral key pairs for each operation, ensuring forward secrecy.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Consider applying screen capture protection when displaying card details. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" for full end-to-end functionality due to the device attestation requirement. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"kind":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"type":"topic","title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","role":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"type":"topic","abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","kind":"article","title":"Security Guide","url":"\/documentation\/cardprovisioningsessions\/securityguide","role":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","title":"Issuing SDK","role":"collection","url":"\/documentation\/issuingsdkdocs","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"type":"topic","kind":"article"}}}