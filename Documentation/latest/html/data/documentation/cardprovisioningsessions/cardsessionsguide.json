{"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"metadata":{"title":"Card Sessions","roleHeading":"Article","role":"article"},"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Supported operations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"type":"text","text":" — PAN, CVC, expiry month, and expiry year"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reveal PIN","type":"text"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Change PIN"}]},{"type":"text","text":" — set a new PIN for the card"}]}]}]},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"isActive":true,"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","type":"reference"},{"type":"text","text":" before proceeding."}]}]},{"text":"Import","anchor":"Import","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the imports to your file:"}]},{"type":"codeListing","syntax":"swift","code":["import CardSessions","import IssuingCommon"]},{"type":"heading","text":"Session Token Roles","level":2,"anchor":"Session-Token-Roles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Include only the roles for the operations your user will perform."}]},{"type":"heading","text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSessions.Configuration"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"]},{"type":"heading","text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSession","type":"codeVoice"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}]},{"type":"codeListing","syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"type":"aside","name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"CardSession"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations.","type":"text"}]}]},{"type":"heading","text":"Reveal Card Details","anchor":"Reveal-Card-Details","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"code":"CardDetails","type":"codeVoice"},{"type":"text","text":" struct contains:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full Primary Account Number","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cvc"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Card Verification Code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryMonth"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryYear"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}]}]]]},{"type":"heading","text":"Reveal PIN","anchor":"Reveal-PIN","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"heading","text":"Change PIN","anchor":"Change-PIN","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"]},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All operations throw "},{"code":"CardSessionError","type":"codeVoice"},{"type":"text","text":" on failure. Use the "},{"code":"code","type":"codeVoice"},{"type":"text","text":" property for programmatic branching:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"]},{"type":"heading","text":"Security Considerations","anchor":"Security-Considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each operation is secured with end-to-end encryption managed entirely within the SDK."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide"},{"type":"text","text":"."}]}]}]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"inlineContent":[{"type":"text","text":"live"}],"type":"strong"},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}]}],"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"url":"\/documentation\/cardprovisioningsessions\/gettingstarted","title":"A Starting Guide (Sessions)","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","kind":"article","type":"topic","role":"article","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}]},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"type":"topic","url":"\/documentation\/cardprovisioningsessions\/securityguide","role":"article","title":"Security Guide","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","kind":"article","abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}]},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"url":"\/documentation\/issuingsdkdocs","role":"collection","title":"Issuing SDK","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","type":"topic"}}}