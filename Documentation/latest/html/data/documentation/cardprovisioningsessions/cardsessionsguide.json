{"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Card Sessions"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal card details","type":"text"}]},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal PIN"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Change PIN"}]},{"text":" — set a new PIN for the card","type":"text"}],"type":"paragraph"}]}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}]}],"style":"important"},{"type":"heading","text":"Import","anchor":"Import","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the imports to your file:"}]},{"code":["import CardSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"text":"Session Token Roles","level":2,"anchor":"Session-Token-Roles","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"]},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","level":2,"anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSessions.Configuration"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"]},{"type":"heading","level":2,"text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}]},{"type":"codeListing","syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"CardSession","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"style":"tip"},{"text":"Reveal Card Details","level":2,"anchor":"Reveal-Card-Details","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"code":"CardDetails","type":"codeVoice"},{"text":" struct contains:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cvc"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Verification Code"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryMonth"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryYear"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}]}]]]},{"level":2,"anchor":"Reveal-PIN","text":"Reveal PIN","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}]},{"type":"codeListing","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"level":2,"anchor":"Change-PIN","text":"Change PIN","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}]},{"syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"type":"codeListing"},{"type":"heading","text":"Error Handling","level":2,"anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure. Use the "},{"code":"code","type":"codeVoice"},{"text":" property for programmatic branching:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"]},{"type":"heading","text":"Security Considerations","level":2,"anchor":"Security-Considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider applying screen capture protection when displaying card details. See ","type":"text"},{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Testing","text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}]}],"kind":"content"}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"role":"article","kind":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","type":"topic"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"role":"collection","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"type":"topic","url":"\/documentation\/issuingsdkdocs","title":"Issuing SDK","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"url":"\/documentation\/cardprovisioningsessions\/securityguide","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"title":"Security Guide","role":"article","type":"topic","kind":"article"}}}