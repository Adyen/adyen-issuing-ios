{"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","interfaceLanguage":"swift"},"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"metadata":{"role":"article","roleHeading":"Article","title":"Card Sessions"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal card details","type":"text"}]},{"type":"text","text":" — PAN, CVC, expiry month, and expiry year"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal PIN"}]},{"type":"text","text":" — the card’s current PIN"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"type":"text","text":" — set a new PIN for the card"}],"type":"paragraph"}]}]},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","isActive":true},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Import","anchor":"Import","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the imports to your file:","type":"text"}]},{"type":"codeListing","code":["import CardSessions","import IssuingCommon"],"syntax":"swift"},{"type":"heading","level":2,"text":"Session Token Roles","anchor":"Session-Token-Roles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}]},{"code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSessions.Configuration"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}]},{"code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSession","type":"codeVoice"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"CardSession"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"type":"aside","style":"tip"},{"level":2,"type":"heading","anchor":"Reveal-Card-Details","text":"Reveal Card Details"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"text":" struct contains:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"pan"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cvc"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Card Verification Code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryMonth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryYear","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}]}]]]},{"type":"heading","text":"Reveal PIN","level":2,"anchor":"Reveal-PIN"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}]},{"type":"codeListing","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"heading","text":"Change PIN","level":2,"anchor":"Change-PIN"},{"type":"paragraph","inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}]},{"type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"heading","text":"Error Handling","level":2,"anchor":"Error-Handling"},{"inlineContent":[{"type":"text","text":"All operations throw "},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure. Use the "},{"type":"codeVoice","code":"code"},{"text":" property for programmatic branching:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .sessionTokenRetrievalFailed:","        \/\/ The token provider failed to retrieve a session token.","        \/\/ Check your backend or re-authenticate the user.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .cardRevealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    default:","        break","    }","}"]},{"text":"Security Considerations","anchor":"Security-Considerations","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","isActive":true},{"type":"text","text":"."}]}]}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"title":"Security Guide","url":"\/documentation\/cardprovisioningsessions\/securityguide","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","role":"article","type":"topic","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"kind":"article"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"type":"topic","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","kind":"article","title":"Issuing SDK","url":"\/documentation\/issuingsdkdocs","role":"collection"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"role":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"kind":"article","type":"topic"}}}