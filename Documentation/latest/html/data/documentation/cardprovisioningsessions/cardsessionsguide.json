{"hierarchy":{"paths":[["doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Supported operations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal PIN"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"text":" — set a new PIN for the card","type":"text"}]}]}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted"},{"type":"text","text":" before proceeding."}]}],"style":"important"},{"type":"heading","text":"Import","anchor":"Import","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the imports to your file:","type":"text"}]},{"type":"codeListing","code":["import CardSessions","import IssuingCommon"],"syntax":"swift"},{"type":"heading","text":"Session Token Roles","anchor":"Session-Token-Roles","level":2},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}]},{"type":"codeListing","code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","level":2},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}]},{"type":"codeListing","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"syntax":"swift"},{"type":"heading","text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session","level":2},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}]},{"type":"codeListing","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"syntax":"swift"},{"type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"style":"tip"},{"type":"heading","text":"Reveal Card Details","anchor":"Reveal-Card-Details","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cvc"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"text":"Card Verification Code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expiryMonth"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryYear"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}]}]]]},{"type":"heading","text":"Reveal PIN","anchor":"Reveal-PIN","level":2},{"inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}],"type":"paragraph"},{"type":"codeListing","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"heading","text":"Change PIN","anchor":"Change-PIN","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}]},{"type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"syntax":"swift"},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All operations throw "},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure. Use the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" property for programmatic branching:"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"],"syntax":"swift"},{"type":"heading","text":"Security Considerations","anchor":"Security-Considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Consider applying screen capture protection when displaying card details. See ","type":"text"},{"identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"url":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/CardSessionsGuide","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Card Sessions"},"kind":"article","abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"references":{"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/GettingStarted":{"kind":"article","role":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/GettingStarted","type":"topic","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"title":"A Starting Guide (Sessions)","url":"\/documentation\/cardprovisioningsessions\/gettingstarted"},"doc://com.adyen.CardProvisioningSessions/documentation/CardProvisioningSessions/SecurityGuide":{"kind":"article","role":"article","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/CardProvisioningSessions\/SecurityGuide","type":"topic","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"title":"Security Guide","url":"\/documentation\/cardprovisioningsessions\/securityguide"},"doc://com.adyen.CardProvisioningSessions/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.CardProvisioningSessions\/documentation\/IssuingSDKDocs","title":"Issuing SDK","kind":"article","type":"topic","abstract":[{"type":"text","text":"Integrate Adyen Issuing features into your iOS application."}],"role":"collection"}}}