{"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardModuleGuide","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module provides low-level cryptographic services for sensitive card operations. Unlike "},{"type":"codeVoice","code":"CardSessions"},{"type":"text","text":" (which handles networking, session management, and token handling automatically), the "},{"code":"Card","type":"codeVoice"},{"type":"text","text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the "},{"code":"Card","type":"codeVoice"},{"type":"text","text":" module when you need:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Full control over the network layer (custom networking stack, interceptors, retry logic)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Integration into an architecture that doesn’t use "},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Direct access to the encrypted keys and data for custom backend flows","type":"text"}],"type":"paragraph"}]}]},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you prefer a higher-level API that handles networking and token management, use "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","isActive":true},{"type":"text","text":" instead."}]}]},{"anchor":"Import","text":"Import","type":"heading","level":2},{"type":"codeListing","code":["import Card"],"syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module has no dependency on "},{"type":"codeVoice","code":"IssuingCommon"},{"type":"text","text":" or "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":". It is a standalone cryptographic library."}]}]},{"text":"Session Token Roles","level":2,"type":"heading","anchor":"Session-Token-Roles"},{"inlineContent":[{"type":"text","text":"Your backend needs the following API credential roles to call the Adyen endpoints used in these flows:"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Operation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Role"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card reveal"}]}],[{"inlineContent":[{"type":"codeVoice","code":"Bank Issuing PaymentInstrument Reveal Webservice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN reveal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Reveal Webservice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN change"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Change Webservice"}]}]]],"header":"row"},{"text":"Card Reveal","anchor":"Card-Reveal","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Reveal the card’s PAN, CVC, and expiry date.","type":"text"}]},{"anchor":"Flow","level":3,"text":"Flow","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=panReveal&format=jwk"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the public key to the SDK to generate an encrypted session key"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your backend sends the encrypted key to Adyen (","type":"text"},{"type":"codeVoice","code":"POST \/paymentInstruments\/reveal"},{"type":"text","text":") and receives encrypted card data"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the encrypted data to the SDK to decrypt and obtain the card details"}]}]}],"type":"orderedList"},{"anchor":"Implementation","type":"heading","text":"Implementation","level":3},{"type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let cardRevealService = CardRevealService()","","\/\/ 2. Generate an encrypted key using the public key from your backend.","\/\/    The public key is the raw JWK data from the Adyen \/publicKey endpoint.","let (encryptedKey, revealContext) = try cardRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/paymentInstruments\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns the `encryptedData` string from the response.","","\/\/ 4. Decrypt the card details","let details = try cardRevealService.cardDetails(","    encryptedData: encryptedData,","    revealContext: revealContext",")","","\/\/ Access the decrypted values","details.pan            \/\/ Full PAN, e.g. \"5412345678901234\"","details.cvc            \/\/ CVC, e.g. \"123\"","details.expiration.month  \/\/ e.g. \"03\"","details.expiration.year   \/\/ e.g. \"2028\""],"syntax":"swift"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"revealContext"},{"type":"text","text":" returned by "},{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" must be passed to "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":". It contains the symmetric key needed for decryption and cannot be reused across separate reveal flows."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key instead of JWK, use "},{"type":"codeVoice","code":"generateEncryptedKey(pem:)"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let (encryptedKey, revealContext) = try cardRevealService.generateEncryptedKey(","    pem: derEncodedPublicKey",")"]},{"anchor":"Error-Handling","type":"heading","level":3,"text":"Error Handling"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" throw "},{"code":"CardRevealService.CardRevealError","type":"codeVoice"},{"type":"text","text":":"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cause"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The public key could not be parsed"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".encryptionFailed","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Key encryption failed"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}]}],[{"inlineContent":[{"type":"text","text":"The encrypted data string is not valid hex"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".decryptionFailed"}]}],[{"inlineContent":[{"type":"text","text":"AES decryption of the card data failed"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unexpectedData"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decryption succeeded but the payload could not be decoded"}]}]]],"type":"table","header":"row"},{"level":2,"anchor":"PIN-Reveal","type":"heading","text":"PIN Reveal"},{"inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN."}],"type":"paragraph"},{"text":"Flow","anchor":"Flow","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinReveal&format=jwk"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass the public key to the SDK to generate an encrypted session key","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"type":"codeVoice","code":"POST \/pins\/reveal"},{"type":"text","text":") and receives an encrypted PIN block and token"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass both to the SDK to decrypt and obtain the PIN"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"anchor":"Implementation","type":"heading","text":"Implementation"},{"type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let pinRevealService = PinRevealService()","","\/\/ 2. Generate an encrypted key","let (encryptedKey, revealContext) = try pinRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/pins\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns `encryptedPinBlock` and `token` from the response.","","\/\/ 4. Decrypt the PIN","let pin = try pinRevealService.pin(","    encryptedPinBlock: encryptedPinBlock,","    token: token,","    revealContext: revealContext",")"],"syntax":"swift"},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"pin"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"PinRevealService.PinRevealError"},{"type":"text","text":":"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Error","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cause"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The public key could not be parsed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key encryption failed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}]}],[{"inlineContent":[{"text":"The encrypted PIN block is not valid","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".decryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decryption failed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unexpectedData"}]}],[{"inlineContent":[{"type":"text","text":"Decrypted PIN block has an unexpected format"}],"type":"paragraph"}]]]},{"type":"heading","text":"PIN Change","anchor":"PIN-Change","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card."}]},{"type":"heading","text":"Flow","anchor":"Flow","level":3},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Your backend fetches a public key from Adyen (","type":"text"},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinChange&format=jwk"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass the public key and the new PIN to the SDK to generate the encrypted payload","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your backend sends the payload to Adyen (","type":"text"},{"type":"codeVoice","code":"POST \/pins\/change"},{"text":")","type":"text"}]}]}]},{"type":"heading","text":"Implementation","anchor":"Implementation","level":3},{"type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let pinChangeService = PinChangeService()","","\/\/ 2. Generate the encrypted PIN block","let encryptedPin = try pinChangeService.encryptedPinBlock(","    jwk: publicKeyData,","    pin: newPin",")","","\/\/ 3. Send to your backend.","\/\/    Your backend calls POST \/pins\/change with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedPin.encryptedKey,","\/\/        \"encryptedPinBlock\": encryptedPin.encryptedPinBlock,","\/\/        \"token\": encryptedPin.token","\/\/    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key:"}]},{"type":"codeListing","code":["let encryptedPin = try pinChangeService.encryptedPinBlock(","    pem: derEncodedPublicKey,","    pin: newPin",")"],"syntax":"swift"},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"PinChangeService.PinChangeError"},{"text":":","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Error"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cause"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPin"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The PIN is malformed (non-decimal characters, too long)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unallowedPin"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The PIN is not permitted (sequential like "},{"type":"codeVoice","code":"1234"},{"type":"text","text":", repeated like "},{"type":"codeVoice","code":"1111"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The public key could not be parsed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"PIN encryption failed"}],"type":"paragraph"}]]]},{"type":"heading","text":"Security Considerations","anchor":"Security-Considerations","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module performs all cryptographic operations in memory. No sensitive data is written to disk."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The symmetric key (inside "},{"type":"codeVoice","code":"RevealContext"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"PinRevealContext"},{"type":"text","text":") is ephemeral and must not be persisted or transmitted."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Never log or persist decrypted card details or PINs."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"RevealContext"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"PinRevealContext"},{"text":" is single-use. Generate a new encrypted key for each reveal operation.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Migration from adyen-card-reveal-ios","anchor":"Migration-from-adyen-card-reveal-ios","level":2},{"inlineContent":[{"text":"If you previously used the standalone ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"},{"type":"text","text":" package, the "},{"type":"codeVoice","code":"Card"},{"text":" module is a direct replacement with minor API changes:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Old API"}],"type":"paragraph"}],[{"inlineContent":[{"text":"New API","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import AdyenCardReveal"}]}],[{"inlineContent":[{"type":"codeVoice","code":"import Card"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"generateEncryptedKey(jwk:)","type":"codeVoice"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"generateEncryptedKey(jwk:)","type":"codeVoice"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"(encryptedKey: String, revealContext: RevealContext)"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardDetails(from: encryptedData)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"cardDetails(encryptedData:, revealContext:)"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"pin(encryptedPinBlock:, token:)","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":"pin(encryptedPinBlock:, token:, revealContext:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"},{"type":"text","text":" (unchanged)"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The key change is that "},{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" now returns a "},{"type":"codeVoice","code":"RevealContext"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"PinRevealContext"},{"type":"text","text":") that must be passed to the decryption method. This makes the API safer by preventing accidental reuse of keys across requests."}]}],"kind":"content"}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"IssuingSDKDocs"}],"title":"Card Module (Low-Level)"},"abstract":[{"type":"text","text":"Reveal card details, reveal PINs, and change PINs using direct service calls."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardmoduleguide"]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"type":"topic","role":"collection","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs","kind":"symbol","abstract":[],"title":"IssuingSDKDocs"},"https://github.com/Adyen/adyen-card-reveal-ios":{"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","type":"link","title":"adyen-card-reveal-ios","titleInlineContent":[{"type":"text","text":"adyen-card-reveal-ios"}],"url":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"title":"Card Sessions","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","url":"\/documentation\/issuingsdkdocs\/cardsessionsguide","abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"role":"article","type":"topic","kind":"article"}}}