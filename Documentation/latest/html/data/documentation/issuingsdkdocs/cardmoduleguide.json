{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Reveal card details, reveal PINs, and change PINs using direct service calls.","type":"text"}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"IssuingSDKDocs"}],"title":"Card (Low-Level)"},"variants":[{"paths":["\/documentation\/issuingsdkdocs\/cardmoduleguide"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardModuleGuide","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module provides low-level cryptographic services for sensitive card operations. Unlike "},{"type":"codeVoice","code":"CardSessions"},{"type":"text","text":" (which handles networking, session management, and token handling automatically), the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module when you need:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Full control over the network layer (custom networking stack, interceptors, retry logic)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Integration into an architecture that doesn’t use ","type":"text"},{"code":"async\/await","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Direct access to the encrypted keys and data for custom backend flows","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"text":"If you prefer a higher-level API that handles networking and token management, use ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","type":"reference","isActive":true},{"text":" instead.","type":"text"}],"type":"paragraph"}]},{"text":"Import","anchor":"Import","type":"heading","level":2},{"code":["import Card"],"syntax":"swift","type":"codeListing"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a standalone cryptographic library that can be used without the rest of the SDK."}],"type":"paragraph"}],"type":"aside"},{"type":"heading","text":"Session Token Roles","anchor":"Session-Token-Roles","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend needs the following API credential roles to call the Adyen endpoints used in these flows:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Operation"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Role","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Card reveal"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bank Issuing PaymentInstrument Reveal Webservice","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"PIN reveal"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bank Issuing Pin Reveal Webservice","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"PIN change"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bank Issuing Pin Change Webservice","type":"codeVoice"}],"type":"paragraph"}]]]},{"text":"Card Reveal","anchor":"Card-Reveal","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reveal the card’s PAN, CVC, and expiry date."}]},{"text":"Flow","anchor":"Flow","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Your backend fetches a public key from Adyen (","type":"text"},{"code":"GET \/publicKey?purpose=panReveal&format=jwk","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the public key to the SDK to generate an encrypted session key","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your backend sends the encrypted key to Adyen (","type":"text"},{"code":"POST \/paymentInstruments\/reveal","type":"codeVoice"},{"text":") and receives encrypted card data","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the encrypted data to the SDK to decrypt and obtain the card details","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Implementation","anchor":"Implementation","type":"heading","level":3},{"code":["import Card","","\/\/ 1. Initialize the service","let cardRevealService = CardRevealService()","","\/\/ 2. Generate an encrypted key using the public key from your backend.","\/\/    The public key is the raw JWK data from the Adyen \/publicKey endpoint.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try cardRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/paymentInstruments\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns the `encryptedData` string from the response.","","\/\/ 4. Decrypt the card details using the same service instance","let details = try cardRevealService.cardDetails(","    encryptedData: encryptedData",")","","\/\/ Access the decrypted values","details.pan            \/\/ Full PAN, e.g. \"5412345678901234\"","details.cvc            \/\/ CVC, e.g. \"123\"","details.expiration.month  \/\/ e.g. \"03\"","details.expiration.year   \/\/ e.g. \"2028\""],"syntax":"swift","type":"codeListing"},{"name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" on the same "},{"type":"codeVoice","code":"CardRevealService"},{"type":"text","text":" instance that produced the encrypted key. The instance retains the symmetric key generated by "},{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":"; calling "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" before generating a key throws "},{"type":"codeVoice","code":".keyNotGenerated"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"If you have a PEM\/DER-encoded public key instead of JWK, use ","type":"text"},{"code":"generateEncryptedKey(pem:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let encryptedKey = try cardRevealService.generateEncryptedKey(","    pem: derEncodedPublicKey",")"],"syntax":"swift","type":"codeListing"},{"text":"Error Handling","anchor":"Error-Handling","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"CardRevealService.CardRevealError"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Error"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cause","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key encryption failed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".keyNotGenerated"}],"type":"paragraph"}],[{"inlineContent":[{"code":"cardDetails","type":"codeVoice"},{"text":" was called before ","type":"text"},{"code":"generateEncryptedKey","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The encrypted data string is not valid hex","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".decryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"text":"AES decryption of the card data failed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unexpectedData"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decryption succeeded but the payload could not be decoded","type":"text"}],"type":"paragraph"}]]]},{"text":"PIN Reveal","anchor":"PIN-Reveal","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN."}]},{"text":"Flow","anchor":"Flow","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Your backend fetches a public key from Adyen (","type":"text"},{"code":"GET \/publicKey?purpose=pinReveal&format=jwk","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the public key to the SDK to generate an encrypted session key","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your backend sends the encrypted key to Adyen (","type":"text"},{"code":"POST \/pins\/reveal","type":"codeVoice"},{"text":") and receives an encrypted PIN block and token","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass both to the SDK to decrypt and obtain the PIN","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Implementation","anchor":"Implementation","type":"heading","level":3},{"code":["import Card","","\/\/ 1. Initialize the service","let pinRevealService = PinRevealService()","","\/\/ 2. Generate an encrypted key.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try pinRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/pins\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns `encryptedPinBlock` and `token` from the response.","","\/\/ 4. Decrypt the PIN using the same service instance","let pin = try pinRevealService.pin(","    encryptedPinBlock: encryptedPinBlock,","    token: token",")"],"syntax":"swift","type":"codeListing"},{"text":"Error Handling","anchor":"Error-Handling","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pin"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"PinRevealService.PinRevealError"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Error"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cause","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key encryption failed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".keyNotGenerated"}],"type":"paragraph"}],[{"inlineContent":[{"code":"pin","type":"codeVoice"},{"text":" was called before ","type":"text"},{"code":"generateEncryptedKey","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The encrypted PIN block is not valid","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".decryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decryption failed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unexpectedData"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decrypted PIN block has an unexpected format","type":"text"}],"type":"paragraph"}]]]},{"text":"PIN Change","anchor":"PIN-Change","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card."}]},{"text":"Flow","anchor":"Flow","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Your backend fetches a public key from Adyen (","type":"text"},{"code":"GET \/publicKey?purpose=pinChange&format=jwk","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the public key and the new PIN to the SDK to generate the encrypted payload","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Your backend sends the payload to Adyen (","type":"text"},{"code":"POST \/pins\/change","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","text":"Implementation","anchor":"Implementation","level":3},{"code":["import Card","","\/\/ 1. Initialize the service","let pinChangeService = PinChangeService()","","\/\/ 2. Generate the encrypted PIN block","let encryptedPin = try pinChangeService.encryptedPinBlock(","    jwk: publicKeyData,","    pin: newPin",")","","\/\/ 3. Send to your backend.","\/\/    Your backend calls POST \/pins\/change with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedPin.encryptedKey,","\/\/        \"encryptedPinBlock\": encryptedPin.encryptedPinBlock,","\/\/        \"token\": encryptedPin.token","\/\/    }"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key:"}]},{"code":["let encryptedPin = try pinChangeService.encryptedPinBlock(","    pem: derEncodedPublicKey,","    pin: newPin",")"],"syntax":"swift","type":"codeListing"},{"text":"Error Handling","anchor":"Error-Handling","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"PinChangeService.PinChangeError"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Error"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cause","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPin"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The PIN is malformed (non-decimal characters, too long)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unallowedPin"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The PIN is not permitted (sequential like ","type":"text"},{"code":"1234","type":"codeVoice"},{"text":", repeated like ","type":"text"},{"code":"1111","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"text":"PIN encryption failed","type":"text"}],"type":"paragraph"}]]]},{"text":"Security Considerations","anchor":"Security-Considerations","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module performs all cryptographic operations in memory. No sensitive data is written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The symmetric key generated during a reveal flow is ephemeral, held only for the lifetime of the service instance, and is never persisted or transmitted.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Never log or persist decrypted card details or PINs.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use a fresh ","type":"text"},{"code":"CardRevealService","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"PinRevealService","type":"codeVoice"},{"text":" instance per reveal operation, and generate a new encrypted key for each flow.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Migration from adyen-card-reveal-ios","anchor":"Migration-from-adyen-card-reveal-ios","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you previously used the standalone "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"},{"type":"text","text":" package, the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a drop-in replacement. The public API is unchanged; only the import name differs:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Old API"}],"type":"paragraph"}],[{"inlineContent":[{"text":"New API","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"import AdyenCardReveal"}],"type":"paragraph"}],[{"inlineContent":[{"code":"import Card","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey(jwk:)"},{"type":"text","text":" → "},{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"text":"unchanged","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardDetails(encryptedData:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"unchanged","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"pin(encryptedPinBlock:, token:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"unchanged","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"unchanged","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace "},{"type":"codeVoice","code":"import AdyenCardReveal"},{"type":"text","text":" with "},{"type":"codeVoice","code":"import Card"},{"type":"text","text":"; no other code changes are required."}]}]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/issuingsdkdocs","abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"url":"\/documentation\/issuingsdkdocs\/cardsessionsguide","abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"kind":"article","title":"Card Sessions","role":"article","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},"https://github.com/Adyen/adyen-card-reveal-ios":{"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","titleInlineContent":[{"text":"adyen-card-reveal-ios","type":"text"}],"title":"adyen-card-reveal-ios","type":"link","url":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"}}}