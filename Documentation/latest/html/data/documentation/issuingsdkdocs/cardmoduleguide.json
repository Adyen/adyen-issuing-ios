{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardmoduleguide"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module provides low-level cryptographic services for sensitive card operations. Unlike ","type":"text"},{"code":"CardSessions","type":"codeVoice"},{"text":" (which handles networking, session management, and token handling automatically), the ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module when you need:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Full control over the network layer (custom networking stack, interceptors, retry logic)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Integration into an architecture that doesn’t use "},{"type":"codeVoice","code":"async\/await"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Direct access to the encrypted keys and data for custom backend flows"}],"type":"paragraph"}]}]},{"type":"aside","name":"Tip","style":"tip","content":[{"inlineContent":[{"text":"If you prefer a higher-level API that handles networking and token management, use ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","isActive":true},{"text":" instead.","type":"text"}],"type":"paragraph"}]},{"anchor":"Import","type":"heading","level":2,"text":"Import"},{"syntax":"swift","type":"codeListing","code":["import Card"]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module is a standalone cryptographic library that can be used without the rest of the SDK.","type":"text"}],"type":"paragraph"}]},{"anchor":"Session-Token-Roles","type":"heading","level":2,"text":"Session Token Roles"},{"inlineContent":[{"text":"Your backend needs the following API credential roles to call the Adyen endpoints used in these flows:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Operation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Role","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Card reveal","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bank Issuing PaymentInstrument Reveal Webservice","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"PIN reveal","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bank Issuing Pin Reveal Webservice","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"PIN change","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Bank Issuing Pin Change Webservice","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Card-Reveal","type":"heading","level":2,"text":"Card Reveal"},{"inlineContent":[{"text":"Reveal the card’s PAN, CVC, and expiry date.","type":"text"}],"type":"paragraph"},{"anchor":"Flow","type":"heading","level":3,"text":"Flow"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=panReveal&format=jwk"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the public key to the SDK to generate an encrypted session key"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"type":"codeVoice","code":"POST \/paymentInstruments\/reveal"},{"type":"text","text":") and receives encrypted card data"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the encrypted data to the SDK to decrypt and obtain the card details"}],"type":"paragraph"}]}]},{"anchor":"Implementation","type":"heading","level":3,"text":"Implementation"},{"syntax":"swift","type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let cardRevealService = CardRevealService()","","\/\/ 2. Generate an encrypted key using the public key from your backend.","\/\/    The public key is the raw JWK data from the Adyen \/publicKey endpoint.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try cardRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/paymentInstruments\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns the `encryptedData` string from the response.","","\/\/ 4. Decrypt the card details using the same service instance","let details = try cardRevealService.cardDetails(","    encryptedData: encryptedData",")","","\/\/ Access the decrypted values","details.pan            \/\/ Full PAN, e.g. \"5412345678901234\"","details.cvc            \/\/ CVC, e.g. \"123\"","details.expiration.month  \/\/ e.g. \"03\"","details.expiration.year   \/\/ e.g. \"2028\""]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"cardDetails","type":"codeVoice"},{"text":" on the same ","type":"text"},{"code":"CardRevealService","type":"codeVoice"},{"text":" instance that produced the encrypted key. The instance retains the symmetric key generated by ","type":"text"},{"code":"generateEncryptedKey","type":"codeVoice"},{"text":"; calling ","type":"text"},{"code":"cardDetails","type":"codeVoice"},{"text":" before generating a key throws ","type":"text"},{"code":".keyNotGenerated","type":"codeVoice"},{"text":".","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key instead of JWK, use "},{"type":"codeVoice","code":"generateEncryptedKey(pem:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let encryptedKey = try cardRevealService.generateEncryptedKey(","    pem: derEncodedPublicKey",")"]},{"anchor":"Error-Handling","type":"heading","level":3,"text":"Error Handling"},{"inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"CardRevealService.CardRevealError"},{"type":"text","text":":"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Error"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Cause","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}]}],[{"inlineContent":[{"type":"text","text":"Key encryption failed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".keyNotGenerated"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" was called before "},{"type":"codeVoice","code":"generateEncryptedKey"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".invalidEncryptedData","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"The encrypted data string is not valid hex"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".decryptionFailed"}]}],[{"inlineContent":[{"type":"text","text":"AES decryption of the card data failed"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unexpectedData"}]}],[{"inlineContent":[{"type":"text","text":"Decryption succeeded but the payload could not be decoded"}],"type":"paragraph"}]]]},{"level":2,"type":"heading","text":"PIN Reveal","anchor":"PIN-Reveal"},{"inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Flow","anchor":"Flow"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinReveal&format=jwk"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass the public key to the SDK to generate an encrypted session key","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"type":"codeVoice","code":"POST \/pins\/reveal"},{"text":") and receives an encrypted PIN block and token","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass both to the SDK to decrypt and obtain the PIN"}]}]}],"type":"orderedList"},{"level":3,"type":"heading","text":"Implementation","anchor":"Implementation"},{"syntax":"swift","code":["import Card","","\/\/ 1. Initialize the service","let pinRevealService = PinRevealService()","","\/\/ 2. Generate an encrypted key.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try pinRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/pins\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns `encryptedPinBlock` and `token` from the response.","","\/\/ 4. Decrypt the PIN using the same service instance","let pin = try pinRevealService.pin(","    encryptedPinBlock: encryptedPinBlock,","    token: token",")"],"type":"codeListing"},{"anchor":"Error-Handling","level":3,"text":"Error Handling","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pin"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"PinRevealService.PinRevealError"},{"type":"text","text":":"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error"}]}],[{"inlineContent":[{"text":"Cause","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".invalidPublicKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Key encryption failed"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".keyNotGenerated","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"pin","type":"codeVoice"},{"text":" was called before ","type":"text"},{"code":"generateEncryptedKey","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The encrypted PIN block is not valid"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".decryptionFailed","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Decryption failed","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".unexpectedData","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Decrypted PIN block has an unexpected format","type":"text"}]}]]],"type":"table","header":"row"},{"type":"heading","level":2,"text":"PIN Change","anchor":"PIN-Change"},{"inlineContent":[{"type":"text","text":"Set a new PIN for the card."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Flow","text":"Flow"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinChange&format=jwk"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass the public key and the new PIN to the SDK to generate the encrypted payload","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Your backend sends the payload to Adyen ("},{"type":"codeVoice","code":"POST \/pins\/change"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Implementation","anchor":"Implementation"},{"type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let pinChangeService = PinChangeService()","","\/\/ 2. Generate the encrypted PIN block","let encryptedPin = try pinChangeService.encryptedPinBlock(","    jwk: publicKeyData,","    pin: newPin",")","","\/\/ 3. Send to your backend.","\/\/    Your backend calls POST \/pins\/change with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedPin.encryptedKey,","\/\/        \"encryptedPinBlock\": encryptedPin.encryptedPinBlock,","\/\/        \"token\": encryptedPin.token","\/\/    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you have a PEM\/DER-encoded public key:","type":"text"}]},{"type":"codeListing","code":["let encryptedPin = try pinChangeService.encryptedPinBlock(","    pem: derEncodedPublicKey,","    pin: newPin",")"],"syntax":"swift"},{"type":"heading","level":3,"text":"Error Handling","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"code":"encryptedPinBlock","type":"codeVoice"},{"text":" throws ","type":"text"},{"code":"PinChangeService.PinChangeError","type":"codeVoice"},{"text":":","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Error","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cause"}]}]],[[{"inlineContent":[{"code":".invalidPin","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The PIN is malformed (non-decimal characters, too long)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".unallowedPin","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The PIN is not permitted (sequential like ","type":"text"},{"type":"codeVoice","code":"1234"},{"text":", repeated like ","type":"text"},{"type":"codeVoice","code":"1111"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN encryption failed"}]}]]],"type":"table","header":"row"},{"type":"heading","level":2,"text":"Security Considerations","anchor":"Security-Considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module performs all cryptographic operations in memory. No sensitive data is written to disk."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The symmetric key generated during a reveal flow is ephemeral, held only for the lifetime of the service instance, and is never persisted or transmitted."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Never log or persist decrypted card details or PINs.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use a fresh "},{"type":"codeVoice","code":"CardRevealService"},{"text":" \/ ","type":"text"},{"code":"PinRevealService","type":"codeVoice"},{"type":"text","text":" instance per reveal operation, and generate a new encrypted key for each flow."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Migration from adyen-card-reveal-ios","anchor":"Migration-from-adyen-card-reveal-ios"},{"inlineContent":[{"type":"text","text":"If you previously used the standalone "},{"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","isActive":true,"type":"reference"},{"text":" package, the ","type":"text"},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a drop-in replacement. The public API is unchanged; only the import name differs:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Old API","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"New API"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import AdyenCardReveal"}]}],[{"inlineContent":[{"type":"codeVoice","code":"import Card"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey(jwk:)"},{"type":"text","text":" → "},{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unchanged"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cardDetails(encryptedData:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"unchanged","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"pin(encryptedPinBlock:, token:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unchanged"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"unchanged","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"Replace ","type":"text"},{"code":"import AdyenCardReveal","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"import Card","type":"codeVoice"},{"text":"; no other code changes are required.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardModuleGuide","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"role":"article","title":"Card (Low-Level)","roleHeading":"Article"},"kind":"article","abstract":[{"type":"text","text":"Reveal card details, reveal PINs, and change PINs using direct service calls."}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"title":"IssuingSDKDocs","kind":"symbol","url":"\/documentation\/issuingsdkdocs","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","abstract":[],"role":"collection"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"title":"Card Sessions","kind":"article","url":"\/documentation\/issuingsdkdocs\/cardsessionsguide","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"role":"article"},"https://github.com/Adyen/adyen-card-reveal-ios":{"type":"link","url":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","title":"adyen-card-reveal-ios","titleInlineContent":[{"type":"text","text":"adyen-card-reveal-ios"}],"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"}}}