{"sections":[],"abstract":[{"text":"Reveal card details, reveal PINs, and change PINs using direct service calls.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardModuleGuide","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module provides low-level cryptographic services for sensitive card operations. Unlike "},{"type":"codeVoice","code":"CardSessions"},{"type":"text","text":" (which handles networking, session management, and token handling automatically), the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module when you need:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full control over the network layer (custom networking stack, interceptors, retry logic)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Integration into an architecture that doesn’t use "},{"type":"codeVoice","code":"async\/await"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Direct access to the encrypted keys and data for custom backend flows"}]}]}],"type":"unorderedList"},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you prefer a higher-level API that handles networking and token management, use "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","isActive":true},{"type":"text","text":" instead."}]}],"type":"aside","name":"Tip"},{"text":"Import","level":2,"type":"heading","anchor":"Import"},{"syntax":"swift","type":"codeListing","code":["import Card"]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a standalone cryptographic library that can be used without the rest of the SDK."}]}],"type":"aside","name":"Note"},{"text":"Session Token Roles","level":2,"type":"heading","anchor":"Session-Token-Roles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend needs the following API credential roles to call the Adyen endpoints used in these flows:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Operation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Role"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card reveal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bank Issuing PaymentInstrument Reveal Webservice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN reveal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Reveal Webservice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN change"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Change Webservice"}]}]]]},{"text":"Card Reveal","level":2,"type":"heading","anchor":"Card-Reveal"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reveal the card’s PAN, CVC, and expiry date."}]},{"text":"Flow","level":3,"type":"heading","anchor":"Flow"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=panReveal&format=jwk"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the public key to the SDK to generate an encrypted session key"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"type":"codeVoice","code":"POST \/paymentInstruments\/reveal"},{"type":"text","text":") and receives encrypted card data"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the encrypted data to the SDK to decrypt and obtain the card details"}]}]}],"type":"orderedList"},{"text":"Implementation","level":3,"type":"heading","anchor":"Implementation"},{"syntax":"swift","type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let cardRevealService = CardRevealService()","","\/\/ 2. Generate an encrypted key using the public key from your backend.","\/\/    The public key is the raw JWK data from the Adyen \/publicKey endpoint.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try cardRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/paymentInstruments\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns the `encryptedData` string from the response.","","\/\/ 4. Decrypt the card details using the same service instance","let details = try cardRevealService.cardDetails(","    encryptedData: encryptedData",")","","\/\/ Access the decrypted values","details.pan            \/\/ Full PAN, e.g. \"5412345678901234\"","details.cvc            \/\/ CVC, e.g. \"123\"","details.expiration.month  \/\/ e.g. \"03\"","details.expiration.year   \/\/ e.g. \"2028\""]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" on the same "},{"type":"codeVoice","code":"CardRevealService"},{"type":"text","text":" instance that produced the encrypted key. The instance retains the symmetric key generated by "},{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":"; calling "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" before generating a key throws "},{"type":"codeVoice","code":".keyNotGenerated"},{"type":"text","text":"."}]}],"type":"aside","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key instead of JWK, use "},{"type":"codeVoice","code":"generateEncryptedKey(pem:)"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["let encryptedKey = try cardRevealService.generateEncryptedKey(","    pem: derEncodedPublicKey",")"]},{"text":"Error Handling","level":3,"type":"heading","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"CardRevealService.CardRevealError"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cause"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The public key could not be parsed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key encryption failed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".keyNotGenerated"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" was called before "},{"type":"codeVoice","code":"generateEncryptedKey"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The encrypted data string is not valid hex"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".decryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"AES decryption of the card data failed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unexpectedData"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decryption succeeded but the payload could not be decoded"}]}]]]},{"text":"PIN Reveal","level":2,"type":"heading","anchor":"PIN-Reveal"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN."}]},{"text":"Flow","level":3,"type":"heading","anchor":"Flow"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinReveal&format=jwk"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the public key to the SDK to generate an encrypted session key"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"type":"codeVoice","code":"POST \/pins\/reveal"},{"type":"text","text":") and receives an encrypted PIN block and token"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass both to the SDK to decrypt and obtain the PIN"}]}]}],"type":"orderedList"},{"text":"Implementation","level":3,"type":"heading","anchor":"Implementation"},{"syntax":"swift","type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let pinRevealService = PinRevealService()","","\/\/ 2. Generate an encrypted key.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try pinRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/pins\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns `encryptedPinBlock` and `token` from the response.","","\/\/ 4. Decrypt the PIN using the same service instance","let pin = try pinRevealService.pin(","    encryptedPinBlock: encryptedPinBlock,","    token: token",")"]},{"text":"Error Handling","level":3,"type":"heading","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pin"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"PinRevealService.PinRevealError"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cause"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The public key could not be parsed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key encryption failed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".keyNotGenerated"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pin"},{"type":"text","text":" was called before "},{"type":"codeVoice","code":"generateEncryptedKey"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The encrypted PIN block is not valid"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".decryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decryption failed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unexpectedData"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decrypted PIN block has an unexpected format"}]}]]]},{"text":"PIN Change","level":2,"type":"heading","anchor":"PIN-Change"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card."}]},{"text":"Flow","level":3,"type":"heading","anchor":"Flow"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinChange&format=jwk"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the public key and the new PIN to the SDK to generate the encrypted payload"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend sends the payload to Adyen ("},{"type":"codeVoice","code":"POST \/pins\/change"},{"type":"text","text":")"}]}]}],"type":"orderedList"},{"text":"Implementation","level":3,"type":"heading","anchor":"Implementation"},{"syntax":"swift","type":"codeListing","code":["import Card","","\/\/ 1. Initialize the service","let pinChangeService = PinChangeService()","","\/\/ 2. Generate the encrypted PIN block","let encryptedPin = try pinChangeService.encryptedPinBlock(","    jwk: publicKeyData,","    pin: newPin",")","","\/\/ 3. Send to your backend.","\/\/    Your backend calls POST \/pins\/change with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedPin.encryptedKey,","\/\/        \"encryptedPinBlock\": encryptedPin.encryptedPinBlock,","\/\/        \"token\": encryptedPin.token","\/\/    }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have a PEM\/DER-encoded public key:"}]},{"syntax":"swift","type":"codeListing","code":["let encryptedPin = try pinChangeService.encryptedPinBlock(","    pem: derEncodedPublicKey,","    pin: newPin",")"]},{"text":"Error Handling","level":3,"type":"heading","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"PinChangeService.PinChangeError"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cause"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPin"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The PIN is malformed (non-decimal characters, too long)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unallowedPin"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The PIN is not permitted (sequential like "},{"type":"codeVoice","code":"1234"},{"type":"text","text":", repeated like "},{"type":"codeVoice","code":"1111"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The public key could not be parsed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN encryption failed"}]}]]]},{"text":"Security Considerations","level":2,"type":"heading","anchor":"Security-Considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module performs all cryptographic operations in memory. No sensitive data is written to disk."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The symmetric key generated during a reveal flow is ephemeral, held only for the lifetime of the service instance, and is never persisted or transmitted."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Never log or persist decrypted card details or PINs."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a fresh "},{"type":"codeVoice","code":"CardRevealService"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"PinRevealService"},{"type":"text","text":" instance per reveal operation, and generate a new encrypted key for each flow."}]}]}],"type":"unorderedList"},{"text":"Migration from adyen-card-reveal-ios","level":2,"type":"heading","anchor":"Migration-from-adyen-card-reveal-ios"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you previously used the standalone "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"},{"type":"text","text":" package, the "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a drop-in replacement. The public API is unchanged; only the import name differs:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Old API"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"New API"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import AdyenCardReveal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import Card"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey(jwk:)"},{"type":"text","text":" → "},{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unchanged"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardDetails(encryptedData:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unchanged"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pin(encryptedPinBlock:, token:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unchanged"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unchanged"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace "},{"type":"codeVoice","code":"import AdyenCardReveal"},{"type":"text","text":" with "},{"type":"codeVoice","code":"import Card"},{"type":"text","text":"; no other code changes are required."}]}]}],"variants":[{"paths":["\/documentation\/issuingsdkdocs\/cardmoduleguide"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","title":"Card (Low-Level)","modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article"},"kind":"article","references":{"https://github.com/Adyen/adyen-card-reveal-ios":{"type":"link","titleInlineContent":[{"text":"adyen-card-reveal-ios","type":"text"}],"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","title":"adyen-card-reveal-ios","url":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"url":"\/documentation\/issuingsdkdocs\/cardsessionsguide","title":"Card Sessions","abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs","type":"topic","url":"\/documentation\/issuingsdkdocs","role":"collection","kind":"symbol"}}}