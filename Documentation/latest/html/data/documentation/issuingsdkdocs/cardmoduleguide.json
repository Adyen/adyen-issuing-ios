{"variants":[{"paths":["\/documentation\/issuingsdkdocs\/cardmoduleguide"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module provides low-level cryptographic services for sensitive card operations. Unlike "},{"code":"CardSessions","type":"codeVoice"},{"text":" (which handles networking, session management, and token handling automatically), the ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module is a pure crypto library: you manage all network calls yourself and use the SDK only for encryption and decryption.","type":"text"}]},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module when you need:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Full control over the network layer (custom networking stack, interceptors, retry logic)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Integration into an architecture that doesn’t use "},{"type":"codeVoice","code":"async\/await"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Direct access to the encrypted keys and data for custom backend flows"}]}]}],"type":"unorderedList"},{"style":"tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"If you prefer a higher-level API that handles networking and token management, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},{"text":" instead.","type":"text"}]}],"name":"Tip"},{"type":"heading","text":"Import","level":2,"anchor":"Import"},{"code":["import Card"],"syntax":"swift","type":"codeListing"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Card"},{"type":"text","text":" module is a standalone cryptographic library that can be used without the rest of the SDK."}],"type":"paragraph"}],"name":"Note"},{"anchor":"Session-Token-Roles","text":"Session Token Roles","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Your backend needs the following API credential roles to call the Adyen endpoints used in these flows:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Operation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Role"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card reveal"}]}],[{"inlineContent":[{"code":"Bank Issuing PaymentInstrument Reveal Webservice","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"PIN reveal"}]}],[{"inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Reveal Webservice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"PIN change","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"Bank Issuing Pin Change Webservice"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Card-Reveal","text":"Card Reveal","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Reveal the card’s PAN, CVC, and expiry date.","type":"text"}]},{"text":"Flow","type":"heading","level":3,"anchor":"Flow"},{"items":[{"content":[{"inlineContent":[{"text":"Your backend fetches a public key from Adyen (","type":"text"},{"code":"GET \/publicKey?purpose=panReveal&format=jwk","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the public key to the SDK to generate an encrypted session key"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"code":"POST \/paymentInstruments\/reveal","type":"codeVoice"},{"text":") and receives encrypted card data","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass the encrypted data to the SDK to decrypt and obtain the card details"}]}]}],"type":"orderedList"},{"anchor":"Implementation","text":"Implementation","type":"heading","level":3},{"code":["import Card","","\/\/ 1. Initialize the service","let cardRevealService = CardRevealService()","","\/\/ 2. Generate an encrypted key using the public key from your backend.","\/\/    The public key is the raw JWK data from the Adyen \/publicKey endpoint.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try cardRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/paymentInstruments\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns the `encryptedData` string from the response.","","\/\/ 4. Decrypt the card details using the same service instance","let details = try cardRevealService.cardDetails(","    encryptedData: encryptedData",")","","\/\/ Access the decrypted values","details.pan            \/\/ Full PAN, e.g. \"5412345678901234\"","details.cvc            \/\/ CVC, e.g. \"123\"","details.expiration.month  \/\/ e.g. \"03\"","details.expiration.year   \/\/ e.g. \"2028\""],"syntax":"swift","type":"codeListing"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"cardDetails","type":"codeVoice"},{"text":" on the same ","type":"text"},{"type":"codeVoice","code":"CardRevealService"},{"text":" instance that produced the encrypted key. The instance retains the symmetric key generated by ","type":"text"},{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":"; calling "},{"code":"cardDetails","type":"codeVoice"},{"text":" before generating a key throws ","type":"text"},{"type":"codeVoice","code":".keyNotGenerated"},{"type":"text","text":"."}]}],"name":"Important"},{"inlineContent":[{"text":"If you have a PEM\/DER-encoded public key instead of JWK, use ","type":"text"},{"type":"codeVoice","code":"generateEncryptedKey(pem:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let encryptedKey = try cardRevealService.generateEncryptedKey(","    pem: derEncodedPublicKey",")"],"type":"codeListing"},{"type":"heading","text":"Error Handling","anchor":"Error-Handling","level":3},{"inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" throw "},{"type":"codeVoice","code":"CardRevealService.CardRevealError"},{"text":":","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cause"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The public key could not be parsed"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".encryptionFailed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key encryption failed"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".keyNotGenerated","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardDetails"},{"type":"text","text":" was called before "},{"code":"generateEncryptedKey","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}]}],[{"type":"paragraph","inlineContent":[{"text":"The encrypted data string is not valid hex","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".decryptionFailed","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"AES decryption of the card data failed"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unexpectedData"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Decryption succeeded but the payload could not be decoded"}],"type":"paragraph"}]]],"type":"table"},{"type":"heading","level":2,"text":"PIN Reveal","anchor":"PIN-Reveal"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN.","type":"text"}]},{"anchor":"Flow","text":"Flow","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinReveal&format=jwk"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the public key to the SDK to generate an encrypted session key"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Your backend sends the encrypted key to Adyen ("},{"type":"codeVoice","code":"POST \/pins\/reveal"},{"type":"text","text":") and receives an encrypted PIN block and token"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pass both to the SDK to decrypt and obtain the PIN","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Implementation","text":"Implementation","type":"heading","level":3},{"code":["import Card","","\/\/ 1. Initialize the service","let pinRevealService = PinRevealService()","","\/\/ 2. Generate an encrypted key.","\/\/    The service retains the generated symmetric key for the decryption step.","let encryptedKey = try pinRevealService.generateEncryptedKey(","    jwk: publicKeyData",")","","\/\/ 3. Send `encryptedKey` to your backend.","\/\/    Your backend calls POST \/pins\/reveal with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedKey","\/\/    }","\/\/    and returns `encryptedPinBlock` and `token` from the response.","","\/\/ 4. Decrypt the PIN using the same service instance","let pin = try pinRevealService.pin(","    encryptedPinBlock: encryptedPinBlock,","    token: token",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Error-Handling","text":"Error Handling","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"generateEncryptedKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"pin"},{"type":"text","text":" throw "},{"code":"PinRevealService.PinRevealError","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Error","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cause","type":"text"}]}]],[[{"inlineContent":[{"code":".invalidPublicKey","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The public key could not be parsed","type":"text"}]}]],[[{"inlineContent":[{"code":".encryptionFailed","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Key encryption failed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".keyNotGenerated","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"pin","type":"codeVoice"},{"text":" was called before ","type":"text"},{"code":"generateEncryptedKey","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidEncryptedData"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The encrypted PIN block is not valid","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".decryptionFailed","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Decryption failed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".unexpectedData","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decrypted PIN block has an unexpected format","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"PIN-Change","level":2,"text":"PIN Change","type":"heading"},{"inlineContent":[{"text":"Set a new PIN for the card.","type":"text"}],"type":"paragraph"},{"anchor":"Flow","text":"Flow","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend fetches a public key from Adyen ("},{"type":"codeVoice","code":"GET \/publicKey?purpose=pinChange&format=jwk"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Pass the public key and the new PIN to the SDK to generate the encrypted payload","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Your backend sends the payload to Adyen (","type":"text"},{"code":"POST \/pins\/change","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Implementation","text":"Implementation","type":"heading","level":3},{"code":["import Card","","\/\/ 1. Initialize the service","let pinChangeService = PinChangeService()","","\/\/ 2. Generate the encrypted PIN block","let encryptedPin = try pinChangeService.encryptedPinBlock(","    jwk: publicKeyData,","    pin: newPin",")","","\/\/ 3. Send to your backend.","\/\/    Your backend calls POST \/pins\/change with:","\/\/    {","\/\/        \"paymentInstrumentId\": \"PI123...\",","\/\/        \"encryptedKey\": encryptedPin.encryptedKey,","\/\/        \"encryptedPinBlock\": encryptedPin.encryptedPinBlock,","\/\/        \"token\": encryptedPin.token","\/\/    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you have a PEM\/DER-encoded public key:","type":"text"}],"type":"paragraph"},{"code":["let encryptedPin = try pinChangeService.encryptedPinBlock(","    pem: derEncodedPublicKey,","    pin: newPin",")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Error Handling","anchor":"Error-Handling","type":"heading"},{"inlineContent":[{"code":"encryptedPinBlock","type":"codeVoice"},{"type":"text","text":" throws "},{"type":"codeVoice","code":"PinChangeService.PinChangeError"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Error"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cause","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPin"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The PIN is malformed (non-decimal characters, too long)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unallowedPin"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The PIN is not permitted (sequential like ","type":"text"},{"code":"1234","type":"codeVoice"},{"text":", repeated like ","type":"text"},{"type":"codeVoice","code":"1111"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidPublicKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The public key could not be parsed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".encryptionFailed","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"PIN encryption failed","type":"text"}]}]]]},{"type":"heading","level":2,"text":"Security Considerations","anchor":"Security-Considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module performs all cryptographic operations in memory. No sensitive data is written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The symmetric key generated during a reveal flow is ephemeral, held only for the lifetime of the service instance, and is never persisted or transmitted."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Never log or persist decrypted card details or PINs.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Use a fresh ","type":"text"},{"code":"CardRevealService","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"PinRevealService","type":"codeVoice"},{"text":" instance per reveal operation, and generate a new encrypted key for each flow.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Migration from adyen-card-reveal-ios","anchor":"Migration-from-adyen-card-reveal-ios"},{"inlineContent":[{"text":"If you previously used the standalone ","type":"text"},{"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","isActive":true,"type":"reference"},{"text":" package, the ","type":"text"},{"code":"Card","type":"codeVoice"},{"text":" module is a drop-in replacement. The public API is unchanged; only the import name differs:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Old API","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"New API","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import AdyenCardReveal"}]}],[{"type":"paragraph","inlineContent":[{"code":"import Card","type":"codeVoice"}]}]],[[{"inlineContent":[{"code":"generateEncryptedKey(jwk:)","type":"codeVoice"},{"type":"text","text":" → "},{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"unchanged"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardDetails(encryptedData:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"unchanged"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"pin(encryptedPinBlock:, token:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"unchanged"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"encryptedPinBlock(pem:, pin:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"unchanged","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"Replace ","type":"text"},{"code":"import AdyenCardReveal","type":"codeVoice"},{"type":"text","text":" with "},{"code":"import Card","type":"codeVoice"},{"text":"; no other code changes are required.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardModuleGuide"},"metadata":{"roleHeading":"Article","title":"Card (Low-Level)","modules":[{"name":"IssuingSDKDocs"}],"role":"article"},"abstract":[{"type":"text","text":"Reveal card details, reveal PINs, and change PINs using direct service calls."}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"type":"topic","title":"Card Sessions","role":"article","abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","url":"\/documentation\/issuingsdkdocs\/cardsessionsguide"},"https://github.com/Adyen/adyen-card-reveal-ios":{"type":"link","url":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","titleInlineContent":[{"text":"adyen-card-reveal-ios","type":"text"}],"identifier":"https:\/\/github.com\/Adyen\/adyen-card-reveal-ios","title":"adyen-card-reveal-ios"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"type":"topic","title":"IssuingSDKDocs","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs"}}}