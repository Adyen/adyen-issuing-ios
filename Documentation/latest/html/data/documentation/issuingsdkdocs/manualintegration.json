ment: .live",")"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Wallet Extension Support","anchor":"Wallet-Extension-Support"},{"inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following framework with "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"CardProvisioningSessions.xcframework"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In the extension, use the same import:"}],"type":"paragraph"},{"code":["import CardProvisioningSessions"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Verify the Integration","anchor":"Verify-the-Integration"},{"inlineContent":[{"type":"text","text":"After embedding:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Build the project. All three frameworks should compile and link without errors."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run on the iOS Simulator to verify basic initialization."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Test provisioning on a physical device (simulators do not support Apple Wallet)."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Troubleshooting","anchor":"Troubleshooting"},{"type":"heading","level":3,"text":"“No such module ‘CardProvisioningSessions’” or “No such module ‘CardSessions’”","anchor":"No-such-module-CardProvisioningSessions-or-No-such-module-CardSessions"},{"inlineContent":[{"type":"text","text":"Ensure the XCFramework is added to your target’s "},{"type":"strong","inlineContent":[{"text":"Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":" section and is set to "},{"type":