ion."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Test provisioning on a physical device (simulators do not support Apple Wallet).","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Troubleshooting","type":"heading","anchor":"Troubleshooting"},{"level":3,"text":"“No such module ‘CardProvisioningSessions’” or “No such module ‘CardSessions’”","anchor":"No-such-module-CardProvisioningSessions-or-No-such-module-CardSessions","type":"heading"},{"inlineContent":[{"text":"Ensure the XCFramework is added to your target’s ","type":"text"},{"inlineContent":[{"text":"Frameworks, Libraries, and Embedded Content","type":"text"}],"type":"strong"},{"text":" section and is set to ","type":"text"},{"inlineContent":[{"type":"text","text":"Embed & Sign"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Duplicate symbols","anchor":"Duplicate-symbols","type":"heading"},{"inlineContent":[{"text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","metadata":{"modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article","role":"article","title":"Manual Integration"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/manualintegration"]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"title":"IssuingSDKDocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","kind":"symbol","url":"\/documentation\/issuingsdkdocs","type":"topic"}}}