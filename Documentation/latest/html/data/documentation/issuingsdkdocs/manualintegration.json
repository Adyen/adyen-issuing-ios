ow"},{"text":"Card (Low-Level PAN\/PIN Reveal, PIN Change)","type":"heading","anchor":"Card-Low-Level-PANPIN-Reveal-PIN-Change","level":3},{"type":"paragraph","inlineContent":[{"text":"If you prefer direct control over the network layer:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Framework","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Card.xcframework","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Low-level cryptographic services (no networking)","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"level":2,"text":"Embed the Frameworks","type":"heading","anchor":"Embed-the-Frameworks"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Drag the "},{"type":"codeVoice","code":".xcframework"},{"type":"text","text":" bundles for your chosen integration path into your Xcode project navigator (see the Required Frameworks section above)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select your app target, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"General > Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"text":". Include only the frameworks for the features you use:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sessions approach (provisioning):"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"CardProvisioningSessions.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Manual approach (provisioning