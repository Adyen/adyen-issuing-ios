{"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"metadata":{"title":"A Starting Guide (Sessions)","modules":[{"name":"IssuingSDKDocs"}],"role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"kind":"article","identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/issuingsdkdocs\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}],"type":"strong"},{"type":"text","text":" — Add payment cards to Apple Wallet"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Card Sessions"}],"type":"strong"},{"text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"level":2,"text":"Prerequisites","type":"heading","anchor":"Prerequisites"},{"type":"paragraph","inlineContent":[{"text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}]},{"level":2,"text":"Embed the Certificate","type":"heading","anchor":"Embed-the-Certificate"},{"inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Fetch a Session Token","type":"heading","anchor":"Fetch-a-Session-Token"},{"inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Environment","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"URL","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Test","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Live","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"https:\/\/authe-live.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}],"type":"paragraph"}]]]},{"inlineContent":[{"inlineContent":[{"text":"Headers:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type: application\/json"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body:"}]}],"type":"paragraph"},{"syntax":"json","code":["{","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"],"type":"codeListing"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"The required ","type":"text"},{"type":"codeVoice","code":"roles"},{"text":" depend on the SDK feature you are using. See the feature-specific documentation for details.","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"text":"Your backend should receive the session token and pass it to your iOS application.","type":"text"}],"type":"paragraph"},{"text":"Import the SDK","level":2,"anchor":"Import-the-SDK","type":"heading"},{"inlineContent":[{"text":"Add the appropriate import statements at the top of your Swift files:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import CardProvisioningSessions","import IssuingCommon"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}],"type":"paragraph"}],"name":"Note"},{"type":"heading","text":"Implement a Token Provider","level":2,"anchor":"Implement-a-Token-Provider"},{"type":"paragraph","inlineContent":[{"text":"Your app needs an object that conforms to the ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}]},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing","syntax":"swift"},{"anchor":"Device-Testing-Requirements","level":2,"type":"heading","text":"Device Testing Requirements"},{"type":"paragraph","inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"text":"Release build on a physical device","type":"text"}],"type":"strong"},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}]},{"type":"heading","anchor":"Next-Steps","text":"Next Steps","level":2},{"inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide","isActive":true},{"type":"text","text":" — Understand the two provisioning approaches and choose the right one for your architecture"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","isActive":true},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide"},{"type":"text","text":" — Add cards to Apple Wallet with direct control over each provisioning step"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","isActive":true},{"text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)","type":"text"}]}]}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardSessionsGuide":{"type":"topic","url":"\/documentation\/issuingsdkdocs\/cardsessionsguide","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","title":"Card Sessions","kind":"article","role":"article","abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}]},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","kind":"symbol","abstract":[],"title":"IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs","type":"topic","role":"collection"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SessionsProvisioningGuide":{"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"title":"Card Provisioning Sessions","url":"\/documentation\/issuingsdkdocs\/sessionsprovisioningguide","type":"topic","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/OfflineProvisioningGuide":{"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet with direct control over each step of the provisioning flow."}],"title":"Card Provisioning (Offline)","url":"\/documentation\/issuingsdkdocs\/offlineprovisioningguide","type":"topic","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/CardProvisioningGuide":{"kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide","abstract":[{"type":"text","te