agraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Obtain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"text":"App Attest","type":"text"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"type":"text","text":") to your app:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set to "},{"type":"codeVoice","code":"\"development\""},{"type":"text","text":" for testing. Use "},{"type":"codeVoice","code":"SessionEnvironment.test"},{"type":"text","text":". Card operations work fully, but the provisioning flow is limited."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set to "},{"type":"codeVoice","code":"\"production\""},{"type":"text","text":" for production. Use "},{"type":"codeVoice","code":"SessionEnvironment.live"},{"type":"text","text":". The full provisioning flow requires an App Store or TestFlight build."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"TestFlight builds automatically set the App Attest environment to "},{"type":"codeVoice","code":"\"production\""},{"type":"text","text":"."}]}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"anchor":"Embed-the-Certificate","level":2,"type":"heading","text":"Embed the Certificate"},{"type":"paragraph","inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}]},{"anchor":"Fetch-a-Session-Token","level":2,"type":"heading","text":"Fetch a Session Token"},{"type":"paragraph","inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}]},{"type":"paragraph","inlin