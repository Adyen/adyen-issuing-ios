{"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"sections":[],"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/gettingstarted"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card Provisioning Sessions"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card Sessions"}]},{"type":"text","text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}]},{"type":"heading","text":"Prerequisites","anchor":"Prerequisites","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK."}]},{"type":"heading","text":"Embed the Certificate","anchor":"Embed-the-Certificate","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}]},{"type":"heading","text":"Fetch a Session Token","anchor":"Fetch-a-Session-Token","level"