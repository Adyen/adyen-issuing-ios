 for details.","type":"text"}]}],"style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend should receive the session token and pass it to your iOS application."}]},{"type":"heading","text":"Import the SDK","anchor":"Import-the-SDK","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the appropriate import statements at the top of your Swift files:"}]},{"type":"codeListing","code":["import CardProvisioningSessions","import IssuingCommon"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Do not import ","type":"text"},{"code":"IssuingCore","type":"codeVoice"},{"text":" directly. It is an internal dependency that is required at link time but has no public API for integrators.","type":"text"}]}],"style":"note"},{"type":"heading","text":"Implement a Token Provider","anchor":"Implement-a-Token-Provider","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}]},{"type":"codeListing","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"syntax":"swift"},{"type":"heading","text":"Device Testing Requirements","anchor":"Device-Testing-Requirements","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK requires a "},{"type":"strong","inlineContent":[{"text":"Release build on a physical device","type":"text"}]},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}]},{"type":"heading","text":"Next Steps","anchor":"Next-Steps","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once you have completed the common setup, proceed to the feature-specific guide:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide","isActive":true},{"type":"text","text":" — Understand the two provisioning approaches and choose the right one for your architecture"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","isActive":true},{"type":"text","text":" — Add cards to Apple Wallet using the session-based API (recommended)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide","isActive":true},{"type":"text","text":" — Add cards to Apple Wallet with direct control over each provisioning step"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","isActive":true},{"type":"text","text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)"}],"type":"paragraph"}]}]}]}],"kind":"