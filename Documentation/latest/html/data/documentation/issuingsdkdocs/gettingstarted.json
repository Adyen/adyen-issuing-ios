code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This gives you access to all public types, including "},{"code":"TokenProviding","type":"codeVoice"},{"type":"text","text":", "},{"code":"Configuration","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"text":" directly. It is an internal dependency that is required at link time but has no public API for integrators.","type":"text"}]}]},{"level":2,"anchor":"Implement-a-Token-Provider","type":"heading","text":"Implement a Token Provider"},{"inlineContent":[{"text":"Your app needs an object that conforms to the ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}],"type":"paragraph"},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"syntax":"swift","type":"codeListing"},{"anchor":"Device-Testing-Requirements","type":"heading","text":"Device Testing Requirements","level":2},{"inlineContent":[{"type":"text","text":"The SDK requires a "},{"type":"strong","inlineContent":[{"text":"Release build on a physical device","type":"text"}]},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for