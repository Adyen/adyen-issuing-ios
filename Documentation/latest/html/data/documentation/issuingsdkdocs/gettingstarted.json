}]},{"level":2,"text":"Import the SDK","anchor":"Import-the-SDK","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the appropriate import statements at the top of your Swift files:"}]},{"code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This gives you access to all public types, including ","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"text":", and ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":".","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Implement-a-Token-Provider","text":"Implement a Token Provider","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"code":"TokenProviding","type":"codeVoice"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}]},{"code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing","syntax":"swift"},{"text":"Device Testing Requirements","type":"heading","level":2,"anchor":"Device-Testing-Requirements"},{"inlineContent":[{"text":"The SDK requires a ","type":"t