inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Perform a ","type":"text"},{"type":"codeVoice","code":"POST"},{"text":" request to the following endpoint:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Environment"}],"type":"paragraph"}],[{"inlineContent":[{"text":"URL","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Test","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Live"}]}],[{"inlineContent":[{"type":"codeVoice","code":"https:\/\/authe-live.adyen.com\/authe\/api\/v1\/sessions"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Headers:","type":"text"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type: application\/json"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Body:","type":"text"}],"type":"strong"}]},{"syntax":"json","code":["{","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"],"type":"codeListing"},{"type":"aside","content":[{"inlineContent":[{"text":"The required ","type":"text"},{"type":"codeVoice","code":"roles"},{"type":"text","text":" depend on the SDK feature you are using. See the feature-specific documentation for details."}],"type":"paragraph"}],"style":"note","name":"Note"},{"inlineContent":[{"text":"Your backend should receive the session token and pass it to your iOS application.","type":"text"}],"type":"paragraph"},{"text":"Import the SDK","type":"heading","level":2,"anchor":"Import-the-SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the appropriate import statements at the top of your Swift files:"}]},{"code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This gives you access to all public types, including ","type":"text"},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":"."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}],"name":"Note","style":"note","type":"aside"},{"type":"heading","anchor":"Implement-a-Token-Provider","level":2,"text":"Implement a Token Provider"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"code":"TokenProviding","type":"codeVoice"},{"text":" protocol. This object is responsible for supplying the session token fetched in the previous step.","type":"text"}]},{"syntax":"swift","code":["import IssuingCommon","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing"},{"text":"Device Testing Requirements","type":"heading","level":2,"anchor":"Device-Testing-Requirements"},{"type":"paragraph","inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"text":"Release build on a physical device","type":"text"}],"type":"strong"},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}]},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide covered the common, sessions-based setup. Continue with the feature-specific guide for what you want to build:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","type":"reference","isActive":true},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},{"type":"text","text":" — Reveal card details, reveal PIN, change PIN (Work in Progress)"}]}]}]}]}],"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SessionsProvisioningGuide":{"title":"Card Provisioning Sessions","abstract":[{"text":"Add payment cards to Apple Wallet using the session-based API.","type":"text"}],"type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","kind":"article","role":"article","url":"\/documentation\/issuingsdkdocs\/sessionsprovisioningguide"},"https://www.adyen.com/issuing":{"url"