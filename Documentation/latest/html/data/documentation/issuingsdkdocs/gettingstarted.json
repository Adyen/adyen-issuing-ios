{"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Provisioning Sessions","type":"text"}]},{"type":"text","text":" — Add payment cards to Apple Wallet"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Card Sessions","type":"text"}]},{"text":" — Securely reveal card details (PAN, CVC, expiry), reveal PIN, and change PIN (Work in Progress)","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This guide covers the common setup steps required for all SDK features.","type":"text"}]},{"type":"heading","text":"Requirements","anchor":"Requirements","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 16.0+"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Swift 5.9+"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Xcode 16+"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"https:\/\/www.adyen.com\/issuing","isActive":true,"type":"reference"},{"type":"text","text":" integration on your backend"}]}]}],"type":"unorderedList"},{"text":"Prerequisites","level":2,"anchor":"Prerequisites","type":"heading"},{"inlineContent":[{"text":"Before you begin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"strong","inlineContent":[{"text":"App Attest","type":"text"}]},{"text":" entitlement (","type":"text"},{"type":"codeVoice","code":"com.apple.developer.devicecheck.appattest-environment"},{"text":") to your app:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Set to ","type":"text"},{"type":"codeVoice","code":"\"development\""},{"type":"text","text":" for testing. Use "},{"type":"codeVoice","code":"SessionEnvironment.test"},{"type":"text","text":". Card operations work fully, but the provisioning flow is limited."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set to ","type":"text"},{"code":"\"production\"","type":"codeVoice"},{"text":" for production. Use ","type":"text"},{"code":"SessionEnvironment.live","type":"codeVoice"},{"type":"text","text":". The full provisioning flow requires an App Store or TestFlight build."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"TestFlight builds automatically set the App Attest environment to ","type":"text"},{"code":"\"production\"","type":"codeVoice"},{"text":".","type":"text"}]}]}]}]}],"type":"orderedList"},{"text":"Embed the Certificate","type":"heading","anchor":"Embed-the-Certificate","level":2},{"type":"paragraph","inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}]},{"type":"heading","text":"Fetch a Session Token","level":2,"anchor":"Fetch-a-Session-Token"},{"inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Perform a "},{"code":"POST","type":"codeVoice"},{"text":" request to the following endpoint:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"type"