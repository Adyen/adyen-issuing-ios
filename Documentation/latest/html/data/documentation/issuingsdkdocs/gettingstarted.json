Token = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"]},{"anchor":"Device-Testing-Requirements","text":"Device Testing Requirements","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK requires a "},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}],"type":"paragraph"},{"anchor":"Next-Steps","text":"Next Steps","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Once you have completed the common setup, proceed to the feature-specific guide:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardProvisioningGuide","isActive":true},{"text":" — Understand the two provisioning approaches and choose the right one for your architecture","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","type":"reference"},{"text":" — Add cards to Apple Wallet using the session-based API (recommended)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/OfflineProvisioningGuide"},{"type":"text","text":" — Add cards to Apple Wallet with direct control over each provisioning step"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","type":"reference","isActive":true},{"text":" — Reveal card details, reveal PIN, change PIN