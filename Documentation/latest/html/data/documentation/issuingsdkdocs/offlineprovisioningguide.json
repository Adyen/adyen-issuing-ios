{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","title":"Card Provisioning (Offline)","modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Offline approach uses the ","type":"text"},{"code":"CardProvisioning","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CardProvisioningExtension","type":"codeVoice"},{"text":" packages. Your backend fetches ","type":"text"},{"code":"sdkInput","type":"codeVoice"},{"text":" activation data from the Adyen API and passes it to your app, which passes it directly to the SDK. You handle delegate callbacks to exchange ","type":"text"},{"code":"sdkOutput","type":"codeVoice"},{"text":" with your backend and complete provisioning.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"text":"“Offline” refers to the SDK itself — it makes no network requests. Your app and backend are still fully responsible for all networking with the Adyen API. The SDK only processes the data you hand to it and produces the cryptographic output you hand back.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"This approach is suitable when your app already owns its networking layer and requires fine-grained control over each provisioning step.","type":"text"}]},{"style":"important","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"},{"level":2,"text":"Import","type":"heading","anchor":"Import"},{"type":"paragraph","inlineContent":[{"text":"In your main app target:","type":"text"}]},{"code":["import CardProvisioning"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"In your Wallet extension target:","type":"text"}]},{"code":["import CardProvisioningExtension"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Get Activation Data","type":"heading","anchor":"Get-Activation-Data"},{"type":"paragraph","inlineContent":[{"text":"Before initializing the SDK, your backend must fetch the ","type":"text"},{"code":"sdkInput","type":"codeVoice"},{"text":" activation data for the payment instrument.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"From your backend, make a ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":" request to the ","type":"text"},{"code":"\/paymentInstruments\/{id}\/networkTokenActivationData","type":"codeVoice"},{"text":" endpoint:","type":"text"}]},{"code":["curl https:\/\/balanceplatform-api-test.adyen.com\/bcl\/v2\/paymentInstruments\/{id}\/networkTokenActivationData \\","  -H 'x-api-key: YOUR_BALANCE_PLATFORM_API_KEY'"],"type":"codeListing","syntax":"bash"},{"type":"paragraph","inlineContent":[{"text":"Your API credential needs the ","type":"text"},{"inlineContent":[{"text":"Bank Issuing PaymentInstrument Network Token Activation Data","type":"text"}],"type":"strong"},{"text":" role.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The response contains the ","type":"text"},{"code":"sdkInput","type":"codeVoice"},{"text":" object. Pass it to your iOS app. Also cache it — you will need it later for the Wallet extension.","type":"text"}]},{"level":2,"text":"Initialize the Provisioning Service","type":"heading","anchor":"Initialize-the-Provisioning-Service"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"ProvisioningService","type":"codeVoice"},{"text":" using the ","type":"text"},{"code":"sdkInput","type":"codeVoice"},{"text":" received from your backend:","type":"text"}]},{"code":["do {","    provisioningService = try ProvisioningService(sdkInput: sdkInput)","} catch {","    \/\/ Handle initialization error","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Check if a Card Can Be Added","type":"heading","anchor":"Check-if-a-Card-Can-Be-Added"},{"type":"paragraph","inlineContent":[{"text":"Before showing the ","type":"text"},{"inlineContent":[{"text":"Add to Apple Wallet","type":"text"}],"type":"strong"},{"text":" button, check whether the card can be added to this device or a paired Apple Watch.","type":"text"}]},{"code":["let isWatchActivated = await WatchAvailability.activate()","let state = provisioningService.canAddCardDetails(isWatchActivated: isWatchActivated)","","if state.canAddCard {","    \/\/ Show \"Add to Apple Wallet\" button","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"canAddCard","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", the card is already present in Wallet on all available devices.","type":"text"}]},{"style":"tip","content":[{"inlineContent":[{"text":"If a card appears in Wallet but ","type":"text"},{"type":"codeVoice","code":"canAddCard"},{"text":" is still ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", the card’s configuration profile on the card network side (Visa, Mastercard) is likely not yet complete.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Tip"},{"level":2,"text":"Initiate Card Provisioning","type":"heading","anchor":"Initiate-Card-Provisioning"},{"type":"paragraph","inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"inlineContent":[{"text":"Add to Apple Wallet","type":"text"}],"type":"strong"},{"text":", start provisioning:","type":"text"}]},{"code":["try provisioningService.start(","    delegate: self,","    presentingViewController: viewController",")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Handle the Provisioning Callback","type":"heading","anchor":"Handle-the-Provisioning-Callback"},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"code":"ProvisioningServiceDelegate","type":"codeVoice"},{"text":". The SDK calls ","type":"text"},{"code":"provision(sdkOutput:paymentInstrumentId:)","type":"codeVoice"},{"text":" when it needs your backend to generate the final activation data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In this callback:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"POST"},{"type":"text","text":" the "},{"type":"codeVoice","code":"sdkOutput"},{"type":"text","text":" to your backend, which calls "},{"type":"codeVoice","code":"\/paymentInstruments\/{id}\/networkTokenActivationData"},{"type":"text","text":" with the output."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Return the new "},{"type":"codeVoice","code":"sdkInput"},{"type":"text","text":" from the response."}],"type":"paragraph"}]}]},{"code":["func provision(sdkOutput: Data, paymentInstrumentId: String) async -> Data? {","    struct RequestBody: Encodable { let sdkOutput: Data }","    struct Response: Decodable { let sdkInput: Data }","","    do {","        let encoder = JSONEncoder()","        encoder.dataEncodingStrategy = .base64","        let body = try encoder.encode(RequestBody(sdkOutput: sdkOutput))","","        let responseData = try await yourNetworkClient.post(body: body)","","        let decoder = JSONDecoder()","        decoder.dataDecodingStrategy = .base64","        return try decoder.decode(Response.self, from: responseData).sdkInput","    } catch {","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Finalize Provisioning","type":"heading","anchor":"Finalize-Provisioning"},{"type":"paragraph","inlineContent":[{"text":"When provisioning is complete, the SDK calls ","type":"text"},{"code":"didFinishProvisioning","type":"codeVoice"},{"text":". Update your UI here.","type":"text"}]},{"code":["func didFinishProvisioning(with pass: PKPaymentPass?, error: Error?) {","    if let pass {","        \/\/ Card successfully added to Apple Wallet","    } else if let error {","        \/\/ Handle the error","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Wallet Extension","type":"heading","anchor":"Wallet-Extension"},{"type":"paragraph","inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"text":" section.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Offline approach uses ","type":"text"},{"code":"ExtensionProvisioningService","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"CardProvisioningExtension","type":"codeVoice"},{"text":". You subclass ","type":"text"},{"code":"PKIssuerProvisioningExtensionHandler","type":"codeVoice"},{"text":" directly and implement the required Apple provisioning extension methods, delegating the heavy lifting to ","type":"text"},{"code":"ExtensionProvisioningService","type":"codeVoice"},{"text":".","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"text":"You are responsible for caching ","type":"text"},{"type":"codeVoice","code":"sdkInput"},{"text":" and making it available to the extension. The extension itself cannot make time-sensitive network calls for the ","type":"text"},{"type":"codeVoice","code":"status()"},{"text":" method.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"level":3,"text":"Prerequisites","type":"heading","anchor":"Prerequisites"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A shared keychain or app group must be configured so the main app can pass cached "},{"type":"codeVoice","code":"sdkInput"},{"type":"text","text":" to the extension."}],"type":"paragraph"}]}]},{"level":3,"text":"Step 1: Create the Non-UI Extension Target","type":"heading","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"type":"text","text":" and select "},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletNonUIExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add a shared app group entitlement (e.g., "},{"type":"codeVoice","code":"group.com.yourcompany.wallet"},{"type":"text","text":") matching the one in your main app."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningExtension"},{"type":"text","text":" as a dependency of this target."}],"type":"paragraph"}]}]},{"level":3,"text":"Step 2: Cache sdkInput in the Main App","type":"heading","anchor":"Step-2-Cache-sdkInput-in-the-Main-App"},{"type":"paragraph","inlineContent":[{"text":"After fetching ","type":"text"},{"code":"sdkInput","type":"codeVoice"},{"text":" in your main app, store it in a location accessible to the extension (for example, a shared ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" suite or a shared keychain access group):","type":"text"}]},{"code":["\/\/ Example: store in a shared app group UserDefaults","let sharedDefaults = UserDefaults(suiteName: \"group.com.yourcompany.wallet\")","sharedDefaults?.set(sdkInput, forKey: \"cachedSdkInput_\\(paymentInstrumentId)\")"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Step 3: Implement the Non-UI Extension Handler","type":"heading","anchor":"Step-3-Implement-the-Non-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a class that subclasses ","type":"text"},{"code":"PKIssuerProvisioningExtensionHandler","type":"codeVoice"},{"text":" and conforms to ","type":"text"},{"code":"ExtensionProvisioningServiceDelegate","type":"codeVoice"},{"text":". The class name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The extension handler is re-instantiated for each method call by the system, so you must re-initialize ","type":"text"},{"code":"ExtensionProvisioningService","type":"codeVoice"},{"text":" on each call.","type":"text"}]},{"code":["import PassKit","import CardProvisioningExtension","","class WalletNonUIExtensionHandler: PKIssuerProvisioningExtensionHandler, ExtensionProvisioningServiceDelegate {","","    \/\/ MARK: - status()","    \/\/ Called by the Wallet app to determine whether your app should appear","    \/\/ in \"From Apps on Your iPhone\". Has a strict 100ms execution limit —","    \/\/ network calls are not feasible here. You must use cached data.","","    override func status() async -> PKIssuerProvisioningExtensionStatus {","        guard let service = makeService(retrieveNewData: false) else {","            return ExtensionProvisioningService.entriesUnavailableExtensionStatus","        }","        return service.extensionStatus(requiresAuthentication: true)","    }","","    \/\/ MARK: - passEntries() \/ remotePassEntries()","    \/\/ Called to build the list of cards shown in the Wallet app.","    \/\/ Has a 20-second limit — a network call to refresh sdkInput is allowed here.","","    override func passEntries() async -> [PKIssuerProvisioningExtensionPassEntry] {","        guard let service = await makeService(retrieveNewData: true) else { return [] }","        return service.passEntries(withDelegate: self)","    }","","    override func remotePassEntries() async -> [PKIssuerProvisioningExtensionPassEntry] {","        guard let service = await makeService(retrieveNewData: true) else { return [] }","        return service.passEntries(withDelegate: self)","    }","","    \/\/ MARK: - generateAddPaymentPassRequestForPassEntryWithIdentifier(...)","    \/\/ Called when the user selects a card in the Wallet app to begin provisioning.","","    override func generateAddPaymentPassRequestForPassEntryWithIdentifier(","        _ identifier: String,","        configuration: PKAddPaymentPassRequestConfiguration,","        certificateChain certificates: [Data],","        nonce: Data,","        nonceSignature: Data","    ) async -> PKAddPaymentPassRequest? {","        guard let service = await makeService(retrieveNewData: true) else { return nil }","        return try? await service.generateAddPaymentPassRequestForPassEntryWithIdentifier(","            identifier,","            configuration: configuration,","            certificateChain: certificates,","            nonce: nonce,","            nonceSignature: nonceSignature,","            delegate: self","        )","    }","","    \/\/ MARK: - ExtensionProvisioningServiceDelegate","","    func cardArt(paymentInstrumentId: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        let imageName = \"card_placeholder\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    func provision(paymentInstrumentId: String, sdkOutput: Data) async -> Data? {","        \/\/ POST sdkOutput to your backend and return the new sdkInput.","        \/\/ This is the same exchange as in the in-app flow.","        return try? await yourNetworkClient.provisionCard(","            paymentInstrumentId: paymentInstrumentId,","            sdkOutput: sdkOutput","        )","    }","","    \/\/ MARK: - Helpers","","    private func makeService(retrieveNewData: Bool) async -> ExtensionProvisioningService? {","        \/\/ Retrieve cached sdkInput written by the main app.","        guard let cachedSdkInput = loadCachedSdkInput() else { return nil }","","        if !retrieveNewData {","            \/\/ Use cached data for time-sensitive calls (status()).","            return try? ExtensionProvisioningService(sdkInput: cachedSdkInput)","        }","","        \/\/ For passEntries \/ generateAddPaymentPassRequest, fetch fresh data from your backend.","        guard let freshSdkInput = try? await yourNetworkClient.fetchSdkInput() else { return nil }","        storeCachedSdkInput(freshSdkInput)","        return try? ExtensionProvisioningService(sdkInput: freshSdkInput)","    }","","    private func loadCachedSdkInput() -> Data? {","        \/\/ Read from the shared app group or keychain.","        return UserDefaults(suiteName: \"group.com.yourcompany.wallet\")?","            .data(forKey: \"cachedSdkInput\")","    }","","    private func storeCachedSdkInput(_ sdkInput: Data) {","        UserDefaults(suiteName: \"group.com.yourcompany.wallet\")?","            .set(sdkInput, forKey: \"cachedSdkInput\")","    }","}"],"type":"codeListing","syntax":"swift"},{"level":4,"text":"Extension Method Time Limits","type":"heading","anchor":"Extension-Method-Time-Limits"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Time limit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Network call allowed","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"status()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"100 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No — must use cached ","type":"text"},{"type":"codeVoice","code":"sdkInput"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"passEntries()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"20 s","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes — fetch fresh ","type":"text"},{"type":"codeVoice","code":"sdkInput"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"remotePassEntries()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"20 s","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes — fetch fresh ","type":"text"},{"type":"codeVoice","code":"sdkInput"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"generateAddPaymentPassRequest..."}],"type":"paragraph"}],[{"inlineContent":[{"text":"20 s","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes — fetch fresh ","type":"text"},{"type":"codeVoice","code":"sdkInput"}],"type":"paragraph"}]]]},{"level":3,"text":"Step 4: Create the UI Extension Target (Optional)","type":"heading","anchor":"Step-4-Create-the-UI-Extension-Target-Optional"},{"type":"paragraph","inlineContent":[{"text":"The Wallet app can present a UI extension from your app to authenticate the cardholder before provisioning.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"type":"text","text":" and select "},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", set:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]}]},{"level":3,"text":"Step 5: Implement the UI Extension Handler","type":"heading","anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":" that conforms to ","type":"text"},{"code":"PKIssuerProvisioningExtensionAuthorizationProviding","type":"codeVoice"},{"text":". Call ","type":"text"},{"code":"completionHandler","type":"codeVoice"},{"text":" with the result of authentication.","type":"text"}]},{"code":["import PassKit","import UIKit","","class WalletUIExtensionHandler: UIViewController, PKIssuerProvisioningExtensionAuthorizationProviding {","","    var completionHandler: ((PKIssuerProvisioningExtensionAuthorizationResult) -> Void)?","","    override func viewDidLoad() {","        super.viewDidLoad()","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completionHandler?(success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Entitlements Summary","type":"heading","anchor":"Entitlements-Summary"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Entitlement","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Main App","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Non-UI Extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"UI Extension","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.security.application-groups"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optional","type":"text"}],"type":"paragraph"}]]]},{"level":3,"text":"How the Extension Flow Works","type":"heading","anchor":"How-the-Extension-Flow-Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"User opens Apple Wallet"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"status()"},{"type":"text","text":" is called with a 100 ms limit. The SDK reads cached "},{"type":"codeVoice","code":"sdkInput"},{"type":"text","text":" to determine whether cards are available. Your app appears in "},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":" if cards are available."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"User selects your app"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"passEntries()"},{"type":"text","text":" is called. Fresh "},{"type":"codeVoice","code":"sdkInput"},{"type":"text","text":" is fetched from your backend. Card art from "},{"type":"codeVoice","code":"cardArt(paymentInstrumentId:)"},{"type":"text","text":" is shown."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"strong"},{"type":"text","text":" — if "},{"type":"codeVoice","code":"requiresAuthentication: true"},{"type":"text","text":" was passed to "},{"type":"codeVoice","code":"extensionStatus(requiresAuthentication:)"},{"type":"text","text":", your UI Extension is presented."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Provisioning"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"generateAddPaymentPassRequestForPassEntryWithIdentifier(...)"},{"type":"text","text":" is called. The SDK calls your "},{"type":"codeVoice","code":"provision(paymentInstrumentId:sdkOutput:)"},{"type":"text","text":" delegate method to exchange data with your backend."}],"type":"paragraph"}]}]},{"level":3,"text":"Troubleshooting","type":"heading","anchor":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"App does not appear in Wallet’s “From Apps on Your iPhone”:","type":"text"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement is present on all targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure the main app has cached "},{"type":"codeVoice","code":"sdkInput"},{"type":"text","text":" before the user opens Wallet."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Confirm "},{"type":"codeVoice","code":"status()"},{"type":"text","text":" completes within 100 ms — any delay will result in "},{"type":"codeVoice","code":"entriesUnavailableExtensionStatus"},{"type":"text","text":" being returned."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authentication UI does not appear:","type":"text"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"requiresAuthentication: true"},{"type":"text","text":" is passed to "},{"type":"codeVoice","code":"extensionStatus(requiresAuthentication:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Extension cannot read cached data:","type":"text"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the shared app group identifier matches in both the main app and extension entitlements."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure "},{"type":"codeVoice","code":"sdkInput"},{"type":"text","text":" is written to the shared storage before the user opens Wallet."}],"type":"paragraph"}]}]},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Card provisioning only works on TestFlight or App Store builds on a ","type":"text"},{"inlineContent":[{"text":"physical device","type":"text"}],"type":"strong"},{"text":" using the ","type":"text"},{"inlineContent":[{"text":"live","type":"text"}],"type":"strong"},{"text":" environment. The Simulator cannot complete the provisioning