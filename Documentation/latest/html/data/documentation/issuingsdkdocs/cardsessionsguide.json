{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},"variants":[{"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"role":"article","modules":[{"name":"IssuingSDKDocs"}],"title":"Card Sessions","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal PIN"}],"type":"strong"},{"type":"text","text":" — the card’s current PIN"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Change PIN","type":"text"}],"type":"strong"},{"text":" — set a new PIN for the card","type":"text"}],"type":"paragraph"}]}]},{"content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"type":"heading","level":2,"text":"Import","anchor":"Import"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"code":["import CardSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"Session Token Roles","anchor":"Session-Token-Roles"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [","    \"Card Reveal: Reveal Card Details\",","    \"Card Reveal: Reveal Pin\",","    \"Card Reveal: Change Pin\"","]"]},{"inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object","type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSessions.Configuration"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"type":"codeListing"},{"level":2,"text":"Initialize the Card Session","type":"heading","anchor":"Initialize-the-Card-Session"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardSession"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations.","type":"text"}]}]},{"level":2,"text":"Reveal Card Details","type":"heading","anchor":"Reveal-Card-Details"},{"inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}],"type":"paragraph"},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"code":"CardDetails","type":"codeVoice"},{"text":" struct contains:","type":"text"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"pan","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full Primary Account Number"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cvc"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Card Verification Code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryMonth"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryYear","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}]}]]],"type":"table"},{"level":2,"text":"Reveal PIN","anchor":"Reveal-PIN","type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve the card’s current PIN:"}],"type":"paragraph"},{"code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Change-PIN","text":"Change PIN","type":"heading"},{"inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"]},{"anchor":"Error-Handling","type":"heading","text":"Error Handling","level":2},{"inlineContent":[{"text":"All operations throw ","type":"text"},{"type":"codeVoice","code":"CardSessionError"},{"text":" on failure. Use the ","type":"text"},{"type":"codeVoice","code":"code"},{"type":"text","text":" property for programmatic branching:"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"],"type":"codeListing"},{"type":"heading","level":2,"text":"Security Considerations","anchor":"Security-Considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each operation is secured with end-to-end encryption managed entirely within the SDK."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","isActive":true},{"text":".","type":"text"}]}]}]},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"inlineContent":[{"type":"text","text":"physical device"}],"type":"strong"},{"text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"strong","inlineContent":[{"type":"text","text":"live"}]},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"url":"\/documentation\/issuingsdkdocs\/gettingstarted","type":"topic","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","title":"A Starting Guide (Sessions)","kind":"article","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"type":"topic","url":"\/documentation\/issuingsdkdocs\/securityguide","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"title":"Security Guide","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","kind":"article","role":"article"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","type":"topic","abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs","kind":"symbol","role":"collection"}}}