{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","title":"Card Sessions","modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Supported operations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Reveal PIN","type":"text"}],"type":"strong"},{"text":" — the card’s current PIN","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Change PIN","type":"text"}]},{"text":" — set a new PIN for the card","type":"text"}],"type":"paragraph"}]}]},{"name":"Important","style":"important","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":2,"anchor":"Import","type":"heading","text":"Import"},{"inlineContent":[{"text":"Add the imports to your file:","type":"text"}],"type":"paragraph"},{"code":["import CardSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"anchor":"Session-Token-Roles","text":"Session Token Roles","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}],"type":"paragraph"},{"code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Create-a-Configuration-Object","type":"heading","text":"Create a Configuration Object"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSessions.Configuration","type":"codeVoice"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}]},{"code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Initialize-the-Card-Session","type":"heading","text":"Initialize the Card Session"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardSession","type":"codeVoice"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}]},{"code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"CardSession","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"type":"aside","style":"tip","name":"Tip"},{"level":2,"anchor":"Reveal-Card-Details","type":"heading","text":"Reveal Card Details"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}]},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"code":"CardDetails","type":"codeVoice"},{"text":" struct contains:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"pan","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Full Primary Account Number","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cvc","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Card Verification Code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryMonth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryYear","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":2,"type":"heading","anchor":"Reveal-PIN","text":"Reveal PIN"},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}]},{"code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"Change PIN","anchor":"Change-PIN"},{"inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}],"type":"paragraph"},{"code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Error-Handling","text":"Error Handling","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"All operations throw "},{"code":"CardSessionError","type":"codeVoice"},{"type":"text","text":" on failure. Use the "},{"code":"code","type":"codeVoice"},{"type":"text","text":" property for programmatic branching and the "},{"code":"underlyingError","type":"codeVoice"},{"text":" property to get backend trace identifiers for support inquiries:","type":"text"}],"type":"paragraph"},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","","    \/\/ Extract trace identifiers for Adyen support","    if let context = error.underlyingError {","        print(\"Request ID: \\(context.requestId ?? \"N\/A\")\")","        print(\"Trace: \\(context.traceParent ?? \"N\/A\")\")","        print(\"HTTP status: \\(context.httpErrorCode.map(String.init) ?? \"N\/A\")\")","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Security-Considerations","text":"Security Considerations","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk."}]}]},{"content":[{"inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Consider applying screen capture protection when displaying card details. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"inlineContent":[{"text":"Card Sessions requires a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"inlineContent":[{"text":"live","type":"text"}],"type":"strong"},{"type":"text","text":" environment with a valid payment instrument for end-to-end testing."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","interfaceLanguage":"swift"},"sections":[],"kind":"article","abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"title":"IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","kind":"symbol","abstract":[],"role":"collection"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"role":"article","kind":"article","url":"\/documentation\/issuingsdkdocs\/securityguide","type":"topic","title":"Security Guide","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"title":"A Starting Guide (Sessions)","url":"\/documentation\/issuingsdkdocs\/gettingstarted","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","kind":"article","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"role":"article"}}}