{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported operations:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal card details"}]},{"type":"text","text":" — PAN, CVC, expiry month, and expiry year"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal PIN","type":"text"}]},{"type":"text","text":" — the card’s current PIN"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Change PIN","type":"text"}]},{"type":"text","text":" — set a new PIN for the card"}]}]}],"type":"unorderedList"},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","type":"reference"},{"type":"text","text":" before proceeding."}],"type":"paragraph"}]},{"anchor":"Import","type":"heading","text":"Import","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the imports to your file:"}]},{"code":["import CardSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"anchor":"Session-Token-Roles","text":"Session Token Roles","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:"}]},{"syntax":"json","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Include only the roles for the operations your user will perform."}]},{"type":"heading","level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardSessions.Configuration"},{"type":"text","text":". This object configures the session with your certificate, your Apple Team ID, and the target environment."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Initialize the Card Session","anchor":"Initialize-the-Card-Session"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSession","type":"codeVoice"},{"type":"text","text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation."}]},{"syntax":"swift","type":"codeListing","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CardSession"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}],"type":"aside","name":"Tip","style":"tip"},{"text":"Reveal Card Details","type":"heading","level":2,"anchor":"Reveal-Card-Details"},{"inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error. Log the error itself, not its localizedDescription,","    \/\/ so the trace identifier is preserved.","    print(\"Reveal failed: \\(error)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"text":" struct contains:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full Primary Account Number","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cvc"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"inlineContent":[{"text":"Card Verification Code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryMonth"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expiry month (e.g., “03”)"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"expiryYear","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":"String"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}]}]]],"header":"row","type":"table"},{"type":"heading","level":2,"anchor":"Reveal-PIN","text":"Reveal PIN"},{"inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error)\")","}"],"type":"codeListing"},{"anchor":"Change-PIN","type":"heading","text":"Change PIN","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set a new PIN for the card:"}]},{"syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error)\")","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Error Handling","anchor":"Error-Handling"},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" on failure."}]},{"type":"heading","anchor":"Match-a-single-case","level":3,"text":"Match a single case"},{"inlineContent":[{"text":"The error type supports pattern matching, so you can catch one case directly without casting.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Matching compares the "},{"code":"code","type":"codeVoice"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"text":" ","type":"text"},{"type":"text","text":"underlying cause:"}],"type":"paragraph"},{"type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: newPin","    )","} catch CardSessionError.invalidPin {","    \/\/ Ask the cardholder for a correctly formatted PIN.","} catch {","    \/\/ Handle everything else.","}"],"syntax":"swift"},{"anchor":"Branch-across-several-cases","type":"heading","level":3,"text":"Branch across several cases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To handle several failures at once, use the "},{"code":"code","type":"codeVoice"},{"text":" property. ","type":"text"},{"type":"codeVoice","code":"Code"},{"text":" is non-exhaustive, so always","type":"text"},{"type":"text","text":" "},{"text":"include a ","type":"text"},{"code":"default","type":"codeVoice"},{"type":"text","text":" case to stay forward compatible with future SDK versions:"}]},{"code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .sessionTokenRetrievalFailed:","        \/\/ The token provider failed to retrieve a session token.","        \/\/ Check your backend or re-authenticate the user.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .cardRevealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    default:","        break","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Logging","level":3,"text":"Logging"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" conforms to "},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":", so log the error itself:","type":"text"}]},{"syntax":"swift","code":["print(error)","\/\/ CardSessionError.cardRevealFailed: cardReveal, serverHTTPError. Trace: 00-abc..."],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Where the failure came from a network call, "},{"type":"codeVoice","code":"description"},{"text":" includes the trace identifier Adyen","type":"text"},{"type":"text","text":" "},{"type":"text","text":"support needs to correlate the request. It never contains card data, PINs or session tokens, so"},{"type":"text","text":" "},{"type":"text","text":"it is safe to log."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Avoid logging ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":". It carries no diagnostic detail, so the trace identifier is"},{"text":" ","type":"text"},{"type":"text","text":"lost."}]},{"type":"paragraph","inlineContent":[{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" is deliberately short because errors are commonly passed straight to the"},{"text":" ","type":"text"},{"text":"UI, but it is not meant for display either: the text is English and is not localized. Map ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"to your own copy for anything the cardholder sees."}]},{"level":2,"type":"heading","text":"Security Considerations","anchor":"Security-Considerations"},{"items":[{"content":[{"inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","type":"reference"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"anchor":"Testing","type":"heading","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Card Sessions requires a ","type":"text"},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"inlineContent":[{"text":"live","type":"text"}],"type":"strong"},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Card Sessions","modules":[{"name":"IssuingSDKDocs"}]},"abstract":[{"text":"Securely reveal card details, reveal PINs, and change PINs.","type":"text"}],"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","title":"IssuingSDKDocs","role":"collection","url":"\/documentation\/issuingsdkdocs","kind":"symbol","type":"topic"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"type":"topic","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","role":"article","url":"\/documentation\/issuingsdkdocs\/securityguide","kind":"article","title":"Security Guide"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","title":"A Starting Guide (Sessions)","role":"article","url":"\/documentation\/issuingsdkdocs\/gettingstarted","kind":"article","type":"topic"}}}