{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide"},"kind":"article","abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Supported operations:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Reveal PIN","type":"text"}]},{"text":" — the card’s current PIN","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Change PIN"}],"type":"strong"},{"text":" — set a new PIN for the card","type":"text"}]}]}],"type":"unorderedList"},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Import","level":2,"anchor":"Import"},{"type":"paragraph","inlineContent":[{"text":"Add the imports to your file:","type":"text"}]},{"type":"codeListing","code":["import CardSessions","import IssuingCommon"],"syntax":"swift"},{"type":"heading","text":"Session Token Roles","level":2,"anchor":"Session-Token-Roles"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}]},{"type":"codeListing","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","text":"Create a Configuration Object","level":2,"anchor":"Create-a-Configuration-Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}]},{"type":"codeListing","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"],"syntax":"swift"},{"type":"heading","text":"Initialize the Card Session","level":2,"anchor":"Initialize-the-Card-Session"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}]},{"type":"codeListing","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"],"syntax":"swift"},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"CardSession"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations."}]}]},{"type":"heading","text":"Reveal Card Details","level":2,"anchor":"Reveal-Card-Details"},{"inlineContent":[{"type":"text","text":"Retrieve the full card number (PAN), CVC, and expiry date:"}],"type":"paragraph"},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error. Log the error itself, not its localizedDescription,","    \/\/ so the trace identifier is preserved.","    print(\"Reveal failed: \\(error)\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"type":"codeVoice","code":"CardDetails"},{"type":"text","text":" struct contains:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pan"}]}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full Primary Account Number","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cvc"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"inlineContent":[{"type":"text","text":"Card Verification Code"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"expiryMonth"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}]}]],[[{"inlineContent":[{"code":"expiryYear","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"String","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expiry year (e.g., “2027”)"}]}]]]},{"anchor":"Reveal-PIN","text":"Reveal PIN","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}]},{"code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Change PIN","anchor":"Change-PIN"},{"type":"paragraph","inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}]},{"code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Error-Handling","level":2,"text":"Error Handling","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"type":"codeVoice","code":"CardSessionError"},{"text":" on failure.","type":"text"}]},{"anchor":"Match-a-single-case","level":3,"text":"Match a single case","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The error type supports pattern matching, so you can catch one case directly without casting.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Matching compares the "},{"type":"codeVoice","code":"code"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"type":"text","text":" "},{"type":"text","text":"underlying cause:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: newPin","    )","} catch CardSessionError.invalidPin {","    \/\/ Ask the cardholder for a correctly formatted PIN.","} catch {","    \/\/ Handle everything else.","}"]},{"anchor":"Branch-across-several-cases","level":3,"text":"Branch across several cases","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To handle several failures at once, use the "},{"type":"codeVoice","code":"code"},{"text":" property. ","type":"text"},{"code":"Code","type":"codeVoice"},{"type":"text","text":" is non-exhaustive, so always"},{"type":"text","text":" "},{"type":"text","text":"include a "},{"type":"codeVoice","code":"default"},{"type":"text","text":" case to stay forward compatible with future SDK versions:"}]},{"type":"codeListing","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .sessionTokenRetrievalFailed:","        \/\/ The token provider failed to retrieve a session token.","        \/\/ Check your backend or re-authenticate the user.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .cardRevealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    default:","        break","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Logging","anchor":"Logging"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CardSessionError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"CustomStringConvertible"},{"text":", so log the error itself:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["print(error)","\/\/ CardSessionError.cardRevealFailed: cardReveal, serverHTTPError. Trace: 00-abc..."]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the failure came from a network call, "},{"type":"codeVoice","code":"description"},{"type":"text","text":" includes the trace identifier Adyen"},{"type":"text","text":" "},{"text":"support needs to correlate the request. It never contains card data, PINs or session tokens, so","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it is safe to log."}]},{"type":"paragraph","inlineContent":[{"text":"Avoid logging ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"text":". It carries no diagnostic detail, so the trace identifier is","type":"text"},{"text":" ","type":"text"},{"text":"lost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is deliberately short because errors are commonly passed straight to the"},{"text":" ","type":"text"},{"text":"UI, but it is not meant for display either: the text is English and is not localized. Map ","type":"text"},{"code":"code","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to your own copy for anything the cardholder sees."}]},{"text":"Security Considerations","type":"heading","level":2,"anchor":"Security-Considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Consider applying screen capture protection when displaying card details. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"inlineContent":[{"type":"text","text":"Card Sessions requires a "},{"type":"strong","inlineContent":[{"text":"physical device","type":"text"}]},{"type":"text","text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator."}],"type":"paragraph"},{"inlineContent":[{"text":"Use the ","type":"text"},{"inlineContent":[{"text":"live","type":"text"}],"type":"strong"},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article","role":"article","title":"Card Sessions"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"title":"Security Guide","role":"article","kind":"article","type":"topic","abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","url":"\/documentation\/issuingsdkdocs\/securityguide"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"title":"A Starting Guide (Sessions)","role":"article","kind":"article","type":"topic","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"url":"\/documentation\/issuingsdkdocs\/gettingstarted","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"type":"topic","title":"IssuingSDKDocs","role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","url":"\/documentation\/issuingsdkdocs"}}}