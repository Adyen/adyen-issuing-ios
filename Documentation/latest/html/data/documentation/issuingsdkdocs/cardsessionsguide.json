{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/cardsessionsguide"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","modules":[{"name":"IssuingSDKDocs"}],"role":"article","title":"Card Sessions"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card Sessions provides a session-based API for sensitive card operations. All cryptographic operations are handled securely within the SDK. Your server never sees cleartext card data: sensitive information is encrypted end-to-end between the SDK and the Adyen backend."}]},{"type":"paragraph","inlineContent":[{"text":"Supported operations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reveal card details"}],"type":"strong"},{"text":" — PAN, CVC, expiry month, and expiry year","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reveal PIN"}]},{"type":"text","text":" — the card’s current PIN"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Change PIN","type":"text"}]},{"type":"text","text":" — set a new PIN for the card"}]}]}]},{"type":"aside","style":"important","content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true,"type":"reference"},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}],"name":"Important"},{"type":"heading","anchor":"Import","text":"Import","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the imports to your file:","type":"text"}]},{"type":"codeListing","code":["import CardSessions","import IssuingCommon"],"syntax":"swift"},{"type":"heading","anchor":"Session-Token-Roles","text":"Session Token Roles","level":2},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for Card Sessions, use the following roles depending on the operations you need:","type":"text"}]},{"type":"codeListing","code":["\"roles\": [","    \"PaymentInstrument: Card Reveal\",","    \"PaymentInstrument: Pin Reveal\",","    \"PaymentInstrument: Pin Change\"","]"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Include only the roles for the operations your user will perform.","type":"text"}]},{"type":"heading","anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object","level":2},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSessions.Configuration","type":"codeVoice"},{"text":". This object configures the session with your certificate, your Apple Team ID, and the target environment.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Load the certificate provided by Adyen","guard let certificateUrl = Bundle.main.url(forResource: \"certificate\", withExtension: \"der\"),","      let certificate = try? Data(contentsOf: certificateUrl) else {","    \/\/ Handle missing certificate","    return","}","","let parameters = CardSessions.Configuration(","    appCertificate: certificate,","    environment: .live",")"]},{"anchor":"Initialize-the-Card-Session","text":"Initialize the Card Session","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" with the configuration parameters and your token provider. The initializer is synchronous and lightweight. No network calls are made until you invoke an operation.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let cardSession = CardSession(","    parameters: parameters,","    tokenProvider: tokenProvider",")"]},{"type":"aside","name":"Tip","style":"tip","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"CardSession","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and can be shared safely across tasks. You can create it once and reuse it for multiple operations.","type":"text"}],"type":"paragraph"}]},{"anchor":"Reveal-Card-Details","text":"Reveal Card Details","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Retrieve the full card number (PAN), CVC, and expiry date:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","","    \/\/ Display the card details in your UI — never log sensitive values","    panLabel.text = details.pan","    cvcLabel.text = details.cvc","    expiryLabel.text = \"\\(details.expiryMonth)\/\\(details.expiryYear)\"","} catch {","    \/\/ Handle the error","    print(\"Reveal failed: \\(error.localizedDescription)\")","}"]},{"type":"paragraph","inlineContent":[{"text":"The returned ","type":"text"},{"code":"CardDetails","type":"codeVoice"},{"text":" struct contains:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"pan","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Full Primary Account Number","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cvc","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Card Verification Code","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryMonth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry month (e.g., “03”)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"expiryYear","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expiry year (e.g., “2027”)","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Reveal-PIN","text":"Reveal PIN","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Retrieve the card’s current PIN:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let pin = try await cardSession.revealPin(","        paymentInstrumentId: paymentInstrumentId","    )","    \/\/ Display the PIN in your UI — never log sensitive values","    pinLabel.text = pin","} catch {","    print(\"PIN reveal failed: \\(error.localizedDescription)\")","}"]},{"anchor":"Change-PIN","text":"Change PIN","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Set a new PIN for the card:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await cardSession.changePin(","        paymentInstrumentId: paymentInstrumentId,","        newPin: userEnteredPin","    )","    \/\/ PIN changed successfully","} catch {","    print(\"PIN change failed: \\(error.localizedDescription)\")","}"]},{"anchor":"Error-Handling","text":"Error Handling","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"All operations throw ","type":"text"},{"code":"CardSessionError","type":"codeVoice"},{"text":" on failure. Use the ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" property for programmatic branching:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let details = try await cardSession.revealCardDetails(","        paymentInstrumentId: paymentInstrumentId","    )","} catch let error as CardSessionError {","    switch error.code {","    case .invalidSessionToken:","        \/\/ The session token is invalid or expired.","        \/\/ Prompt the user to retry or refresh the token.","        break","    case .couldNotEstablishSession:","        \/\/ Could not establish a secure connection.","        \/\/ Check network connectivity and certificate validity.","        break","    case .revealFailed:","        \/\/ The reveal operation failed on the backend.","        break","    case .pinRevealFailed:","        \/\/ PIN reveal failed.","        break","    case .pinChangeFailed:","        \/\/ PIN change failed.","        break","    case .invalidPin:","        \/\/ The new PIN format is invalid.","        break","    case .publicKeyExpired:","        \/\/ The encryption key has expired. Retry the operation.","        break","    }","}"]},{"anchor":"Security-Considerations","text":"Security Considerations","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Card details and PINs are decrypted only within the SDK’s memory. They are never written to disk.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Each operation is secured with end-to-end encryption managed entirely within the SDK.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Display sensitive data (PAN, PIN) only temporarily and clear it from the UI promptly.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Consider applying screen capture protection when displaying card details. See ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Testing","text":"Testing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Card Sessions requires a ","type":"text"},{"inlineContent":[{"text":"physical device","type":"text"}],"type":"strong"},{"text":" for full end-to-end functionality. The iOS Simulator can be used for development and UI work, but secure operations will not complete on the Simulator.","type":"text"}]},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"text":" environment with a valid payment instrument for end-to-end testing.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/CardSessionsGuide","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Securely reveal card details, reveal PINs, and change PINs."}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/SecurityGuide":{"url":"\/documentation\/issuingsdkdocs\/securityguide","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","role":"article","kind":"article","abstract":[{"type":"text","text":"Ensure your integration meets security best practices when handling sensitive data."}],"title":"Security Guide"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"url":"\/documentation\/issuingsdkdocs\/gettingstarted","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","role":"article","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"kind":"article","title":"A Starting Guide (Sessions)"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","type":"topic","role":"collection","abstract":[],"kind":"symbol","title":"IssuingSDKDocs"}}}