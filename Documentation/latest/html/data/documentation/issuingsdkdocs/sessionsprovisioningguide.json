{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide"},"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"Card Provisioning Sessions","modules":[{"name":"IssuingSDKDocs"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","type":"reference"},{"text":" before proceeding.","type":"text"}]}],"name":"Important","type":"aside"},{"type":"heading","text":"Import","anchor":"Import","level":2},{"code":["import CardProvisioningSessions","import IssuingCommon"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Session Token Role","anchor":"Session-Token-Role"},{"inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}],"type":"paragraph"},{"type":"codeListing","code":["\"roles\": [\"Network Token: Create\"]"],"syntax":"json"},{"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","level":2,"type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"text":"Initialize a Provisioning Session","anchor":"Initialize-a-Provisioning-Session","level":2,"type":"heading"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":" and call ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" to fetch activation data. The initializer is synchronous — async work begins only in ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"type":"codeListing"},{"text":"Check the Provisioning State","anchor":"Check-the-Provisioning-State","level":2,"type":"heading"},{"inlineContent":[{"text":"Before showing the ","type":"text"},{"inlineContent":[{"type":"text","text":"Add to Apple Wallet"}],"type":"strong"},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Log reason for diagnostics, and map it to your own","    \/\/ copy for anything the cardholder sees.","}"],"type":"codeListing"},{"text":"Provision the Card","anchor":"Provision-the-Card","level":2,"type":"heading"},{"inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"inlineContent":[{"type":"text","text":"Add to Apple Wallet"}],"type":"strong"},{"text":", present the native Wallet sheet:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ The cardholder or the system dismissed the Apple Pay sheet.","    \/\/ This is not a failure, so leave your UI unchanged.","} catch {","    \/\/ Handle provisioning error","}"],"type":"codeListing"},{"text":"Handle the Result","anchor":"Handle-the-Result","level":2,"type":"heading"},{"inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"code":"CardActivationState","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"type":"codeListing"},{"text":"Error Handling","anchor":"Error-Handling","level":2,"type":"heading"},{"inlineContent":[{"text":"All session operations throw ","type":"text"},{"code":"CardProvisioningSessionError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Match a single case","anchor":"Match-a-single-case","level":3,"type":"heading"},{"inlineContent":[{"text":"The error type supports pattern matching, so you can catch one case directly without casting.","type":"text"},{"text":" ","type":"text"},{"text":"Matching compares the ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" only, so it succeeds regardless of the error’s message or","type":"text"},{"text":" ","type":"text"},{"text":"underlying cause:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    try await provisioningSession.configure()","} catch CardProvisioningSessionError.couldNotEstablishSession {","    \/\/ Check connectivity and the session token, then retry.","} catch {","    \/\/ Handle everything else.","}"],"type":"codeListing"},{"text":"Handle cancellation gracefully","anchor":"Handle-cancellation-gracefully","level":3,"type":"heading"},{"inlineContent":[{"code":"provisioningCancelled","type":"codeVoice"},{"text":" reports that the Apple Pay sheet was dismissed by the cardholder or by","type":"text"},{"text":" ","type":"text"},{"text":"the system. Nothing was provisioned and nothing failed, so treat it as a normal outcome. Do not","type":"text"},{"text":" ","type":"text"},{"text":"present it as an error:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["do {","    _ = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ Expected when the cardholder taps Cancel. Leave the UI as it was.","} catch {","    \/\/ Log the error for diagnostics, and show your own copy to the cardholder.","    print(error)","    showAlert(yourMessage(for: error))","}"]},{"type":"heading","level":3,"text":"Branch across several cases","anchor":"Branch-across-several-cases"},{"type":"paragraph","inlineContent":[{"text":"To handle several failures at once, switch over ","type":"text"},{"code":"code","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Code","type":"codeVoice"},{"text":" is non-exhaustive, so always","type":"text"},{"text":" ","type":"text"},{"text":"include a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" case to stay forward compatible with future SDK versions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await provisioningSession.configure()","} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .noPaymentInstrumentsProvided:","        \/\/ `paymentInstrumentIds` in the configuration was empty.","        break","    case .noKeychainGroupIdProvided:","        \/\/ `keychainAccessGroup` was empty.","        break","    case .couldNotEstablishSession:","        \/\/ Network or authentication failure.","        break","    case .activationDataUnavailable:","        \/\/ Activation data could not be fetched or cached.","        break","    case .provisioningAlreadyInProgress:","        \/\/ A provisioning flow is already running for this payment instrument.","        break","    case .provisioningCancelled:","        \/\/ Dismissed by the cardholder or the system. Not a failure.","        break","    case .provisioningFailed:","        \/\/ PassKit or the provisioning infrastructure reported a failure.","        break","    default:","        break","    }","}"]},{"type":"heading","level":3,"text":"Logging","anchor":"Logging"},{"type":"paragraph","inlineContent":[{"code":"CardProvisioningSessionError","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"CustomStringConvertible","type":"codeVoice"},{"text":", so log the error itself:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["print(error)","\/\/ CardProvisioningSessionError.couldNotEstablishSession: deviceRegistration, serverHTTPError. Trace: 00-abc..."]},{"type":"paragraph","inlineContent":[{"text":"Where the failure came from a network call, ","type":"text"},{"code":"description","type":"codeVoice"},{"text":" includes the trace identifier Adyen","type":"text"},{"text":" ","type":"text"},{"text":"support needs to correlate the request. Where it came from PassKit, it includes the underlying","type":"text"},{"text":" ","type":"text"},{"text":"PassKit error. It never contains card data or session tokens, so it is safe to log.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Avoid logging "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":". It carries no diagnostic detail, so the trace identifier is"},{"type":"text","text":" "},{"type":"text","text":"lost."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"localizedDescription"},{"text":" is deliberately short because errors are commonly passed straight to the","type":"text"},{"text":" ","type":"text"},{"text":"UI, but it is not meant for display either: the text is English and is not localized. Map ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to your own copy for anything the cardholder sees.","type":"text"}],"type":"paragraph"},{"text":"Wallet Extension","level":2,"anchor":"Wallet-Extension","type":"heading"},{"inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s "},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":" section."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sessions approach provides a high-level base class, "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":", that handles the full extension flow. You subclass it and override a small set of methods."}]},{"text":"Prerequisites","level":3,"anchor":"Prerequisites","type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A shared keychain access group must be configured (the same "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" you passed to "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}]}]]],"header":"row"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":" (e.g., "},{"type":"codeVoice","code":"[TeamId].com.yourcompany.shared"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"type":"heading","text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"]},{"level":4,"type":"heading","text":"Required Overrides","anchor":"Required-Overrides"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared keychain group for activation data cached by the main app"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}]}]]]},{"level":4,"type":"heading","text":"Optional Overrides","anchor":"Optional-Overrides"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment()"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".live"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override to use "},{"type":"codeVoice","code":".test"},{"type":"text","text":" environment"}]}]]]},{"level":3,"type":"heading","text":"Step 3: Ensure Activation Data Is Cached","anchor":"Step-3-Ensure-Activation-Data-Is-Cached"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK caches activation data in the shared keychain automatically when you call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" in the main app with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section."}]},{"name":"Important","type":"aside","content":[{"inlineContent":[{"text":"The user must open the provisioning flow in your main app at least once before the extension can show cards.","type":"text"}],"type":"paragraph"}],"style":"important"},{"type":"heading","level":3,"text":"Step 4: Create the UI Extension Target (Optional)","anchor":"Step-4-Create-the-UI-Extension-Target-Optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", set:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]}]},{"type":"heading","text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"code":"WalletExtensionUIHandler","type":"codeVoice"},{"type":"text","text":". Build your authentication UI inside the initializer and call "},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"type":"text","text":" when the user finishes."}]},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI is also supported via "},{"code":"UIHostingController","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Entitlements Summary","anchor":"Entitlements-Summary"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Entitlement","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Main App","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Non-UI Extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"UI Extension","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"—","type":"text"}],"type":"paragraph"}]]]},{"type":"heading","level":3,"text":"How the Extension Flow Works","anchor":"How-the-Extension-Flow-Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"User opens 