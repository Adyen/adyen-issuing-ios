{"sections":[],"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"text":" before proceeding.","type":"text"}]}],"style":"important","type":"aside","name":"Important"},{"level":2,"text":"Import","type":"heading","anchor":"Import"},{"code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Session Token Role","type":"heading","anchor":"Session-Token-Role"},{"inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}],"type":"paragraph"},{"code":["\"roles\": [\"Network Token: Create\"]"],"type":"codeListing","syntax":"json"},{"level":2,"text":"Create a Configuration Object","type":"heading","anchor":"Create-a-Configuration-Object"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}],"type":"paragraph"},{"code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"type":"codeListing","syntax":"swift"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below.","type":"text"}],"type":"paragraph"}]},{"text":"Initialize a Provisioning Session","anchor":"Initialize-a-Provisioning-Session","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"code":"configure()","type":"codeVoice"},{"text":" to fetch activation data. The initializer is synchronous — async work begins only in ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"syntax":"swift"},{"text":"Check the Provisioning State","type":"heading","anchor":"Check-the-Provisioning-State","level":2},{"inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"type":"text","text":" button, check the current provisioning state for the payment instrument."}],"type":"paragraph"},{"syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Log reason for diagnostics, and map it to your own","    \/\/ copy for anything the cardholder sees.","}"],"type":"codeListing"},{"level":2,"text":"Provision the Card","anchor":"Provision-the-Card","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":", present the native Wallet sheet:","type":"text"}]},{"code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ The cardholder or the system dismissed the Apple Pay sheet.","    \/\/ This is not a failure, so leave your UI unchanged.","} catch {","    \/\/ Handle provisioning error","}"],"type":"codeListing","syntax":"swift"},{"text":"Handle the Result","anchor":"Handle-the-Result","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"code":"CardActivationState","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"]},{"text":"Error Handling","type":"heading","anchor":"Error-Handling","level":2},{"type":"paragraph","inlineContent":[{"text":"All session operations throw ","type":"text"},{"code":"CardProvisioningSessionError","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"Match a single case","anchor":"Match-a-single-case"},{"type":"paragraph","inlineContent":[{"text":"The error type supports pattern matching, so you can catch one case directly without casting.","type":"text"},{"text":" ","type":"text"},{"text":"Matching compares the ","type":"text"},{"code":"code","type":"codeVoice"},{"type":"text","text":" only, so it succeeds regardless of the error’s message or"},{"text":" ","type":"text"},{"text":"underlying cause:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await provisioningSession.configure()","} catch CardProvisioningSessionError.couldNotEstablishSession {","    \/\/ Check connectivity and the session token, then retry.","} catch {","    \/\/ Handle everything else.","}"]},{"level":3,"text":"Handle cancellation gracefully","anchor":"Handle-cancellation-gracefully","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provisioningCancelled"},{"type":"text","text":" reports that the Apple Pay sheet was dismissed by the cardholder or by"},{"type":"text","text":" "},{"type":"text","text":"the system. Nothing was provisioned and nothing failed, so treat it as a normal outcome. Do not"},{"type":"text","text":" "},{"type":"text","text":"present it as an error:"}]},{"type":"codeListing","code":["do {","    _ = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","} catch CardProvisioningSessionError.provisioningCancelled {","    \/\/ Expected when the cardholder taps Cancel. Leave the UI as it was.","} catch {","    \/\/ Log the error for diagnostics, and show your own copy to the cardholder.","    print(error)","    showAlert(yourMessage(for: error))","}"],"syntax":"swift"},{"text":"Branch across several cases","anchor":"Branch-across-several-cases","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To handle several failures at once, switch over "},{"code":"code","type":"codeVoice"},{"type":"text","text":". "},{"code":"Code","type":"codeVoice"},{"type":"text","text":" is non-exhaustive, so always"},{"type":"text","text":" "},{"text":"include a ","type":"text"},{"code":"default","type":"codeVoice"},{"text":" case to stay forward compatible with future SDK versions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    try await provisioningSession.configure()","} catch let error as CardProvisioningSessionError {","    switch error.code {","    case .noPaymentInstrumentsProvided:","        \/\/ `paymentInstrumentIds` in the configuration was empty.","        break","    case .noKeychainGroupIdProvided:","        \/\/ `keychainAccessGroup` was empty.","        break","    case .couldNotEstablishSession:","        \/\/ Network or authentication failure.","        break","    case .activationDataUnavailable:","        \/\/ Activation data could not be fetched or cached.","        break","    case .provisioningAlreadyInProgress:","        \/\/ A provisioning flow is already running for this payment instrument.","        break","    case .provisioningCancelled:","        \/\/ Dismissed by the cardholder or the system. Not a failure.","        break","    case .provisioningFailed:","        \/\/ PassKit or the provisioning infrastructure reported a failure.","        break","    default:","        break","    }","}"]},{"type":"heading","level":3,"text":"Logging","anchor":"Logging"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CardProvisioningSessionError"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"CustomStringConvertible"},{"text":", so log the error itself:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["print(error)","\/\/ CardProvisioningSessionError.couldNotEstablishSession: deviceRegistration, serverHTTPError. Trace: 00-abc..."]},{"type":"paragraph","inlineContent":[{"text":"Where the failure came from a network call, ","type":"text"},{"type":"codeVoice","code":"description"},{"text":" includes the trace identifier Adyen","type":"text"},{"text":" ","type":"text"},{"text":"support needs to correlate the request. Where it came from PassKit, it includes that error’s","type":"text"},{"text":" ","type":"text"},{"text":"domain and code. It never contains card data or session tokens, so it is safe to log.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Avoid logging ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"text":". It carries no diagnostic detail, so the trace identifier is","type":"text"},{"text":" ","type":"text"},{"text":"lost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"localizedDescription","type":"codeVoice"},{"text":" is deliberately short because errors are commonly passed straight to the","type":"text"},{"text":" ","type":"text"},{"text":"UI, but it is not meant for display either: the text is English and is not localized. Map ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to your own copy for anything the cardholder sees.","type":"text"}]},{"type":"heading","level":2,"text":"Wallet Extension","anchor":"Wallet-Extension"},{"type":"paragraph","inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"text":" section.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}]},{"type":"heading","level":3,"text":"Prerequisites","anchor":"Prerequisites"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" you passed to ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":").","type":"text"}]}]}]},{"type":"heading","level":3,"text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"text":" and select ","type":"text"},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":", find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}]}]]]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"text":" entitlement (","type":"text"},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"text":") and include the same access group identifier you pass to ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"text":" (e.g., ","type":"text"},{"code":"[TeamId].com.yourcompany.shared","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"code":"CardProvisioningSessions","type":"codeVoice"},{"text":" as a dependency of this target.","type":"text"}]}]}]},{"type":"heading","level":3,"text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"text":". The class name must match the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"],"type":"codeListing"},{"level":4,"text":"Required Overrides","anchor":"Required-Overrides","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fetch a session token from your backend","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}],"type":"paragraph"}]]],"type":"table"},{"text":"Optional Overrides","anchor":"Optional-Overrides","type":"heading","level":4},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment()"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".live"}]}],[{"inlineContent":[{"text":"Override to use ","type":"text"},{"type":"codeVoice","code":".test"},{"text":" environment","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":3,"text":"Step 3: Ensure Activation Data Is Cached","anchor":"Step-3-Ensure-Activation-Data-Is-Cached","type":"heading"},{"inlineContent":[{"text":"The SDK caches activation data in the shared keychain automatically when you call ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":" in the main app with a ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s ","type":"text"},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"text":" section.","type":"text"}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"inlineContent":[{"text":"The user must open the provisioning flow in your main app at least once before the extension can show cards.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":3,"text":"Step 4: Create the UI Extension Target (Optional)","anchor":"Step-4-Create-the-UI-Extension-Target-Optional","type":"heading"},{"inlineContent":[{"text":"If ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"text":" and select ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":", set:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}]}]]],"type":"table","header":"row"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement."}]}]}],"type":"orderedList"},{"level":3,"text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"type":"codeVoice","code":"WalletExtensionUIHandler"},{"text":". Build your authentication UI inside the initializer and call ","type":"text"},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when the user finishes.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"],"type":"codeListing"},{"inlineContent":[{"text":"SwiftUI is also supported via ","type":"text"},{"type":"codeVoice","code":"UIHostingController"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Entitlements Summary","anchor":"Entitlements-Summary","type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Entitlement","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Main App","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Non-UI Extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"UI Extension","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"—","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":3,"text":"How the Extension Flow Works","anchor":"How-the-Extension-Flow-Works","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User opens Apple Wallet"}]},{"type":"text","text":" — the SDK reads cached activation data to determine available cards. Your app appears in "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User selects a card"}]},{"type":"text","text":" — card art from "},{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"},{"type":"text","text":" is shown."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication"}]},{"type":"text","text":" — if "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", your UI Extension is presented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Provisioning"}]},{"type":"text","text":" — the SDK fetches a fresh session token via "},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"type":"text","text":" and completes provisioning."}]}]}],"type":"orderedList"},{"level":3,"text":"Troubleshooting","anchor":"Troubleshooting","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"App does not appear in Wallet’s “From Apps on Your iPhone”:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement is present on all targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" has been called in the main app at least once so activation data is cached."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" matches your class name exactly."}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Authentication UI does not appear:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Extension cannot read cached data:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm the "},{"code":"keychainAccessGroup()","type":"codeVoice"},{"type":"text","text":" return value matches the "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" used in "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"type":"text","text":" entitlement ("},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"type":"text","text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier."}]}]}],"type":"unorderedList"},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"inlineContent":[{"text":"Card provisioning requires a ","type":"text"},{"inlineContent":[{"text":"physical device","type":"text"}],"type":"strong"},{"text":" and a supported distribution build (TestFlight or App Store) using the ","type":"text"},{"inlineContent":[{"text":"live","type":"text"}],"type":"strong"},{"text":" environment. The Simulator is not supported for provisioning.","type"