{"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The Sessions approach uses the ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}]}]},{"level":2,"anchor":"Import","text":"Import","type":"heading"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"level":2,"type":"heading","text":"Session Token Role","anchor":"Session-Token-Role"},{"inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}],"type":"paragraph"},{"code":["\"roles\": [\"Network Token: Create\"]"],"type":"codeListing","syntax":"json"},{"level":2,"text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"type":"text","text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment."}]},{"type":"codeListing","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"level":2,"text":"Initialize a Provisioning Session","anchor":"Initialize-a-Provisioning-Session","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"code":"configure()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Check the Provisioning State","anchor":"Check-the-Provisioning-State"},{"inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}],"type":"paragraph"},{"code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Provision the Card","level":2,"anchor":"Provision-the-Card"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the cardholder taps "},{"inlineContent":[{"text":"Add to Apple Wallet","type":"text"}],"type":"strong"},{"type":"text","text":", present the native Wallet sheet:"}]},{"syntax":"swift","type":"codeListing","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"]},{"anchor":"Handle-the-Result","level":2,"text":"Handle the Result","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"code":"CardActivationState","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"]},{"text":"Wallet Extension","type":"heading","anchor":"Wallet-Extension","level":2},{"inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":" section."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Sessions approach provides a high-level base class, "},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Prerequisites","level":3,"anchor":"Prerequisites"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}]}]},{"content":[{"inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" you passed to ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":3,"text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"text":" entitlement (","type":"text"},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" in ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":" (e.g., "},{"code":"[TeamId].com.yourcompany.shared","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" as a dependency of this target.","type":"text"}]}]}]},{"type":"heading","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","text":"Step 2: Implement the Non-UI Extension Handler","level":3},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"code":"WalletExtensionHandler","type":"codeVoice"},{"type":"text","text":". The class name must match the "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Required-Overrides","level":4,"text":"Required Overrides","type":"heading"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}]}]]]},{"anchor":"Optional-Overrides","level":4,"text":"Optional Overrides","type":"heading"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment()"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Override to use ","type":"text"},{"code":".test","type":"codeVoice"},{"text":" environment","type":"text"}]}]]]},{"anchor":"Step-3-Ensure-Activation-Data-Is-Cached","level":3,"type":"heading","text":"Step 3: Ensure Activation Data Is Cached"},{"inlineContent":[{"text":"The SDK caches activation data in the shared keychain automatically when you call ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" in the main app with a ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section.","type":"text"}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"inlineContent":[{"text":"The user must open the provisioning flow in your main app at least once before the extension can show cards.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"anchor":"Step-4-Create-the-UI-Extension-Target-Optional","level":3,"type":"heading","text":"Step 4: Create the UI Extension Target (Optional)"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"type":"text","text":" and select "},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":", set:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}]}]]]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Step-5-Implement-the-UI-Extension-Handler","text":"Step 5: Implement the UI Extension Handler","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"code":"WalletExtensionUIHandler","type":"codeVoice"},{"type":"text","text":". Build your authentication UI inside the initializer and call "},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"type":"text","text":" when the user finishes."}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authVi