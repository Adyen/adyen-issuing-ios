{"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"code":"CardProvisioningSessions","type":"codeVoice"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}]}],"type":"aside"},{"text":"Import","type":"heading","level":2,"anchor":"Import"},{"type":"codeListing","code":["import CardProvisioningSessions","import IssuingCommon"],"syntax":"swift"},{"level":2,"type":"heading","text":"Session Token Role","anchor":"Session-Token-Role"},{"inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\"roles\": [\"Network Token: Create\"]"],"syntax":"json"},{"level":2,"anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"type":"text","text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment."}]},{"code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"syntax":"swift","type":"codeListing"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"level":2,"text":"Initialize a Provisioning Session","type":"heading","anchor":"Initialize-a-Provisioning-Session"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"ProvisioningSession"},{"type":"text","text":" and call "},{"type":"codeVoice","code":"configure()"},{"text":" to fetch activation data. The initializer is synchronous — async work begins only in ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"type":"codeListing"},{"level":2,"anchor":"Check-the-Provisioning-State","text":"Check the Provisioning State","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"]},{"level":2,"text":"Provision the Card","type":"heading","anchor":"Provision-the-Card"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the cardholder taps "},{"inlineContent":[{"type":"text","text":"Add to Apple Wallet"}],"type":"strong"},{"type":"text","text":", present the native Wallet sheet:"}]},{"syntax":"swift","type":"codeListing","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"]},{"level":2,"type":"heading","anchor":"Handle-the-Result","text":"Handle the Result"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provision(paymentInstrumentId:viewController:)"},{"type":"text","text":" returns a "},{"code":"CardActivationState","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"]},{"level":2,"type":"heading","text":"Wallet Extension","anchor":"Wallet-Extension"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s "},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"text":" section.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The Sessions approach provides a high-level base class, "},{"code":"WalletExtensionHandler","type":"codeVoice"},{"type":"text","text":", that handles the full extension flow. You subclass it and override a small set of methods."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Prerequisites","text":"Prerequisites"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A shared keychain access group must be configured (the same "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" you passed to "},{"code":"Configuration","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"orderedList"},{"level":3,"text":"Step 1: Create the Non-UI Extension Target","anchor":"Step-1-Create-the-Non-UI-Extension-Target","type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]