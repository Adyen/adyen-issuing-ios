pe":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}]]],"type":"table"},{"level":3,"anchor":"How-the-Extension-Flow-Works","type":"heading","text":"How the Extension Flow Works"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"User opens Apple Wallet","type":"text"}],"type":"strong"},{"type":"text","text":" — the SDK reads cached activation data to determine available cards. Your app appears in "},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"User selects a card","type":"text"}],"type":"strong"},{"type":"text","text":" — card art from "},{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"},{"type":"text","text":" is shown."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"type":"text","text":" — if "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", your UI Extension is presented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Provisioning","type":"text"}],"type":"strong"},{"type":"text","text":" — the SDK fetches a fresh session token via "},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"type":"text","text":" and completes provisioning."}]}]}]},{"level":3,"anchor":"Troubleshooting","type":"heading","text":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"App does not appear in Wallet’s “From Apps on Your iPhone”:"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement is present on all targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" has been called in the main app at least once so activation data is cached."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" matches your class name exactly."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication UI does not appear:"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Extension cannot read cached data:"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm the "},{"code":"keychainAccessGroup()","type":"codeVoice"},{"type":"text","text":" return value matches the "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" used in "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"type":"text","text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier."}]}]}]},{"level":2,"anchor":"Testing","type":"heading","text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Card provisioning requires a ","type":"text"},{"inlineContent":[{"type":"text","text":"physical device"}],"type":"strong"},{"text":" and a supported distribution build (TestFlight or App Store) using the ","type":"text"},{"inlineContent":[{"type":"text","text":"live"}],"type":"strong"},{"text":" environment. The Simulator is not supported for provisioning.","type":"text"}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/sessionsprovisioningguide"]}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"url":"\/documentation\/issuingsdkdocs\/gettingstarted","type":"topic","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","role":"article","abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"kind":"article","title":"A Starting Guide (Sessions)"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","type":"topic","role":"collection","abstract":[],"kind":"symbol","title":"IssuingSDKDocs"}}}