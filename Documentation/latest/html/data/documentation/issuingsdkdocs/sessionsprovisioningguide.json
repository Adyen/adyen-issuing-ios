{"sections":[],"metadata":{"role":"article","title":"Card Provisioning Sessions","modules":[{"name":"IssuingSDKDocs"}],"roleHeading":"Article"},"kind":"article","identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"code":"CardProvisioningSessions","type":"codeVoice"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"type":"text","text":" before proceeding."}],"type":"paragraph"}]},{"level":2,"type":"heading","text":"Import","anchor":"Import"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"]},{"text":"Session Token Role","anchor":"Session-Token-Role","level":2,"type":"heading"},{"inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["\"roles\": [\"Network Token: Create\"]"],"type":"codeListing"},{"level":2,"type":"heading","text":"Create a Configuration Object","anchor":"Create-a-Configuration-Object"},{"inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"type":"text","text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}],"type":"paragraph"}]},{"text":"Initialize a Provisioning Session","level":2,"anchor":"Initialize-a-Provisioning-Session","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"ProvisioningSession","type":"codeVoice"},{"type":"text","text":" and call "},{"code":"configure()","type":"codeVoice"},{"text":" to fetch activation data. The initializer is synchronous — async work begins only in ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"]},{"level":2,"type":"heading","text":"Check the Provisioning State","anchor":"Check-the-Provisioning-State"},{"inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"],"type":"codeListing"},{"text":"Provision the Card","anchor":"Provision-the-Card","type":"heading","level":2},{"inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":", present the native Wallet sheet:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"],"type":"codeListing"},{"text":"Handle the Result","level":2,"anchor":"Handle-the-Result","type":"heading"},{"inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"type":"text","text":" returns a "},{"code":"CardActivationState","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"type":"codeListing"},{"text":"Wallet Extension","level":2,"anchor":"Wallet-Extension","type":"heading"},{"inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Sessions approach provides a high-level base class, "},{"code":"WalletExtensionHandler","type":"codeVoice"},{"type":"text","text":", that handles the full extension flow. You subclass it and override a small set of methods."}],"type":"paragraph"},{"text":"Prerequisites","level":3,"anchor":"Prerequisites","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"In-app provisioning must be working first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" you passed to ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Step 1: Create the Non-UI Extension Target","level":3,"anchor":"Step-1-Create-the-Non-UI-Extension-Target","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"type":"text","text":") and include the same access group identifier you pass to "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" in "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":" (e.g., "},{"code":"[TeamId].com.yourcompany.shared","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"code":"CardProvisioningSessions","type":"codeVoice"},{"type":"text","text":" as a dependency of this target."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Step 2: Implement the Non-UI Extension Handler","level":3,"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","type":"heading"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"code":"WalletExtensionHandler","type":"codeVoice"},{"type":"text","text":". The class name must match the "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" in "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"],"type":"codeListing"},{"text":"Required Overrides","level":4,"anchor":"Required-Overrides","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared keychain group for activation data cached by the main app"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Provide card art as a "},{"code":"CGImage","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Optional Overrides","level":4,"anchor":"Optional-Overrides","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default"}]}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Override to use "},{"code":".test","type":"codeVoice"},{"type":"text","text":" environment"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Step 3: Ensure Activation Data Is Cached","level":3,"anchor":"Step-3-Ensure-Activation-Data-Is-Cached","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK caches activation data in the shared keychain automatically when you call "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" in the main app with a "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section."}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The user must open the provisioning flow in your main app at least once before the extension can show cards.","type":"text"}]}],"name":"Important","style":"important"},{"level":3,"anchor":"Step-4-Create-the-UI-Extension-Target-Optional","type":"heading","text":"Step 4: Create the UI Extension Target (Optional)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning."}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"type":"text","text":" and select "},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":", set:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement."}]}]}]},{"level":3,"anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading","text":"Step 5: Implement the UI Extension Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"code":"WalletExtensionUIHandler","type":"codeVoice"},{"text":". Build your authentication UI inside the initializer and call ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when the user finishes.","type":"text"}]},{"syntax":"swift","code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: Str