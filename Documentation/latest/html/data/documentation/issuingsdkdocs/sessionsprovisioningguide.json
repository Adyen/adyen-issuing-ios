t","text":"User opens Apple Wallet"}],"type":"strong"},{"text":" — the SDK reads cached activation data to determine available cards. Your app appears in ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"User selects a card","type":"text"}]},{"text":" — card art from ","type":"text"},{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"},{"text":" is shown.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"type":"text","text":" — if "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", your UI Extension is presented."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Provisioning","type":"text"}]},{"text":" — the SDK fetches a fresh session token via ","type":"text"},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"text":" and completes provisioning.","type":"text"}]}]}]},{"type":"heading","text":"Troubleshooting","level":3,"anchor":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"App does not appear in Wallet’s “From Apps on Your iPhone”:"}]}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement is present on all targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" has been called in the main app at least once so activation data is cached."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" matches your class name exactly."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication UI does not appear:"}]}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Extension cannot read cached data:"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" return value matches the "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" used in "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"inlineContent":[{"type":"text","text":"Keychain Sharing"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Testing","text":"Testing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card provisioning requires a "},{"type":"strong","inlineContent":[{"type":"text","text":"physical device"}]},{"type":"text","text":" and a supported distribution build (TestFlight or App Store) using the "},{"type":"strong","inlineContent":[{"text":"live","type":"text"}]},{"type":"text","text":" environment. The Simulator is not supported for provisioning."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"variants":[{"paths":["\/documentation\/issuingsdkdocs\/sessionsprovisioningguide"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Card Provisioning Sessions","modules":[{"name":"IssuingSDKDocs"}],"role":"article","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide"},"sections":[],"abstract":[{"text":"Add payment cards to Apple Wallet using the session-based API.","type":"text"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"title":"A Starting Guide (Sessions)","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"role":"article","type":"topic","url":"\/documentation\/issuingsdkdocs\/gettingstarted","kind":"article","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"kind":"symbol","url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","title":"IssuingSDKDocs","type":"topic"}}}