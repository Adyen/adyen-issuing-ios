inside the initializer and call "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when the user finishes."}]},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI is also supported via "},{"type":"codeVoice","code":"UIHostingController"},{"type":"text","text":"."}]},{"type":"heading","text":"Entitlements Summary","level":3,"anchor":"Entitlements-Summary"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entitlement","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Main App","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Non-UI Extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"UI Extension","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"—","type":"text"}]}]]],"header":"row"},{"type":"heading","text":"How the Extension Flow Works","level":3,"anchor":"How-the-Extension-Flow-Works"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"User opens Apple Wallet"}],"type":"strong"},{"text":" — the SDK reads cached activation data to determine available cards. Your app appears in ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User selects a card"}]},{"type":"text","text":" — card art from "},{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"},{"type":"text","text":" is shown."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication"}],"type":"strong"},{"type":"text","text":" — if "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":", your UI Extension is presented."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Provisioning"}]},{"type":"text","text":" — the SDK fetches a fresh session token via "},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"text":" and completes provisioning.","type":"text"}]}]}]},{"type":"heading","text":"Troubleshooting","level":3,"anchor":"Troubleshooting"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"App does not appear in Wallet’s “From Apps on Your iPhone”:","type":"text"}]}]},{"items":[{"content":[{"inlineContent":[{"text":"Verify the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement is present on all targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":" has been called in the main app at least once so activation data is cached.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" matches your class name exactly."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication UI does not appear:","type":"text"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Extension cannot read cached data:","type":"text"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" return value matches the "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" used in "},{"code":"Configuration","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"text":" entitlement (","type":"text"},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Testing","type":"heading","text":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Card provisioning requires a "},{"inlineContent":[{"type":"text","text":"physical device"}],"type":"strong"},{"text":" and a supported distribution build (TestFlight or App Store) using the ","type":"text"},{"inlineContent":[{"type":"text","text":"live"}],"type":"strong"},{"type":"text","text":" environment. The Simulator is not supported for provisioning."}]}],"kind":"content"}],"kind":"article","references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","abstract":[],"type":"topic","url":"\/documentation\/issuingsdkdocs","title":"IssuingSDKDocs","kind":"symbol"},"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs/GettingStarted":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","title":"A Starting Guide (Sessions)","role":"article","type":"topic","url":"\/documentation\/issuingsdkdocs\/gettingstarted","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"kind":"article"}}}