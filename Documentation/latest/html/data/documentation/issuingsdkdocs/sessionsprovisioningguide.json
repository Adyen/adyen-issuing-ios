of this target.","type":"text"}]}]}],"type":"orderedList"},{"level":3,"text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","type":"heading"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> SessionEnvironment {","        return .live","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Required Overrides","level":4,"type":"heading","anchor":"Required-Overrides"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared keychain group for activation data cached by the main app"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fetch a session token from your backend","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}]}]]],"type":"table"},{"level":4,"text":"Optional Overrides","anchor":"Optional-Overrides","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"inlineContent":[{"text":"Default","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment()"}]}],[{"inlineContent":[{"type":"codeVoice","code":".live"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Override to use "},{"type":"codeVoice","code":".test"},{"type":"text","text":" environment"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Step-3-Ensure-Activation-Data-Is-Cached","type":"heading","level":3,"text":"Step 3: Ensure Activation Data Is Cached"},{"inlineContent":[{"text":"The SDK caches activation data in the shared keychain automatically when you call ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" in the main app with a ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The user must open the provisioning flow in your main app at least once before the extension can show cards."}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"level":3,"text":"Step 4: Create the UI Extension Target (Optional)","type":"heading","anchor":"Step-4-Create-the-UI-Extension-Target-Optional"},{"inlineContent":[{"text":"If ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"t