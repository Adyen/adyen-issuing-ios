{"abstract":[{"type":"text","text":"Add payment cards to Apple Wallet using the session-based API."}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally."}],"type":"paragraph"},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted"},{"type":"text","text":" before proceeding."}]}],"name":"Important"},{"level":2,"type":"heading","text":"Import","anchor":"Import"},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import IssuingCommon"]},{"level":2,"type":"heading","text":"Session Token Role","anchor":"Session-Token-Role"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}]},{"code":["\"roles\": [\"Network Token: Create\"]"],"type":"codeListing","syntax":"json"},{"anchor":"Create-a-Configuration-Object","level":2,"text":"Create a Configuration Object","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"type":"text","text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment."}]},{"code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}]}],"type":"aside","name":"Note"},{"type":"heading","text":"Initialize a Provisioning Session","level":2,"anchor":"Initialize-a-Provisioning-Session"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create an instance of "},{"code":"ProvisioningSession","type":"codeVoice"},{"type":"text","text":" and call "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"code":"configure()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"syntax":"swift"},{"text":"Check the Provisioning State","level":2,"type":"heading","anchor":"Check-the-Provisioning-State"},{"type":"paragraph","inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}]},{"code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Provision the Card","anchor":"Provision-the-Card"},{"type":"paragraph","inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add to Apple Wallet","type":"text"}]},{"text":", present the native Wallet sheet:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"]},{"text":"Handle the Result","level":2,"type":"heading","anchor":"Handle-the-Result"},{"type":"paragraph","inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"type":"codeVoice","code":"CardActivationState"},{"text":":","type":"text"}]},{"code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"syntax":"swift","type":"codeListing"},{"text":"Wallet Extension","level":2,"type":"heading","anchor":"Wallet-Extension"},{"inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"code":"WalletExtensionHandler","type":"codeVoice"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}],"type":"paragraph"},{"anchor":"Prerequisites","level":3,"text":"Prerequisites","type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"In-app provisioning must be working first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}]}]},{"content":[{"inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" you passed to ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"heading","text":"Step 1: Create the Non-UI Extension Target","level":3,"anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":", find the ","type":"text"},{"code":"NSExtension","type":"codeVoice"},{"text":" dictionary and set:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}],"type":"paragraph"}]]],"header":"row","type":"table"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Keychain Sharing"}]},{"text":" entitlement (","type":"text"},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"text":" (e.g., ","type":"text"},{"type":"codeVoice","code":"[TeamId].com.yourcompany.shared"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"text":"Add ","type":"text"},{"code":"CardProvisioningSessions","type":"codeVoice"},{"type":"text","text":" as a dependency of this target."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Step 2: Implement the Non-UI Extension Handler","type":"heading","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"]},{"text":"Required Overrides","type":"heading","anchor":"Required-Overrides","level":4},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Fetch a session token from your backend","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}]}]]],"type":"table"},{"anchor":"Optional-Overrides","type":"heading","level":4,"text":"Optional Overrides"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"inlineContent":[{"text":"Default","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".live"}]}],[{"type":"paragraph","inlineContent":[{"text":"Override to use ","type":"text"},{"type":"codeVoice","code":".test"},{"text":" environment","type":"text"}]}]]],"type":"table"},{"text":"Step 3: Ensure Activation Data Is Cached","type":"heading","anchor":"Step-3-Ensure-Activation-Data-Is-Cached","level":3},{"type":"paragraph","inlineContent":[{"text":"The SDK caches activation data in the shared keychain automatically when you call ","type":"text"},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" in the main app with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s "},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"type":"text","text":" section."}]},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user must open the provisioning flow in your main app at least once before the extension can show cards."}]}],"type":"aside"},{"anchor":"Step-4-Create-the-UI-Extension-Target-Optional","type":"heading","level":3,"text":"Step 4: Create the UI Extension Target (Optional)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"text":" and select ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":", set:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}]}]]],"header":"row","type":"table"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"type":"codeVoice","code":"WalletExtensionUIHandler"},{"type":"text","text":". Build your authentication UI inside the initializer and call "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when the user finishes.","type":"text"}]},{"code":["import CardProvisioningSessions","import UIKit","","class WalletUIExtensionHandler: WalletExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let authViewController = YourAuthViewController { [weak self] success in","            self?.completeAuthorization(result: success ? .authorized : .canceled)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) { fatalError(\"init(coder:) has not been implemented\") }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"SwiftUI is also supported via ","type":"text"},{"code":"UIHostingController","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Entitlements Summary","level":3,"type":"heading","anchor":"Entitlements-Summary"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entitlement","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Main App"}]}],[{"type":"paragraph","inlineContent":[{"text":"Non-UI Extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UI Extension"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"—"}]}]]],"type":"table"},{"anchor":"How-the-Extension-Flow-Works","level":3,"text":"How the Extension Flow Works","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"User opens Apple Wallet","type":"text"}],"type":"strong"},{"text":" — the SDK reads cached activation data to determine available cards. Your app appears in ","type":"text"},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"User selects a card","type":"text"}],"type":"strong"},{"text":" — card art from ","type":"text"},{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"},{"text":" is shown.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"text":" — if ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", your UI Extension is presented.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Provisioning","type":"text"}],"type":"strong"},{"text":" — the SDK fetches a fresh session token via ","type":"text"},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"text":" and completes provisioning.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Troubleshooting","level":3,"text":"Troubleshooting","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"App does not appear in Wallet’s “From Apps on Your iPhone”:"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement is present on all targets.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure ","type":"text"},{"type":"codeVoice","code":"configure()"},{"text":" has been called in the main app at least once so activation data is cached.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" matches your class name exactly.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication UI does not appear:"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Extension cannot read cached data:"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Confirm the ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup()"},{"text":" return value matches the ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" used in ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the ","type":"text"},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"text":" entitlement (","type":"text"},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"inlineConten