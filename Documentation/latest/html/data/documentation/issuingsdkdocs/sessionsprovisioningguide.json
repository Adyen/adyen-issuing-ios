so activation data is cached.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" matches your class name exactly.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication UI does not appear:"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Extension cannot read cached data:"}],"type":"strong"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Confirm the ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup()"},{"text":" return value matches the ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" used in ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the ","type":"text"},{"inlineContent":[{"type":"text","text":"Keychain Sharing"}],"type":"strong"},{"text":" entitlement (","type":"text"},{"type":"codeVoice","code":"com.apple.security.keychain-access-groups"},{"text":") is present on both the main app and Non-UI Extension targets and includes the same access group identifier.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"inli