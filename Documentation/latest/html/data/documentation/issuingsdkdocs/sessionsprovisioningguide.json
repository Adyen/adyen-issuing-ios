","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" has been called in the main app at least once so activation data is cached.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Check that ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" matches your class name exactly.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"text":"Authentication UI does not appear:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"text":"Extension cannot read cached data:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Confirm the ","type":"text"},{"code":"keychainAccessGroup()","type":"codeVoice"},{"text":" return value matches the ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":" used in ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify the ","type":"text"},{"inlineContent":[{"type":"text","text":"Keychain Sharing"}],"type":"strong"},{"text":" entitlement (","type":"text"},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"text":") is present on both the main app and Non-UI