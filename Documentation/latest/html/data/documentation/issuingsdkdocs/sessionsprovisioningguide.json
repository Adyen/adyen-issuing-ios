{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Sessions approach uses the "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Complete the steps in ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true},{"text":" before proceeding.","type":"text"}]}],"type":"aside","name":"Important"},{"text":"Import","level":2,"anchor":"Import","type":"heading"},{"code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Session Token Role","anchor":"Session-Token-Role","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When fetching a session token for provisioning, use the following role:"}]},{"type":"codeListing","syntax":"json","code":["\"roles\": [\"Network Token: Create\"]"]},{"anchor":"Create-a-Configuration-Object","text":"Create a Configuration Object","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"codeVoice","code":"CardProvisioningSessions.Configuration"},{"type":"text","text":" with your certificate, your Apple Team ID, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    appTeamId: \"[YourAppleTeamID]\",","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below."}]}]},{"type":"heading","level":2,"text":"Initialize a Provisioning Session","anchor":"Initialize-a-Provisioning-Session"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":" and call ","type":"text"},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" to fetch activation data. The initializer is synchronous — async work begins only in "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":"."}]},{"code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Check-the-Provisioning-State","level":2,"type":"heading","text":"Check the Provisioning State"},{"type":"paragraph","inlineContent":[{"text":"Before showing the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"]},{"type":"heading","level":2,"anchor":"Provision-the-Card","text":"Provision the Card"},{"type":"paragraph","inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Add to Apple Wallet"}]},{"type":"text","text":", present the native Wallet sheet:"}]},{"syntax":"swift","type":"codeListing","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"]},{"level":2,"anchor":"Handle-the-Result","type":"heading","text":"Handle the Result"},{"inlineContent":[{"code":"provision(paymentInstrumentId:viewController:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"type":"codeVoice","code":"CardActivationState"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"type":"codeListing"},{"text":"Wallet Extension","level":2,"anchor":"Wallet-Extension","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section.","type":"text"}]},{"inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"text":", that handles the full extension flow. You subclass it and override a small set of methods.","type":"text"}],"type":"paragraph"},{"text":"Prerequisites","type":"heading","level":3,"anchor":"Prerequisites"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In-app provisioning must be working first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" you passed to ","type":"text"},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":")."}]}]}]},{"type":"heading","level":3,"anchor":"Step-1-Create-the-Non-UI-Extension-Target","text":"Step 1: Create the Non-UI Extension Target"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":" and select "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files except ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler"}],"type":"paragraph"}]]],"type":"table"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add a shared app group entitlement matching the one in your main app (e.g., ","type":"text"},{"type":"codeVoice","code":"group.com.yourcompany.wallet"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"text":" as a dependency of this target.","type":"text"}]}]}]},{"text":"Step 2: Implement the Non-UI Extension Handler","type":"heading","level":3,"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionHandler"},{"text":". The class name must match the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import CardProvisioningSessions","","class WalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's ConfigurationParameters.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"]},{"type":"heading","anchor":"Required-Overrides","text":"Required Overrides","level":4},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"