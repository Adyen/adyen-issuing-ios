{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SessionsProvisioningGuide"},"abstract":[{"text":"Add payment cards to Apple Wallet using the session-based API.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","metadata":{"title":"Card Provisioning Sessions","roleHeading":"Article","modules":[{"name":"IssuingSDKDocs"}],"role":"article"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Sessions approach uses the ","type":"text"},{"code":"CardProvisioningSessions","type":"codeVoice"},{"text":" package. You supply a session token from your backend and the SDK manages device registration, activation data retrieval, provisioning state tracking, and retries internally.","type":"text"}]},{"content":[{"inlineContent":[{"text":"Complete the steps in ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/GettingStarted","isActive":true,"type":"reference"},{"text":" before proceeding.","type":"text"}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"},{"level":2,"text":"Import","type":"heading","anchor":"Import"},{"syntax":"swift","code":["import CardProvisioningSessions","import IssuingCommon"],"type":"codeListing"},{"level":2,"text":"Session Token Role","type":"heading","anchor":"Session-Token-Role"},{"type":"paragraph","inlineContent":[{"text":"When fetching a session token for provisioning, use the following role:","type":"text"}]},{"syntax":"json","code":["\"roles\": [\"Network Token: Create\"]"],"type":"codeListing"},{"level":2,"text":"Create a Configuration Object","type":"heading","anchor":"Create-a-Configuration-Object"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"CardProvisioningSessions.Configuration","type":"codeVoice"},{"text":" with your certificate, the payment instrument IDs you want to provision, a shared keychain access group, and the target environment.","type":"text"}]},{"syntax":"swift","code":["let certificate: Data = \/\/ ... load from your app bundle","","let parameters = CardProvisioningSessions.Configuration(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[YourAppleTeamID].com.yourcompany.shared\",","    environment: .live",")"],"type":"codeListing"},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" must be shared between your main app and any Wallet extensions so that cached activation data is accessible from the extension. See the Wallet Extension section below.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"level":2,"text":"Initialize a Provisioning Session","type":"heading","anchor":"Initialize-a-Provisioning-Session"},{"type":"paragraph","inlineContent":[{"text":"Create an instance of ","type":"text"},{"code":"ProvisioningSession","type":"codeVoice"},{"text":" and call ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":" to fetch activation data. The initializer is synchronous — async work begins only in ","type":"text"},{"code":"configure()","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","}"],"type":"codeListing"},{"level":2,"text":"Check the Provisioning State","type":"heading","anchor":"Check-the-Provisioning-State"},{"type":"paragraph","inlineContent":[{"text":"Before showing the ","type":"text"},{"inlineContent":[{"text":"Add to Apple Wallet","type":"text"}],"type":"strong"},{"text":" button, check the current provisioning state for the payment instrument.","type":"text"}]},{"syntax":"swift","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let devices):","    \/\/ Show the \"Add to Apple Wallet\" button.","    \/\/ devices indicates which of phone \/ watch can be provisioned.","case .provisioned(let devices):","    \/\/ Already provisioned on all available devices. Hide or disable the button.","case .cannotProvision(let reason):","    \/\/ Cannot provision. Use reason.localizedDescription for display only.","}"],"type":"codeListing"},{"level":2,"text":"Provision the Card","type":"heading","anchor":"Provision-the-Card"},{"type":"paragraph","inlineContent":[{"text":"When the cardholder taps ","type":"text"},{"inlineContent":[{"text":"Add to Apple Wallet","type":"text"}],"type":"strong"},{"text":", present the native Wallet sheet:","type":"text"}]},{"syntax":"swift","code":["guard let viewController = view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Update your UI based on activationState","} catch {","    \/\/ Handle provisioning error","}"],"type":"codeListing"},{"level":2,"text":"Handle the Result","type":"heading","anchor":"Handle-the-Result"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"provision(paymentInstrumentId:viewController:)"},{"text":" returns a ","type":"text"},{"code":"CardActivationState","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["switch activationState {","case .activated:","    \/\/ Card successfully added and active.","case .requiresActivation:","    \/\/ Card added but requires further activation steps.","case .activating:","    \/\/ Card is currently activating.","case .suspended:","    \/\/ Card suspended by the issuer.","case .deactivated:","    \/\/ Card deactivated.","case .unknown:","    \/\/ State could not be determined.","}"],"type":"codeListing"},{"level":2,"text":"Wallet Extension","type":"heading","anchor":"Wallet-Extension"},{"type":"paragraph","inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders provision cards directly from the Apple Wallet app. When configured, your app appears in Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"text":" section.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Sessions approach provides a high-level base class, ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":", that handles the full extension flow. You subclass it and override a small set of methods."}]},{"type":"heading","level":3,"text":"Prerequisites","anchor":"Prerequisites"},{"items":[{"content":[{"inlineContent":[{"text":"In-app provisioning must be working first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement must be present on the main app, Non-UI Extension, and UI Extension targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A shared keychain access group must be configured (the same ","type":"text"},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":" you passed to ","type":"text"},{"code":"Configuration","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"orderedList"},{"level":3,"text":"Step 1: Create the Non-UI Extension Target","type":"heading","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"text":" and select ","type":"text"},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"code":"Info.plist","type":"codeVoice"},{"text":", find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).MyWalletExtensionHandler"}],"type":"paragraph"}]]]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"inlineContent":[{"text":"Keychain Sharing","type":"text"}],"type":"strong"},{"type":"text","text":" entitlement ("},{"code":"com.apple.security.keychain-access-groups","type":"codeVoice"},{"type":"text","text":") and include the same access group identifier you pass to "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Configuration"},{"type":"text","text":" (e.g., "},{"type":"codeVoice","code":"[TeamId].com.yourcompany.shared"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"CardProvisioningSessions"},{"type":"text","text":" as a dependency of this target."}]}]}],"type":"orderedList"},{"level":3,"text":"Step 2: Implement the Non-UI Extension Handler","type":"heading","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"type":"codeVoice","code":"WalletExtensionHandler"},{"type":"text","text":". The class name must match the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import UIKit","","class MyWalletExtensionHandler: WalletExtensionHandler {","","    override func keychainAccessGroup() -> String {","        \/\/ Must match the keychainAccessGroup in your main app's Configuration.","        return \"[TeamId].com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given payment instrument IDs.","        return try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you select the correct asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let cgImage = UIImage(named: imageName)?.cgImage { return cgImage }","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have a UI Extension for cardholder authentication.","        return true","    }","","    override func environment() -> IssuingEnvironment {","        return .live","    }","}"],"type":"codeListing","syntax":"swift"},{"level":4,"text":"Required Overrides","anchor":"Required-Overrides","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared keychain group for activation data cached by the main app","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fetch a session token from your backend","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}]}]]],"type":"table"},{"level":4,"text":"Optional Overrides","anchor":"Optional-Overrides","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Override to use ","type":"text"},{"code":".test","type":"codeVoice"},{"text":" environment","type":"text"}]}]]],"type":"table"},{"level":3,"text":"Step 3: Ensure Activation Data Is Cached","anchor":"Step-3-Ensure-Activation-Data-Is-Cached","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK caches activation data in the shared keychain automatically when you call "},{"type":"codeVoice","code":"configure()"},{"type":"text","text":" in the main app with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":". The extension reads from this cache. If no data is cached, your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user must open the provisioning flow in your main app at least once before the extension can show cards.","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"level":3,"text":"Step 4: Create the UI Extension Target (Optional)","anchor":"Step-4-Create-the-UI-Extension-Target-Optional","type":"heading"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet will present your UI Extension for cardholder authentication before provisioning."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"type":"text","text":" and select "},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files except "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", set:"}]},{"header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement."}]}]}]},{"level":3,"text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"codeVoice","code":"WalletExtensionUIHandler"},{"type":"text","text":". Build your authentication UI inside the initializer and call "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when the user finishes."}],"type":"paragraph"},{"code":["import CardProvisioningSessions","import UIK