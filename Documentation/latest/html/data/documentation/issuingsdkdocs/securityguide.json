{"abstract":[{"text":"Ensure your integration meets security best practices when handling sensitive data.","type":"text"}],"metadata":{"roleHeading":"Article","title":"Security Guide","modules":[{"name":"IssuingSDKDocs"}],"role":"article"},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs\/SecurityGuide","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK handles sensitive financial data and cryptographic operations. When integrating the SDK into your application, your client app is responsible for applying the following iOS security practices.","type":"text"}]},{"anchor":"Device-Unlock-Requirement","text":"Device Unlock Requirement","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Require the user to authenticate with device biometrics or PIN before performing sensitive operations such as provisioning a card."}]},{"syntax":"swift","type":"codeListing","code":["import LocalAuthentication","","func requireAuthentication(completion: @escaping (Bool) -> Void) {","    let context = LAContext()","    var error: NSError?","","    guard context.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else {","        completion(false)","        return","    }","","    context.evaluatePolicy(","        .deviceOwnerAuthentication,","        localizedReason: \"Authenticate to proceed\"","    ) { success, _ in","        DispatchQueue.main.async { completion(success) }","    }","}"]},{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":".deviceOwnerAuthentication","type":"codeVoice"},{"type":"text","text":" (not "},{"type":"codeVoice","code":".deviceOwnerAuthenticationWithBiometrics"},{"text":") so users with a passcode but no biometrics are not locked out.","type":"text"}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"},{"text":"Prevent Screen Capture","anchor":"Prevent-Screen-Capture","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prevent screenshots and screen recordings on screens that display sensitive card or provisioning data."}]},{"type":"codeListing","code":["func addScreenshotProtection(to view: UIView) {","    let field = UITextField()","    field.isSecureTextEntry = true","    view.addSubview(field)","    field.translatesAutoresizingMaskIntoConstraints = false","    NSLayoutConstraint.activate([","        field.centerXAnchor.constraint(equalTo: view.centerXAnchor),","        field.centerYAnchor.constraint(equalTo: view.centerYAnchor)","    ])","    view.layer.superlayer?.addSublayer(field.layer)","    field.layer.sublayers?.last?.addSublayer(view.layer)","}"],"syntax":"swift"},{"type":"heading","text":"Protect Sensitive Views in App Switcher","anchor":"Protect-Sensitive-Views-in-App-Switcher","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Hide sensitive content when the app moves to the background to prevent it appearing in the iOS app switcher."}]},{"code":["final class AppDelegate: UIResponder, UIApplicationDelegate {","    private var privacyOverlay: UIView?","","    func applicationWillResignActive(_ application: UIApplication) {","        guard privacyOverlay == nil,","              let window = application.keyWindow else { return }","        let overlay = UIView(frame: window.bounds)","        overlay.backgroundColor = .systemBackground","        window.addSubview(overlay)","        privacyOverlay = overlay","    }","","    func applicationDidBecomeActive(_ application: UIApplication) {","        privacyOverlay?.removeFromSuperview()","        privacyOverlay = nil","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Secure-Data-Storage","text":"Secure Data Storage","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Never store tokens, keys, or credentials in "},{"code":"UserDefaults","type":"codeVoice"},{"text":" or plain files. Always use the iOS Keychain with appropriate accessibility constraints.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func saveToKeychain(_ data: Data, service: String, account: String) throws {","    let query: [String: Any] = [","        kSecClass as String: kSecClassGenericPassword,","        kSecAttrService as String: service,","        kSecAttrAccount as String: account,","        kSecValueData as String: data,","        kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly","    ]","    let status = SecItemAdd(query as CFDictionary, nil)","    guard status == errSecSuccess else {","        throw KeychainError.unexpectedStatus(status)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"kSecAttrAccessibleWhenUnlockedThisDeviceOnly"},{"type":"text","text":" to ensure data is only accessible when the device is unlocked and cannot be transferred to another device via iCloud backup."}]},{"anchor":"Handle-Sensitive-Data-in-Memory","text":"Handle Sensitive Data in Memory","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Minimise the lifetime of sensitive values in memory. Overwrite buffers as soon as they are no longer needed."}],"type":"paragraph"},{"code":["func clearSensitiveData(_ buffer: inout Data) {","    buffer.withUnsafeMutableBytes { ptr in","        ptr.baseAddress.map {","            memset_s($0, ptr.count, 0, ptr.count)","        }","    }","    buffer = Data()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Avoid storing sensitive values in ","type":"text"},{"code":"String","type":"codeVoice"},{"type":"text","text":" — prefer "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" so you control the lifecycle. Never log sensitive values."}],"type":"paragraph"},{"anchor":"Secure-Networking","type":"heading","level":2,"text":"Secure Networking"},{"inlineContent":[{"type":"text","text":"All communication with Adyen services uses HTTPS with TLS 1.2 or higher. Ensure your "},{"type":"codeVoice","code":"Info.plist"},{"text":" does not weaken App Transport Security:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["<!-- Do NOT add this unless absolutely required for a specific non-Adyen domain -->","<key>NSAppTransportSecurity<\/key>","<dict>","    <key>NSAllowsArbitraryLoads<\/key>","    <false\/>","<\/dict>"],"syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For additional protection, implement certificate pinning on your "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" to prevent man-in-the-middle attacks on your own backend endpoints."}]},{"level":2,"text":"Jailbreak Detection","anchor":"Jailbreak-Detection","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Jailbroken devices have weakened security controls that make it easier to inspect memory, bypass protections, and intercept payment data. To protect your users, integrate a dedicated mobile security solution that provides robust, actively maintained jailbreak and tampering detection.","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"Simple home-grown checks (path lookups, write-access probes) are trivially bypassed on a rooted device. A professional solution provides layered, regularly updated detection that is significantly harder to evade.","type":"text"}],"type":"paragraph"}],"name":"Note"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/issuingsdkdocs\/securityguide"]}],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/IssuingSDKDocs":{"abstract":[],"kind":"symbol","url":"\/documentation\/issuingsdkdocs","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs","role":"collection","title":"IssuingSDKDocs","type":"topic"}}}