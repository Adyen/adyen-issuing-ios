dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Required-Overrides","text":"Required Overrides"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared keychain group for cached data between app and extension","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}]}]],[[{"inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Optional-Overrides","level":3,"text":"Optional Overrides","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"inlineContent":[{"type":"text","text":"Default"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".live"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Set the session environment (","type":"text"},{"type":"codeVoice","code":".test"},{"type":"text","text":", "},{"type":"codeVoice","code":".live"},{"type":"text","text":")"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App","level":2,"text":"Step 3: Cache Activation Data in Your Main App","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."],"type":"codeListing"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section. Make sure the user has opened the provisioning flow in your main app at least once."}],"type":"paragraph"}],"style":"important","type":"aside"},{"anchor":"Step-4-Create-the-UI-Extension-Target","level":2,"text":"Step 4: Create the UI Extension Target","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the "},{"inlineContent":[{"text":"Action Extension","type":"text"}],"type":"strong"},{"type":"text","text":" template again (e.g., "},{"code":"WalletUIExtension","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Remove all generated files ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Update the "},{"type":"codeVoice","code":"Info.plist"},{"text":" — find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}]}]]],"type":"table","header":"row"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement to this target as well."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Step-5-Implement-the-UI-Extension-Handler","level":2,"text":"Step 5: Implement the UI Extension Handler","type":"heading"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","type":"reference"},{"text":". This view controller is presented by Apple Wallet when authentication is required.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"You can use UIKit or SwiftUI (via ","type":"text"},{"type":"codeVoice","code":"UIHostingController"},{"text":") for the authentication UI. The key requirement is calling ","type":"text"},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when the user finishes authenticating.","type":"text"}],"type":"paragraph"},{"anchor":"Using-SwiftUI","type":"heading","text":"Using SwiftUI","level":3},{"syntax":"swift","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing"},{"anchor":"Entitlements-Summary","type":"heading","text":"Entitlements Summary","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access."}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entitlement","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text"