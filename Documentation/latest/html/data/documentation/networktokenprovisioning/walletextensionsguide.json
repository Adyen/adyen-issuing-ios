{"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"identifier":{"url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/SecurityGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources"],"anchor":"Guides","generated":true}],"sections":[],"abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"text":" section, giving users another path to provision their cards.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This requires two app extensions:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provides card data, status, and handles the provisioning flow"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UI Extension"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Presents your custom authentication UI before provisioning"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic.","type":"text"}]},{"anchor":"Prerequisites","type":"heading","text":"Prerequisites","level":2},{"type":"paragraph","inlineContent":[{"text":"Before implementing wallet extensions:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Complete the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","type":"reference"},{"text":" guide and have in-app provisioning working.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure you have the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement. This entitlement must be added to ","type":"text"},{"inlineContent":[{"type":"text","text":"all three targets"}],"type":"strong"},{"type":"text","text":": the main app, the Non-UI Extension, and the UI Extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set up a shared keychain access group so the main app and extensions can share cached data.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Step-1-Create-the-Non-UI-Extension-Target","type":"heading","level":2,"text":"Step 1: Create the Non-UI Extension Target"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"text":" template and create a new target (e.g., ","type":"text"},{"code":"WalletExtension","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Remove all generated files ","type":"text"},{"inlineContent":[{"type":"text","text":"except"}],"type":"strong"},{"text":" ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Update the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" — find the ","type":"text"},{"code":"NSExtension","type":"codeVoice"},{"text":" dictionary and set:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler","type":"codeVoice"}]}]]]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement to this target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a shared app group entitlement (e.g., ","type":"text"},{"code":"group.com.yourcompany.wallet","type":"codeVoice"},{"type":"text","text":") matching the one in your main app."}],"type":"paragraph"}]}]},{"text":"Add the SDK to the Extension Target","anchor":"Add-the-SDK-to-the-Extension-Target","level":3,"type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager:"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"AdyenNetworkTokenProvisioning","type":"codeVoice"},{"text":" as a dependency of your extension target, just as you did for the main app.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual Integration:"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Embed the same XCFrameworks in the extension target with "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":". See "},{"type":"reference","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","isActive":true},{"type":"text","text":" for which frameworks are required."}],"type":"paragraph"},{"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","level":2,"text":"Step 2: Implement the Non-UI Extension Handler","type":"heading"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"reference","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler","isActive":true},{"type":"text","text":". This class is your extension’s entry point — its name must match the "},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"type":"text","text":" in your "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Required-Overrides","level":3,"text":"Required Overrides","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"keychainAccessGroup()","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Shared keychain group for cached data between app and extension"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fetch a session token from your backend","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"cardArt(paymentInstrumentId:brand:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Provide card art as a ","type":"text"},{"code":"CGImage","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"shouldAuthenticateUser()","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}]}]]],"type":"table"},{"text":"Optional Overrides","anchor":"Optional-Overrides","level":3,"type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"environment()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Set the session environment (","type":"text"},{"code":".test","type":"codeVoice"},{"text":", ","type":"text"},{"code":".live","type":"codeVoice"},{"text":")","type":"text"}]}]]],"type":"table"},{"level":2,"text":"Step 3: Cache Activation Data in Your Main App","anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."],"type":"codeListing"},{"type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section. Make sure the user has opened the provisioning flow in your main app at least once."}],"type":"paragraph"}],"style":"important"},{"type":"heading","level":2,"text":"Step 4: Create the UI Extension Target","anchor":"Step-4-Create-the-UI-Extension-Target"},{"type":"paragraph","inlineContent":[{"text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":" template again (e.g., "},{"type":"codeVoice","code":"WalletUIExtension"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Update the "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":" — find the "},{"type":"codeVoice","code":"NSExtension"},{"type":"text","text":" dictionary and set:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}]}]]],"header":"row","type":"table"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement to this target as well."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler","type":"heading"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","type":"reference"},{"text":". This view controller is presented by Apple Wallet when authentication is required.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can use UIKit or SwiftUI (via "},{"type":"codeVoice","code":"UIHostingController"},{"type":"text","text":") for the authentication UI. The key requirement is calling "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when the user finishes authenticating."}],"type":"paragraph"},{"level":3,"text":"Using SwiftUI","anchor":"Using-SwiftUI","type":"heading"},{"syntax":"swift","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing"},{"level":2,"text":"Entitlements Summary","anchor":"Entitlements-Summary","type":"heading"},{"inlineContent":[{"text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entitlement","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Main App","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Non-UI Extension","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"UI Extension","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.security.application-groups"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Example ","type":"text"},{"code":".entitlements","type":"codeVoice"},{"text":" file for the Non-UI Extension:","type":"text"}],"type":"paragraph"},{"syntax":"xml","code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"],"type":"codeListing"},{"level":2,"text":"How It Works","anchor":"How-It-Works","type":"heading"},{"inlineContent":[{"text":"Once configured, the flow works as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User opens Apple Wallet"}]},{"type":"text","text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User selects your app"}]},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication"}]},{"type":"text","text":" — If "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet presents your UI Extension. Your UI Extension calls "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when done."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Provisioning"}]},{"type":"text","text":" — The SDK handles the provisioning request using the session token from your "},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"type":"text","text":" method."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}]},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference."}],"type":"paragraph"}],"type":"aside"},{"level":2,"text":"Troubleshooting","anchor":"Troubleshooting","type":"heading"},{"level":3,"text":"App does not appear in Wallet’s “From Apps on Your iPhone”","anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement is present on all three targets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure activation data has been cached by the main app before opening Wallet."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"},{"type":"text","text":" (not the authorization variant) in the Non-UI Extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make sure the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" matches your handler class name exactly."}]}]}],"type":"unorderedList"},{"level":3,"text":"Authentication UI does not appear","anchor":"Authentication-UI-does-not-appear","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"level":3,"text":"Extension cannot access cached data","anchor":"Extension-cannot-access-cached-data","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm both the main app and the extension share the same keychain access group."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the "},{"type":"codeVoice","code":"keychainAccessGroup()"},{"type":"text","text":" override returns the correct value."}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"title":"Wallet Extensions","roleHeading":"Article","role":"article"},"references":{"doc://com.adyen.NetworkTokenProvisioning/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs","role":"collection","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"kind":"article","title":"Issuing SDK","url":"\/documentation\/issuingsdkdocs","type":"topic"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/AdditionalResources":{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources","role":"article","title":"Additional Resources","kind":"article","abstract":[{"type":"text","text":"Find more information about Adyen Issuing and related services."}],"url":"\/documentation\/networktokenprovisioning\/additionalresources","type":"topic"},"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/NetworkTokenProvisioningExtensionUIHandler":{"abstract":[{"type":"text","text":"An abstract base view controller that provides the UI layer for cardholder"},{"type":"text","text":" "},{"type":"text","text":"authentication during Apple Wallet provisioning."}],"type":"topic","title":"NetworkTokenProvisioningExtensionUIHandler","navigatorTitle":[{"text":"Network