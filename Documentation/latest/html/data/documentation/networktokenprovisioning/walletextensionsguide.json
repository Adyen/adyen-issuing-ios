{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide"},"kind":"article","sections":[],"abstract":[{"text":"Allow cardholders to provision cards directly from the Apple Wallet app.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section, giving users another path to provision their cards."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This requires two app extensions:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Extension","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provides card data, status, and handles the provisioning flow"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Presents your custom authentication UI before provisioning"}]}]]]},{"inlineContent":[{"type":"text","text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic."}],"type":"paragraph"},{"level":2,"text":"Prerequisites","type":"heading","anchor":"Prerequisites"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before implementing wallet extensions:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Complete the "},{"type":"reference","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","isActive":true},{"type":"text","text":" guide and have in-app provisioning working."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure you have the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement. This entitlement must be added to "},{"type":"strong","inlineContent":[{"text":"all three targets","type":"text"}]},{"type":"text","text":": the main app, the Non-UI Extension, and the UI Extension."}]}]},{"content":[{"inlineContent":[{"text":"Set up a shared keychain access group so the main app and extensions can share cached data.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"anchor":"Step-1-Create-the-Non-UI-Extension-Target","type":"heading","text":"Step 1: Create the Non-UI Extension Target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"type":"text","text":" template and create a new target (e.g., "},{"type":"codeVoice","code":"WalletExtension"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files "},{"inlineContent":[{"type":"text","text":"except"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Update the "},{"code":"Inf