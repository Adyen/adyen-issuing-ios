{"kind":"article","metadata":{"role":"article","title":"Wallet Extensions","roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/SecurityGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"type":"text","text":" section, giving users another path to provision their cards."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires two app extensions:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Extension","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Purpose","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-UI Extension","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Provides card data, status, and handles the provisioning flow","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"UI Extension","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presents your custom authentication UI before provisioning","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic."}]},{"anchor":"Prerequisites","type":"heading","level":2,"text":"Prerequisites"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before implementing wallet extensions:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete the ","type":"text"},{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","type":"reference","isActive":true},{"text":" guide and have in-app provisioning working.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure you have the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement. This entitlement must be added to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"all three targets"}]},{"text":": the main app, the Non-UI Extension, and the UI Extension.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set up a shared keychain access group so the main app and extensions can share cached data.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Step-1-Create-the-Non-UI-Extension-Target","type":"heading","level":2,"text":"Step 1: Create the Non-UI Extension Target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Action Extension"}]},{"text":" template and create a new target (e.g., ","type":"text"},{"type":"codeVoice","code":"WalletExtension"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Update the ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" — find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler","type":"codeVoice"}]}]]],"type":"table"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement to this target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add a shared app group entitlement (e.g., ","type":"text"},{"type":"codeVoice","code":"group.com.yourcompany.wallet"},{"text":") matching the one in your main app.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Add-the-SDK-to-the-Extension-Target","type":"heading","level":3,"text":"Add the SDK to the Extension Target"},{"type":"paragraph","inlineContent":