he SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a ","type":"text"},{"code":"keychainAccessGroup","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section. Make sure the user has opened the provisioning flow in your main app at least once."}],"type":"paragraph"}],"name":"Important"},{"type":"heading","level":2,"text":"Step 4: Create the UI Extension Target","anchor":"Step-4-Create-the-UI-Extension-Target"},{"type":"paragraph","inlineContent":[{"text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"inlineContent":[{"text":"File > New > Target","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the ","type":"text"},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"text":" template again (e.g., ","type":"text"},{"type":"codeVoice","code":"WalletUIExtension"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files "},{"inlineContent":[{"text":"except","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":" — find the "},{"code":"NSExtension","type":"codeVoice"},{"type":"text","text":" dictionary and set:"}]},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row","type":"table"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement to this target as well."}]}]}]},{"type":"heading","level":2,"text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"type":"paragraph","inlineContent":[{"text":"Create a subclass of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","type":"reference"},{"text":". This view controller is presented by Apple Wallet when authentication is required.","type":"text"}]},{"type":"codeListing","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"You can use UIKit or SwiftUI (via ","type":"text"},{"code":"UIHostingController","type":"codeVoice"},{"text":") for the authentication UI. The key requirement is calling ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when the user finishes authenticating.","type":"text"}]},{"type":"heading","level":3,"text":"Using SwiftUI","anchor":"Using-SwiftUI"},{"type":"codeListing","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"Entitlements Summary","anchor":"Entitlements-Summary"},{"type":"paragraph","inlineContent":[{"text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access.","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Entitlement"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Main App"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Non-UI Extension"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.security.application-groups"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"Example ","type":"text"},{"type":"codeVoice","code":".entitlements"},{"text":" file for the Non-UI Extension:","type":"text"}]},{"type":"codeListing","code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"],"syntax":"xml"},{"type":"heading","level":2,"text":"How It Works","anchor":"How-It-Works"},{"type":"paragraph","inlineContent":[{"text":"Once configured, the flow works as follows:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"User opens Apple Wallet","type":"text"}],"type":"strong"},{"type":"text","text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the "},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"type":"text","text":" section."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"User selects your app","type":"text"}],"type":"strong"},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"text":" — If ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":", Apple Wallet presents your UI Extension. Your UI Extension calls "},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"text":" when done.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Provisioning"}],"type":"strong"},{"text":" — The SDK handles the provisioning request using the session token from your ","type":"text"},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"text":" method.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference.","type":"text"}],"type":"paragraph"}],"name":"Note"},{"level":2,"anchor":"Troubleshooting","type":"heading","text":"Troubleshooting"},{"level":3,"anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone","type":"heading","text":"App does not appear in Wallet’s “From Apps on Your iPhone”"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement is present on all three targets."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure activation data has been cached by the main app before opening Wallet.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the ","type":"text"},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is set to "},{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"},{"text":" (not the authorization variant) in the Non-UI Extension.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make sure the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" matches your handler class name exactly.","type":"text"}]}]}]},{"level":3,"anchor":"Authentication-UI-does-not-appear","type":"heading","text":"Authentication UI does not appear"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"text":" is set to ","type":"text"},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"level":3,"anchor":"Extension-cannot-access-cached-data","type":"heading","text":"Extension cannot access cached data"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Confirm both the main app and the extension share the same keychain access group."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"code":"com.apple.security.application-groups","type":"codeVoice"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the "},{"code":"keychainAccessGroup()","type":"codeVoice"},{"text":" override returns the correct value.","type":"text"}]}]}]}]}],"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"metadata":{