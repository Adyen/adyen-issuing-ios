{"sections":[],"identifier":{"url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","interfaceLanguage":"swift"},"abstract":[{"text":"Allow cardholders to provision cards directly from the Apple Wallet app.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/SecurityGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources"],"generated":true}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"text":" section, giving users another path to provision their cards.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This requires two app extensions:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Extension"}]}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-UI Extension"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Provides card data, status, and handles the provisioning flow","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineC