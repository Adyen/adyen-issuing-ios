{"metadata":{"title":"Manual Integration","roleHeading":"Article","role":"article"},"abstract":[{"text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/ManualIntegration"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code.","type":"text"}]},{"anchor":"Download-the-SDK","level":2,"type":"heading","text":"Download the SDK"},{"type":"paragraph","inlineContent":[{"text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:","type":"text"}]},{"type":"codeListing","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"],"syntax":"text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning"},{"type":"text","text":" SDK, available from "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios"},{"type":"text","text":". Download the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"type":"text","text":" if you use a Wallet Extension)."}]},{"type":"heading","level":2,"anchor":"Required-Frameworks","text":"Required Frameworks"},{"type":"heading","level":3,"anchor":"Network-Token-Provisioning","text":"Network Token Provisioning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All of the following frameworks are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" for Apple Wallet provisioning:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Framework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Purpose"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import in Code?"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provisioning logic and public API"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared types (","type":"text"},{"code":"TokenProviding","type":"codeVoice"},{"text":", etc.)","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Internal secure communication"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Apple Pay provisioning interface","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]}]}]]]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" must be embedded in your app for the SDK to function, but you should "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" import them in your code. They are used internally by ","type":"text"},{"type":"codeVoice","code":"NetworkTokenProvisioning"},{"type":"text","text":" and should not be accessed directly."}]}],"type":"aside","name":"Important","style":"important"},{"type":"heading","anchor":"Embed-the-Frameworks","text":"Embed the Frameworks","level":2},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Drag all four ","type":"text"},{"code":".xcframework","type":"codeVoice"},{"text":" bundles into your Xcode project navigator.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your app target, go to "},{"type":"strong","inlineContent":[{"text":"General > Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}]},{"type":"heading","anchor":"Import-Statements","text":"Import Statements","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When embedding manually, import the individual modules — not the SPM wrapper name:"}]},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"With SPM, you use ","type":"text"},{"code":"import AdyenNetworkTokenProvisioning","type":"codeVoice"},{"text":" instead (which re-exports both modules automatically). When embedding manually, you must import each module separately.","type":"text"}]}],"style":"note"},{"type":"heading","anchor":"Keychain-Access-Group","text":"Keychain Access Group","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses extensions (e.g., a Wallet Extension for background provisioning), configure a shared keychain access group:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Enable "},{"type":"strong","inlineContent":[{"text":"Keychain Sharing","type":"text"}]},{"type":"text","text":" in your app target’s "},{"type":"strong","inlineContent":[{"text":"Signing & Capabilities","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add the same access group to both the app and the extension."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Pass the access group identifier when configuring the SDK:"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.shared\",","    environment: .live",")"]},{"type":"heading","anchor":"Wallet-Extension-Support","text":"Wallet Extension Support","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app includes a Wallet Extension for provisioning cards in the background, the extension target requires the following frameworks with "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCore.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"IssuingCommon.xcframework","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"AdyenApplePayExtensionProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" (instead of "},{"code":"AdyenApplePayProvisioning","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the extension, use the same imports:"}]},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"type":"heading","anchor":"Verify-the-Integration","text":"Verify the Integration","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"After embedding:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Build the project. All three frameworks should compile and link without errors."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run on the iOS Simulator to verify basic initialization."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Test provisioning on a physical device (simulators do not support Apple Wallet)."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Troubleshooting","text":"Troubleshooting","level":2},{"type":"heading","anchor":"No-such-module-NetworkTokenProvisioning","text":"“No such module ‘NetworkTokenProvisioning’”","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure the XCFramework is added to your target’s "},{"type":"strong","inlineContent":[{"text":"Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":" section and is set to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":"."}]},{"type":"heading","anchor":"No-such-module-IssuingCommon","text":"“No such module ‘IssuingCommon’”","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Same as above — "},{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" must also be embedded. This framework contains shared types like "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Runtime-crash-Library-not-loaded-IssuingCore","text":"Runtime crash: “Library not loaded: IssuingCore”","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" is not embedded. Add it to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":" even though you don’t import it in code. The other frameworks depend on it at runtime."}]},{"type":"heading","anchor":"Runtime-crash-Library-not-loaded-AdyenApplePayProvisioning","text":"Runtime crash: “Library not loaded: AdyenApplePayProvisioning”","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" is not embedded. It is a required dependency for Network Token Provisioning. Add it to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":"."}]},{"type":"heading","anchor":"Duplicate-symbols","text":"Duplicate symbols","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you see duplicate symbol errors, ensure you are not linking both the SPM package and the manual XCFrameworks in the same target. Use one integration method, not both."}]}]}],"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/GettingStarted","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/WalletExtensionsGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/SecurityGuide","doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/AdditionalResources"],"anchor":"Guides"}],"sections":[],"references":{"doc://com.adyen.NetworkTokenProvisioning/documentation/NetworkTokenProvisioning/NetworkTokenProvisioningGuide":{"type":"topic","role":"article","identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningGuide","abstract":[{"type":"text","text":"Add payment cards to Apple Wallet from your iOS application."}],"url":"\/documentation\/networktokenprovisioning\/networktokenprovisioningguide","title":"In-App Provisioning","kind":"article"},"https://github.com/Adyen/adyen-apple-pay-provisioning-ios":{"title":"its GitHub repository","titleInlineContent":[{"type":"text","text":"its GitHub repository"}],"type":"link","url":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios","identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios"},"doc://com.adyen.NetworkTokenProvisioning/documentation/IssuingSDKDocs":{"identifier":"doc:\/\/com.adyen.NetworkTokenProvisioning\/documentation\/IssuingSDKDocs","type":"topic","kind":"article","role":"collection","url":"\/documentation\/issuingsdkdocs","abstract":[{"text":"Integrate Adyen Issuing features into your iOS application.","type":"text"}],"title":"Issuing SDK"},"doc://com.adyen.NetworkTokenProvisioning