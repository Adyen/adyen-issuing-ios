{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you cannot use Swift Package Manager, you can integrate the SDK by manually embedding the pre-built XCFrameworks into your project. This guide covers which frameworks to include, how to configure your project, and what to import in your code."}]},{"level":2,"type":"heading","text":"Download the SDK","anchor":"Download-the-SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Obtain the SDK distribution package from Adyen. The package contains the following structure:"}]},{"type":"codeListing","syntax":"text","code":["Build-IssuingSDK\/","├── XCFrameworks\/","│   ├── NetworkTokenProvisioning.xcframework","│   ├── IssuingCore.xcframework","│   └── IssuingCommon.xcframework","└── Documentation\/"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning"},{"type":"text","text":" SDK, available from "},{"type":"reference","identifier":"https:\/\/github.com\/Adyen\/adyen-apple-pay-provisioning-ios","isActive":true},{"type":"text","text":". Download the "},{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"AdyenApplePayExtensionProvisioning.xcframework"},{"type":"text","text":" if you use a Wallet Extension)."}]},{"level":2,"type":"heading","text":"Required Frameworks","anchor":"Required-Frameworks"},{"level":3,"type":"heading","text":"Network Token Provisioning","anchor":"Network-Token-Provisioning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All of the following frameworks are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" for Apple Wallet provisioning:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Framework","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Import in Code?","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkTokenProvisioning.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"text":"Provisioning logic and public API","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared types (","type":"text"},{"type":"codeVoice","code":"TokenProviding"},{"text":", etc.)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"text":"Internal secure communication","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple Pay provisioning interface"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"}]}]]]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"IssuingCore.xcframework"},{"text":" and ","type":"text"},{"code":"AdyenApplePayProvisioning.xcframework","type":"codeVoice"},{"type":"text","text":" must be embedded in your app for the SDK to function, but you should "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" import them in your code. They are used internally by ","type":"text"},{"type":"codeVoice","code":"NetworkTokenProvisioning"},{"type":"text","text":" and should not be accessed directly."}]}],"name":"Important","type":"aside"},{"level":2,"type":"heading","text":"Embed the Frameworks","anchor":"Embed-the-Frameworks"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Drag all four "},{"type":"codeVoice","code":".xcframework"},{"type":"text","text":" bundles into your Xcode project navigator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select your app target, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"General > Frameworks, Libraries, and Embedded Content"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Ensure all frameworks are listed and set to "},{"type":"strong","inlineContent":[{"text":"Embed & Sign","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NetworkTokenProvisioning.xcframework","type":"codeVoice"},{"text":" — Embed & Sign","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCore.xcframework"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"IssuingCommon.xcframework"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"AdyenApplePayProvisioning.xcframework"},{"type":"text","text":" — Embed & Sign"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"level":2,"type":"heading","text":"Import Statements","anchor":"Import-Statements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When embedding manually, import the individual modules — not the SPM wrapper name:"}]},{"type":"codeListing","code":["import NetworkTokenProvisioning","import IssuingCommon"],"syntax":"swift"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"With SPM, you use "},{"type":"codeVoice","cod