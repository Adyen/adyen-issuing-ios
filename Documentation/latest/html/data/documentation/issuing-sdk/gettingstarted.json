btain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"},{"anchor":"Embed-the-Certificate","type":"heading","level":2,"text":"Embed the Certificate"},{"inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}],"type":"paragraph"},{"anchor":"Fetch-a-Session-Token","type":"heading","text":"Fetch a Session Token","level":2},{"inlineContent":[{"type":"text","text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"URL:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Headers:"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type: application\/json"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"X-API-Key: YOUR_API_KEY","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body:"}]}],"type":"paragraph"},{"syntax":"json","code":["{","    \"allowOrigin\": \"https:\/\/www.adyen.com\",","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"The required "},{"code":"roles","type":"codeVoice"},{"type":"text","