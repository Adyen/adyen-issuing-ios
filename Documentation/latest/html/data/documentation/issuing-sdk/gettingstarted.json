{"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"Getting Started"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"abstract":[{"text":"Integrate the Adyen Issuing SDK into your iOS application.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Network Token Provisioning"}],"type":"strong"},{"type":"text","text":" — Add payment cards to Apple Wallet"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"PIN & PAN Reveal"}],"type":"strong"},{"type":"text","text":" — Securely display card details "},{"inlineContent":[{"type":"text","text":"(coming soon)"}],"type":"emphasis"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This guide covers the common setup steps required for all SDK features.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Prerequisites","anchor":"Prerequisites","type":"heading"},{"inlineContent":[{"text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Embed the Certificate","anchor":"Embed-the-Certificate","type":"heading"},{"inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Fetch a Session Token","anchor":"Fetch-a-Session-Token","type":"heading"},{"inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Perform a ","type":"text"},{"type":"codeVoice","code":"POST"},{"text":" request to the following endpoint:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"URL:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Headers:"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Content-Type: application\/json"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"X-API-Key: YOUR_API_KEY","type":"codeVoice"}]}]}]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Body:"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","    \"allowOrigin\": \"https:\/\/www.adyen.com\",","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The required "},{"type":"codeVoice","code":"roles"},{"type":"text","text":" depend on the SDK feature you are using. See the feature-specific documentation for details."}],"type":"paragraph"}],"style":"note"},{"inlineContent":[{"type":"text","text":"Your backend should receive the session token and pass it to your iOS application."}],"type":"paragraph"},{"text":"Import the SDK","type":"heading","anchor":"Import-the-SDK","level":2},{"inlineContent":[{"type":"text","text":"Add the appropriate import statement at the top of your Swift files."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Swift Package Manager:"}],"type":"strong"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AdyenNetworkTokenProvisioning"]},{"inlineContent":[{"type":"text","text":"This single import gives you access to all public types, including "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ConfigurationParameters","isActive":true,"type":"reference"},{"type":"text","text":", and "},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual Integration (XCFrameworks):"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you embedded the XCFrameworks directly, import the individual modules:"}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","import IssuingCommon"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Do not import "},{"code":"IssuingCore","type":"codeVoice"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}],"type":"paragraph"}],"name":"Note"},{"level":2,"anchor":"Implement-a-Token-Provider","type":"heading","text":"Implement a Token Provider"},{"inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}],"type":"paragraph"},{"code":["import AdyenNetworkTokenProvisioning","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Device Testing Requirements","anchor":"Device-Testing-Requirements"},{"type":"paragraph","inlineContent":[{"text":"The SDK requires a ","type":"text"},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator.","type":"text"}]},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"generated":true,"anchor":"Guides"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/ManualIntegrat