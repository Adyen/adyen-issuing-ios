{"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Network Token Provisioning","type":"text"}]},{"text":" — Add payment cards to Apple Wallet","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"PIN & PAN Reveal"}]},{"type":"text","text":" — Securely display card details "},{"type":"emphasis","inlineContent":[{"type":"text","text":"(coming soon)"}]}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"level":2,"text":"Prerequisites","anchor":"Prerequisites","type":"heading"},{"inlineContent":[{"type":"text","text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"},{"type":"heading","text":"Embed the Certificate","anchor":"Embed-the-Certificate","level":2},{"type":"paragraph","inlineContent":[{"text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle.","type":"text"}]},{"type":"heading","text":"Fetch a Session Token","anchor":"Fetch-a-Session-Token","level":2},{"type":"paragraph","inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}],"type":"paragraph"},{"type":"paragraph","inlineCon