{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Adyen Issuing SDK provides a suite of features for managing payment instruments in your iOS app:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Network Token Provisioning"}],"type":"strong"},{"type":"text","text":" — Add payment cards to Apple Wallet"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"PIN & PAN Reveal"}],"type":"strong"},{"text":" — Securely display card details ","type":"text"},{"inlineContent":[{"text":"(coming soon)","type":"text"}],"type":"emphasis"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This guide covers the common setup steps required for all SDK features."}],"type":"paragraph"},{"level":2,"anchor":"Prerequisites","text":"Prerequisites","type":"heading"},{"inlineContent":[{"type":"text","text":"Before you begin, you must obtain a certificate from Adyen. This certificate is required to initialize the SDK."}],"type":"paragraph"},{"type":"heading","text":"Embed the Certificate","level":2,"anchor":"Embed-the-Certificate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Take the certificate provided by Adyen and embed it directly into your app’s main bundle."}]},{"anchor":"Fetch-a-Session-Token","type":"heading","level":2,"text":"Fetch a Session Token"},{"type":"paragraph","inlineContent":[{"text":"All SDK features require a session token from the Adyen API. Your backend needs to fetch this token for the specific payment instruments.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Perform a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the following endpoint:"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"URL:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"https:\/\/test.adyen.com\/authe\/api\/v1\/sessions","type":"codeVoice"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Headers:"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Content-Type: application\/json","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"X-API-Key: YOUR_API_KEY"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body:"}]}]},{"syntax":"json","code":["{","    \"allowOrigin\": \"https:\/\/www.adyen.com\",","    \"product\": \"platform\",","    \"policy\": {","        \"resources\": [","            {","                \"type\": \"paymentInstrument\",","                \"paymentInstrumentId\": \"...\"","            }","        ],","        \"roles\": [\"...\"]","    }","}"],"type":"codeListing"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The required "},{"type":"codeVoice","code":"roles"},{"text":" depend on the SDK feature you are using. See the feature-specific documentation for details.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your backend should receive the session token and pass it to your iOS application."}]},{"anchor":"Import-the-SDK","type":"heading","level":2,"text":"Import the SDK"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the appropriate import statement at the top of your Swift files."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Swift Package Manager:","type":"text"}]}]},{"syntax":"swift","code":["import AdyenNetworkTokenProvisioning"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This single import gives you access to all public types, including ","type":"text"},{"type":"codeVoice","code":"TokenProviding"},{"text":",