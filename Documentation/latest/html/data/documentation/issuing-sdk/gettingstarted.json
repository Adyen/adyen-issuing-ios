ng ","type":"text"},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ConfigurationParameters","isActive":true},{"text":", and ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Manual Integration (XCFrameworks):"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"If you embedded the XCFrameworks directly, import the individual modules:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import IssuingCommon"]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not import "},{"type":"codeVoice","code":"IssuingCore"},{"type":"text","text":" directly. It is an internal dependency that is required at link time but has no public API for integrators."}]}]},{"type":"heading","level":2,"text":"Implement a Token Provider","anchor":"Implement-a-Token-Provider"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your app needs an object that conforms to the "},{"type":"codeVoice","code":"TokenProviding"},{"type":"text","text":" protocol. This object is responsible for supplying the session token fetched in the previous step."}]},{"code":["import AdyenNetworkTokenProvisioning","","class TokenProvider: TokenProviding {","    func retrieveToken(for paymentInstrumentIds: Set<String>) async throws -> String {","        \/\/ Implement the logic to retrieve the session token for the given","        \/\/ payment instrument IDs from your backend and return it.","        let sessionToken = \"...\"","        return sessionToken","    }","}","","let tokenProvider = TokenProvider()"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Device Testing Requirements","anchor":"Device-Testing-Requirements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK requires a "},{"inlineContent":[{"type":"text","text":"Release build on a physical device"}],"type":"strong"},{"type":"text","text":" for full end-to-end functionality. Use TestFlight to distribute Release builds to testers. The iOS Simulator is suitable for UI development and integration work, but provisioning flows cannot complete on the Simulator."}]},{"type":"heading","level":2,"text":"Next Steps","anchor":"Next-Steps"},{"type":"paragraph","inlineContent":[{"text":"Once you have completed the common setup, proceed to the feature-specific guide:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","isActive":true,"type":"reference"}],"type":"paragraph"}]}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"generated":true,"anchor":"Guides","title":"Guides"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"article","roleHeading":"Article","title":"Getting Started"},"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","interfaceLanguage":"swift"},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK into your iOS application."}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/NetworkTokenProvisioning/C