{"identifier":{"url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","roleHeading":"Article","title":"In-App Provisioning"},"abstract":[{"text":"Add payment cards to Apple Wallet from your iOS application.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Network Token Provisioning enables your users to add their payment cards to Apple Wallet directly from your app. This is a session-based service that manages the provisioning flow and tracks card status across iPhone and Apple Watch."}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complete the steps in "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","isActive":true},{"type":"text","text":" before proceeding."}]}],"type":"aside"},{"anchor":"Import","level":2,"text":"Import","type":"heading"},{"inlineContent":[{"type":"text","text":"If you haven’t already, add the import to your file:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import AdyenNetworkTokenProvisioning"]},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you integrated the SDK manually with XCFrameworks, use "},{"code":"import NetworkTokenProvisioning","type":"codeVoice"},{"type":"text","text":" and "},{"code":"import IssuingCommon","type":"codeVoice"},{"type":"text","text":" instead. See "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","isActive":true},{"type":"text","text":" for details."}]}],"type":"aside"},{"anchor":"Session-Token-Roles","level":2,"text":"Session Token Roles","type":"heading"},{"inlineContent":[{"type":"text","text":"When fetching a session token for Network Token Provisioning, use the following role:"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["\"roles\": [\"Network Token: Create\"]"]},{"anchor":"Create-a-Configuration-Object","level":2,"text":"Create a Configuration Object","type":"heading"},{"inlineContent":[{"type":"text","text":"Create an instance of "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ConfigurationParameters","isActive":true},{"type":"text","text":". This object configures the session with your certificate, the specific payment instrument, your keychain group, and the target environment."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Read the certificate data from your app's bundle","let certificate: Data = \/\/ ... load your certificate data","","\/\/ Define the configuration parameters","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"[TeamId].com.yourcompany.yourappname.provisioningkeychain\",","    environment: .test",")"]},{"anchor":"Initialize-the-Provisioning-Session","level":2,"text":"Initialize the Provisioning Session","type":"heading"},{"inlineContent":[{"type":"text","text":"With the configuration parameters and token provider ready, create an instance of "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and call "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession\/configure()","isActive":true},{"type":"text","text":" to fetch activation data."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The initializer is synchronous, so you can create the session in any context (e.g., dependency injection"},{"type":"text","text":" "},{"type":"text","text":"containers, view model initializers). The async work happens in "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession\/configure()","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let session = try ProvisioningSession(","        parameters: parameters,","        tokenProvider: tokenProvider","    )","    try await session.configure()","    self.provisioningSession = session","} catch {","    \/\/ Handle initialization or configuration errors","    print(\"Provisioning session could not be created.\")","}"]},{"anchor":"Check-the-Provisioning-State","level":2,"text":"Check the Provisioning State","type":"heading"},{"inlineContent":[{"type":"text","text":"Before showing the “Add to Apple Wallet” button, check the current state for the specific payment instrument. This ensures that the card is eligible for provisioning and allows you to update your UI based on which devices are available."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let state = await provisioningSession.provisioningState(for: paymentInstrumentId)","","switch state {","case .canProvision(let provisionableDevices):","    \/\/ The card can be provisioned. Show the \"Add to Apple Wallet\" button.","    switch provisionableDevices {","    case .phone:","        print(\"Can provision on this phone.\")","    case .phoneAndWatch:","        print(\"Can provision on this phone and a paired watch.\")","    case .provisionedOnWatchCanProvisionOnPhone:","        print(\"Already on watch, but can be added to this phone.\")","    case .provisionedOnPhoneCanProvisionOnWatch:","        print(\"Already on phone, but can be added to a paired watch.\")","    }","","case .provisioned(let provisionedDevices):","    \/\/ The card is already provisioned on all available devices.","    switch provisionedDevices {","    case .phone:","        print(\"Card is provisioned on this phone.\")","    case .phoneAndWatch:","        print(\"Card is provisioned on this phone and a paired watch.\")","    }","","case .cannotProvision(let reason):","    \/\/ The card cannot be provisioned. Use reason.localizedDescription for display only.","    switch reason {","    case .notConfigured:","        print(\"Call configure() before checking provisioning state.\")","    case .provisioningError(let error):","        print(\"Provisioning error: \\(error.localizedDescription)\")","    case .missingPassURL, .cannotAddCard, .unexpectedCardState:","        print(\"Card cannot be provisioned.\")","    }","}"]},{"anchor":"Provision-the-Card","level":2,"text":"Provision the Card","type":"heading"},{"inlineContent":[{"type":"text","text":"When the user taps your “Add to Apple Wallet” button, call the "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession\/provision(paymentInstrumentId:viewController:)","isActive":true},{"type":"text","text":" method. This method presents the native Apple Wallet interface."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["guard let viewController = self.view.window?.rootViewController else { return }","","do {","    let activationState = try await provisioningSession.provision(","        paymentInstrumentId: paymentInstrumentId,","        viewController: viewController","    )","    \/\/ Handle the result in the next step","} catch {","    print(\"Provisioning failed.\")","}"]},{"anchor":"Handle-the-Final-State","level":2,"text":"Handle the Final State","type":"heading"},{"inlineContent":[{"type":"text","text":"After the Apple Wallet flow completes, the "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession\/provision(paymentInstrumentId:viewController:)","isActive":true},{"type":"text","text":" method returns a "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenActivationState","isActive":true},{"type":"text","text":". Use this state to update your UI accordingly."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["switch activationState {","case .activated:","    \/\/ Card was successfully added and is active.","case .requiresActivation:","    \/\/ Card was added but requires additional activation steps from the user.","case .activating:","    \/\/ Card is currently in the process of activating.","case .suspended:","    \/\/ Card has been suspended by the issuer.","case .deactivated:","    \/\/ Card has been deactivated by the user or issuer.","case .unknown:","    \/\/ The state of the card could not be determined.","}"]},{"anchor":"Wallet-Extensions","level":2,"text":"Wallet Extensions","type":"heading"},{"inlineContent":[{"type":"text","text":"To provision cards from the Apple Wallet app (without opening your app), see "},{"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"generated":true,"anchor":"Guides"}],"references":{"doc://com.adyen.IssuingSDKDocs/documentation/NetworkTokenP