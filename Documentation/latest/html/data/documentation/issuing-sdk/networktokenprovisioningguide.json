"text":"paymentInstrumentId"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:24NetworkTokenProvisioning19PaymentInstrumentIda","text":"PaymentInstrumentId"},{"kind":"text","text":", "},{"kind":"externalParam","text":"viewController"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIViewController","text":"UIViewController"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:24NetworkTokenProvisioning0aB15ActivationStateO","text":"NetworkTokenActivationState"}],"kind":"symbol","url":"\/documentation\/networktokenprovisioning\/provisioningsession\/provision(paymentinstrumentid:viewcontroller:)","abstract":[{"type":"text","text":"Starts the Apple Wallet provisioning flow for a specific payment instrument."}],"title":"provision(paymentInstrumentId:viewController:)","role":"symbol"},"doc://com.adyen.IssuingSDKDocs/documentation/NetworkTokenProvisioning/NetworkTokenActivationState":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenActivationState","navigatorTitle":[{"kind":"identifier","text":"NetworkTokenActivationState"}],"title":"NetworkTokenActivationState","url":"\/documentation\/networktokenprovisioning\/networktokenactivationstate","abstract":[{"type":"text","text":"Represents the activation state of a provisioned network token (card) in Apple Wallet."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"NetworkTokenActivationState"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/WalletExtensionsGuide":{"kind":"article","role":"article","title":"Wallet Extensions","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide","type":"topic","url":"\/documen