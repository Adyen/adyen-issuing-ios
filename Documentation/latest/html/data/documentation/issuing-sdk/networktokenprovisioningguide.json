ovisioningSession","role":"symbol","url":"\/documentation\/networktokenprovisioning\/provisioningsession","abstract":[{"type":"text","text":"The main public class for managing a network token provisioning session."}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/ProvisioningSession","navigatorTitle":[{"kind":"identifier","text":"ProvisioningSession"}]},"doc://com.adyen.IssuingSDKDocs/documentation/Issuing-SDK/ManualIntegration":{"kind":"article","role":"article","title":"Manual Integration","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","url":"\/documentation\/issuing-sdk\/manualintegration","type":"topic","abstract":[{"type":"text","text":"Integrate the Adyen Issuing SDK by embedding XCFrameworks directly into your Xcode project."}]}}}