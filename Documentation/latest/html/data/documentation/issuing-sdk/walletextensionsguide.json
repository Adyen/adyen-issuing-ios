{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Allow cardholders to provision cards directly from the Apple Wallet app."}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/IssuingSDKDocs"]]},"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"text":" section, giving users another path to provision their cards.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This requires two app extensions:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Extension","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-UI Extension","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Provides card data, status, and handles the provisioning flow","type":"text"}]}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Presents your custom authentication UI before provisioning"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic."}],"type":"paragraph"},{"text":"Prerequisites","anchor":"Prerequisites","type":"heading","level":2},{"inlineContent":[{"text":"Before implementing wallet extensions:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Complete the "},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":" guide and have in-app provisioning working."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure you have the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement. This entitlement must be added to ","type":"text"},{"inlineContent":[{"type":"text","text":"all three targets"}],"type":"strong"},{"text":": the main app, the Non-UI Extension, and the UI Extension.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Set up a shared keychain access group so the main app and extensions can share cached data.","type":"text"}]}]}]},{"type":"heading","anchor":"Step-1-Create-the-Non-UI-Extension-Target","level":2,"text":"Step 1: Create the Non-UI Extension Target"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"inlineContent":[{"type":"text","text":"File > New > Target"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the ","type":"text"},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"text":" template and create a new target (e.g., ","type":"text"},{"code":"WalletExtension","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files ","type":"text"},{"inlineContent":[{"type":"text","text":"except"}],"type":"strong"},{"text":" ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Update the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" — find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler"}],"type":"paragraph"}]]]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement to this target.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a shared app group entitlement (e.g., ","type":"text"},{"code":"group.com.yourcompany.wallet","type":"codeVoice"},{"text":") matching the one in your main app.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Add-the-SDK-to-the-Extension-Target","level":3,"text":"Add the SDK to the Extension Target"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Swift Package Manager:","type":"text"}],"type":"strong"}]},{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"AdyenNetworkTokenProvisioning"},{"type":"text","text":" as a dependency of your extension target, just as you did for the main app."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Manual Integration:"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Embed the same XCFrameworks in the extension target with "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":". See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration"},{"type":"text","text":" for which frameworks are required."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 2: Implement the Non-UI Extension Handler","anchor":"Step-2-Implement-the-Non-UI-Extension-Handler"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler"},{"type":"text","text":". This class is your extension’s entry point — its name must match the "},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"type":"text","text":" in your "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"]},{"type":"heading","level":3,"text":"Required Overrides","anchor":"Required-Overrides"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}]}],[{"inlineContent":[{"text":"Shared keychain group for cached data between app and extension","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Provide card art as a ","type":"text"},{"type":"codeVoice","code":"CGImage"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Whether to show the UI Extension for authentication"}],"type":"paragraph"}]]]},{"type":"heading","level":3,"text":"Optional Overrides","anchor":"Optional-Overrides"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment()"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Set the session environment (","type":"text"},{"code":".test","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":".live"},{"text":")","type":"text"}]}]]]},{"type":"heading","level":2,"text":"Step 3: Cache Activation Data in Your Main App","anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App"},{"inlineContent":[{"type":"text","text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"text":" section. Make sure the user has opened the provisioning flow in your main app at least once.","type":"text"}]}],"name":"Important"},{"text":"Step 4: Create the UI Extension Target","anchor":"Step-4-Create-the-UI-Extension-Target","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the "},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"type":"text","text":" template again (e.g., "},{"type":"codeVoice","code":"WalletUIExtension"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"text":"except","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Update the ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" — find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"NSExtensionPointIdentifier"}],"type":"paragraph"}],[{"inlineContent":[{"text":"String","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning.authorization"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NSExtensionPrincipalClass"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler"}]}]]]}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement to this target as well.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Step 5: Implement the UI Extension Handler","anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","isActive":true,"type":"reference"},{"type":"text","text":". This view controller is presented by Apple Wallet when authentication is required."}],"type":"paragraph"},{"syntax":"swift","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can use UIKit or SwiftUI (via "},{"type":"codeVoice","code":"UIHostingController"},{"text":") for the authentication UI. The key requirement is calling ","type":"text"},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when the user finishes authenticating.","type":"text"}],"type":"paragraph"},{"text":"Using SwiftUI","anchor":"Using-SwiftUI","type":"heading","level":3},{"code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Entitlements Summary","anchor":"Entitlements-Summary","type":"heading","level":2},{"inlineContent":[{"text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access.","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Entitlement"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Main App"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Non-UI Extension"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"UI Extension"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Required","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"com.apple.security.application-groups","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Required"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optional"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Example ","type":"text"},{"code":".entitlements","type":"codeVoice"},{"text":" file for the Non-UI Extension:","type":"text"}],"type":"paragraph"},{"code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"],"syntax":"xml","type":"codeListing"},{"text":"How It Works","anchor":"How-It-Works","type":"heading","level":2},{"inlineContent":[{"text":"Once configured, the flow works as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"User opens Apple Wallet","type":"text"}]},{"text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the ","type":"text"},{"type":"strong","inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}]},{"type":"text","text":" section."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User selects your app"}]},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authentication","type":"text"}],"type":"strong"},{"text":" — If ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"type":"text","text":" returns "},{"code":"true","type":"codeVoice"},{"text":", Apple Wallet presents your UI Extension. Your UI Extension calls ","type":"text"},{"code":"completeAuthorization(result:)","type":"codeVoice"},{"type":"text","text":" when done."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Provisioning","type":"text"}],"type":"strong"},{"text":" — The SDK handles the provisioning request using the session token from your ","type":"text"},{"code":"sessionToken(paymentInstrumentIds:)","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference.","type":"text"}]}]},{"type":"heading","anchor":"Troubleshooting","level":2,"text":"Troubleshooting"},{"type":"heading","anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone","level":3,"text":"App does not appear in Wallet’s “From Apps on Your iPhone”"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement is present on all three targets.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure activation data has been cached by the main app before opening Wallet.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Check that the ","type":"text"},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"text":" is set to ","type":"text"},{"code":"com.apple.PassKit.issuer-provisioning","type":"codeVoice"},{"text":" (not the authorization variant) in the Non-UI Extension.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Make sure the ","type":"text"},{"type":"codeVoice","code":"NSExtensionPrincipalClass"},{"text":" matches your handler class name exactly.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Authentication-UI-does-not-appear","level":3,"text":"Authentication UI does not appear"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"code":"shouldAuthenticateUser()","type":"codeVoice"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check that the UI Extension’s ","type":"text"},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"text":" is set to ","type":"text"},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"level":3,"text":"Extension cannot access cached data","type":"heading","anchor":"Extension-cannot-access-cached-data"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Confirm both the main app and the extension share the same keychain access group.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify the ","type":"text"},{"code":"com.apple.security.application-groups","type":"codeVoice"},{"text":" entitlement is present on both targets with the same group identifier.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure the ","type":"text"},{"code":"keychainAccessGroup()","type":"codeVoice"},{"text":" override returns the correct value.","type":"text"}],"type":"paragraph"}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/WalletExtensionsGuide"},"metadata":{"roleHeading":"Article","title":"Wallet Extensions","role":"article"},"references":{"doc://com.adyen.IssuingSDKDocs/documentation/NetworkTokenProvisioning/NetworkTokenProvisioningExtensionHandler":{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler","role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The main entry point for the Apple Pay provisioning app extension."}],"navigatorTitle":[{"kind":"identifier","text":"NetworkTokenProvisioningExtensionHandler"}],"title":"NetworkTokenProvisioningExtensionHandler","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"NetworkTokenProvisioningExtensionHandler","kind":"identifier"}],"url":"\/documentation\/networktokenprovisioning\/networktokenprovisioningextensionhandler"},"doc://com.adyen.IssuingSDKDocs/documentation/NetworkTokenProvisioning/NetworkTokenProvisioningExtensionUIHandler":{"url":"\/documentation\/networktokenprovisioning\/networktokenprovisioningextensionuihandler","navigatorTitle":[{"kind":"identifier","text":"NetworkTokenProvisioningExtensionUIHandler"}],"type":"topic","title":"NetworkTokenProvisioningExtensionUIHandler","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"NetworkTokenProvisioningExtensionUIHandler"}],"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler","kind":"symbol","abstract":[{"type":"text","text":"An abstra