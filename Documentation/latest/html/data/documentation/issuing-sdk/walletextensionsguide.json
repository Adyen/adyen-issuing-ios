{"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/NetworkTokenProvisioningGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/SecurityGuide","doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/AdditionalResources"],"generated":true,"title":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition to in-app provisioning, you can let cardholders add their payment cards from the Apple Wallet app itself. When configured, your app’s name and icon appear in Wallet’s "},{"type":"strong","inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}]},{"type":"text","text":" section, giving users another path to provision their cards."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This requires two app extensions:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Extension"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Non-UI Extension","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provides card data, status, and handles the provisioning flow"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"UI Extension","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Presents your custom authentication UI before provisioning","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The SDK provides two base classes that handle the complexity of communicating with Apple Wallet. You subclass them and provide your app-specific logic.","type":"text"}]},{"anchor":"Prerequisites","level":2,"text":"Prerequisites","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Before implementing wallet extensions:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Complete the ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/GettingStarted","type":"reference","isActive":true},{"text":" guide and have in-app provisioning working.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure you have the "},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"type":"text","text":" entitlement. This entitlement must be added to "},{"type":"strong","inlineContent":[{"text":"all three targets","type":"text"}]},{"type":"text","text":": the main app, the Non-UI Extension, and the UI Extension."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set up a shared keychain access group so the main app and extensions can share cached data."}]}]}],"type":"orderedList"},{"level":2,"text":"Step 1: Create the Non-UI Extension Target","type":"heading","anchor":"Step-1-Create-the-Non-UI-Extension-Target"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"type":"text","text":"File > New > Target"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Action Extension","type":"text"}]},{"text":" template and create a new target (e.g., ","type":"text"},{"type":"codeVoice","code":"WalletExtension"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove all generated files "},{"type":"strong","inlineContent":[{"type":"text","text":"except"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Update the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" — find the ","type":"text"},{"code":"NSExtension","type":"codeVoice"},{"text":" dictionary and set:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"String"}]}],[{"inlineContent":[{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"String"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"$(PRODUCT_MODULE_NAME).WalletExtensionHandler"}],"type":"paragraph"}]]],"header":"row"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"},{"text":" entitlement to this target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a shared app group entitlement (e.g., "},{"code":"group.com.yourcompany.wallet","type":"codeVoice"},{"type":"text","text":") matching the one in your main app."}]}]}]},{"text":"Add the SDK to the Extension Target","anchor":"Add-the-SDK-to-the-Extension-Target","level":3,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Swift Package Manager:"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"AdyenNetworkTokenProvisioning"},{"type":"text","text":" as a dependency of your extension target, just as you did for the main app."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Manual Integration:"}],"type":"strong"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Embed the same XCFrameworks in the extension target with "},{"type":"strong","inlineContent":[{"type":"text","text":"Embed & Sign"}]},{"type":"text","text":". See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/Issuing-SDK\/ManualIntegration"},{"type":"text","text":" for which frameworks are required."}],"type":"paragraph"},{"anchor":"Step-2-Implement-the-Non-UI-Extension-Handler","level":2,"text":"Step 2: Implement the Non-UI Extension Handler","type":"heading"},{"inlineContent":[{"text":"Create a subclass of ","type":"text"},{"identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionHandler","type":"reference","isActive":true},{"text":". This class is your extension’s entry point — its name must match the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" in your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["import NetworkTokenProvisioning","","class WalletExtensionHandler: NetworkTokenProvisioningExtensionHandler {","","    override init() {","        super.init()","        \/\/ Perform any setup needed, such as configuring","        \/\/ your dependency container for the extension context.","    }","","    override func keychainAccessGroup() -> String {","        \/\/ Return the shared keychain access group identifier.","        \/\/ This must match the access group used in your main app","        \/\/ so the extension can read cached provisioning data.","        return \"TEAM_ID.com.yourcompany.shared\"","    }","","    override func sessionToken(paymentInstrumentIds: [String]) async throws -> String {","        \/\/ Fetch a session token from your backend for the given","        \/\/ payment instrument IDs. This is the same token retrieval","        \/\/ logic you use in your main app's TokenProvider.","        let token = try await yourNetworkClient.fetchSessionToken(","            paymentInstrumentIds: paymentInstrumentIds","        )","        return token","    }","","    override func cardArt(paymentInstrumentId: String, brand: String) -> CGImage {","        \/\/ Return a CGImage representing the card.","        \/\/ The brand parameter (e.g., \"visa\", \"mc\") can help you","        \/\/ select the correct card art asset.","        let imageName = brand.contains(\"mc\") ? \"card_mc\" : \"card_visa\"","        if let image = UIImage(named: imageName), let cgImage = image.cgImage {","            return cgImage","        }","        \/\/ Fall back to a placeholder asset if the named image is missing.","        if let placeholder = UIImage(named: \"card_placeholder\"), let cgImage = placeholder.cgImage {","            return cgImage","        }","        \/\/ Last resort: render a 1×1 solid-colour image so this method never crashes.","        \/\/ UIGraphicsImageRenderer always produces a valid CGImage.","        let renderer = UIGraphicsImageRenderer(size: CGSize(width: 1, height: 1))","        return renderer.image { ctx in","            UIColor.systemGray5.setFill()","            UIRectFill(ctx.format.bounds)","        }.cgImage!","    }","","    override func shouldAuthenticateUser() -> Bool {","        \/\/ Return true if you have implemented a UI Extension","        \/\/ for cardholder authentication. Return false to skip","        \/\/ the authentication step.","        return true","    }","","    override func environment() -> SessionEnvironment {","        \/\/ Return the environment matching your backend configuration.","        \/\/ Defaults to .live if not overridden.","        return .live","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Required-Overrides","level":3,"text":"Required Overrides","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Purpose"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"keychainAccessGroup()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shared keychain group for cached data between app and extension","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fetch a session token from your backend"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"cardArt(paymentInstrumentId:brand:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Provide card art as a "},{"type":"codeVoice","code":"CGImage"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"shouldAuthenticateUser()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether to show the UI Extension for authentication","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Optional-Overrides","level":3,"text":"Optional Overrides","type":"heading"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"text":"Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Purpose","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment()"}]}],[{"type":"paragraph","inlineContent":[{"code":".live","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Set the session environment (","type":"text"},{"code":".test","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":".live"},{"type":"text","text":")"}]}]]],"header":"row"},{"anchor":"Step-3-Cache-Activation-Data-in-Your-Main-App","type":"heading","level":2,"text":"Step 3: Cache Activation Data in Your Main App"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK needs cached activation data to be available in the shared keychain so the extension can function. In your main app, ensure you configure the session with a "},{"type":"codeVoice","code":"keychainAccessGroup"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ In your main app, after fetching activation data:","let parameters = ConfigurationParameters(","    appCertificate: certificate,","    paymentInstrumentIds: [paymentInstrumentId],","    keychainAccessGroup: \"TEAM_ID.com.yourcompany.shared\",","    environment: .live",")","","\/\/ The SDK automatically caches activation data in the shared","\/\/ keychain when you configure a session with a keychainAccessGroup."]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"If no cached data is available, the extension will report that no entries are available, and your app will not appear in the Wallet’s ","type":"text"},{"inlineContent":[{"type":"text","text":"From Apps on Your iPhone"}],"type":"strong"},{"text":" section. Make sure the user has opened the provisioning flow in your main app at least once.","type":"text"}]}],"style":"important"},{"anchor":"Step-4-Create-the-UI-Extension-Target","type":"heading","level":2,"text":"Step 4: Create the UI Extension Target"},{"inlineContent":[{"type":"text","text":"If you want to authenticate the cardholder before provisioning (recommended), create a second extension:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, go to "},{"type":"strong","inlineContent":[{"text":"File > New > Target","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Select the ","type":"text"},{"inlineContent":[{"type":"text","text":"Action Extension"}],"type":"strong"},{"text":" template again (e.g., ","type":"text"},{"type":"codeVoice","code":"WalletUIExtension"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove all generated files ","type":"text"},{"inlineContent":[{"text":"except","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"Info.plist"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Update the ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" — find the ","type":"text"},{"type":"codeVoice","code":"NSExtension"},{"text":" dictionary and set:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPointIdentifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NSExtensionPrincipalClass","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"String","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"$(PRODUCT_MODULE_NAME).WalletUIExtensionHandler","type":"codeVoice"}]}]]],"type":"table"}]},{"content":[{"inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"text":" entitlement to this target as well.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","text":"Step 5: Implement the UI Extension Handler","level":2,"anchor":"Step-5-Implement-the-UI-Extension-Handler"},{"inlineContent":[{"type":"text","text":"Create a subclass of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.adyen.IssuingSDKDocs\/documentation\/NetworkTokenProvisioning\/NetworkTokenProvisioningExtensionUIHandler"},{"type":"text","text":". This view controller is presented by Apple Wallet when authentication is required."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        \/\/ Build your authentication UI.","        \/\/ When authentication succeeds, call completeAuthorization(result: .authorized).","        \/\/ When it fails or is canceled, call completeAuthorization(result: .canceled).","","        let authViewController = YourAuthViewController { [weak self] success in","            let result: AuthorizationResult = success ? .authorized : .canceled","            self?.completeAuthorization(result: result)","        }","","        addChild(authViewController)","        view.addSubview(authViewController.view)","        authViewController.view.frame = view.bounds","        authViewController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"]},{"inlineContent":[{"type":"text","text":"You can use UIKit or SwiftUI (via "},{"type":"codeVoice","code":"UIHostingController"},{"type":"text","text":") for the authentication UI. The key requirement is calling "},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"type":"text","text":" when the user finishes authenticating."}],"type":"paragraph"},{"type":"heading","text":"Using SwiftUI","level":3,"anchor":"Using-SwiftUI"},{"syntax":"swift","type":"codeListing","code":["import NetworkTokenProvisioning","import SwiftUI","import UIKit","","class WalletUIExtensionHandler: NetworkTokenProvisioningExtensionUIHandler {","","    override init(nibName nibNameOrNil: String?, bundle nibBundleOrNil: Bundle?) {","        super.init(nibName: nibNameOrNil, bundle: nibBundleOrNil)","","        let hostingController = UIHostingController(","            rootView: YourAuthView { [weak self] success in","                let result: AuthorizationResult = success ? .authorized : .canceled","                self?.completeAuthorization(result: result)","            }","        )","","        addChild(hostingController)","        view.addSubview(hostingController.view)","        hostingController.view.frame = view.bounds","        hostingController.didMove(toParent: self)","    }","","    override func viewDidLayoutSubviews() {","        super.viewDidLayoutSubviews()","        children.first?.view.frame = view.bounds","    }","","    @available(*, unavailable)","    required init?(coder: NSCoder) {","        fatalError(\"init(coder:) has not been implemented\")","    }","}"]},{"type":"heading","text":"Entitlements Summary","level":2,"anchor":"Entitlements-Summary"},{"inlineContent":[{"type":"text","text":"All three targets need the provisioning entitlement. The main app and Non-UI Extension also need a shared app group for keychain access."}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Entitlement"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Main App","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Non-UI Extension"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"UI Extension"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.payment-pass-provisioning","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.security.application-groups","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Required","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Required"}]}],[{"inlineContent":[{"text":"Optional","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example "},{"type":"codeVoice","code":".entitlements"},{"type":"text","text":" file for the Non-UI Extension:"}]},{"syntax":"xml","type":"codeListing","code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\"","  \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    <key>com.apple.developer.payment-pass-provisioning<\/key>","    <true\/>","    <key>com.apple.security.application-groups<\/key>","    <array>","        <string>group.com.yourcompany.wallet<\/string>","    <\/array>","<\/dict>","<\/plist>"]},{"level":2,"type":"heading","text":"How It Works","anchor":"How-It-Works"},{"inlineContent":[{"type":"text","text":"Once configured, the flow works as follows:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"User opens Apple Wallet"}],"type":"strong"},{"text":" — The SDK uses cached activation data to determine whether cards are available for provisioning. Your app appears in the ","type":"text"},{"inlineContent":[{"text":"From Apps on Your iPhone","type":"text"}],"type":"strong"},{"text":" section.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"User selects your app"}]},{"type":"text","text":" — The SDK displays available cards using the card art you provide."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication"}]},{"text":" — If ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", Apple Wallet presents your UI Extension. Your UI Extension calls ","type":"text"},{"type":"codeVoice","code":"completeAuthorization(result:)"},{"text":" when done.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Provisioning","type":"text"}]},{"type":"text","text":" — The SDK handles the provisioning request using the session token from your "},{"type":"codeVoice","code":"sessionToken(paymentInstrumentIds:)"},{"type":"text","text":" method."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Card is added to Apple Wallet"}],"type":"strong"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"text":"The SDK handles all the provisioning logic internally. Your Non-UI Extension subclass only needs to provide the session token, card art, keychain access group, and authentication preference.","type":"text"}],"type":"paragraph"}]},{"text":"Troubleshooting","anchor":"Troubleshooting","level":2,"type":"heading"},{"text":"App does not appear in Wallet’s “From Apps on Your iPhone”","anchor":"App-does-not-appear-in-Wallets-From-Apps-on-Your-iPhone","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.developer.payment-pass-provisioning"},{"type":"text","text":" entitlement is present on all three targets."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure activation data has been cached by the main app before opening Wallet."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Check that the "},{"type":"codeVoice","code":"NSExtensionPointIdentifier"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"com.apple.PassKit.issuer-provisioning"},{"type":"text","text":" (not the authorization variant) in the Non-UI Extension."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Make sure the ","type":"text"},{"code":"NSExtensionPrincipalClass","type":"codeVoice"},{"text":" matches your handler class name exactly.","type":"text"}]}]}]},{"level":3,"type":"heading","text":"Authentication UI does not appear","anchor":"Authentication-UI-does-not-appear"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"shouldAuthenticateUser()"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check that the UI Extension’s "},{"code":"NSExtensionPointIdentifier","type":"codeVoice"},{"type":"text","text":" is set to "},{"code":"com.apple.PassKit.issuer-provisioning.authorization","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"level":3,"anchor":"Extension-cannot-access-cached-data","text":"Extension cannot access cached data","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Confirm both the main app and the extension share the same keychain access group.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the "},{"type":"codeVoice","code":"com.apple.security.application-groups"},{"type":"text","text":" entitlement is present on both targets with the same group identifier."}]}]},{"content":[{"inlineContent":[{"text":"Ensure the ","type":"text"},{"code":"keychainAccessGroup()","type":"codeVoice"},{"text":" override returns the correct value.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"schemaVersion":{"pat